alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias Inputs = std::process::Inputs;
alias HandleFactory = std::io::HandleFactory;
alias CancelWatch = std::time::CancelWatch;
alias Instant = std::time::Instant;
alias IoError = std::io::IoError;
alias ReadStop = std::io::ReadStop;
alias Args = std::text::Args;
alias TcpListener = std::net::TcpListener;
alias TcpReceive = std::net::TcpReceive;
alias TcpSend = std::net::TcpSend;
alias TcpConnection = std::net::TcpConnection;
alias AcceptedConnection = std::net::AcceptedConnection;
alias SocketAddress = std::net::SocketAddress;

fn parse_port(args: &Args) -> result: Result<u16, unit> reads(args) {
  let arg_result = std::text::arg_get(args: args, position: 1_u64);
  let port_str = match arg_result {
    Ok(value: s) => {
      give s;
    }
    Err(error: e) => {
      return Err<u16, unit>(error: unit);
    }
  };
  let port_len = std::text::host_bytes_len(value: &port_str);
  if port_len > 5_u64 {
    return Err<u16, unit>(error: unit);
  }
  let port_buffer = array_filled::<u8, 5>(value: 0_u8);
  let copy_result = std::text::host_copy_bytes(value: &port_str, destination: &port_buffer[0_u64..5_u64], start: 0_u64, end: port_len);
  let actual_copied = match copy_result {
    Ok(value: next) => {
      give next;
    }
    Err(error: e) => {
      return Err<u16, unit>(error: unit);
    }
  };
  let port = 0_u16;
  for (i in 0_u64..actual_copied) {
    let digit = port_buffer[i];
    let is_digit = band(digit >= 48_u8, digit <= 57_u8);
    if is_digit {
      let value = digit - 48_u8;
      let temp = cvt::<u8, u16>(value);
      let port_wrapped = port *wrap 10_u16;
      let temp_wide = cvt::<u16, u16>(temp);
      set port = port_wrapped +wrap temp_wide;
    } else {
      return Err<u16, unit>(error: unit);
    }
  }
  return Ok<u16, unit>(value: port);
}

fn echo_peer(receive: std::net::TcpReceive, send: std::net::TcpSend, factory: &HandleFactory) -> result: unit pure waits {
  let buffer = array_filled::<u8, 3>(value: 0_u8);
  loop @reading {
    let window = &buffer[0_u64..3_u64];
    let no_deadline = None<Instant>();
    let cancel = std::time::cancel_never();
    let read_outcome = std::net::receive_next(receive: &receive, destination: window, start: 0_u64, end: 3_u64, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match read_outcome {
      Ok(value: next) => {
        if next > 0_u64 {
          let send_buffer = &buffer[0_u64..next];
          let sent = 0_u64;
          loop @sending {
            let remaining = next - sent;
            if remaining > 0_u64 {
            } else {
              break @sending;
            }
            let send_cancel = std::time::cancel_never();
            let send_outcome = std::net::send_once(send: &send, source: send_buffer, start: sent, end: next, deadline: no_deadline, cancel: &send_cancel);
            std::time::close_cancel_watch(watch: move send_cancel);
            match send_outcome {
              Ok(value: sent_next) => {
                set sent = sent_next;
              }
              Err(error: problem) => {
                let close_recv = std::net::close_receive(factory: factory, receive: move receive);
                let close_send = std::net::close_send(factory: factory, send: move send);
                return unit;
              }
            }
          }
        }
      }
      Err(error: stop) => {
        match stop {
          ReadEnd() => {
            let close_recv = std::net::close_receive(factory: factory, receive: move receive);
            let close_send = std::net::close_send(factory: factory, send: move send);
            return unit;
          }
          ReadFailed(error: problem) => {
            let close_recv = std::net::close_receive(factory: factory, receive: move receive);
            let close_send = std::net::close_send(factory: factory, send: move send);
            return unit;
          }
        }
      }
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: args, drivers: unused_drivers, cwd: cwd, stdout: unused_stdout, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd;
  let close_write = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let close_read = std::fs::close_directory(factory: &factory, directory: move cwd_read);
  let port_result = parse_port(args: &args);
  let port = match port_result {
    Ok(value: p) => {
      give p;
    }
    Err(error: e) => {
      return exit_status(code: 1_u8);
    }
  };
  let address = std::net::socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: port);
  let no_deadline = None<Instant>();
  let cancel = std::time::cancel_never();
  let listen_outcome = std::net::tcp_listen(factory: &factory, address: &address);
  std::time::close_cancel_watch(watch: move cancel);
  let listener = match listen_outcome {
    Ok(value: l) => {
      give l;
    }
    Err(error: e) => {
      return exit_status(code: 1_u8);
    }
  };
  for (i in 0_u64..12_u64) {
    let cancel_accept = std::time::cancel_never();
    let accept_outcome = std::net::tcp_accept(factory: &factory, listener: &listener, deadline: no_deadline, cancel: &cancel_accept);
    std::time::close_cancel_watch(watch: move cancel_accept);
    let std::net::AcceptedConnection(connection: conn, peer: unused_peer) = match accept_outcome {
      Ok(value: ac) => {
        give ac;
      }
      Err(error: e) => {
        let close_listener = std::net::close_listener(factory: &factory, listener: move listener);
        return exit_status(code: 1_u8);
      }
    };
    let std::net::TcpConnection(receive: recv, send: snd) = move conn;
    spawn echo_peer(receive: move recv, send: move snd, factory: &factory);
  }
  let close_listener = std::net::close_listener(factory: &factory, listener: move listener);
  return exit_status(code: 0_u8);
}

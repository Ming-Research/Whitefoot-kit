alias Args = std::text::Args;
alias CancelWatch = std::time::CancelWatch;
alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias IoError = std::io::IoError;
alias TcpReceive = std::net::TcpReceive;
alias TcpSend = std::net::TcpSend;
alias exit_status = std::process::exit_status;

fn read_port(args: &Args) -> result: Option<u16> reads(args) {
  let fetched = std::text::arg_get(args: args, position: 1_u64);
  match move fetched {
    Ok(value: text) => {
      let digits = array_filled::<u8, 8>(value: 0_u8);
      let window = &digits[0_u64..8_u64];
      let copied = std::text::host_copy_utf8(value: &text, destination: window, start: 0_u64, end: 8_u64);
      match copied {
        Ok(value: length) => {
          let port_value = 0_u64;
          for (index in 0_u64..length) {
            let byte = digits[index];
            if byte < 48_u8 {
              return None<u16>();
            }
            if byte > 57_u8 {
              return None<u16>();
            }
            let offset = byte -wrap 48_u8;
            let digit = cvt::<u8, u64>(offset);
            let scaled = port_value *wrap 10_u64;
            set port_value = scaled +wrap digit;
          }
          let lower = port_value >= 1_u64;
          let upper = port_value <= 65535_u64;
          let in_range = band(lower, upper);
          if in_range {
            let narrow = cvt::<u64, u16>(port_value);
            return Some<u16>(value: narrow);
          }
          return None<u16>();
        }
        Err(error: unused_copy) => {
          return None<u16>();
        }
      }
    }
    Err(error: unused_arg) => {
      return None<u16>();
    }
  }
}

fn echo(send: &TcpSend, source: &[u8], length: u64, cancel: &CancelWatch) -> result: Result<unit, IoError> reads(source), reads(cancel), writes(send) waits contract {
  requires length <= source^.len;
} {
  let sent = 0_u64;
  loop @echoing {
    if sent < length {
    } else {
      break @echoing;
    }
    let no_deadline = None<std::time::Instant>();
    let outcome = std::net::send_once(send: send, source: source, start: sent, end: length, deadline: no_deadline, cancel: cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn serve(receive: TcpReceive, send: TcpSend, factory: HandleFactory) -> result: unit pure waits {
  let cancel = std::time::cancel_never();
  let digits = array_filled::<u8, 16>(value: 0_u8);
  let window = &digits[0_u64..16_u64];
  loop @serving {
    let no_deadline = None<std::time::Instant>();
    let outcome = std::net::receive_next(receive: &receive, destination: window, start: 0_u64, end: 16_u64, deadline: no_deadline, cancel: &cancel);
    match outcome {
      Ok(value: count) => {
        let echoed = echo(send: &send, source: window, length: count, cancel: &cancel);
        match echoed {
          Ok(value: unused_echo) => {
          }
          Err(error: unused_echo_error) => {
            break @serving;
          }
        }
      }
      Err(error: unused_stop) => {
        break @serving;
      }
    }
  }
  let receive_closed = std::net::close_receive(factory: &factory, receive: move receive);
  match receive_closed {
    Ok(value: unused_receive_closed) => {
    }
    Err(error: unused_receive_error) => {
    }
  }
  let send_closed = std::net::close_send(factory: &factory, send: move send);
  match send_closed {
    Ok(value: unused_send_closed) => {
    }
    Err(error: unused_send_error) => {
    }
  }
  std::time::close_cancel_watch(watch: move cancel);
  return unit;
}

fn run(factory: HandleFactory, port: u16) -> status: ExitStatus pure waits {
  let address = std::net::socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: port);
  let listened = std::net::tcp_listen(factory: &factory, address: &address);
  match move listened {
    Ok(value: listener) => {
      let watch = std::time::cancel_never();
      let failed = False();
      for (index in 0_u64..12_u64) {
        let no_deadline = None<std::time::Instant>();
        let accepted = std::net::tcp_accept(factory: &factory, listener: &listener, deadline: no_deadline, cancel: &watch);
        match move accepted {
          Ok(value: conn) => {
            let std::net::AcceptedConnection(connection: link, peer: unused_peer) = move conn;
            let std::net::TcpConnection(receive: rx, send: tx) = move link;
            let child = std::io::factory_share(factory: &factory);
            spawn serve(receive: move rx, send: move tx, factory: move child);
          }
          Err(error: unused_accept) => {
            set failed = True();
            break;
          }
        }
      }
      std::time::close_cancel_watch(watch: move watch);
      let listener_closed = std::net::close_listener(factory: &factory, listener: move listener);
      match listener_closed {
        Ok(value: unused_listener_closed) => {
        }
        Err(error: unused_listener_error) => {
          set failed = True();
        }
      }
      if failed {
        return exit_status(code: 1_u8);
      }
      return exit_status(code: 0_u8);
    }
    Err(error: unused_listen) => {
      return exit_status(code: 1_u8);
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: program_args, cwd: startup_directory, handles: factory, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move startup_directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let port = read_port(args: &program_args);
  match move port {
    Some(value: listen_port) => {
      return run(factory: move factory, port: listen_port);
    }
    None() => {
      return exit_status(code: 2_u8);
    }
  }
}

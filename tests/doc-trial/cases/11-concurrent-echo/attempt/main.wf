alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias Inputs = std::process::Inputs;

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(
    args: args_val,
    drivers: unused_d,
    cwd: cwd_val,
    stdout: unused_s1,
    stderr: unused_s2,
    handles: hf,
    stdin: unused_s3,
    clock: unused_c,
    wall_clock: unused_w,
    stops: unused_st,
    memory_meter: unused_m
  ) = move inputs;
  let std::fs::Directory(read: rd, write: wr) = move cwd_val;
  std::fs::close_directory_write(factory: &hf, directory: move wr);
  std::fs::close_directory(factory: &hf, directory: move rd);
  let ac = std::text::args_count(args: &args_val);
  if ac != 2_u64 {
    return exit_status(code: 1_u8);
  }
  let ag = std::text::arg_get(args: &args_val, position: 1_u64);
  let prt = 0_u16;
  match ag {
    Ok(value: hs) => {
      let ln = std::text::host_bytes_len(value: &hs);
      if ln > 0_u64 {
        if ln <= 5_u64 {
          let bb = array_filled::<u8, 5>(value: 0_u8);
          let cp = std::text::host_copy_bytes(
            value: &hs,
            destination: &bb,
            start: 0_u64,
            end: ln
          );
          match cp {
            Ok(value: unused_cp) => {
              let pp = parse_it(b: &bb, l: ln);
              match pp {
                Ok(value: pv) => {
                  set prt = pv;
                }
                Err(error: unused_pp) => {
                }
              }
            }
            Err(error: unused_cpe) => {
            }
          }
        }
      }
    }
    Err(error: unused_ag) => {
    }
  }
  if prt == 0_u16 {
    return exit_status(code: 1_u8);
  }
  let sa = std::net::socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: prt);
  let tl = std::net::tcp_listen(factory: &hf, address: &sa);
  let ls = match tl {
    Ok(value: l) => {
      l
    }
    Err(error: unused_tl) => {
      return exit_status(code: 1_u8);
    }
  };
  let cs = slots_new::<std::net::TcpConnection, 12>();
  let na = 0_u64;
  loop @acc {
    if na < 12_u64 {
    } else {
      break @acc;
    }
    let can = std::time::cancel_never();
    let dl = None<std::time::Instant>();
    let ac_res = std::net::tcp_accept(
      factory: &hf,
      listener: &ls,
      deadline: dl,
      cancel: &can
    );
    std::time::close_cancel_watch(watch: move can);
    match ac_res {
      Ok(value: acn) => {
        place_back(window: &cs, value: acn.connection);
        set na = na +wrap 1_u64;
      }
      Err(error: unused_ac) => {
        break @acc;
      }
    }
  }
  std::net::close_listener(factory: &hf, listener: move ls);
  if cs.len != 12_u64 {
    free_empty(window: move cs);
    return exit_status(code: 1_u8);
  }
  let px = 11_u64;
  loop @proc {
    if px < 12_u64 {
    } else {
      break @proc;
    }
    let cn = take_back(window: &cs);
    echo_it(c: move cn, f: &hf);
    if px == 0_u64 {
      break @proc;
    }
    set px = px - 1_u64;
  }
  free_empty(window: move cs);
  return exit_status(code: 0_u8);
}

fn parse_it(b: &[u8], l: u64) -> result: Result<u16, unit> reads(b) {
  let vl = 0_u64;
  for (i in 0_u64..l) {
    let by = b[i];
    let cond1 = by >= 48_u8;
    let cond2 = by <= 57_u8;
    let ok = band(cond1, cond2);
    if ok {
      let dgt = by - 48_u8;
      let dv = cvt::<u8, u64>(dgt);
      let m = vl *checked 10_u64;
      match m {
        Ok(value: vm) => {
          let s = vm +checked dv;
          match s {
            Ok(value: vs) => {
              set vl = vs;
            }
            Err(error: unused_s) => {
              return Err<u16, unit>(error: unit);
            }
          }
        }
        Err(error: unused_m) => {
          return Err<u16, unit>(error: unit);
        }
      }
    } else {
      return Err<u16, unit>(error: unit);
    }
  }
  if vl == 0_u64 {
    return Err<u16, unit>(error: unit);
  }
  if vl > 65535_u64 {
    return Err<u16, unit>(error: unit);
  }
  let p = cvt::<u64, u16>(vl);
  return Ok<u16, unit>(value: p);
}

fn echo_it(c: std::net::TcpConnection, f: &std::io::HandleFactory) -> result: unit writes(f) waits {
  let buf = array_filled::<u8, 512>(value: 0_u8);
  loop @rd {
    let can = std::time::cancel_never();
    let dl = None<std::time::Instant>();
    let res = std::net::receive_next(
      receive: &c.receive,
      destination: &buf,
      start: 0_u64,
      end: 512_u64,
      deadline: dl,
      cancel: &can
    );
    std::time::close_cancel_watch(watch: move can);
    match res {
      Ok(value: nr) => {
        let pos = 0_u64;
        loop @wr {
          if pos < nr {
          } else {
            break @wr;
          }
          let can2 = std::time::cancel_never();
          let sres = std::net::send_once(
            send: &c.send,
            source: &buf,
            start: pos,
            end: nr,
            deadline: dl,
            cancel: &can2
          );
          std::time::close_cancel_watch(watch: move can2);
          match sres {
            Ok(value: ns) => {
              set pos = ns;
            }
            Err(error: unused_sres) => {
              break @rd;
            }
          }
        }
      }
      Err(error: st) => {
        match st {
          std::io::ReadStop::ReadEnd() => {
            break @rd;
          }
          std::io::ReadStop::ReadFailed(error: unused_rf) => {
            break @rd;
          }
        }
      }
    }
  }
  std::net::close_receive(factory: f, receive: move c.receive);
  std::net::close_send(factory: f, send: move c.send);
  return unit;
}

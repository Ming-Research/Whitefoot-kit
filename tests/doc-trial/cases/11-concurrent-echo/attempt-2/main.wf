alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias Args = std::text::Args;
alias HandleFactory = std::io::HandleFactory;
alias TcpListener = std::net::TcpListener;
alias TcpReceive = std::net::TcpReceive;
alias TcpSend = std::net::TcpSend;
alias AcceptedConnection = std::net::AcceptedConnection;
alias TcpConnection = std::net::TcpConnection;
alias exit_status = std::process::exit_status;

fn parse_port(args: &Args) -> result: Option<u16> reads(args) {
  let count = args_count(args: args);
  if count == 1_u64 {
  } else {
    return None<u16>();
  }
  let first = arg_get(args: args, position: 0_u64);
  match move first {
    Ok(value: text) => {
      let length = host_bytes_len(value: &text);
      if length < 9_u64 {
      } else {
        return None<u16>();
      }
      let digits = array_filled::<u8, 8>(value: 0_u8);
      let window = &digits[0_u64..8_u64];
      let copied = host_copy_bytes(value: &text, destination: window, start: 0_u64, end: length);
      match copied {
        Ok(value: copied_length) => {
        }
        Err(error: unused_copy_error) => {
          return None<u16>();
        }
      }
      let port = 0_u64;
      let ok = True();
      for (i in 0_u64..length) {
        let byte = digits[i];
        let low = byte >= 48_u8;
        let high = byte <= 57_u8;
        let digit_ok = band(low, high);
        if digit_ok {
          let digit = byte - 48_u8;
          let wide = cvt::<u8, u64>(digit);
          set port = port *wrap 10_u64;
          set port = port +wrap wide;
        } else {
          set ok = False();
        }
      }
      if ok {
      } else {
        return None<u16>();
      }
      let narrow = cvt.checked::<u64, u16>(port);
      match narrow {
        Ok(value: number) => {
          let nonzero = number >= 1_u16;
          if nonzero {
            return Some<u16>(value: number);
          }
        }
        Err(error: unused_narrow_error) => {
        }
      }
    }
    Err(error: unused_arg_error) => {
    }
  }
  return None<u16>();
}

fn echo_peer(receive: TcpReceive, send: TcpSend, factory: HandleFactory) -> result: unit waits {
  let buffer = array_filled::<u8, 64>(value: 0_u8);
  let watch = std::time::cancel_never();
  loop @echoing {
    let window = &buffer[0_u64..64_u64];
    let no_deadline = None<std::time::Instant>();
    let received = receive_next(receive: &receive, destination: window, start: 0_u64, end: 64_u64, deadline: no_deadline, cancel: &watch);
    match received {
      Ok(value: count) => {
        let sent = 0_u64;
        let failed = False();
        loop @sending {
          if sent < count {
          } else {
            break @sending;
          }
          let rest = &buffer[0_u64..64_u64];
          let send_deadline = None<std::time::Instant>();
          let sent_result = send_once(send: &send, source: rest, start: sent, end: count, deadline: send_deadline, cancel: &watch);
          match sent_result {
            Ok(value: next) => {
              set sent = next;
            }
            Err(error: unused_send_error) => {
              set failed = True();
              break @sending;
            }
          }
        }
        if failed {
          break @echoing;
        }
      }
      Err(error: unused_stop) => {
        break @echoing;
      }
    }
  }
  let closed_receive = close_receive(factory: &factory, receive: move receive);
  match closed_receive {
    Ok(value: unused_receive_closed) => {
    }
    Err(error: unused_receive_error) => {
    }
  }
  let closed_send = close_send(factory: &factory, send: move send);
  match closed_send {
    Ok(value: unused_send_closed) => {
    }
    Err(error: unused_send_close_error) => {
    }
  }
  std::time::close_cancel_watch(watch: move watch);
  return unit;
}

fn serve(factory: &HandleFactory, listener: &TcpListener) -> result: unit writes(factory), writes(listener) waits {
  let watch = std::time::cancel_never();
  let accepted = 0_u64;
  loop @accepting {
    if accepted < 12_u64 {
    } else {
      break @accepting;
    }
    let no_deadline = None<std::time::Instant>();
    let outcome = std::net::tcp_accept(factory: factory, listener: listener, deadline: no_deadline, cancel: &watch);
    match outcome {
      Ok(value: arrived) => {
        let AcceptedConnection(connection: link, peer: unused_peer) = move arrived;
        let TcpConnection(receive: link_receive, send: link_send) = move link;
        let own_factory = std::io::factory_share(factory: factory);
        spawn echo_peer(receive: move link_receive, send: move link_send, factory: move own_factory);
        set accepted = accepted +wrap 1_u64;
      }
      Err(error: unused_accept_error) => {
      }
    }
  }
  std::time::close_cancel_watch(watch: move watch);
  return unit;
}

fn run(factory: &HandleFactory, port: u16) -> result: u8 writes(factory) waits {
  let address = std::net::socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: port);
  let listened = std::net::tcp_listen(factory: factory, address: &address);
  match listened {
    Ok(value: listener) => {
      serve(factory: factory, listener: &listener);
      let closed = std::net::close_listener(factory: factory, listener: move listener);
      match closed {
        Ok(value: unused_listener_closed) => {
        }
        Err(error: unused_listener_error) => {
          return 1_u8;
        }
      }
      return 0_u8;
    }
    Err(error: unused_listen_error) => {
      return 1_u8;
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: invocation_args, drivers: unused_drivers, cwd: cwd_directory, stdout: unused_stdout, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move cwd_directory;
  let write_closed = std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  let read_closed = std::fs::close_directory(factory: &factory, directory: move directory_read);
  let code = 0_u8;
  match write_closed {
    Ok(value: unused_write_closed) => {
    }
    Err(error: unused_write_error) => {
      set code = 1_u8;
    }
  }
  match read_closed {
    Ok(value: unused_read_closed) => {
    }
    Err(error: unused_read_error) => {
      set code = 1_u8;
    }
  }
  let port = parse_port(args: &invocation_args);
  match port {
    Some(value: number) => {
      let run_code = run(factory: &factory, port: number);
      set code = run_code;
    }
    None() => {
      set code = 1_u8;
    }
  }
  return exit_status(code: code);
}

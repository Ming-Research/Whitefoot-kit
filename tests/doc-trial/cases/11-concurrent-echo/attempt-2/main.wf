alias HandleFactory = std::io::HandleFactory;
alias IoError = std::io::IoError;
alias ReadStop = std::io::ReadStop;
alias Instant = std::time::Instant;
alias CancelWatch = std::time::CancelWatch;
alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias TcpListener = std::net::TcpListener;
alias TcpReceive = std::net::TcpReceive;
alias TcpSend = std::net::TcpSend;
alias SocketAddress = std::net::SocketAddress;
alias Args = std::text::Args;
alias HostString = std::text::HostString;

fn parse_port(args: &Args) -> result: Result<u16, unit> reads(args) {
  let count = std::text::args_count(args: args);
  if count != 2_u64 {
    return Err<u16, unit>(error: unit);
  }
  let port_result = std::text::arg_get(args: args, position: 1_u64);
  match port_result {
    Ok(value: port_str) => {
      let port_bytes = array_filled::<u8, 10>(value: 0_u8);
      let copy_result = std::text::host_copy_bytes(value: &port_str, destination: &port_bytes[0_u64..10_u64], start: 0_u64, end: 10_u64);
      match copy_result {
        Ok(value: copied) => {
          if copied < 1_u64 {
            return Err<u16, unit>(error: unit);
          }
          if copied > 5_u64 {
            return Err<u16, unit>(error: unit);
          }
          let port_u64 = 0_u64;
          let i = 0_u64;
          loop @parse {
            if i < copied {
            } else {
              break @parse;
            }
            let digit = port_bytes[i];
            let is_digit = band(digit >= 48_u8, digit <= 57_u8);
            if is_digit {
              let digit_value = cvt::<u8, u64>(digit - 48_u8);
              let port_u64_new = port_u64 *wrap 10_u64 +wrap digit_value;
              set port_u64 = port_u64_new;
            } else {
              return Err<u16, unit>(error: unit);
            }
            let next = i + 1_u64;
            set i = next;
            continue @parse;
          }
          if port_u64 > 65535_u64 {
            return Err<u16, unit>(error: unit);
          }
          if port_u64 == 0_u64 {
            return Err<u16, unit>(error: unit);
          }
          let port = cvt::<u64, u16>(port_u64);
          return Ok<u16, unit>(value: port);
        }
        Err(error: too_small) => {
          return Err<u16, unit>(error: unit);
        }
      }
    }
    Err(error: no_arg) => {
      return Err<u16, unit>(error: unit);
    }
  }
}

fn echo_handler(receive: TcpReceive, send: TcpSend, factory: HandleFactory, completed: Shared<u64>) -> result: unit pure waits {
  let buffer = array_filled::<u8, 4096>(value: 0_u8);
  loop @reading {
    let no_deadline = None<Instant>();
    let cancel = std::time::cancel_never();
    let read_result = std::net::receive_next(receive: &receive, destination: &buffer[0_u64..4096_u64], start: 0_u64, end: 4096_u64, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match read_result {
      Ok(value: read_end) => {
        if read_end > 0_u64 {
          let sent = 0_u64;
          loop @sending {
            if sent < read_end {
            } else {
              break @sending;
            }
            let no_deadline_send = None<Instant>();
            let cancel_send = std::time::cancel_never();
            let send_result = std::net::send_once(send: &send, source: &buffer[0_u64..read_end], start: sent, end: read_end, deadline: no_deadline_send, cancel: &cancel_send);
            std::time::close_cancel_watch(watch: move cancel_send);
            match send_result {
              Ok(value: sent_end) => {
                set sent = sent_end;
              }
              Err(error: send_error) => {
                break @reading;
              }
            }
            continue @sending;
          }
        }
      }
      Err(error: stop) => {
        break @reading;
      }
    }
    continue @reading;
  }
  let close_receive_result = std::net::close_receive(factory: &factory, receive: move receive);
  let close_send_result = std::net::close_send(factory: &factory, send: move send);
  atomic count = &completed {
    set count^ = count^ +wrap 1_u64;
  }
  return unit;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: args_param, drivers: unused_drivers, cwd: cwd_param, stdout: unused_stdout, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_param;
  std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  std::fs::close_directory(factory: &factory, directory: move cwd_read);
  let port_result = parse_port(args: &args_param);
  match port_result {
    Ok(value: port) => {
      let address = std::net::socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: port);
      let listen_result = std::net::tcp_listen(factory: &factory, address: &address);
      match listen_result {
        Ok(value: listener) => {
          let completed = shared_new::<u64>(value: 0_u64);
          let target_connections = 12_u64;
          let i = 0_u64;
          loop @accepting {
            if i < target_connections {
            } else {
              break @accepting;
            }
            let no_deadline = None<Instant>();
            let cancel = std::time::cancel_never();
            let accept_result = std::net::tcp_accept(factory: &factory, listener: &listener, deadline: no_deadline, cancel: &cancel);
            std::time::close_cancel_watch(watch: move cancel);
            match accept_result {
              Ok(value: accepted) => {
                let connection = accepted.connection;
                let receive = connection.receive;
                let send = connection.send;
                let factory_copy = std::io::factory_share(factory: &factory);
                let completed_copy = shared_share::<u64>(shared: &completed);
                spawn echo_handler(receive: move receive, send: move send, factory: move factory_copy, completed: move completed_copy);
              }
              Err(error: accept_error) => {
              }
            }
            let next = i + 1_u64;
            set i = next;
            continue @accepting;
          }
          atomic count = &completed when count^ == target_connections {
          }
          let close_listener_result = std::net::close_listener(factory: &factory, listener: move listener);
          return std::process::exit_status(code: 0_u8);
        }
        Err(error: listen_error) => {
          return std::process::exit_status(code: 1_u8);
        }
      }
    }
    Err(error: parse_error) => {
      return std::process::exit_status(code: 1_u8);
    }
  }
}

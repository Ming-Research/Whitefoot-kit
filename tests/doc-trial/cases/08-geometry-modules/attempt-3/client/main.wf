alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias IoError = std::io::IoError;
alias OutputStream = std::io::OutputStream;
alias Coord = pkg::geometry::Coord;
alias coord_from_pixels = pkg::geometry::coord_from_pixels;
alias coord_from_binary64 = pkg::geometry::coord_from_binary64;
alias coord_to_binary64 = pkg::geometry::coord_to_binary64;
alias coord_add = pkg::geometry::coord_add;
alias coord_sub = pkg::geometry::coord_sub;
alias rect_from_origin_size = pkg::geometry::rect_from_origin_size;
alias rect_contains = pkg::geometry::rect_contains;
alias rect_intersects = pkg::geometry::rect_intersects;

fn raw_bits(coord: Coord) -> result: u64 pure {
  let bits = cvt.wrap::<i32, u64>(coord.raw);
  return bits;
}

fn bit_word(flag: Bool) -> result: u64 pure {
  let value = if flag {
    give 1_u64;
  } else {
    give 0_u64;
  }
  return value;
}

fn word_bytes(bits: u64) -> result: Array<u8, 8> pure {
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  let rest = bits;
  for (k in 0_u64..8_u64) {
    set bytes[k] = cvt.wrap::<u64, u8>(rest);
    set rest = ishr.wrap(rest, 8_u32);
  }
  return bytes;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn emit_words(factory: &HandleFactory, output: &OutputStream, words: &[u64]) -> result: Result<unit, IoError> reads(words), writes(factory), writes(output) waits {
  let count = words^.len;
  for (i in 0_u64..count) {
    let bytes = word_bytes(bits: words^[i]);
    let sent = publish_all(factory: factory, output: output, source: &bytes[0_u64..8_u64], length: 8_u64);
    match sent {
      Ok(value: unused_sent) => {
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: directory, stdout: output, handles: factory, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let two = coord_from_pixels(pixels: 2_i32);
  let word1 = raw_bits(coord: two);
  let max_pixels = coord_from_pixels(pixels: 2147483647_i32);
  let word2 = raw_bits(coord: max_pixels);
  let min_pixels = coord_from_pixels(pixels: -2147483648_i32);
  let word3 = raw_bits(coord: min_pixels);
  let one_point_five = coord_from_binary64(pixels: 1.5_f64);
  let word4 = raw_bits(coord: one_point_five);
  let back = coord_to_binary64(coord: one_point_five);
  let word5 = reinterpret::<f64, u64>(back);
  let tiny_down = coord_from_binary64(pixels: 0.0078125_f64);
  let word6 = raw_bits(coord: tiny_down);
  let tiny_up = coord_from_binary64(pixels: 0.0234375_f64);
  let word7 = raw_bits(coord: tiny_up);
  let one = coord_from_pixels(pixels: 1_i32);
  let bumped = coord_add(left: max_pixels, right: one);
  let word8 = raw_bits(coord: bumped);
  let lowered = coord_sub(left: min_pixels, right: one);
  let word9 = raw_bits(coord: lowered);
  let x10 = coord_from_pixels(pixels: 10_i32);
  let y20 = coord_from_pixels(pixels: 20_i32);
  let w3 = coord_from_pixels(pixels: 3_i32);
  let h4 = coord_from_pixels(pixels: 4_i32);
  let x12 = coord_from_pixels(pixels: 12_i32);
  let x13 = coord_from_pixels(pixels: 13_i32);
  let y23 = coord_from_pixels(pixels: 23_i32);
  let y24 = coord_from_pixels(pixels: 24_i32);
  let origin = pkg::geometry::Point(x: x10, y: y20);
  let size = pkg::geometry::Point(x: w3, y: h4);
  let area = rect_from_origin_size(origin: origin, size: size);
  let corner = pkg::geometry::Point(x: x10, y: y20);
  let inside = pkg::geometry::Point(x: x12, y: y23);
  let right_out = pkg::geometry::Point(x: x13, y: y23);
  let bottom_out = pkg::geometry::Point(x: x12, y: y24);
  let shifted = pkg::geometry::Point(x: x13, y: y20);
  let shifted_area = rect_from_origin_size(origin: shifted, size: size);
  let c10 = rect_contains(rect: area, point: corner);
  let word10 = bit_word(flag: c10);
  let c11 = rect_contains(rect: area, point: inside);
  let word11 = bit_word(flag: c11);
  let c12 = rect_contains(rect: area, point: right_out);
  let word12 = bit_word(flag: c12);
  let c13 = rect_contains(rect: area, point: bottom_out);
  let word13 = bit_word(flag: c13);
  let hit = rect_intersects(first: area, second: shifted_area);
  let word14 = bit_word(flag: hit);
  let words = array_filled::<u64, 14>(value: 0_u64);
  set words[0_u64] = word1;
  set words[1_u64] = word2;
  set words[2_u64] = word3;
  set words[3_u64] = word4;
  set words[4_u64] = word5;
  set words[5_u64] = word6;
  set words[6_u64] = word7;
  set words[7_u64] = word8;
  set words[8_u64] = word9;
  set words[9_u64] = word10;
  set words[10_u64] = word11;
  set words[11_u64] = word12;
  set words[12_u64] = word13;
  set words[13_u64] = word14;
  let emitted = emit_words(factory: &factory, output: &output, words: &words[0_u64..14_u64]);
  match emitted {
    Ok(value: unused_emitted) => {
      return exit_status(code: 0_u8);
    }
    Err(error: unused_error) => {
      return exit_status(code: 1_u8);
    }
  }
}

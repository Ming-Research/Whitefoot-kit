fn contains_point(rect: Rectangle, x: Coordinate, y: Coordinate) -> result: Bool pure {
  let right = add_saturating(left: rect.left, right: rect.width);
  let bottom = add_saturating(left: rect.top, right: rect.height);
  let x_left_check = rect.left.value <= x.value;
  let x_right_check = x.value < right.value;
  let x_in_range = band(x_left_check, x_right_check);
  let y_top_check = rect.top.value <= y.value;
  let y_bottom_check = y.value < bottom.value;
  let y_in_range = band(y_top_check, y_bottom_check);
  let result = band(x_in_range, y_in_range);
  return result;
}

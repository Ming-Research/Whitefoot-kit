fn from_f64_pixels(pixels: f64) -> result: Coordinate pure {
  let scaled = fmul.strict(pixels, 64.0_f64);
  let is_nan = bnot(feq(scaled, scaled));
  let zero_if_nan = if is_nan {
    give 0.0_f64;
  } else {
    give scaled;
  }
  let rounded = froundeven(zero_if_nan);
  let max_i32_f64 = 2147483647.0_f64;
  let min_i32_f64 = -2147483648.0_f64;
  let is_too_large = fgt(rounded, max_i32_f64);
  let is_too_small = flt(rounded, min_i32_f64);
  let saturated = if is_too_large {
    give max_i32_f64;
  } else if is_too_small {
    give min_i32_f64;
  } else {
    give rounded;
  }
  let converted = cvt::<f64, i32>(saturated);
  return Coordinate(value: converted);
}

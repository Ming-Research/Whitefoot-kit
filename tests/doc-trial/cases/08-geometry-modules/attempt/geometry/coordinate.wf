fn coordinate_from_whole_pixels(pixels: i32) -> result: Coordinate pure contract {
  requires pixels >= -33554432_i32;
  requires pixels <= 33554431_i32;
} {
  let product = fmul.strict(cvt::<i32, f64>(pixels), 64.0_f64);
  let rounded = froundeven(product);
  let checked = cvt.checked::<f64, i32>(rounded);
  let raw = match checked {
    Ok(value: v) => {
      give v;
    }
    Err(error: unused_error) => {
      if pixels < 0_i32 {
        give -2147483648_i32;
      } else {
        give 2147483647_i32;
      }
    }
  }
  return Coordinate(raw: raw);
}

fn coordinate_from_f64(value: f64) -> result: Coordinate pure {
  let is_finite = fge(value, 0.0_f64);
  let is_neg = flt(value, 0.0_f64);
  let is_nan = bnot(bor(is_finite, is_neg));
  if is_nan {
    return Coordinate(raw: 0_i32);
  }
  let abs_val = fabs(value);
  let is_zero = feq(abs_val, 0.0_f64);
  if is_zero {
    return Coordinate(raw: 0_i32);
  }
  let product = fmul.strict(value, 64.0_f64);
  let rounded = froundeven(product);
  let checked = cvt.checked::<f64, i32>(rounded);
  let raw = match checked {
    Ok(value: v) => {
      give v;
    }
    Err(error: unused_error) => {
      if flt(value, 0.0_f64) {
        give -2147483648_i32;
      } else {
        give 2147483647_i32;
      }
    }
  }
  return Coordinate(raw: raw);
}

fn coordinate_to_f64(coord: Coordinate) -> result: f64 pure {
  let value = cvt::<i32, f64>(coord.raw);
  let result = fdiv.strict(value, 64.0_f64);
  return result;
}

fn coordinate_saturating_add(left: Coordinate, right: Coordinate) -> result: Coordinate pure {
  let checked = left.raw +checked right.raw;
  let raw = match checked {
    Ok(value: v) => {
      give v;
    }
    Err(error: unused_error) => {
      if left.raw < 0_i32 {
        give -2147483648_i32;
      } else {
        give 2147483647_i32;
      }
    }
  }
  return Coordinate(raw: raw);
}

fn coordinate_saturating_sub(left: Coordinate, right: Coordinate) -> result: Coordinate pure {
  let checked = left.raw -checked right.raw;
  let raw = match checked {
    Ok(value: v) => {
      give v;
    }
    Err(error: unused_error) => {
      if left.raw < 0_i32 {
        give -2147483648_i32;
      } else {
        give 2147483647_i32;
      }
    }
  }
  return Coordinate(raw: raw);
}

fn coordinate_min(left: Coordinate, right: Coordinate) -> result: Coordinate pure {
  if left.raw < right.raw {
    return left;
  } else {
    return right;
  }
}

fn coordinate_max(left: Coordinate, right: Coordinate) -> result: Coordinate pure {
  if left.raw > right.raw {
    return left;
  } else {
    return right;
  }
}

fn point_contains(point: Point, rect: Rectangle) -> result: Bool pure {
  let right = rect.left.raw + rect.width.raw;
  let bottom = rect.top.raw + rect.height.raw;
  let x_left_ok = rect.left.raw <= point.x.raw;
  let x_right_ok = point.x.raw < right;
  let y_top_ok = rect.top.raw <= point.y.raw;
  let y_bottom_ok = point.y.raw < bottom;
  let x_in = band(x_left_ok, x_right_ok);
  let y_in = band(y_top_ok, y_bottom_ok);
  return band(x_in, y_in);
}

fn rectangles_intersect(rect1: Rectangle, rect2: Rectangle) -> result: Bool pure {
  let rect1_right = rect1.left.raw + rect1.width.raw;
  let rect1_bottom = rect1.top.raw + rect1.height.raw;
  let rect2_right = rect2.left.raw + rect2.width.raw;
  let rect2_bottom = rect2.top.raw + rect2.height.raw;
  let x_cmp1 = rect1.left.raw < rect2_right;
  let x_cmp2 = rect2.left.raw < rect1_right;
  let y_cmp1 = rect1.top.raw < rect2_bottom;
  let y_cmp2 = rect2.top.raw < rect1_bottom;
  let x_overlap = band(x_cmp1, x_cmp2);
  let y_overlap = band(y_cmp1, y_cmp2);
  return band(x_overlap, y_overlap);
}

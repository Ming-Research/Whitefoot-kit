fn point_in_rect(px: i32, py: i32, rx: i32, ry: i32, width: i32, height: i32) -> contained: Bool pure {
  let right = rx +sat width;
  let bottom = ry +sat height;
  let x_low = px >= rx;
  let x_high = px < right;
  let x_in = band(x_low, x_high);
  let y_low = py >= ry;
  let y_high = py < bottom;
  let y_in = band(y_low, y_high);
  return band(x_in, y_in);
}

fn rects_intersect(r1x: i32, r1y: i32, r1w: i32, r1h: i32, r2x: i32, r2y: i32, r2w: i32, r2h: i32) -> intersect: Bool pure {
  let r1_right = r1x +sat r1w;
  let r1_bottom = r1y +sat r1h;
  let r2_right = r2x +sat r2w;
  let r2_bottom = r2y +sat r2h;
  let x_lo = r1x < r2_right;
  let x_hi = r2x < r1_right;
  let x_overlap = band(x_lo, x_hi);
  let y_lo = r1y < r2_bottom;
  let y_hi = r2y < r1_bottom;
  let y_overlap = band(y_lo, y_hi);
  return band(x_overlap, y_overlap);
}

public struct Coord {
  public raw: i32;
}

public struct Point {
  public x: Coord;
  public y: Coord;
}

public struct Rect {
  public x: Coord;
  public y: Coord;
  public width: Coord;
  public height: Coord;
}

public fn coord_from_pixels(pixels: i32) -> result: Coord pure doc "Creates a coordinate from whole pixels.";

public fn coord_from_f64(value: f64) -> result: Coord pure doc "Creates a coordinate from a binary64 pixel value using rounding.";

public fn coord_to_f64(coord: Coord) -> result: f64 pure doc "Converts a coordinate back to binary64 pixels.";

public fn coord_add_saturate(a: Coord, b: Coord) -> result: Coord pure doc "Saturating addition of two coordinates.";

public fn coord_sub_saturate(a: Coord, b: Coord) -> result: Coord pure doc "Saturating subtraction of two coordinates.";

public fn coord_min(a: Coord, b: Coord) -> result: Coord pure doc "Returns the minimum of two coordinates.";

public fn coord_max(a: Coord, b: Coord) -> result: Coord pure doc "Returns the maximum of two coordinates.";

public fn rect_contains(rect: Rect, point: Point) -> result: Bool pure doc "Checks if a rectangle contains a point.";

public fn rect_intersects(a: Rect, b: Rect) -> result: Bool pure doc "Checks if two rectangles intersect.";

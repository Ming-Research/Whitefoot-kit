public fn from_whole_pixels(pixels: i32) -> raw: i32 pure doc "Converts whole pixels to raw coordinate (pixels * 64, saturating).";

public fn from_binary64(pixels: f64) -> raw: i32 pure doc "Converts binary64 pixels to raw coordinate (pixels * 64, rounded, saturating; NaN becomes 0).";

public fn to_binary64(raw: i32) -> pixels: f64 pure doc "Converts raw coordinate back to binary64 pixels (raw / 64, exact).";

public fn saturating_add(a: i32, b: i32) -> result: i32 pure doc "Saturating addition of raw coordinates.";

public fn saturating_sub(a: i32, b: i32) -> result: i32 pure doc "Saturating subtraction of raw coordinates.";

public fn min_coord(a: i32, b: i32) -> result: i32 pure doc "Minimum of two raw coordinates.";

public fn max_coord(a: i32, b: i32) -> result: i32 pure doc "Maximum of two raw coordinates.";

public fn point_in_rect(px: i32, py: i32, rx: i32, ry: i32, width: i32, height: i32) -> contained: Bool pure doc "Whether point (px, py) is contained in rectangle at (rx, ry) with size (width, height).";

public fn rects_intersect(r1x: i32, r1y: i32, r1w: i32, r1h: i32, r2x: i32, r2y: i32, r2w: i32, r2h: i32) -> intersect: Bool pure doc "Whether two rectangles intersect.";

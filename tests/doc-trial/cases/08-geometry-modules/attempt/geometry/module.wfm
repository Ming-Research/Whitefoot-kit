public struct Coord {
  public raw: i32;
}

public struct Rect {
  left: Coord;
  top: Coord;
  right: Coord;
  bottom: Coord;
}

public fn coord_from_pixels(pixels: i32) -> result: Coord pure doc "Converts whole pixels to coordinate units, saturating at the signed 32-bit limits.";

public fn coord_from_binary64(pixels: f64) -> result: Coord pure doc "Converts binary64 pixels to coordinate units, rounding ties to even and saturating by sign; NaN becomes zero.";

public fn coord_to_binary64(value: Coord) -> result: f64 pure doc "Converts a coordinate back to binary64 pixels exactly.";

public fn coord_add(left: Coord, right: Coord) -> result: Coord pure doc "Adds two coordinates with saturation.";

public fn coord_sub(left: Coord, right: Coord) -> result: Coord pure doc "Subtracts right from left with saturation.";

public fn coord_min(left: Coord, right: Coord) -> result: Coord pure doc "Returns the smaller coordinate.";

public fn coord_max(left: Coord, right: Coord) -> result: Coord pure doc "Returns the larger coordinate.";

public fn rect_from_pixels(x: i32, y: i32, width: i32, height: i32) -> result: Rect pure doc "Builds a rectangle from whole-pixel origin and size, with saturating far edges.";

public fn rect_contains(rect: Rect, x: Coord, y: Coord) -> result: Bool pure doc "Returns whether the point lies in the rectangle, including its top and left edges and excluding its bottom and right edges.";

public fn rect_intersects(first: Rect, second: Rect) -> result: Bool pure doc "Returns whether two rectangles overlap on both axes; touching edges do not count.";

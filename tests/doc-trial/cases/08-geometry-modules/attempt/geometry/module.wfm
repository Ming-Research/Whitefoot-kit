public struct Coordinate {
  public raw: i32;
}

public struct Point {
  public x: Coordinate;
  public y: Coordinate;
}

public struct Rectangle {
  public left: Coordinate;
  public top: Coordinate;
  public width: Coordinate;
  public height: Coordinate;
}

public fn coordinate_from_whole_pixels(pixels: i32) -> result: Coordinate pure contract {
  requires pixels >= -33554432_i32;
  requires pixels <= 33554431_i32;
} doc "Creates a coordinate from whole pixels, saturating at signed 32-bit limits.";

public fn coordinate_from_f64(value: f64) -> result: Coordinate pure doc "Creates a coordinate from binary64 pixels using strict multiplication and rounding.";

public fn coordinate_to_f64(coord: Coordinate) -> result: f64 pure doc "Converts a coordinate to binary64 pixels by exact division by 64.";

public fn coordinate_saturating_add(left: Coordinate, right: Coordinate) -> result: Coordinate pure doc "Saturating addition of two coordinates.";

public fn coordinate_saturating_sub(left: Coordinate, right: Coordinate) -> result: Coordinate pure doc "Saturating subtraction of two coordinates.";

public fn coordinate_min(left: Coordinate, right: Coordinate) -> result: Coordinate pure doc "Returns the minimum of two coordinates.";

public fn coordinate_max(left: Coordinate, right: Coordinate) -> result: Coordinate pure doc "Returns the maximum of two coordinates.";

public fn point_contains(point: Point, rect: Rectangle) -> result: Bool pure doc "Returns true if the point is contained in the rectangle.";

public fn rectangles_intersect(rect1: Rectangle, rect2: Rectangle) -> result: Bool pure doc "Returns true if two rectangles intersect.";

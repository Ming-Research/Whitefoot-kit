fn coordinate_from_whole(pixels: i64) -> result: Coordinate pure {
  let raw_min = -2147483648_i64;
  let raw_max = 2147483647_i64;
  let scaled_value = pixels *wrap 64_i64;
  if scaled_value < raw_min {
    return Coordinate(raw: -2147483648_i32);
  }
  if scaled_value > raw_max {
    return Coordinate(raw: 2147483647_i32);
  }
  let raw_i32 = cvt::<i64, i32>(scaled_value);
  return Coordinate(raw: raw_i32);
}

fn coordinate_from_f64(pixels: f64) -> result: Coordinate pure {
  let scaled = fmul.strict(pixels, 64.0_f64);

  let raw_min_f64 = -2147483648.0_f64;
  let raw_max_f64 = 2147483647.0_f64;

  if fnot.ordered(scaled) {
    return Coordinate(raw: 0_i32);
  }

  if fle.strict(scaled, raw_min_f64) {
    return Coordinate(raw: -2147483648_i32);
  }
  if fge.strict(scaled, raw_max_f64) {
    return Coordinate(raw: 2147483647_i32);
  }

  let rounded = cvt.nearest::<f64, i64>(scaled);
  let raw_i32 = cvt::<i64, i32>(rounded);
  return Coordinate(raw: raw_i32);
}

fn coordinate_to_f64(coord: Coordinate) -> result: f64 pure {
  let raw_f64 = cvt::<i32, f64>(coord.raw);
  let result = fdiv.strict(raw_f64, 64.0_f64);
  return result;
}

fn coordinate_add_saturating(a: Coordinate, b: Coordinate) -> result: Coordinate pure {
  let a_i64 = cvt::<i32, i64>(a.raw);
  let b_i64 = cvt::<i32, i64>(b.raw);
  let sum = a_i64 +wrap b_i64;

  let raw_min = -2147483648_i64;
  let raw_max = 2147483647_i64;

  if sum < raw_min {
    return Coordinate(raw: -2147483648_i32);
  }
  if sum > raw_max {
    return Coordinate(raw: 2147483647_i32);
  }

  let result = cvt::<i64, i32>(sum);
  return Coordinate(raw: result);
}

fn coordinate_sub_saturating(a: Coordinate, b: Coordinate) -> result: Coordinate pure {
  let a_i64 = cvt::<i32, i64>(a.raw);
  let b_i64 = cvt::<i32, i64>(b.raw);
  let diff = a_i64 -wrap b_i64;

  let raw_min = -2147483648_i64;
  let raw_max = 2147483647_i64;

  if diff < raw_min {
    return Coordinate(raw: -2147483648_i32);
  }
  if diff > raw_max {
    return Coordinate(raw: 2147483647_i32);
  }

  let result = cvt::<i64, i32>(diff);
  return Coordinate(raw: result);
}

fn coordinate_min(a: Coordinate, b: Coordinate) -> result: Coordinate pure {
  if a.raw < b.raw {
    return Coordinate(raw: a.raw);
  }
  return Coordinate(raw: b.raw);
}

fn coordinate_max(a: Coordinate, b: Coordinate) -> result: Coordinate pure {
  if a.raw > b.raw {
    return Coordinate(raw: a.raw);
  }
  return Coordinate(raw: b.raw);
}

fn rectangle_contains_point(rect: Rectangle, point: Point) -> result: Bool pure {
  let x_valid = band(point.x.raw >= rect.left.raw, point.x.raw < rect.right.raw);
  let y_valid = band(point.y.raw >= rect.top.raw, point.y.raw < rect.bottom.raw);
  return band(x_valid, y_valid);
}

fn rectangle_intersects(r1: Rectangle, r2: Rectangle) -> result: Bool pure {
  let x_overlap = band(r1.left.raw < r2.right.raw, r2.left.raw < r1.right.raw);
  let y_overlap = band(r1.top.raw < r2.bottom.raw, r2.top.raw < r1.bottom.raw);
  return band(x_overlap, y_overlap);
}

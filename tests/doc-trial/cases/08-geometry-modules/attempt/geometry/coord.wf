fn coord_from_pixels(pixels: i32) -> result: Coord pure {
  let raw = pixels *sat 64_i32;
  return Coord(raw: raw);
}

fn coord_from_f64(value: f64) -> result: Coord pure {
  let scaled = fmul.strict(value, 64.0_f64);
  let rounded = froundeven(scaled);
  let conversion = cvt.checked::<f64, i32>(rounded);
  let raw = match conversion {
    Ok(value: r) => {
      give r;
    }
    Err(error: problem) => {
      let sign = flt(value, 0.0_f64);
      if sign {
        give -2147483648_i32;
      } else {
        give 2147483647_i32;
      }
    }
  }
  return Coord(raw: raw);
}

fn coord_to_f64(coord: Coord) -> result: f64 pure {
  let raw_f64 = cvt::<i32, f64>(coord.raw);
  let result = fdiv.strict(raw_f64, 64.0_f64);
  return result;
}

fn coord_add_saturate(a: Coord, b: Coord) -> result: Coord pure {
  let sum = a.raw +checked b.raw;
  let raw = match sum {
    Ok(value: s) => {
      give s;
    }
    Err(error: problem) => {
      let is_positive = a.raw >= 0_i32;
      if is_positive {
        give 2147483647_i32;
      } else {
        give -2147483648_i32;
      }
    }
  }
  return Coord(raw: raw);
}

fn coord_sub_saturate(a: Coord, b: Coord) -> result: Coord pure {
  let diff = a.raw -checked b.raw;
  let raw = match diff {
    Ok(value: d) => {
      give d;
    }
    Err(error: problem) => {
      let is_positive = a.raw >= 0_i32;
      if is_positive {
        give 2147483647_i32;
      } else {
        give -2147483648_i32;
      }
    }
  }
  return Coord(raw: raw);
}

fn coord_min(a: Coord, b: Coord) -> result: Coord pure {
  let is_less = a.raw < b.raw;
  if is_less {
    return Coord(raw: a.raw);
  } else {
    return Coord(raw: b.raw);
  }
}

fn coord_max(a: Coord, b: Coord) -> result: Coord pure {
  let is_greater = a.raw > b.raw;
  if is_greater {
    return Coord(raw: a.raw);
  } else {
    return Coord(raw: b.raw);
  }
}

fn rect_contains(rect: Rect, point: Point) -> result: Bool pure {
  let x_min = rect.x.raw;
  let x_max_coord = coord_add_saturate(a: rect.x, b: rect.width);
  let x_max = x_max_coord.raw;
  let y_min = rect.y.raw;
  let y_max_coord = coord_add_saturate(a: rect.y, b: rect.height);
  let y_max = y_max_coord.raw;
  let x_ge_min = x_min <= point.x.raw;
  let x_lt_max = point.x.raw < x_max;
  let x_in_range = band(x_ge_min, x_lt_max);
  let y_ge_min = y_min <= point.y.raw;
  let y_lt_max = point.y.raw < y_max;
  let y_in_range = band(y_ge_min, y_lt_max);
  return band(x_in_range, y_in_range);
}

fn rect_intersects(a: Rect, b: Rect) -> result: Bool pure {
  let a_right = coord_add_saturate(a: a.x, b: a.width);
  let b_right = coord_add_saturate(a: b.x, b: b.width);
  let a_bottom = coord_add_saturate(a: a.y, b: a.height);
  let b_bottom = coord_add_saturate(a: b.y, b: b.height);
  let a_x_lt_b_right = a.x.raw < b_right.raw;
  let b_x_lt_a_right = b.x.raw < a_right.raw;
  let x_overlap = band(a_x_lt_b_right, b_x_lt_a_right);
  let a_y_lt_b_bottom = a.y.raw < b_bottom.raw;
  let b_y_lt_a_bottom = b.y.raw < a_bottom.raw;
  let y_overlap = band(a_y_lt_b_bottom, b_y_lt_a_bottom);
  return band(x_overlap, y_overlap);
}

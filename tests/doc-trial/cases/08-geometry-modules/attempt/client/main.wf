alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias Instant = std::time::Instant;
alias CancelWatch = std::time::CancelWatch;
alias from_whole_pixels = pkg::geometry::from_whole_pixels;
alias from_binary64 = pkg::geometry::from_binary64;
alias to_binary64 = pkg::geometry::to_binary64;
alias saturating_add = pkg::geometry::saturating_add;
alias saturating_sub = pkg::geometry::saturating_sub;
alias point_in_rect = pkg::geometry::point_in_rect;
alias rects_intersect = pkg::geometry::rects_intersect;

fn encode_u64_le(buffer: &[u8], offset: u64, value: u64) -> result: unit writes(buffer) contract {
  requires offset + 8_u64 <= buffer^.len;
} {
  let b0 = iand(value, 0xFF_u64);
  let v1 = ishr(value, 8_u32);
  let b1 = iand(v1, 0xFF_u64);
  let v2 = ishr(value, 16_u32);
  let b2 = iand(v2, 0xFF_u64);
  let v3 = ishr(value, 24_u32);
  let b3 = iand(v3, 0xFF_u64);
  let v4 = ishr(value, 32_u32);
  let b4 = iand(v4, 0xFF_u64);
  let v5 = ishr(value, 40_u32);
  let b5 = iand(v5, 0xFF_u64);
  let v6 = ishr(value, 48_u32);
  let b6 = iand(v6, 0xFF_u64);
  let v7 = ishr(value, 56_u32);
  let b7 = iand(v7, 0xFF_u64);
  let off0 = offset;
  let off1 = offset + 1_u64;
  let off2 = offset + 2_u64;
  let off3 = offset + 3_u64;
  let off4 = offset + 4_u64;
  let off5 = offset + 5_u64;
  let off6 = offset + 6_u64;
  let off7 = offset + 7_u64;
  set buffer^[off0] = cvt::<u64, u8>(b0);
  set buffer^[off1] = cvt::<u64, u8>(b1);
  set buffer^[off2] = cvt::<u64, u8>(b2);
  set buffer^[off3] = cvt::<u64, u8>(b3);
  set buffer^[off4] = cvt::<u64, u8>(b4);
  set buffer^[off5] = cvt::<u64, u8>(b5);
  set buffer^[off6] = cvt::<u64, u8>(b6);
  set buffer^[off7] = cvt::<u64, u8>(b7);
  return unit;
}

fn encode_i64_le(buffer: &[u8], offset: u64, value: i64) -> result: unit writes(buffer) contract {
  requires offset + 8_u64 <= buffer^.len;
} {
  let as_u64 = reinterpret::<i64, u64>(value);
  encode_u64_le(buffer: buffer, offset: offset, value: as_u64);
  return unit;
}

fn encode_f64_le(buffer: &[u8], offset: u64, value: f64) -> result: unit writes(buffer) contract {
  requires offset + 8_u64 <= buffer^.len;
} {
  let as_u64 = reinterpret::<f64, u64>(value);
  encode_u64_le(buffer: buffer, offset: offset, value: as_u64);
  return unit;
}

fn write_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, std::io::IoError> reads(source), writes(factory), writes(output) waits {
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, std::io::IoError>(error: problem);
      }
    }
  }
  return Ok<unit, std::io::IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: cwd_directory, handles: factory, stdout: output, ..) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  std::fs::close_directory(factory: &factory, directory: move cwd_read);
  let buffer = array_filled::<u8, 112>(value: 0_u8);
  let obs1 = from_whole_pixels(pixels: 2_i32);
  let obs1_i64 = cvt::<i32, i64>(obs1);
  encode_i64_le(buffer: &buffer[0_u64..112_u64], offset: 0_u64, value: obs1_i64);
  let obs2 = from_whole_pixels(pixels: 2147483647_i32);
  let obs2_i64 = cvt::<i32, i64>(obs2);
  encode_i64_le(buffer: &buffer[0_u64..112_u64], offset: 8_u64, value: obs2_i64);
  let obs3 = from_whole_pixels(pixels: -2147483648_i32);
  let obs3_i64 = cvt::<i32, i64>(obs3);
  encode_i64_le(buffer: &buffer[0_u64..112_u64], offset: 16_u64, value: obs3_i64);
  let obs4 = from_binary64(pixels: 1.5_f64);
  let obs4_i64 = cvt::<i32, i64>(obs4);
  encode_i64_le(buffer: &buffer[0_u64..112_u64], offset: 24_u64, value: obs4_i64);
  let obs5 = to_binary64(raw: obs4);
  encode_f64_le(buffer: &buffer[0_u64..112_u64], offset: 32_u64, value: obs5);
  let obs6 = from_binary64(pixels: 0.0078125_f64);
  let obs6_i64 = cvt::<i32, i64>(obs6);
  encode_i64_le(buffer: &buffer[0_u64..112_u64], offset: 40_u64, value: obs6_i64);
  let obs7 = from_binary64(pixels: 0.0234375_f64);
  let obs7_i64 = cvt::<i32, i64>(obs7);
  encode_i64_le(buffer: &buffer[0_u64..112_u64], offset: 48_u64, value: obs7_i64);
  let obs8 = saturating_add(a: 2147483647_i32, b: 64_i32);
  let obs8_i64 = cvt::<i32, i64>(obs8);
  encode_i64_le(buffer: &buffer[0_u64..112_u64], offset: 56_u64, value: obs8_i64);
  let obs9 = saturating_sub(a: -2147483648_i32, b: 64_i32);
  let obs9_i64 = cvt::<i32, i64>(obs9);
  encode_i64_le(buffer: &buffer[0_u64..112_u64], offset: 64_u64, value: obs9_i64);
  let obs10 = point_in_rect(px: 10_i32, py: 20_i32, rx: 10_i32, ry: 20_i32, width: 3_i32, height: 4_i32);
  let obs10_u64 = if obs10 {
    give 1_u64;
  } else {
    give 0_u64;
  }
  encode_u64_le(buffer: &buffer[0_u64..112_u64], offset: 72_u64, value: obs10_u64);
  let obs11 = point_in_rect(px: 12_i32, py: 23_i32, rx: 10_i32, ry: 20_i32, width: 3_i32, height: 4_i32);
  let obs11_u64 = if obs11 {
    give 1_u64;
  } else {
    give 0_u64;
  }
  encode_u64_le(buffer: &buffer[0_u64..112_u64], offset: 80_u64, value: obs11_u64);
  let obs12 = point_in_rect(px: 13_i32, py: 23_i32, rx: 10_i32, ry: 20_i32, width: 3_i32, height: 4_i32);
  let obs12_u64 = if obs12 {
    give 1_u64;
  } else {
    give 0_u64;
  }
  encode_u64_le(buffer: &buffer[0_u64..112_u64], offset: 88_u64, value: obs12_u64);
  let obs13 = point_in_rect(px: 12_i32, py: 24_i32, rx: 10_i32, ry: 20_i32, width: 3_i32, height: 4_i32);
  let obs13_u64 = if obs13 {
    give 1_u64;
  } else {
    give 0_u64;
  }
  encode_u64_le(buffer: &buffer[0_u64..112_u64], offset: 96_u64, value: obs13_u64);
  let obs14 = rects_intersect(r1x: 10_i32, r1y: 20_i32, r1w: 3_i32, r1h: 4_i32, r2x: 13_i32, r2y: 20_i32, r2w: 3_i32, r2h: 4_i32);
  let obs14_u64 = if obs14 {
    give 1_u64;
  } else {
    give 0_u64;
  }
  encode_u64_le(buffer: &buffer[0_u64..112_u64], offset: 104_u64, value: obs14_u64);
  let view = &buffer[0_u64..112_u64];
  let write_result = write_all(factory: &factory, output: &output, source: view, length: 112_u64);
  let code = match write_result {
    Ok(value: unused) => {
      give 0_u8;
    }
    Err(error: unused) => {
      give 1_u8;
    }
  }
  return exit_status(code: code);
}

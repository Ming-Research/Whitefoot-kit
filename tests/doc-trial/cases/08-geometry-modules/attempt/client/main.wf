alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias OutputStream = std::io::OutputStream;
alias HandleFactory = std::io::HandleFactory;
alias IoError = std::io::IoError;
alias CancelWatch = std::time::CancelWatch;
alias cancel_never = std::time::cancel_never;
alias close_cancel_watch = std::time::close_cancel_watch;
alias Coordinate = pkg::geometry::Coordinate;
alias Point = pkg::geometry::Point;
alias Rectangle = pkg::geometry::Rectangle;
alias coordinate_from_whole_pixels = pkg::geometry::coordinate_from_whole_pixels;
alias coordinate_from_f64 = pkg::geometry::coordinate_from_f64;
alias coordinate_to_f64 = pkg::geometry::coordinate_to_f64;
alias coordinate_saturating_add = pkg::geometry::coordinate_saturating_add;
alias coordinate_saturating_sub = pkg::geometry::coordinate_saturating_sub;
alias point_contains = pkg::geometry::point_contains;
alias rectangles_intersect = pkg::geometry::rectangles_intersect;
alias write_once = std::io::write_once;

fn write_all(factory: &HandleFactory, output: &OutputStream, buffer: &[u8]) -> result: Bool writes(factory), writes(output) waits {
  let cancel = cancel_never();
  let length = buffer^.len;
  let sent = 0_u64;
  loop {
    let outcome = write_once(factory: factory, output: output, source: buffer, start: sent, end: length, deadline: None<std::time::Instant>(), cancel: &cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
        if sent == length {
          let unused = close_cancel_watch(watch: move cancel);
          return True();
        }
      }
      Err(error: unused_error) => {
        let unused = close_cancel_watch(watch: move cancel);
        return False();
      }
    }
  }
}

fn write_i64_le(buffer: &[u8], offset: u64, value: i64) -> result: unit writes(buffer) {
  let byte0 = cvt::<i64, u8>(value);
  set buffer^[offset] = byte0;
  let byte1 = cvt::<i64, u8>(ishr(value, 8_u32));
  set buffer^[offset + 1_u64] = byte1;
  let byte2 = cvt::<i64, u8>(ishr(value, 16_u32));
  set buffer^[offset + 2_u64] = byte2;
  let byte3 = cvt::<i64, u8>(ishr(value, 24_u32));
  set buffer^[offset + 3_u64] = byte3;
  let byte4 = cvt::<i64, u8>(ishr(value, 32_u32));
  set buffer^[offset + 4_u64] = byte4;
  let byte5 = cvt::<i64, u8>(ishr(value, 40_u32));
  set buffer^[offset + 5_u64] = byte5;
  let byte6 = cvt::<i64, u8>(ishr(value, 48_u32));
  set buffer^[offset + 6_u64] = byte6;
  let byte7 = cvt::<i64, u8>(ishr(value, 56_u32));
  set buffer^[offset + 7_u64] = byte7;
  return unit;
}

fn write_f64_le(buffer: &[u8], offset: u64, value: f64) -> result: unit writes(buffer) {
  let bits = reinterpret::<f64, u64>(value);
  let byte0 = cvt::<u64, u8>(bits);
  set buffer^[offset] = byte0;
  let byte1 = cvt::<u64, u8>(ishr(bits, 8_u32));
  set buffer^[offset + 1_u64] = byte1;
  let byte2 = cvt::<u64, u8>(ishr(bits, 16_u32));
  set buffer^[offset + 2_u64] = byte2;
  let byte3 = cvt::<u64, u8>(ishr(bits, 24_u32));
  set buffer^[offset + 3_u64] = byte3;
  let byte4 = cvt::<u64, u8>(ishr(bits, 32_u32));
  set buffer^[offset + 4_u64] = byte4;
  let byte5 = cvt::<u64, u8>(ishr(bits, 40_u32));
  set buffer^[offset + 5_u64] = byte5;
  let byte6 = cvt::<u64, u8>(ishr(bits, 48_u32));
  set buffer^[offset + 6_u64] = byte6;
  let byte7 = cvt::<u64, u8>(ishr(bits, 56_u32));
  set buffer^[offset + 7_u64] = byte7;
  return unit;
}

fn write_bool_le(buffer: &[u8], offset: u64, value: Bool) -> result: unit writes(buffer) {
  let encoded = if value {
    give 1_i64;
  } else {
    give 0_i64;
  }
  write_i64_le(buffer: buffer, offset: offset, value: encoded);
  return unit;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: cwd_directory, handles: factory, stdout: stdout_stream, ..) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  let close_write_result = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let close_read_result = std::fs::close_directory(factory: &factory, directory: move cwd);
  let unused_1 = match close_write_result {
    Ok(value: unused_write_ok) => {
      give unit;
    }
    Err(error: unused_write_error) => {
      give unit;
    }
  }
  let unused_2 = match close_read_result {
    Ok(value: unused_read_ok) => {
      give unit;
    }
    Err(error: unused_read_error) => {
      give unit;
    }
  }
  let buffer = array_filled::<u8, 112>(value: 0_u8);
  let obs1 = coordinate_from_whole_pixels(pixels: 2_i32);
  write_i64_le(buffer: &buffer, offset: 0_u64, value: cvt::<i32, i64>(obs1.raw));
  let obs2 = coordinate_from_whole_pixels(pixels: 2147483647_i32);
  write_i64_le(buffer: &buffer, offset: 8_u64, value: cvt::<i32, i64>(obs2.raw));
  let obs3 = coordinate_from_whole_pixels(pixels: -2147483648_i32);
  write_i64_le(buffer: &buffer, offset: 16_u64, value: cvt::<i32, i64>(obs3.raw));
  let obs4 = coordinate_from_f64(value: 1.5_f64);
  write_i64_le(buffer: &buffer, offset: 24_u64, value: cvt::<i32, i64>(obs4.raw));
  let obs5 = coordinate_to_f64(coord: obs4);
  write_f64_le(buffer: &buffer, offset: 32_u64, value: obs5);
  let obs6 = coordinate_from_f64(value: 0.0078125_f64);
  write_i64_le(buffer: &buffer, offset: 40_u64, value: cvt::<i32, i64>(obs6.raw));
  let obs7 = coordinate_from_f64(value: 0.0234375_f64);
  write_i64_le(buffer: &buffer, offset: 48_u64, value: cvt::<i32, i64>(obs7.raw));
  let max_coord = Coordinate(raw: 2147483647_i32);
  let one_coord = Coordinate(raw: 64_i32);
  let obs8 = coordinate_saturating_add(left: max_coord, right: one_coord);
  write_i64_le(buffer: &buffer, offset: 56_u64, value: cvt::<i32, i64>(obs8.raw));
  let min_coord = Coordinate(raw: -2147483648_i32);
  let obs9 = coordinate_saturating_sub(left: min_coord, right: one_coord);
  write_i64_le(buffer: &buffer, offset: 64_u64, value: cvt::<i32, i64>(obs9.raw));
  let rect1 = Rectangle(left: coordinate_from_whole_pixels(pixels: 10_i32), top: coordinate_from_whole_pixels(pixels: 20_i32), width: coordinate_from_whole_pixels(pixels: 3_i32), height: coordinate_from_whole_pixels(pixels: 4_i32));
  let point1 = Point(x: coordinate_from_whole_pixels(pixels: 10_i32), y: coordinate_from_whole_pixels(pixels: 20_i32));
  let obs10 = point_contains(point: point1, rect: rect1);
  write_bool_le(buffer: &buffer, offset: 72_u64, value: obs10);
  let point2 = Point(x: coordinate_from_whole_pixels(pixels: 12_i32), y: coordinate_from_whole_pixels(pixels: 23_i32));
  let obs11 = point_contains(point: point2, rect: rect1);
  write_bool_le(buffer: &buffer, offset: 80_u64, value: obs11);
  let point3 = Point(x: coordinate_from_whole_pixels(pixels: 13_i32), y: coordinate_from_whole_pixels(pixels: 23_i32));
  let obs12 = point_contains(point: point3, rect: rect1);
  write_bool_le(buffer: &buffer, offset: 88_u64, value: obs12);
  let point4 = Point(x: coordinate_from_whole_pixels(pixels: 12_i32), y: coordinate_from_whole_pixels(pixels: 24_i32));
  let obs13 = point_contains(point: point4, rect: rect1);
  write_bool_le(buffer: &buffer, offset: 96_u64, value: obs13);
  let rect2 = Rectangle(left: coordinate_from_whole_pixels(pixels: 13_i32), top: coordinate_from_whole_pixels(pixels: 20_i32), width: coordinate_from_whole_pixels(pixels: 3_i32), height: coordinate_from_whole_pixels(pixels: 4_i32));
  let obs14 = rectangles_intersect(rect1: rect1, rect2: rect2);
  write_bool_le(buffer: &buffer, offset: 104_u64, value: obs14);
  let write_outcome = write_all(factory: &factory, output: &stdout_stream, buffer: &buffer[0_u64..112_u64]);
  if write_outcome {
    return exit_status(code: 0_u8);
  } else {
    return exit_status(code: 1_u8);
  }
}

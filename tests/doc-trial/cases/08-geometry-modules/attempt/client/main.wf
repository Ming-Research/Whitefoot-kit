alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: output, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move cwd_directory;
  let write_closed = std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  let read_closed = std::fs::close_directory(factory: &factory, directory: move directory_read);
  let one_pixel = pkg::geometry::coord_from_pixels(pixels: 1_i32);
  let two = pkg::geometry::coord_from_pixels(pixels: 2_i32);
  let w1 = raw_word(value: two);
  let max_pixels = pkg::geometry::coord_from_pixels(pixels: 2147483647_i32);
  let w2 = raw_word(value: max_pixels);
  let min_pixels = pkg::geometry::coord_from_pixels(pixels: -2147483648_i32);
  let w3 = raw_word(value: min_pixels);
  let fraction = pkg::geometry::coord_from_binary64(pixels: 1.5_f64);
  let w4 = raw_word(value: fraction);
  let back = pkg::geometry::coord_to_binary64(value: fraction);
  let w5 = f64_word(value: back);
  let tiny = pkg::geometry::coord_from_binary64(pixels: 0.0078125_f64);
  let w6 = raw_word(value: tiny);
  let small = pkg::geometry::coord_from_binary64(pixels: 0.0234375_f64);
  let w7 = raw_word(value: small);
  let at_max = pkg::geometry::coord_add(left: max_pixels, right: one_pixel);
  let w8 = raw_word(value: at_max);
  let at_min = pkg::geometry::coord_sub(left: min_pixels, right: one_pixel);
  let w9 = raw_word(value: at_min);
  let rect = pkg::geometry::rect_from_pixels(x: 10_i32, y: 20_i32, width: 3_i32, height: 4_i32);
  let x10 = pkg::geometry::coord_from_pixels(pixels: 10_i32);
  let y20 = pkg::geometry::coord_from_pixels(pixels: 20_i32);
  let x12 = pkg::geometry::coord_from_pixels(pixels: 12_i32);
  let y23 = pkg::geometry::coord_from_pixels(pixels: 23_i32);
  let x13 = pkg::geometry::coord_from_pixels(pixels: 13_i32);
  let y24 = pkg::geometry::coord_from_pixels(pixels: 24_i32);
  let corner = pkg::geometry::rect_contains(rect: rect, x: x10, y: y20);
  let w10 = bool_word(flag: corner);
  let inner = pkg::geometry::rect_contains(rect: rect, x: x12, y: y23);
  let w11 = bool_word(flag: inner);
  let right_edge = pkg::geometry::rect_contains(rect: rect, x: x13, y: y23);
  let w12 = bool_word(flag: right_edge);
  let bottom_edge = pkg::geometry::rect_contains(rect: rect, x: x12, y: y24);
  let w13 = bool_word(flag: bottom_edge);
  let neighbour = pkg::geometry::rect_from_pixels(x: 13_i32, y: 20_i32, width: 3_i32, height: 4_i32);
  let overlap = pkg::geometry::rect_intersects(first: rect, second: neighbour);
  let w14 = bool_word(flag: overlap);
  let buffer = array_filled::<u8, 112>(value: 0_u8);
  let window = &buffer[0_u64..112_u64];
  put_word(bytes: window, base: 0_u64, word: w1);
  put_word(bytes: window, base: 8_u64, word: w2);
  put_word(bytes: window, base: 16_u64, word: w3);
  put_word(bytes: window, base: 24_u64, word: w4);
  put_word(bytes: window, base: 32_u64, word: w5);
  put_word(bytes: window, base: 40_u64, word: w6);
  put_word(bytes: window, base: 48_u64, word: w7);
  put_word(bytes: window, base: 56_u64, word: w8);
  put_word(bytes: window, base: 64_u64, word: w9);
  put_word(bytes: window, base: 72_u64, word: w10);
  put_word(bytes: window, base: 80_u64, word: w11);
  put_word(bytes: window, base: 88_u64, word: w12);
  put_word(bytes: window, base: 96_u64, word: w13);
  put_word(bytes: window, base: 104_u64, word: w14);
  let published = publish_all(factory: &factory, output: &output, source: window, length: 112_u64);
  let code = 0_u8;
  match write_closed {
    Ok(value: unused_write_closed) => {
    }
    Err(error: unused_write_error) => {
      set code = 1_u8;
    }
  }
  match read_closed {
    Ok(value: unused_read_closed) => {
    }
    Err(error: unused_read_error) => {
      set code = 1_u8;
    }
  }
  match published {
    Ok(value: unused_published) => {
    }
    Err(error: unused_publish_error) => {
      set code = 1_u8;
    }
  }
  return std::process::exit_status(code: code);
}

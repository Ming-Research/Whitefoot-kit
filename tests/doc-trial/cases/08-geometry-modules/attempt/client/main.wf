alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias Inputs = std::process::Inputs;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;

alias Coord = pkg::geometry::Coord;
alias Point = pkg::geometry::Point;
alias Rect = pkg::geometry::Rect;
alias coord_from_pixels = pkg::geometry::coord_from_pixels;
alias coord_from_f64 = pkg::geometry::coord_from_f64;
alias coord_to_f64 = pkg::geometry::coord_to_f64;
alias coord_add_saturate = pkg::geometry::coord_add_saturate;
alias coord_sub_saturate = pkg::geometry::coord_sub_saturate;
alias rect_contains = pkg::geometry::rect_contains;
alias rect_intersects = pkg::geometry::rect_intersects;

fn write_all(factory: &HandleFactory, output: &OutputStream, source: &[u8]) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits {
  let sent = 0_u64;
  let length = source^.len;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn i64_to_le_bytes(value: i64) -> result: Array<u8, 8> pure {
  let b0 = cvt.wrap::<i64, u8>(value);
  let v1 = ishr(value, 8_u32);
  let b1 = cvt.wrap::<i64, u8>(v1);
  let v2 = ishr(value, 16_u32);
  let b2 = cvt.wrap::<i64, u8>(v2);
  let v3 = ishr(value, 24_u32);
  let b3 = cvt.wrap::<i64, u8>(v3);
  let v4 = ishr(value, 32_u32);
  let b4 = cvt.wrap::<i64, u8>(v4);
  let v5 = ishr(value, 40_u32);
  let b5 = cvt.wrap::<i64, u8>(v5);
  let v6 = ishr(value, 48_u32);
  let b6 = cvt.wrap::<i64, u8>(v6);
  let v7 = ishr(value, 56_u32);
  let b7 = cvt.wrap::<i64, u8>(v7);
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  set bytes[0_u64] = b0;
  set bytes[1_u64] = b1;
  set bytes[2_u64] = b2;
  set bytes[3_u64] = b3;
  set bytes[4_u64] = b4;
  set bytes[5_u64] = b5;
  set bytes[6_u64] = b6;
  set bytes[7_u64] = b7;
  return move bytes;
}

fn u64_to_le_bytes(value: u64) -> result: Array<u8, 8> pure {
  let b0 = cvt.wrap::<u64, u8>(value);
  let v1 = ishr(value, 8_u32);
  let b1 = cvt.wrap::<u64, u8>(v1);
  let v2 = ishr(value, 16_u32);
  let b2 = cvt.wrap::<u64, u8>(v2);
  let v3 = ishr(value, 24_u32);
  let b3 = cvt.wrap::<u64, u8>(v3);
  let v4 = ishr(value, 32_u32);
  let b4 = cvt.wrap::<u64, u8>(v4);
  let v5 = ishr(value, 40_u32);
  let b5 = cvt.wrap::<u64, u8>(v5);
  let v6 = ishr(value, 48_u32);
  let b6 = cvt.wrap::<u64, u8>(v6);
  let v7 = ishr(value, 56_u32);
  let b7 = cvt.wrap::<u64, u8>(v7);
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  set bytes[0_u64] = b0;
  set bytes[1_u64] = b1;
  set bytes[2_u64] = b2;
  set bytes[3_u64] = b3;
  set bytes[4_u64] = b4;
  set bytes[5_u64] = b5;
  set bytes[6_u64] = b6;
  set bytes[7_u64] = b7;
  return move bytes;
}

fn f64_to_u64(value: f64) -> result: u64 pure {
  return reinterpret::<f64, u64>(value);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: stdout, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  let write_closed = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let read_closed = std::fs::close_directory(factory: &factory, directory: move cwd);
  let error_code = 0_u8;
  match write_closed {
    Ok(value: unused_write_closed) => {
    }
    Err(error: unused_write_error) => {
      set error_code = 1_u8;
    }
  }
  match read_closed {
    Ok(value: unused_read_closed) => {
    }
    Err(error: unused_read_error) => {
      set error_code = 1_u8;
    }
  }
  if error_code == 1_u8 {
    return exit_status(code: error_code);
  }
  let c1 = coord_from_pixels(pixels: 2_i32);
  let obs1_i64 = cvt::<i32, i64>(c1.raw);
  let obs1_bytes = i64_to_le_bytes(obs1_i64);
  let c2 = coord_from_pixels(pixels: 2147483647_i32);
  let obs2_i64 = cvt::<i32, i64>(c2.raw);
  let obs2_bytes = i64_to_le_bytes(obs2_i64);
  let c3 = coord_from_pixels(pixels: -2147483648_i32);
  let obs3_i64 = cvt::<i32, i64>(c3.raw);
  let obs3_bytes = i64_to_le_bytes(obs3_i64);
  let c4 = coord_from_f64(value: 1.5_f64);
  let obs4_i64 = cvt::<i32, i64>(c4.raw);
  let obs4_bytes = i64_to_le_bytes(obs4_i64);
  let obs5_f64 = coord_to_f64(coord: move c4);
  let obs5_u64 = f64_to_u64(obs5_f64);
  let obs5_bytes = u64_to_le_bytes(obs5_u64);
  let c6 = coord_from_f64(value: 0.0078125_f64);
  let obs6_i64 = cvt::<i32, i64>(c6.raw);
  let obs6_bytes = i64_to_le_bytes(obs6_i64);
  let c7 = coord_from_f64(value: 0.0234375_f64);
  let obs7_i64 = cvt::<i32, i64>(c7.raw);
  let obs7_bytes = i64_to_le_bytes(obs7_i64);
  let c_max = coord_from_pixels(pixels: 2147483647_i32);
  let c_one = coord_from_pixels(pixels: 1_i32);
  let c8 = coord_add_saturate(a: c_max, b: c_one);
  let obs8_i64 = cvt::<i32, i64>(c8.raw);
  let obs8_bytes = i64_to_le_bytes(obs8_i64);
  let c_min = coord_from_pixels(pixels: -2147483648_i32);
  let c9 = coord_sub_saturate(a: c_min, b: c_one);
  let obs9_i64 = cvt::<i32, i64>(c9.raw);
  let obs9_bytes = i64_to_le_bytes(obs9_i64);
  let rect1 = Rect(x: coord_from_pixels(pixels: 10_i32), y: coord_from_pixels(pixels: 20_i32), width: coord_from_pixels(pixels: 3_i32), height: coord_from_pixels(pixels: 4_i32));
  let point1 = Point(x: coord_from_pixels(pixels: 10_i32), y: coord_from_pixels(pixels: 20_i32));
  let obs10 = rect_contains(rect: rect1, point: point1);
  let obs10_u64 = if obs10 { give 1_u64; } else { give 0_u64; }
  let obs10_bytes = u64_to_le_bytes(obs10_u64);
  let point2 = Point(x: coord_from_pixels(pixels: 12_i32), y: coord_from_pixels(pixels: 23_i32));
  let obs11 = rect_contains(rect: rect1, point: point2);
  let obs11_u64 = if obs11 { give 1_u64; } else { give 0_u64; }
  let obs11_bytes = u64_to_le_bytes(obs11_u64);
  let point3 = Point(x: coord_from_pixels(pixels: 13_i32), y: coord_from_pixels(pixels: 23_i32));
  let obs12 = rect_contains(rect: rect1, point: point3);
  let obs12_u64 = if obs12 { give 1_u64; } else { give 0_u64; }
  let obs12_bytes = u64_to_le_bytes(obs12_u64);
  let point4 = Point(x: coord_from_pixels(pixels: 12_i32), y: coord_from_pixels(pixels: 24_i32));
  let obs13 = rect_contains(rect: rect1, point: point4);
  let obs13_u64 = if obs13 { give 1_u64; } else { give 0_u64; }
  let obs13_bytes = u64_to_le_bytes(obs13_u64);
  let rect2 = Rect(x: coord_from_pixels(pixels: 13_i32), y: coord_from_pixels(pixels: 20_i32), width: coord_from_pixels(pixels: 3_i32), height: coord_from_pixels(pixels: 4_i32));
  let obs14 = rect_intersects(a: rect1, b: rect2);
  let obs14_u64 = if obs14 { give 1_u64; } else { give 0_u64; }
  let obs14_bytes = u64_to_le_bytes(obs14_u64);
  let output_buffer = array_filled::<u8, 112>(value: 0_u8);
  for (i in 0_u64..8_u64) {
    set output_buffer[i] = obs1_bytes[i];
  }
  for (i in 0_u64..8_u64) {
    set output_buffer[8_u64 +wrap i] = obs2_bytes[i];
  }
  for (i in 0_u64..8_u64) {
    set output_buffer[16_u64 +wrap i] = obs3_bytes[i];
  }
  for (i in 0_u64..8_u64) {
    set output_buffer[24_u64 +wrap i] = obs4_bytes[i];
  }
  for (i in 0_u64..8_u64) {
    set output_buffer[32_u64 +wrap i] = obs5_bytes[i];
  }
  for (i in 0_u64..8_u64) {
    set output_buffer[40_u64 +wrap i] = obs6_bytes[i];
  }
  for (i in 0_u64..8_u64) {
    set output_buffer[48_u64 +wrap i] = obs7_bytes[i];
  }
  for (i in 0_u64..8_u64) {
    set output_buffer[56_u64 +wrap i] = obs8_bytes[i];
  }
  for (i in 0_u64..8_u64) {
    set output_buffer[64_u64 +wrap i] = obs9_bytes[i];
  }
  for (i in 0_u64..8_u64) {
    set output_buffer[72_u64 +wrap i] = obs10_bytes[i];
  }
  for (i in 0_u64..8_u64) {
    set output_buffer[80_u64 +wrap i] = obs11_bytes[i];
  }
  for (i in 0_u64..8_u64) {
    set output_buffer[88_u64 +wrap i] = obs12_bytes[i];
  }
  for (i in 0_u64..8_u64) {
    set output_buffer[96_u64 +wrap i] = obs13_bytes[i];
  }
  for (i in 0_u64..8_u64) {
    set output_buffer[104_u64 +wrap i] = obs14_bytes[i];
  }
  let output_slice = &output_buffer[0_u64..112_u64];
  let write_result = write_all(factory: &factory, output: &stdout, source: output_slice);
  let final_code = match write_result {
    Ok(value: unused_ok) => {
      give 0_u8;
    }
    Err(error: unused_error) => {
      give 1_u8;
    }
  }
  return exit_status(code: final_code);
}

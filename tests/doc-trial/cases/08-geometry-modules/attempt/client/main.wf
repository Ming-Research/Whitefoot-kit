alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias Directory = std::fs::Directory;
alias close_directory = std::fs::close_directory;
alias close_directory_write = std::fs::close_directory_write;
alias Coord = pkg::geometry::Coord;
alias Point = pkg::geometry::Point;
alias Rect = pkg::geometry::Rect;
alias coord_from_whole = pkg::geometry::coord_from_whole;
alias coord_from_f64 = pkg::geometry::coord_from_f64;
alias coord_to_f64 = pkg::geometry::coord_to_f64;
alias coord_add_sat = pkg::geometry::coord_add_sat;
alias coord_sub_sat = pkg::geometry::coord_sub_sat;
alias point_in_rect = pkg::geometry::point_in_rect;
alias rects_intersect = pkg::geometry::rects_intersect;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias Instant = std::time::Instant;
alias CancelWatch = std::time::CancelWatch;
alias write_once = std::io::write_once;
alias cancel_never = std::time::cancel_never;
alias close_cancel_watch = std::time::close_cancel_watch;
alias IoError = std::io::IoError;

fn write_i64_le(buffer: &[u8], offset: u64, value: i64) -> result: unit writes(buffer) {
  let s1 = ishr(value, 8_u32);
  let b1 = cvt.wrap::<i64, u8>(s1);
  let s2 = ishr(value, 16_u32);
  let b2 = cvt.wrap::<i64, u8>(s2);
  let s3 = ishr(value, 24_u32);
  let b3 = cvt.wrap::<i64, u8>(s3);
  let s4 = ishr(value, 32_u32);
  let b4 = cvt.wrap::<i64, u8>(s4);
  let s5 = ishr(value, 40_u32);
  let b5 = cvt.wrap::<i64, u8>(s5);
  let s6 = ishr(value, 48_u32);
  let b6 = cvt.wrap::<i64, u8>(s6);
  let s7 = ishr(value, 56_u32);
  let b7 = cvt.wrap::<i64, u8>(s7);
  let b0 = cvt.wrap::<i64, u8>(value);
  let o1 = offset + 1_u64;
  let o2 = offset + 2_u64;
  let o3 = offset + 3_u64;
  let o4 = offset + 4_u64;
  let o5 = offset + 5_u64;
  let o6 = offset + 6_u64;
  let o7 = offset + 7_u64;
  set buffer^[offset] = b0;
  set buffer^[o1] = b1;
  set buffer^[o2] = b2;
  set buffer^[o3] = b3;
  set buffer^[o4] = b4;
  set buffer^[o5] = b5;
  set buffer^[o6] = b6;
  set buffer^[o7] = b7;
  return unit;
}

fn write_f64_le(buffer: &[u8], offset: u64, value: f64) -> result: unit writes(buffer) {
  let bits = reinterpret::<f64, i64>(value);
  return write_i64_le(buffer: buffer, offset: offset, value: bits);
}

fn write_u64_le(buffer: &[u8], offset: u64, value: u64) -> result: unit writes(buffer) {
  let s1 = ishr(value, 8_u32);
  let b1 = cvt.wrap::<u64, u8>(s1);
  let s2 = ishr(value, 16_u32);
  let b2 = cvt.wrap::<u64, u8>(s2);
  let s3 = ishr(value, 24_u32);
  let b3 = cvt.wrap::<u64, u8>(s3);
  let s4 = ishr(value, 32_u32);
  let b4 = cvt.wrap::<u64, u8>(s4);
  let s5 = ishr(value, 40_u32);
  let b5 = cvt.wrap::<u64, u8>(s5);
  let s6 = ishr(value, 48_u32);
  let b6 = cvt.wrap::<u64, u8>(s6);
  let s7 = ishr(value, 56_u32);
  let b7 = cvt.wrap::<u64, u8>(s7);
  let b0 = cvt.wrap::<u64, u8>(value);
  let o1 = offset + 1_u64;
  let o2 = offset + 2_u64;
  let o3 = offset + 3_u64;
  let o4 = offset + 4_u64;
  let o5 = offset + 5_u64;
  let o6 = offset + 6_u64;
  let o7 = offset + 7_u64;
  set buffer^[offset] = b0;
  set buffer^[o1] = b1;
  set buffer^[o2] = b2;
  set buffer^[o3] = b3;
  set buffer^[o4] = b4;
  set buffer^[o5] = b5;
  set buffer^[o6] = b6;
  set buffer^[o7] = b7;
  return unit;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, buffer: &[u8]) -> result: Result<unit, std::io::IoError> reads(buffer), writes(factory), writes(output) waits {
  let sent = 0_u64;
  let length = 112_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<Instant>();
    let cancel = cancel_never();
    let outcome = write_once(factory: factory, output: output, source: buffer, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, std::io::IoError>(error: problem);
      }
    }
  }
  return Ok<unit, std::io::IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: output, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  let close_write_outcome = close_directory_write(factory: &factory, directory: move cwd_write);
  let close_read_outcome = close_directory(factory: &factory, directory: move cwd_read);
  match close_write_outcome {
    Ok(value: unused_write_ok) => {
    }
    Err(error: unused_write_err) => {
    }
  }
  match close_read_outcome {
    Ok(value: unused_read_ok) => {
    }
    Err(error: unused_read_err) => {
    }
  }
  let buffer = array_filled::<u8, 112>(value: 0_u8);
  let obs1_coord = coord_from_whole(pixels: 2_i32);
  let obs1 = cvt::<i32, i64>(obs1_coord.raw);
  write_i64_le(buffer: &buffer, offset: 0_u64, value: obs1);
  let obs2_coord = coord_from_whole(pixels: 2147483647_i32);
  let obs2 = cvt::<i32, i64>(obs2_coord.raw);
  write_i64_le(buffer: &buffer, offset: 8_u64, value: obs2);
  let obs3_coord = coord_from_whole(pixels: -2147483648_i32);
  let obs3 = cvt::<i32, i64>(obs3_coord.raw);
  write_i64_le(buffer: &buffer, offset: 16_u64, value: obs3);
  let obs4_coord = coord_from_f64(pixels: 1.5_f64);
  let obs4 = cvt::<i32, i64>(obs4_coord.raw);
  write_i64_le(buffer: &buffer, offset: 24_u64, value: obs4);
  let obs5_f64 = coord_to_f64(coord: obs4_coord);
  write_f64_le(buffer: &buffer, offset: 32_u64, value: obs5_f64);
  let obs6_coord = coord_from_f64(pixels: 0.0078125_f64);
  let obs6 = cvt::<i32, i64>(obs6_coord.raw);
  write_i64_le(buffer: &buffer, offset: 40_u64, value: obs6);
  let obs7_coord = coord_from_f64(pixels: 0.0234375_f64);
  let obs7 = cvt::<i32, i64>(obs7_coord.raw);
  write_i64_le(buffer: &buffer, offset: 48_u64, value: obs7);
  let max_coord = Coord(raw: 2147483647_i32);
  let one_pixel = coord_from_whole(pixels: 1_i32);
  let obs8_coord = coord_add_sat(left: max_coord, right: one_pixel);
  let obs8 = cvt::<i32, i64>(obs8_coord.raw);
  write_i64_le(buffer: &buffer, offset: 56_u64, value: obs8);
  let min_coord = Coord(raw: -2147483648_i32);
  let obs9_coord = coord_sub_sat(left: min_coord, right: one_pixel);
  let obs9 = cvt::<i32, i64>(obs9_coord.raw);
  write_i64_le(buffer: &buffer, offset: 64_u64, value: obs9);
  let c640 = Coord(raw: 640_i32);
  let c1280 = Coord(raw: 1280_i32);
  let c192 = Coord(raw: 192_i32);
  let c256 = Coord(raw: 256_i32);
  let rect1 = Rect(x: c640, y: c1280, width: c192, height: c256);
  let pt1 = Point(x: c640, y: c1280);
  let obs10 = point_in_rect(point: pt1, rect: rect1);
  let obs10_val = if obs10 {
    give 1_u64;
  } else {
    give 0_u64;
  }
  write_u64_le(buffer: &buffer, offset: 72_u64, value: obs10_val);
  let c768 = Coord(raw: 768_i32);
  let c1472 = Coord(raw: 1472_i32);
  let pt2 = Point(x: c768, y: c1472);
  let obs11 = point_in_rect(point: pt2, rect: rect1);
  let obs11_val = if obs11 {
    give 1_u64;
  } else {
    give 0_u64;
  }
  write_u64_le(buffer: &buffer, offset: 80_u64, value: obs11_val);
  let c832 = Coord(raw: 832_i32);
  let pt3 = Point(x: c832, y: c1472);
  let obs12 = point_in_rect(point: pt3, rect: rect1);
  let obs12_val = if obs12 {
    give 1_u64;
  } else {
    give 0_u64;
  }
  write_u64_le(buffer: &buffer, offset: 88_u64, value: obs12_val);
  let c1536 = Coord(raw: 1536_i32);
  let pt4 = Point(x: c768, y: c1536);
  let obs13 = point_in_rect(point: pt4, rect: rect1);
  let obs13_val = if obs13 {
    give 1_u64;
  } else {
    give 0_u64;
  }
  write_u64_le(buffer: &buffer, offset: 96_u64, value: obs13_val);
  let rect2 = Rect(x: c832, y: c1280, width: c192, height: c256);
  let obs14 = rects_intersect(a: rect1, b: rect2);
  let obs14_val = if obs14 {
    give 1_u64;
  } else {
    give 0_u64;
  }
  write_u64_le(buffer: &buffer, offset: 104_u64, value: obs14_val);
  let published = propagate publish_all(factory: &factory, output: &output, buffer: &buffer);
  return exit_status(code: 0_u8);
}

alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias Coord = pkg::geometry::Coord;
alias coord_from_pixels = pkg::geometry::coord_from_pixels;
alias coord_from_binary64 = pkg::geometry::coord_from_binary64;
alias coord_to_binary64 = pkg::geometry::coord_to_binary64;
alias coord_add = pkg::geometry::coord_add;
alias coord_sub = pkg::geometry::coord_sub;
alias rect_new = pkg::geometry::rect_new;
alias rect_contains = pkg::geometry::rect_contains;
alias rect_intersects = pkg::geometry::rect_intersects;

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: output_stream, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move cwd_directory;
  let write_closed = std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  let read_closed = std::fs::close_directory(factory: &factory, directory: move directory_read);
  match write_closed {
    Ok(value: unused_write_closed) => {
    }
    Err(error: unused_write_error) => {
    }
  }
  match read_closed {
    Ok(value: unused_read_closed) => {
    }
    Err(error: unused_read_error) => {
    }
  }
  let code = 0_u8;
  let whole_two = coord_from_pixels(pixels: 2_i32);
  let word_one = raw_word(coord: whole_two);
  let whole_max = coord_from_pixels(pixels: 2147483647_i32);
  let word_two = raw_word(coord: whole_max);
  let whole_min = coord_from_pixels(pixels: -2147483648_i32);
  let word_three = raw_word(coord: whole_min);
  let half_pixel = coord_from_binary64(pixels: 1.5_f64);
  let word_four = raw_word(coord: half_pixel);
  let back_half = coord_to_binary64(coord: half_pixel);
  let word_five = reinterpret::<f64, u64>(back_half);
  let tiny_low = coord_from_binary64(pixels: 0.0078125_f64);
  let word_six = raw_word(coord: tiny_low);
  let tiny_high = coord_from_binary64(pixels: 0.0234375_f64);
  let word_seven = raw_word(coord: tiny_high);
  let one_pixel = coord_from_pixels(pixels: 1_i32);
  let saturated_high = coord_add(left: whole_max, right: one_pixel);
  let word_eight = raw_word(coord: saturated_high);
  let saturated_low = coord_sub(left: whole_min, right: one_pixel);
  let word_nine = raw_word(coord: saturated_low);
  let left_ten = coord_from_pixels(pixels: 10_i32);
  let top_twenty = coord_from_pixels(pixels: 20_i32);
  let width_three = coord_from_pixels(pixels: 3_i32);
  let height_four = coord_from_pixels(pixels: 4_i32);
  let rect = rect_new(left: left_ten, top: top_twenty, width: width_three, height: height_four);
  let x_twelve = coord_from_pixels(pixels: 12_i32);
  let y_twentythree = coord_from_pixels(pixels: 23_i32);
  let x_thirteen = coord_from_pixels(pixels: 13_i32);
  let y_twentyfour = coord_from_pixels(pixels: 24_i32);
  let contains_origin = rect_contains(rect: rect, x: left_ten, y: top_twenty);
  let word_ten = flag_word(flag: contains_origin);
  let contains_inner = rect_contains(rect: rect, x: x_twelve, y: y_twentythree);
  let word_eleven = flag_word(flag: contains_inner);
  let contains_right = rect_contains(rect: rect, x: x_thirteen, y: y_twentythree);
  let word_twelve = flag_word(flag: contains_right);
  let contains_bottom = rect_contains(rect: rect, x: x_twelve, y: y_twentyfour);
  let word_thirteen = flag_word(flag: contains_bottom);
  let left_thirteen = coord_from_pixels(pixels: 13_i32);
  let other = rect_new(left: left_thirteen, top: top_twenty, width: width_three, height: height_four);
  let overlaps = rect_intersects(first: rect, second: other);
  let word_fourteen = flag_word(flag: overlaps);
  let bytes = array_filled::<u8, 112>(value: 0_u8);
  let window = &bytes[0_u64..112_u64];
  put_word(buffer: window, offset: 0_u64, word: word_one);
  put_word(buffer: window, offset: 8_u64, word: word_two);
  put_word(buffer: window, offset: 16_u64, word: word_three);
  put_word(buffer: window, offset: 24_u64, word: word_four);
  put_word(buffer: window, offset: 32_u64, word: word_five);
  put_word(buffer: window, offset: 40_u64, word: word_six);
  put_word(buffer: window, offset: 48_u64, word: word_seven);
  put_word(buffer: window, offset: 56_u64, word: word_eight);
  put_word(buffer: window, offset: 64_u64, word: word_nine);
  put_word(buffer: window, offset: 72_u64, word: word_ten);
  put_word(buffer: window, offset: 80_u64, word: word_eleven);
  put_word(buffer: window, offset: 88_u64, word: word_twelve);
  put_word(buffer: window, offset: 96_u64, word: word_thirteen);
  put_word(buffer: window, offset: 104_u64, word: word_fourteen);
  let published = publish_all(factory: &factory, output: &output_stream, source: window, length: 112_u64);
  match published {
    Ok(value: unused_published) => {
    }
    Err(error: unused_publish_error) => {
      set code = 1_u8;
    }
  }
  return exit_status(code: code);
}

fn raw_word(coord: Coord) -> result: u64 pure {
  let raw = coord.raw;
  let word = cvt.wrap::<i32, u64>(raw);
  return word;
}

fn flag_word(flag: Bool) -> result: u64 pure {
  let word = if flag {
    give 1_u64;
  } else {
    give 0_u64;
  }
  return word;
}

fn put_word(buffer: &[u8], offset: u64, word: u64) -> result: unit writes(buffer) contract {
  requires offset + 8_u64 <= buffer^.len;
} {
  let rest = word;
  for (k in 0_u64..8_u64) {
    let index = offset + k;
    let byte = cvt.wrap::<u64, u8>(rest);
    set buffer^[index] = byte;
    set rest = ishr(rest, 8_u32);
  }
  return unit;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  requires length <= source^.len;
} {
  let sent = 0_u64;
  loop @publish {
    if sent < length {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

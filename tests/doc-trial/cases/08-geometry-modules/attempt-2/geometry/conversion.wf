fn from_whole_pixels(pixels: i32) -> result: i32 pure {
  return pixels *sat 64_i32;
}

fn from_binary64_pixels(pixels: f64) -> result: i32 pure {
  let scaled = fmul.strict(pixels, 64.0_f64);
  let rounded = froundeven(scaled);
  let as_i64 = cvt.checked::<f64, i64>(rounded);
  let result = match as_i64 {
    Ok(value: v) => {
      let narrowed = cvt.checked::<i64, i32>(v);
      match narrowed {
        Ok(value: u) => {
          give u;
        }
        Err(error: _) => {
          if v > 0_i64 {
            give 2147483647_i32;
          } else {
            give -2147483648_i32;
          }
        }
      }
    }
    Err(error: _) => {
      give 0_i32;
    }
  }
  return result;
}

fn to_binary64_pixels(coord: i32) -> result: f64 pure {
  let as_f64 = cvt::<i32, f64>(coord);
  return fdiv.strict(as_f64, 64.0_f64);
}

alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias Instant = std::time::Instant;

const input: Array<u8, 5> = "+2+34";

const partial_input: Array<u8, 2> = "+2";

enum ParseError {
  Truncated();
  Invalid();
}

enum EvalError {
  Overflow();
}

enum Expr {
  Digit(value: u64);
  Sum(left: Box<Expr>, right: Box<Expr>);
}

struct Parsed {
  expr: Expr;
  next: u64;
}

fn parse(bytes: &[u8], at: u64) -> result: Result<Parsed, ParseError> reads(bytes) {
  let length = bytes^.len;
  if at >= length {
    let truncated = ParseError::Truncated();
    return Err<Parsed, ParseError>(error: truncated);
  }
  let byte = bytes^[at];
  let is_plus = byte == 43_u8;
  if is_plus {
    let after_sign = at +sat 1_u64;
    let first = propagate parse(bytes: bytes, at: after_sign);
    let Parsed(expr: left, next: mid) = move first;
    let second = propagate parse(bytes: bytes, at: mid);
    let Parsed(expr: right, next: finish_at) = move second;
    let left_box = box_new::<Expr>(value: move left);
    let right_box = box_new::<Expr>(value: move right);
    let node = Expr::Sum(left: move left_box, right: move right_box);
    let parsed = Parsed(expr: move node, next: finish_at);
    return Ok<Parsed, ParseError>(value: move parsed);
  }
  let low = byte >= 48_u8;
  let high = byte <= 57_u8;
  let is_digit = band(low, high);
  if is_digit {
    let offset = byte - 48_u8;
    let digit_value = cvt::<u8, u64>(offset);
    let digit = Expr::Digit(value: digit_value);
    let after_digit = at +sat 1_u64;
    let parsed = Parsed(expr: move digit, next: after_digit);
    return Ok<Parsed, ParseError>(value: move parsed);
  }
  let invalid = ParseError::Invalid();
  return Err<Parsed, ParseError>(error: invalid);
}

fn evaluate(expr: &Expr) -> result: Result<u64, EvalError> reads(expr) {
  match expr^ {
    Digit(value: digit_value) => {
      let digit = digit_value^;
      return Ok<u64, EvalError>(value: digit);
    }
    Sum(left: left_box, right: right_box) => {
      let left_inner = &left_box^.inner;
      let right_inner = &right_box^.inner;
      let left_total = propagate evaluate(expr: left_inner);
      let right_total = propagate evaluate(expr: right_inner);
      let added = left_total +checked right_total;
      match added {
        Ok(value: total) => {
          return Ok<u64, EvalError>(value: total);
        }
        Err(error: problem) => {
          let failed = EvalError::Overflow();
          return Err<u64, EvalError>(error: failed);
        }
      }
    }
  }
}

fn store_word(window: &[u8], value: u64) -> result: unit writes(window) contract {
  requires window^.len == 8_u64;
} {
  let rest = value;
  for (i in 0_u64..8_u64) {
    let low = cvt.wrap::<u64, u8>(rest);
    set window^[i] = low;
    set rest = ishr(rest, 8_u32);
  }
  return unit;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: cwd_directory, stdout: stdout, handles: factory, ..) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  std::fs::close_directory(factory: &factory, directory: move cwd_read);
  let code = 0_u8;
  let full = parse(bytes: &input[0_u64..5_u64], at: 0_u64);
  let next_value = 0_u64;
  let sum_value = 0_u64;
  match move full {
    Ok(value: parsed) => {
      let Parsed(expr: tree, next: after) = move parsed;
      set next_value = after;
      let evaluated = evaluate(expr: &tree);
      match evaluated {
        Ok(value: total) => {
          set sum_value = total;
        }
        Err(error: problem) => {
          set code = 1_u8;
        }
      }
    }
    Err(error: problem) => {
      set code = 1_u8;
    }
  }
  if next_value != 5_u64 {
    set code = 1_u8;
  }
  if sum_value != 9_u64 {
    set code = 1_u8;
  }
  let partial = parse(bytes: &partial_input[0_u64..2_u64], at: 0_u64);
  let marker = 0_u64;
  match move partial {
    Ok(value: unused_parsed) => {
      set code = 1_u8;
    }
    Err(error: problem) => {
      match problem {
        Truncated() => {
          set marker = 1_u64;
        }
        Invalid() => {
          set marker = 2_u64;
        }
      }
    }
  }
  if marker != 1_u64 {
    set code = 1_u8;
  }
  let out = array_filled::<u8, 24>(value: 0_u8);
  store_word(window: &out[0_u64..8_u64], value: next_value);
  store_word(window: &out[8_u64..16_u64], value: sum_value);
  store_word(window: &out[16_u64..24_u64], value: marker);
  let published = publish_all(factory: &factory, output: &stdout, source: &out[0_u64..24_u64], length: 24_u64);
  match published {
    Ok(value: unused_published) => {
    }
    Err(error: unused_error) => {
      set code = 250_u8;
    }
  }
  return std::process::exit_status(code: code);
}

alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias OutputStream = std::io::OutputStream;
alias HandleFactory = std::io::HandleFactory;
alias IoError = std::io::IoError;
alias CancelWatch = std::time::CancelWatch;
alias Instant = std::time::Instant;

enum Expression {
  Digit(value: u8);
  Plus(left: Box<Expression>, right: Box<Expression>);
}

enum ParseError {
  Truncated();
  InvalidToken();
}

enum ParseResult {
  Success(expr: Expression, next: u64);
  Error(error: ParseError);
}

fn parse(bytes: &[u8], pos: u64) -> result: ParseResult reads(bytes) contract {
  requires pos <= bytes^.len;
} {
  if pos >= bytes^.len {
    return ParseResult::Error(error: ParseError::Truncated());
  }
  let byte = bytes^[pos];
  let plus = 43_u8;
  let zero = 48_u8;
  let nine = 57_u8;
  let is_plus = byte == plus;
  let is_digit = band(byte >= zero, byte <= nine);
  if is_plus {
    let first_result = parse(bytes: bytes, pos: pos + 1_u64);
    match first_result {
      ParseResult::Success(expr: first_expr, next: after_first) => {
        let second_result = parse(bytes: bytes, pos: after_first);
        match second_result {
          ParseResult::Success(expr: second_expr, next: after_second) => {
            let left_box = box_new::<Expression>(value: move first_expr);
            let right_box = box_new::<Expression>(value: move second_expr);
            let plus_expr = Expression::Plus(left: move left_box, right: move right_box);
            return ParseResult::Success(expr: plus_expr, next: after_second);
          }
          ParseResult::Error(error: err) => {
            return ParseResult::Error(error: move err);
          }
        }
      }
      ParseResult::Error(error: err) => {
        return ParseResult::Error(error: move err);
      }
    }
  } else {
    if is_digit {
      let digit_value = byte - zero;
      let digit_expr = Expression::Digit(value: digit_value);
      return ParseResult::Success(expr: digit_expr, next: pos + 1_u64);
    } else {
      return ParseResult::Error(error: ParseError::InvalidToken());
    }
  }
}

enum EvalResult {
  Ok(value: u64);
  Overflow();
}

fn eval(expr: &Expression) -> result: EvalResult reads(expr) {
  match expr^ {
    Expression::Digit(value: d) => {
      let d_u64 = cvt::<u8, u64>(d);
      return EvalResult::Ok(value: d_u64);
    }
    Expression::Plus(left: left_box, right: right_box) => {
      let left_result = eval(expr: &left_box^.inner);
      match left_result {
        EvalResult::Ok(value: left_val) => {
          let right_result = eval(expr: &right_box^.inner);
          match right_result {
            EvalResult::Ok(value: right_val) => {
              let sum_result = left_val +checked right_val;
              match sum_result {
                Ok(value: sum) => {
                  return EvalResult::Ok(value: sum);
                }
                Err(error: unused_overflow) => {
                  return EvalResult::Overflow();
                }
              }
            }
            EvalResult::Overflow() => {
              return EvalResult::Overflow();
            }
          }
        }
        EvalResult::Overflow() => {
          return EvalResult::Overflow();
        }
      }
    }
  }
}

fn write_bytes(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits {
  let sent = 0_u64;
  loop @publish {
    let continue_loop = sent < length;
    if continue_loop {
    } else {
      break @publish;
    }
    let no_deadline = None<Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn u64_to_le_bytes(value: u64, buffer: &[u8]) -> result: unit writes(buffer) {
  let b0 = cvt::<u64, u8>(value);
  let b1 = cvt::<u64, u8>(ishr(value, 8_u32));
  let b2 = cvt::<u64, u8>(ishr(value, 16_u32));
  let b3 = cvt::<u64, u8>(ishr(value, 24_u32));
  let b4 = cvt::<u64, u8>(ishr(value, 32_u32));
  let b5 = cvt::<u64, u8>(ishr(value, 40_u32));
  let b6 = cvt::<u64, u8>(ishr(value, 48_u32));
  let b7 = cvt::<u64, u8>(ishr(value, 56_u32));
  set buffer[0_u64] = b0;
  set buffer[1_u64] = b1;
  set buffer[2_u64] = b2;
  set buffer[3_u64] = b3;
  set buffer[4_u64] = b4;
  set buffer[5_u64] = b5;
  set buffer[6_u64] = b6;
  set buffer[7_u64] = b7;
  return unit;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: cwd_directory, handles: factory, stdout: output, ..) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  std::fs::close_directory(factory: &factory, directory: move cwd);
  let input_bytes = array_filled::<u8, 5>(value: 0_u8);
  set input_bytes[0_u64] = 43_u8;
  set input_bytes[1_u64] = 50_u8;
  set input_bytes[2_u64] = 43_u8;
  set input_bytes[3_u64] = 51_u8;
  set input_bytes[4_u64] = 52_u8;
  let input_slice = &input_bytes[0_u64..5_u64];
  let parse_result = parse(bytes: input_slice, pos: 0_u64);
  let incomplete_bytes = array_filled::<u8, 2>(value: 0_u8);
  set incomplete_bytes[0_u64] = 43_u8;
  set incomplete_bytes[1_u64] = 50_u8;
  let incomplete_slice = &incomplete_bytes[0_u64..2_u64];
  let incomplete_result = parse(bytes: incomplete_slice, pos: 0_u64);
  let output_buffer = array_filled::<u8, 24>(value: 0_u8);
  let incomplete_is_truncated = match incomplete_result {
    ParseResult::Success(expr: unused_expr, next: unused_next) => {
      give False();
    }
    ParseResult::Error(error: incomplete_err) => {
      let inner = match incomplete_err {
        ParseError::Truncated() => {
          give True();
        }
        ParseError::InvalidToken() => {
          give False();
        }
      };
      give inner;
    }
  };
  if incomplete_is_truncated {
    match parse_result {
      ParseResult::Success(expr: expr, next: parsed_next) => {
        let eval_result = eval(expr: &expr);
        match eval_result {
          EvalResult::Ok(value: value_check) => {
            let next_ok = parsed_next == 5_u64;
            let value_ok = value_check == 9_u64;
            let both_ok = band(next_ok, value_ok);
            if both_ok {
              u64_to_le_bytes(value: parsed_next, buffer: &output_buffer[0_u64..8_u64]);
              u64_to_le_bytes(value: value_check, buffer: &output_buffer[8_u64..16_u64]);
              u64_to_le_bytes(value: 1_u64, buffer: &output_buffer[16_u64..24_u64]);
              let write_outcome = write_bytes(factory: &factory, output: &output, source: &output_buffer[0_u64..24_u64], length: 24_u64);
              match write_outcome {
                Ok(value: unused_ok) => {
                  return exit_status(code: 0_u8);
                }
                Err(error: unused_err) => {
                  return exit_status(code: 250_u8);
                }
              }
            } else {
              return exit_status(code: 1_u8);
            }
          }
          EvalResult::Overflow() => {
            return exit_status(code: 1_u8);
          }
        }
      }
      ParseResult::Error(error: parse_err) => {
        match parse_err {
          ParseError::Truncated() => {
            return exit_status(code: 1_u8);
          }
          ParseError::InvalidToken() => {
            return exit_status(code: 1_u8);
          }
        }
      }
    }
  } else {
    return exit_status(code: 1_u8);
  }
}

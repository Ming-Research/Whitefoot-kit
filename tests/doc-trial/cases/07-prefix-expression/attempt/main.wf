alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias exit_status = std::process::exit_status;
alias write_once = std::io::write_once;
alias cancel_never = std::time::cancel_never;
alias close_cancel_watch = std::time::close_cancel_watch;

enum ParseResult {
  Success(next_pos: u64, value: u64);
  Error(error_code: u8);
}

fn parse_expr(bytes: &[u8], pos: u64) -> result: ParseResult reads(bytes) {
  if pos >= bytes^.len {
    return ParseResult::Error(error_code: 1_u8);
  }
  let byte = bytes^[pos];
  let plus_byte = 43_u8;
  let zero_byte = 48_u8;
  let nine_byte = 57_u8;
  let is_plus = byte == plus_byte;
  if is_plus {
    let first = parse_expr(bytes: bytes, pos: pos +wrap 1_u64);
    match first {
      Success(next_pos: pos1, value: left) => {
        let second = parse_expr(bytes: bytes, pos: pos1);
        match second {
          Success(next_pos: pos2, value: right) => {
            let sum = left +checked right;
            match sum {
              Ok(value: result) => {
                return ParseResult::Success(next_pos: pos2, value: result);
              }
              Err(error: err1) => {
                return ParseResult::Error(error_code: 3_u8);
              }
            }
          }
          Error(error_code: err) => {
            return ParseResult::Error(error_code: err);
          }
        }
      }
      Error(error_code: err) => {
        return ParseResult::Error(error_code: err);
      }
    }
  } else {
    let check_digit = band(byte >= zero_byte, byte <= nine_byte);
    if check_digit {
      let digit = byte - zero_byte;
      let value = cvt::<u8, u64>(digit);
      return ParseResult::Success(next_pos: pos +wrap 1_u64, value: value);
    } else {
      return ParseResult::Error(error_code: 2_u8);
    }
  }
}

fn write_u64_le(factory: &HandleFactory, output: &OutputStream, value: u64) -> result: Result<unit, std::io::IoError> writes(factory), writes(output) waits {
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  let mask = 0xFF_u64;
  let byte0 = iand(value, mask);
  set bytes[0_u64] = cvt::<u64, u8>(byte0);
  let shifted1 = ishr(value, 8_u32);
  let byte1 = iand(shifted1, mask);
  set bytes[1_u64] = cvt::<u64, u8>(byte1);
  let shifted2 = ishr(value, 16_u32);
  let byte2 = iand(shifted2, mask);
  set bytes[2_u64] = cvt::<u64, u8>(byte2);
  let shifted3 = ishr(value, 24_u32);
  let byte3 = iand(shifted3, mask);
  set bytes[3_u64] = cvt::<u64, u8>(byte3);
  let shifted4 = ishr(value, 32_u32);
  let byte4 = iand(shifted4, mask);
  set bytes[4_u64] = cvt::<u64, u8>(byte4);
  let shifted5 = ishr(value, 40_u32);
  let byte5 = iand(shifted5, mask);
  set bytes[5_u64] = cvt::<u64, u8>(byte5);
  let shifted6 = ishr(value, 48_u32);
  let byte6 = iand(shifted6, mask);
  set bytes[6_u64] = cvt::<u64, u8>(byte6);
  let shifted7 = ishr(value, 56_u32);
  let byte7 = iand(shifted7, mask);
  set bytes[7_u64] = cvt::<u64, u8>(byte7);
  let buffer = &bytes[0_u64..8_u64];
  let no_deadline = None<std::time::Instant>();
  let cancel = cancel_never();
  let outcome = write_once(factory: factory, output: output, source: buffer, start: 0_u64, end: 8_u64, deadline: no_deadline, cancel: &cancel);
  close_cancel_watch(watch: move cancel);
  match outcome {
    Ok(value: sent) => {
      let all_sent = sent == 8_u64;
      if all_sent {
        return Ok<unit, std::io::IoError>(value: unit);
      } else {
        return Err<unit, std::io::IoError>(error: std::io::IoError::WriteZero(code: 0_u32, origin: 0_u8));
      }
    }
    Err(error: err) => {
      return Err<unit, std::io::IoError>(error: err);
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: cwd_directory, handles: factory, stdout: stdout_stream, ..) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  std::fs::close_directory(factory: &factory, directory: move cwd_read);
  let test1_bytes = array_filled::<u8, 5>(value: 0_u8);
  set test1_bytes[0_u64] = 43_u8;
  set test1_bytes[1_u64] = 50_u8;
  set test1_bytes[2_u64] = 43_u8;
  set test1_bytes[3_u64] = 51_u8;
  set test1_bytes[4_u64] = 52_u8;
  let test1_buffer = &test1_bytes[0_u64..5_u64];
  let result1 = parse_expr(bytes: test1_buffer, pos: 0_u64);
  let test1_pos = 0_u64;
  let test1_value = 0_u64;
  let test1_error = 0_u8;
  match result1 {
    Success(next_pos: pos, value: val) => {
      set test1_pos = pos;
      set test1_value = val;
    }
    Error(error_code: err) => {
      set test1_error = err;
    }
  }
  let test2_bytes = array_filled::<u8, 2>(value: 0_u8);
  set test2_bytes[0_u64] = 43_u8;
  set test2_bytes[1_u64] = 50_u8;
  let test2_buffer = &test2_bytes[0_u64..2_u64];
  let result2 = parse_expr(bytes: test2_buffer, pos: 0_u64);
  let test2_error = 0_u8;
  match result2 {
    Success(next_pos: pos2, value: val2) => {
    }
    Error(error_code: err) => {
      set test2_error = err;
    }
  }
  let is_test1_pos_ok = test1_pos == 5_u64;
  let is_test1_val_ok = test1_value == 9_u64;
  let is_test1_err_ok = test1_error == 0_u8;
  let is_test2_err_ok = test2_error == 1_u8;
  let all_ok = band(is_test1_pos_ok, is_test1_val_ok);
  let all_ok_2 = band(all_ok, is_test1_err_ok);
  let all_ok_3 = band(all_ok_2, is_test2_err_ok);
  if all_ok_3 {
  } else {
    return exit_status(code: 1_u8);
  }
  let write1 = write_u64_le(factory: &factory, output: &stdout_stream, value: test1_pos);
  match write1 {
    Ok(value: ok_result) => {
    }
    Err(error: io_error) => {
      return exit_status(code: 250_u8);
    }
  }
  let test1_val_extended = test1_value;
  let write2 = write_u64_le(factory: &factory, output: &stdout_stream, value: test1_val_extended);
  match write2 {
    Ok(value: ok_result2) => {
    }
    Err(error: io_error2) => {
      return exit_status(code: 250_u8);
    }
  }
  let test2_error_extended = cvt::<u8, u64>(test2_error);
  let write3 = write_u64_le(factory: &factory, output: &stdout_stream, value: test2_error_extended);
  match write3 {
    Ok(value: ok_result3) => {
    }
    Err(error: io_error3) => {
      return exit_status(code: 250_u8);
    }
  }
  return exit_status(code: 0_u8);
}

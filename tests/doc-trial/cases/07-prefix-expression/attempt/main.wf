alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;

enum ParseResult {
  Success(next_pos: u64, value: u64);
  Error(code: u8);
}

fn parse_expr(bytes: &[u8], pos: u64) -> result: ParseResult reads(bytes) {
  if pos >= bytes^.len {
    return ParseResult::Error(code: 1_u8);
  }
  let byte = bytes^[pos];
  if byte == 43_u8 {
    let next = pos +wrap 1_u64;
    let first = parse_expr(bytes: bytes, pos: next);
    match first {
      Success(next_pos: p1, value: v1) => {
        let second = parse_expr(bytes: bytes, pos: p1);
        match second {
          Success(next_pos: p2, value: v2) => {
            let result = v1 +checked v2;
            match result {
              Ok(value: sum) => {
                return ParseResult::Success(next_pos: p2, value: sum);
              }
              Err(error: e) => {
                return ParseResult::Error(code: 3_u8);
              }
            }
          }
          Error(code: err) => {
            return ParseResult::Error(code: err);
          }
        }
      }
      Error(code: err) => {
        return ParseResult::Error(code: err);
      }
    }
  }
  if byte >= 48_u8 {
    if byte <= 57_u8 {
      let digit = byte - 48_u8;
      let val = cvt::<u8, u64>(digit);
      let next = pos +wrap 1_u64;
      return ParseResult::Success(next_pos: next, value: val);
    }
  }
  return ParseResult::Error(code: 2_u8);
}

fn write_u64_le(factory: &std::io::HandleFactory, output: &std::io::OutputStream, v: u64) -> result: Result<unit, std::io::IoError> writes(factory), writes(output) waits {
  let b = array_filled::<u8, 8>(value: 0_u8);
  let m = 0xFF_u64;
  set b[0_u64] = cvt::<u64, u8>(iand(v, m));
  set b[1_u64] = cvt::<u64, u8>(iand(ishr(v, 8_u32), m));
  set b[2_u64] = cvt::<u64, u8>(iand(ishr(v, 16_u32), m));
  set b[3_u64] = cvt::<u64, u8>(iand(ishr(v, 24_u32), m));
  set b[4_u64] = cvt::<u64, u8>(iand(ishr(v, 32_u32), m));
  set b[5_u64] = cvt::<u64, u8>(iand(ishr(v, 40_u32), m));
  set b[6_u64] = cvt::<u64, u8>(iand(ishr(v, 48_u32), m));
  set b[7_u64] = cvt::<u64, u8>(iand(ishr(v, 56_u32), m));
  let buf = &b[0_u64..8_u64];
  let dl = None<std::time::Instant>();
  let cw = std::time::cancel_never();
  let res = std::io::write_once(factory: factory, output: output, source: buf, start: 0_u64, end: 8_u64, deadline: dl, cancel: &cw);
  std::time::close_cancel_watch(watch: move cw);
  match res {
    Ok(value: n) => {
      if n == 8_u64 {
        return Ok<unit, std::io::IoError>(value: unit);
      }
      return Err<unit, std::io::IoError>(error: std::io::IoError::WriteZero(code: 0_u32, origin: 0_u8));
    }
    Err(error: e) => {
      return Err<unit, std::io::IoError>(error: e);
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: cd, handles: h, stdout: s, ..) = move inputs;
  let std::fs::Directory(read: dr, write: dw) = move cd;
  std::fs::close_directory_write(factory: &h, directory: move dw);
  std::fs::close_directory(factory: &h, directory: move dr);
  let test1 = array_filled::<u8, 5>(value: 0_u8);
  set test1[0_u64] = 43_u8;
  set test1[1_u64] = 50_u8;
  set test1[2_u64] = 43_u8;
  set test1[3_u64] = 51_u8;
  set test1[4_u64] = 52_u8;
  let res1 = parse_expr(bytes: &test1[0_u64..5_u64], pos: 0_u64);
  let p1 = 0_u64;
  let v1 = 0_u64;
  let e1 = 0_u8;
  match res1 {
    Success(next_pos: np, value: vv) => {
      set p1 = np;
      set v1 = vv;
    }
    Error(code: c) => {
      set e1 = c;
    }
  }
  let test2 = array_filled::<u8, 2>(value: 0_u8);
  set test2[0_u64] = 43_u8;
  set test2[1_u64] = 50_u8;
  let res2 = parse_expr(bytes: &test2[0_u64..2_u64], pos: 0_u64);
  let e2 = 0_u8;
  match res2 {
    Success(next_pos: np2, value: vv2) => {
    }
    Error(code: c2) => {
      set e2 = c2;
    }
  }
  if p1 == 5_u64 {
    if v1 == 9_u64 {
      if e1 == 0_u8 {
        if e2 == 1_u8 {
          let w1 = write_u64_le(factory: &h, output: &s, v: p1);
          match w1 {
            Ok(value: u) => {
              let w2 = write_u64_le(factory: &h, output: &s, v: v1);
              match w2 {
                Ok(value: u2) => {
                  let e2v = cvt::<u8, u64>(e2);
                  let w3 = write_u64_le(factory: &h, output: &s, v: e2v);
                  match w3 {
                    Ok(value: u3) => {
                      return std::process::exit_status(code: 0_u8);
                    }
                    Err(error: io) => {
                      return std::process::exit_status(code: 250_u8);
                    }
                  }
                }
                Err(error: io) => {
                  return std::process::exit_status(code: 250_u8);
                }
              }
            }
            Err(error: io) => {
              return std::process::exit_status(code: 250_u8);
            }
          }
        }
      }
    }
  }
  return std::process::exit_status(code: 1_u8);
}

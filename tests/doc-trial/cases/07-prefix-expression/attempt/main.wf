alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias CancelWatch = std::time::CancelWatch;

struct ParseResult {
  value: u64;
  next_pos: u64;
  error: u8;
}

fn parse_expr(bytes: &[u8], pos: u64) -> result: ParseResult reads(bytes) {
  if pos >= bytes^.len {
    return ParseResult(value: 0_u64, next_pos: pos, error: 1_u8);
  }
  let byte = bytes^[pos];
  let is_plus = byte == 43_u8;
  if is_plus {
    let result1 = parse_expr(bytes: bytes, pos: pos + 1_u64);
    if result1.error != 0_u8 {
      return result1;
    }
    let result2 = parse_expr(bytes: bytes, pos: result1.next_pos);
    if result2.error != 0_u8 {
      return result2;
    }
    let sum_result = result1.value +checked result2.value;
    match sum_result {
      Ok(value: total) => {
        return ParseResult(value: total, next_pos: result2.next_pos, error: 0_u8);
      }
      Err(error: unused_overflow) => {
        return ParseResult(value: 0_u64, next_pos: result2.next_pos, error: 2_u8);
      }
    }
  } else {
    let is_digit = band(byte >= 48_u8, byte <= 57_u8);
    if is_digit {
      let digit = byte - 48_u8;
      let digit_u64 = cvt::<u8, u64>(digit);
      return ParseResult(value: digit_u64, next_pos: pos + 1_u64, error: 0_u8);
    } else {
      return ParseResult(value: 0_u64, next_pos: pos, error: 2_u8);
    }
  }
}

fn u64_to_le_bytes(value: u64) -> result: Array<u8, 8> pure {
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  set bytes[0_u64] = cvt::<u64, u8>(value);
  let shifted1 = ishr(value, 8_u32);
  set bytes[1_u64] = cvt::<u64, u8>(shifted1);
  let shifted2 = ishr(value, 16_u32);
  set bytes[2_u64] = cvt::<u64, u8>(shifted2);
  let shifted3 = ishr(value, 24_u32);
  set bytes[3_u64] = cvt::<u64, u8>(shifted3);
  let shifted4 = ishr(value, 32_u32);
  set bytes[4_u64] = cvt::<u64, u8>(shifted4);
  let shifted5 = ishr(value, 40_u32);
  set bytes[5_u64] = cvt::<u64, u8>(shifted5);
  let shifted6 = ishr(value, 48_u32);
  set bytes[6_u64] = cvt::<u64, u8>(shifted6);
  let shifted7 = ishr(value, 56_u32);
  set bytes[7_u64] = cvt::<u64, u8>(shifted7);
  return move bytes;
}

fn write_all(factory: &HandleFactory, output: &OutputStream, bytes: &[u8]) -> result: Result<unit, unit> reads(bytes), writes(factory), writes(output) waits {
  let sent = 0_u64;
  let length = bytes^.len;
  loop @write_loop {
    if sent < length {
    } else {
      break @write_loop;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let write_result = std::io::write_once(factory: factory, output: output, source: bytes, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match write_result {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: unused_error) => {
        return Err<unit, unit>(error: unit);
      }
    }
  }
  return Ok<unit, unit>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: directory, handles: factory, stdout: output, ..) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move directory;
  let cwd_write_closed = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let cwd_read_closed = std::fs::close_directory(factory: &factory, directory: move cwd_read);
  let input_bytes = array_filled::<u8, 5>(value: 0_u8);
  set input_bytes[0_u64] = 43_u8;
  set input_bytes[1_u64] = 50_u8;
  set input_bytes[2_u64] = 43_u8;
  set input_bytes[3_u64] = 51_u8;
  set input_bytes[4_u64] = 52_u8;
  let result1 = parse_expr(bytes: &input_bytes[0_u64..5_u64], pos: 0_u64);
  let incomplete_bytes = array_filled::<u8, 2>(value: 0_u8);
  set incomplete_bytes[0_u64] = 43_u8;
  set incomplete_bytes[1_u64] = 50_u8;
  let result2 = parse_expr(bytes: &incomplete_bytes[0_u64..2_u64], pos: 0_u64);
  let output_pos = u64_to_le_bytes(value: result1.next_pos);
  let output_value = u64_to_le_bytes(value: result1.value);
  let output_error = u64_to_le_bytes(value: cvt::<u8, u64>(result2.error));
  let output_buffer = array_filled::<u8, 24>(value: 0_u8);
  let pos = 0_u64;
  for (i in 0_u64..8_u64) {
    set output_buffer[pos + i] = output_pos[i];
  }
  let pos2 = pos + 8_u64;
  for (i in 0_u64..8_u64) {
    set output_buffer[pos2 + i] = output_value[i];
  }
  let pos3 = pos2 + 8_u64;
  for (i in 0_u64..8_u64) {
    set output_buffer[pos3 + i] = output_error[i];
  }
  let check_pos = result1.next_pos == 5_u64;
  let check_value = result1.value == 9_u64;
  let check_error = result2.error == 1_u8;
  let check_success = band(check_pos, band(check_value, check_error));
  if check_success {
  } else {
    return exit_status(code: 1_u8);
  }
  let write_result = write_all(factory: &factory, output: &output, bytes: &output_buffer[0_u64..24_u64]);
  match write_result {
    Ok(value: unused_unit) => {
    }
    Err(error: unused_error) => {
      return exit_status(code: 250_u8);
    }
  }
  match cwd_write_closed {
    Ok(value: unused_ok) => {
    }
    Err(error: unused_err) => {
    }
  }
  match cwd_read_closed {
    Ok(value: unused_ok) => {
    }
    Err(error: unused_err) => {
    }
  }
  return exit_status(code: 0_u8);
}

alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias IoError = std::io::IoError;
alias OutputStream = std::io::OutputStream;
alias HandleFactory = std::io::HandleFactory;

enum ParseError {
  Truncated();
  Invalid();
  Exceeded();
}

struct Parsed {
  value: u64;
  next: u64;
}

fn parse_expr(source: &[u8], position: u64) -> result: Result<Parsed, ParseError> reads(source) {
  if position < source^.len {
    let token = source^[position];
    let plus = token == '+'_u8;
    if plus {
      let first_at = position +wrap 1_u64;
      let left = propagate parse_expr(source: source, position: first_at);
      let right = propagate parse_expr(source: source, position: left.next);
      let sum = left.value +checked right.value;
      match sum {
        Ok(value: total) => {
          let combined = Parsed(value: total, next: right.next);
          return Ok<Parsed, ParseError>(value: combined);
        }
        Err(error: problem) => {
          let exceeded = ParseError::Exceeded();
          return Err<Parsed, ParseError>(error: exceeded);
        }
      }
    }
    let at_least = token >= '0'_u8;
    let at_most = token <= '9'_u8;
    let digit_ok = band(at_least, at_most);
    if digit_ok {
      let code_word = cvt::<u8, u64>(token);
      let digit = code_word -wrap 48_u64;
      let next_at = position +wrap 1_u64;
      let number = Parsed(value: digit, next: next_at);
      return Ok<Parsed, ParseError>(value: number);
    }
    let invalid = ParseError::Invalid();
    return Err<Parsed, ParseError>(error: invalid);
  } else {
    let truncated = ParseError::Truncated();
    return Err<Parsed, ParseError>(error: truncated);
  }
}

fn byte_at(word: u64, shift: u32) -> result: u8 pure {
  let shifted = ishr.wrap(word, shift);
  return cvt.wrap::<u64, u8>(shifted);
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  requires length <= source^.len;
} {
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

const valid: Array<u8, 5> = "+2+34";

const partial: Array<u8, 2> = "+2";

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: directory, stdout: output, handles: factory, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  let write_closed = std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  let read_closed = std::fs::close_directory(factory: &factory, directory: move directory_read);
  let code = 0_u8;
  match write_closed {
    Ok(value: unused_write_closed) => {
    }
    Err(error: unused_write_error) => {
      set code = 1_u8;
    }
  }
  match read_closed {
    Ok(value: unused_read_closed) => {
    }
    Err(error: unused_read_error) => {
      set code = 1_u8;
    }
  }
  let valid_view = &valid[0_u64..5_u64];
  let partial_view = &partial[0_u64..2_u64];
  let total = 0_u64;
  let next_pos = 0_u64;
  let marker = 0_u8;
  let first_parse = parse_expr(source: valid_view, position: 0_u64);
  match first_parse {
    Ok(value: parsed) => {
      set total = parsed.value;
      set next_pos = parsed.next;
    }
    Err(error: unused_first_error) => {
      set code = 1_u8;
    }
  }
  if total != 9_u64 {
    set code = 1_u8;
  }
  if next_pos != 5_u64 {
    set code = 1_u8;
  }
  match parse_expr(source: partial_view, position: 0_u64) {
    Ok(value: unused_partial) => {
      set code = 1_u8;
    }
    Err(error: problem) => {
      match problem {
        Truncated() => {
          set marker = 1_u8;
        }
        Invalid() => {
          set marker = 2_u8;
        }
        Exceeded() => {
          set marker = 3_u8;
        }
      }
    }
  }
  let marker_word = cvt::<u8, u64>(marker);
  let out = array_filled::<u8, 24>(value: 0_u8);
  set out[0_u64] = byte_at(word: next_pos, shift: 0_u32);
  set out[1_u64] = byte_at(word: next_pos, shift: 8_u32);
  set out[2_u64] = byte_at(word: next_pos, shift: 16_u32);
  set out[3_u64] = byte_at(word: next_pos, shift: 24_u32);
  set out[4_u64] = byte_at(word: next_pos, shift: 32_u32);
  set out[5_u64] = byte_at(word: next_pos, shift: 40_u32);
  set out[6_u64] = byte_at(word: next_pos, shift: 48_u32);
  set out[7_u64] = byte_at(word: next_pos, shift: 56_u32);
  set out[8_u64] = byte_at(word: total, shift: 0_u32);
  set out[9_u64] = byte_at(word: total, shift: 8_u32);
  set out[10_u64] = byte_at(word: total, shift: 16_u32);
  set out[11_u64] = byte_at(word: total, shift: 24_u32);
  set out[12_u64] = byte_at(word: total, shift: 32_u32);
  set out[13_u64] = byte_at(word: total, shift: 40_u32);
  set out[14_u64] = byte_at(word: total, shift: 48_u32);
  set out[15_u64] = byte_at(word: total, shift: 56_u32);
  set out[16_u64] = byte_at(word: marker_word, shift: 0_u32);
  set out[17_u64] = byte_at(word: marker_word, shift: 8_u32);
  set out[18_u64] = byte_at(word: marker_word, shift: 16_u32);
  set out[19_u64] = byte_at(word: marker_word, shift: 24_u32);
  set out[20_u64] = byte_at(word: marker_word, shift: 32_u32);
  set out[21_u64] = byte_at(word: marker_word, shift: 40_u32);
  set out[22_u64] = byte_at(word: marker_word, shift: 48_u32);
  set out[23_u64] = byte_at(word: marker_word, shift: 56_u32);
  let view = &out[0_u64..24_u64];
  let published = publish_all(factory: &factory, output: &output, source: view, length: 24_u64);
  match published {
    Ok(value: unused_published) => {
    }
    Err(error: unused_publish_error) => {
      return exit_status(code: 250_u8);
    }
  }
  return exit_status(code: code);
}

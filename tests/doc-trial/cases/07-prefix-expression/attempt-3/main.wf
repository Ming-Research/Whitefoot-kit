alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;

const plus_example: Array<u8, 5> = "+2+34";

const short_example: Array<u8, 2> = "+2";

struct Parsed {
  value: u64;
  next: u64;
}

enum Failure {
  TruncatedInput();
  InvalidToken();
  SumOverflow();
}

fn parse_expr(source: &[u8], at: u64) -> result: Result<Parsed, Failure> reads(source) {
  if at >= source^.len {
    let problem = Failure::TruncatedInput();
    return Err<Parsed, Failure>(error: problem);
  }
  let byte = source^[at];
  let is_plus = byte == 43_u8;
  if is_plus {
    let after = at +wrap 1_u64;
    let left = parse_expr(source: source, at: after);
    match left {
      Ok(value: first_operand) => {
        let right = parse_expr(source: source, at: first_operand.next);
        match right {
          Ok(value: second_operand) => {
            let total = first_operand.value +checked second_operand.value;
            match total {
              Ok(value: sum) => {
                let parsed = Parsed(value: sum, next: second_operand.next);
                return Ok<Parsed, Failure>(value: parsed);
              }
              Err(error: unused_overflow) => {
                let problem = Failure::SumOverflow();
                return Err<Parsed, Failure>(error: problem);
              }
            }
          }
          Err(error: right_stop) => {
            return Err<Parsed, Failure>(error: right_stop);
          }
        }
      }
      Err(error: left_stop) => {
        return Err<Parsed, Failure>(error: left_stop);
      }
    }
  }
  let low = byte >= 48_u8;
  let high = byte <= 57_u8;
  let is_digit = band(low, high);
  if is_digit {
    let digit = byte - 48_u8;
    let wide = cvt::<u8, u64>(digit);
    let next = at +wrap 1_u64;
    let parsed = Parsed(value: wide, next: next);
    return Ok<Parsed, Failure>(value: parsed);
  }
  let problem = Failure::InvalidToken();
  return Err<Parsed, Failure>(error: problem);
}

fn store_word(bytes: &[u8], word: u64) -> result: unit writes(bytes) contract {
  requires bytes^.len == 8_u64;
} {
  set bytes^[0_u64] = cvt.wrap::<u64, u8>(word);
  let shifted1 = ishr(word, 8_u32);
  set bytes^[1_u64] = cvt.wrap::<u64, u8>(shifted1);
  let shifted2 = ishr(word, 16_u32);
  set bytes^[2_u64] = cvt.wrap::<u64, u8>(shifted2);
  let shifted3 = ishr(word, 24_u32);
  set bytes^[3_u64] = cvt.wrap::<u64, u8>(shifted3);
  let shifted4 = ishr(word, 32_u32);
  set bytes^[4_u64] = cvt.wrap::<u64, u8>(shifted4);
  let shifted5 = ishr(word, 40_u32);
  set bytes^[5_u64] = cvt.wrap::<u64, u8>(shifted5);
  let shifted6 = ishr(word, 48_u32);
  set bytes^[6_u64] = cvt.wrap::<u64, u8>(shifted6);
  let shifted7 = ishr(word, 56_u32);
  set bytes^[7_u64] = cvt.wrap::<u64, u8>(shifted7);
  return unit;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: cwd_directory, stdout: output, handles: factory, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let failed = False();
  let next_word = 0_u64;
  let value_word = 0_u64;
  let marker_word = 0_u64;
  let expr = &plus_example[0_u64..5_u64];
  let parsed_full = parse_expr(source: expr, at: 0_u64);
  match parsed_full {
    Ok(value: parsed) => {
      set next_word = parsed.next;
      set value_word = parsed.value;
      if parsed.next != 5_u64 {
        set failed = True();
      }
      if parsed.value != 9_u64 {
        set failed = True();
      }
    }
    Err(error: unused_full_error) => {
      set failed = True();
    }
  }
  let short_expr = &short_example[0_u64..2_u64];
  let parsed_short = parse_expr(source: short_expr, at: 0_u64);
  match parsed_short {
    Ok(value: unused_short) => {
      set failed = True();
    }
    Err(error: problem) => {
      match problem {
        TruncatedInput() => {
          set marker_word = 1_u64;
        }
        InvalidToken() => {
          set marker_word = 2_u64;
        }
        SumOverflow() => {
          set failed = True();
        }
      }
    }
  }
  let out = array_filled::<u8, 24>(value: 0_u8);
  store_word(bytes: &out[0_u64..8_u64], word: next_word);
  store_word(bytes: &out[8_u64..16_u64], word: value_word);
  store_word(bytes: &out[16_u64..24_u64], word: marker_word);
  let code = 0_u8;
  if failed {
    set code = 1_u8;
  }
  let outcome = publish_all(factory: &factory, output: &output, source: &out[0_u64..24_u64], length: 24_u64);
  match outcome {
    Ok(value: unused_published) => {
    }
    Err(error: unused_publish_error) => {
      return std::process::exit_status(code: 250_u8);
    }
  }
  return std::process::exit_status(code: code);
}

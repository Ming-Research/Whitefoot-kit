alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias MemoryMeter = std::process::MemoryMeter;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias exit_status = std::process::exit_status;
alias heap_in_use = std::process::heap_in_use;

fn release_pool(pool: Box<Paged<u64>>) -> result: unit pure {
  return unit;
}

fn release_zero_pool(pool: Box<Paged<Array<u8, 0>>>) -> result: unit pure {
  return unit;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, std::io::IoError> reads(source), writes(factory), writes(output) waits contract {
  requires length <= source^.len;
} {
  let sent = 0_u64;
  loop @publish {
    if sent < length {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, std::io::IoError>(error: problem);
      }
    }
  }
  return Ok<unit, std::io::IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: directory, handles: factory, stdout: output, memory_meter: meter, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  let write_closed = std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  let read_closed = std::fs::close_directory(factory: &factory, directory: move directory_read);
  let startup_code = 0_u8;
  match write_closed {
    Ok(value: unused_write_closed) => {
    }
    Err(error: unused_write_error) => {
      set startup_code = 1_u8;
    }
  }
  match read_closed {
    Ok(value: unused_read_closed) => {
    }
    Err(error: unused_read_error) => {
      set startup_code = 1_u8;
    }
  }
  let base = heap_in_use(meter: &meter);

  let zero_owner = box_paged_new::<u64>(capacity: 0_u64);
  grow_paged(cell: &zero_owner, capacity: 0_u64);
  let now = heap_in_use(meter: &meter);
  let d_zero = now -sat base;
  if d_zero != 0_u64 {
    return exit_status(code: 1_u8);
  }
  release_pool(pool: move zero_owner);
  let now = heap_in_use(meter: &meter);
  if now -sat base != 0_u64 {
    return exit_status(code: 2_u8);
  }

  let pool = box_paged_new::<u64>(capacity: 1_u64);
  place_back(window: &pool.inner, value: 73_u64);
  let now = heap_in_use(meter: &meter);
  if now -sat base != 40_u64 {
    return exit_status(code: 3_u8);
  }
  grow_paged(cell: &pool, capacity: 2_u64);
  place_back(window: &pool.inner, value: 1_u64);
  let now = heap_in_use(meter: &meter);
  if now -sat base != 48_u64 {
    return exit_status(code: 4_u8);
  }
  grow_paged(cell: &pool, capacity: 3_u64);
  place_back(window: &pool.inner, value: 2_u64);
  let now = heap_in_use(meter: &meter);
  if now -sat base != 64_u64 {
    return exit_status(code: 5_u8);
  }
  let logical = pool.inner.cap;
  if logical != 3_u64 {
    return exit_status(code: 6_u8);
  }
  grow_paged(cell: &pool, capacity: 4_u64);
  let now = heap_in_use(meter: &meter);
  if now -sat base != 64_u64 {
    return exit_status(code: 14_u8);
  }
  grow_paged(cell: &pool, capacity: 512_u64);
  for (
    i in 3_u64..512_u64
  ) {
    place_back(window: &pool.inner, value: i);
  }
  let now = heap_in_use(meter: &meter);
  if now -sat base != 4128_u64 {
    return exit_status(code: 7_u8);
  }
  grow_paged(cell: &pool, capacity: 513_u64);
  place_back(window: &pool.inner, value: 512_u64);
  let now = heap_in_use(meter: &meter);
  if now -sat base != 8232_u64 {
    return exit_status(code: 8_u8);
  }
  let first = pool.inner[0_u64];
  if first != 73_u64 {
    return exit_status(code: 9_u8);
  }
  let sum = 0_u64;
  for (
    k in 0_u64..513_u64
  ) {
    let got = pool.inner[k];
    if k != 0_u64 {
      if got != k {
        return exit_status(code: 10_u8);
      }
    }
    set sum = sum +wrap got;
  }
  if sum != 131401_u64 {
    return exit_status(code: 10_u8);
  }
  release_pool(pool: move pool);
  let now = heap_in_use(meter: &meter);
  if now -sat base != 0_u64 {
    return exit_status(code: 11_u8);
  }

  let separate = box_paged_new::<u64>(capacity: 3_u64);
  place_back(window: &separate.inner, value: 19_u64);
  let now = heap_in_use(meter: &meter);
  if now -sat base != 64_u64 {
    return exit_status(code: 12_u8);
  }
  let kept = separate.inner[0_u64];
  if kept != 19_u64 {
    return exit_status(code: 10_u8);
  }
  release_pool(pool: move separate);
  let now = heap_in_use(meter: &meter);
  if now -sat base != 0_u64 {
    return exit_status(code: 13_u8);
  }

  let zero_size = box_paged_new::<Array<u8, 0>>(capacity: 1_u64);
  let empty_element = array_filled::<u8, 0>(value: 0_u8);
  place_back(window: &zero_size.inner, value: move empty_element);
  grow_paged(cell: &zero_size, capacity: 3_u64);
  let now = heap_in_use(meter: &meter);
  if now -sat base != 33_u64 {
    return exit_status(code: 15_u8);
  }
  release_zero_pool(pool: move zero_size);
  let now = heap_in_use(meter: &meter);
  if now -sat base != 0_u64 {
    return exit_status(code: 16_u8);
  }

  let last_zero = box_paged_new::<u64>(capacity: 0_u64);
  release_pool(pool: move last_zero);
  let now = heap_in_use(meter: &meter);
  if now -sat base != 0_u64 {
    return exit_status(code: 17_u8);
  }

  let words = array_filled::<u64, 18>(value: 0_u64);
  set words[0_u64] = 0_u64;
  set words[1_u64] = 0_u64;
  set words[2_u64] = 0_u64;
  set words[3_u64] = 40_u64;
  set words[4_u64] = 48_u64;
  set words[5_u64] = 64_u64;
  set words[6_u64] = 64_u64;
  set words[7_u64] = 4128_u64;
  set words[8_u64] = 8232_u64;
  set words[9_u64] = 0_u64;
  set words[10_u64] = 64_u64;
  set words[11_u64] = 0_u64;
  set words[12_u64] = 33_u64;
  set words[13_u64] = 0_u64;
  set words[14_u64] = 3_u64;
  set words[15_u64] = 131401_u64;
  set words[16_u64] = 73_u64;
  set words[17_u64] = 19_u64;
  let out = slots_new::<u8, 144>();
  for (
    j in 0_u64..18_u64
  ) {
    let word = words[j];
    for (
      b in 0_u64..8_u64
    ) {
      let shift = b *wrap 8_u64;
      let amount = cvt.wrap::<u64, u32>(shift);
      let shifted = ishr(word, amount);
      let octet = cvt.wrap::<u64, u8>(shifted);
      place_back(window: &out, value: octet);
    }
  }
  let end = out.len;
  let view = &out[0_u64..end];
  let published = publish_all(factory: &factory, output: &output, source: view, length: end);
  match published {
    Ok(value: done) => {
      return exit_status(code: 0_u8);
    }
    Err(error: problem) => {
      return exit_status(code: 250_u8);
    }
  }
}

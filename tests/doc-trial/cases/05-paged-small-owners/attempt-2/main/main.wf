alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias IoError = std::io::IoError;
alias OutputStream = std::io::OutputStream;
alias HandleFactory = std::io::HandleFactory;
alias CancelWatch = std::time::CancelWatch;

fn write_u64_le(factory: &HandleFactory, output: &OutputStream, value: u64, cancel: &CancelWatch) -> r: Result<unit, IoError> writes(factory), writes(output) waits {
  let buffer = array_filled::<u8, 8>(value: 0_u8);
  set buffer[0_u64] = cvt.wrap::<u64, u8>(value);
  let shift8 = ishr(value, 8_u32);
  set buffer[1_u64] = cvt.wrap::<u64, u8>(shift8);
  let shift16 = ishr(value, 16_u32);
  set buffer[2_u64] = cvt.wrap::<u64, u8>(shift16);
  let shift24 = ishr(value, 24_u32);
  set buffer[3_u64] = cvt.wrap::<u64, u8>(shift24);
  let shift32 = ishr(value, 32_u32);
  set buffer[4_u64] = cvt.wrap::<u64, u8>(shift32);
  let shift40 = ishr(value, 40_u32);
  set buffer[5_u64] = cvt.wrap::<u64, u8>(shift40);
  let shift48 = ishr(value, 48_u32);
  set buffer[6_u64] = cvt.wrap::<u64, u8>(shift48);
  let shift56 = ishr(value, 56_u32);
  set buffer[7_u64] = cvt.wrap::<u64, u8>(shift56);
  let view = &buffer[0_u64..8_u64];
  let write_result = std::io::write_once(factory: factory, output: output, source: view, start: 0_u64, end: 8_u64, deadline: None::<std::time::Instant>(), cancel: cancel);
  match write_result {
    Ok(value: written) => {
      if written == 8_u64 {
        return Ok::<unit, IoError>(value: unit);
      }
      let err = IoError::WriteZero(code: 0_u32, origin: 0_u8);
      return Err::<unit, IoError>(error: err);
    }
    Err(error: e) => {
      return Err::<unit, IoError>(error: move e);
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: stdout_stream, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: meter) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  let close_write_result = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let close_read_result = std::fs::close_directory(factory: &factory, directory: move cwd_read);
  let never = std::time::cancel_never();
  let baseline = std::process::heap_in_use(meter: &meter);
  let pool1 = box_paged_new::<u64>(capacity: 0_u64);
  free_empty(window: move pool1);
  let after_zero_create = std::process::heap_in_use(meter: &meter);
  let m1 = after_zero_create - baseline;
  let pool2 = box_paged_new::<u64>(capacity: 0_u64);
  grow_paged(cell: &pool2, capacity: 0_u64);
  let after_zero_grow = std::process::heap_in_use(meter: &meter);
  let m2 = after_zero_grow - baseline;
  free_empty(window: move pool2);
  let pool3 = box_paged_new::<u64>(capacity: 0_u64);
  free_empty(window: move pool3);
  let after_sep_zero = std::process::heap_in_use(meter: &meter);
  let m3 = after_sep_zero - baseline;
  let pool = box_paged_new::<u64>(capacity: 1_u64);
  place_back(window: &pool.inner, value: 73_u64);
  let after_cap1 = std::process::heap_in_use(meter: &meter);
  let m4 = after_cap1 - baseline;
  grow_paged(cell: &pool, capacity: 2_u64);
  place_back(window: &pool.inner, value: 1_u64);
  let after_cap2 = std::process::heap_in_use(meter: &meter);
  let m5 = after_cap2 - baseline;
  grow_paged(cell: &pool, capacity: 3_u64);
  place_back(window: &pool.inner, value: 2_u64);
  let after_cap3 = std::process::heap_in_use(meter: &meter);
  let m6 = after_cap3 - baseline;
  grow_paged(cell: &pool, capacity: 4_u64);
  let after_cap4 = std::process::heap_in_use(meter: &meter);
  let m7 = after_cap4 - baseline;
  grow_paged(cell: &pool, capacity: 512_u64);
  for (i in 3_u64..512_u64) {
    place_back(window: &pool.inner, value: i);
  }
  let after_cap512 = std::process::heap_in_use(meter: &meter);
  let m8 = after_cap512 - baseline;
  grow_paged(cell: &pool, capacity: 513_u64);
  place_back(window: &pool.inner, value: 512_u64);
  let after_cap513 = std::process::heap_in_use(meter: &meter);
  let m9 = after_cap513 - baseline;
  let first_val = pool.inner[0_u64];
  let s = 0_u64;
  for (idx in 0_u64..513_u64) {
    set s = s +wrap pool.inner[idx];
  }
  free_empty(window: move pool);
  let after_release = std::process::heap_in_use(meter: &meter);
  let m10 = after_release - baseline;
  let pool_sep = box_paged_new::<u64>(capacity: 3_u64);
  place_back(window: &pool_sep.inner, value: 19_u64);
  let after_sep_cap3 = std::process::heap_in_use(meter: &meter);
  let m11 = after_sep_cap3 - baseline;
  let sep_val = pool_sep.inner[0_u64];
  free_empty(window: move pool_sep);
  let after_sep_release = std::process::heap_in_use(meter: &meter);
  let m12 = after_sep_release - baseline;
  let pool_zero = box_paged_new::<Array<u8, 0>>(capacity: 1_u64);
  place_back(window: &pool_zero.inner, value: array_filled::<u8, 0>(value: 0_u8));
  grow_paged(cell: &pool_zero, capacity: 3_u64);
  let after_zero_elem = std::process::heap_in_use(meter: &meter);
  let m13 = after_zero_elem - baseline;
  let logical_cap = pool_zero.inner.cap;
  free_empty(window: move pool_zero);
  let after_zero_elem_release = std::process::heap_in_use(meter: &meter);
  let m14 = after_zero_elem_release - baseline;
  let result_1 = write_u64_le(factory: &factory, output: &stdout_stream, value: m1, cancel: &never);
  let result_2 = write_u64_le(factory: &factory, output: &stdout_stream, value: m2, cancel: &never);
  let result_3 = write_u64_le(factory: &factory, output: &stdout_stream, value: m3, cancel: &never);
  let result_4 = write_u64_le(factory: &factory, output: &stdout_stream, value: m4, cancel: &never);
  let result_5 = write_u64_le(factory: &factory, output: &stdout_stream, value: m5, cancel: &never);
  let result_6 = write_u64_le(factory: &factory, output: &stdout_stream, value: m6, cancel: &never);
  let result_7 = write_u64_le(factory: &factory, output: &stdout_stream, value: m7, cancel: &never);
  let result_8 = write_u64_le(factory: &factory, output: &stdout_stream, value: m8, cancel: &never);
  let result_9 = write_u64_le(factory: &factory, output: &stdout_stream, value: m9, cancel: &never);
  let result_10 = write_u64_le(factory: &factory, output: &stdout_stream, value: m10, cancel: &never);
  let result_11 = write_u64_le(factory: &factory, output: &stdout_stream, value: m11, cancel: &never);
  let result_12 = write_u64_le(factory: &factory, output: &stdout_stream, value: m12, cancel: &never);
  let result_13 = write_u64_le(factory: &factory, output: &stdout_stream, value: m13, cancel: &never);
  let result_14 = write_u64_le(factory: &factory, output: &stdout_stream, value: m14, cancel: &never);
  let result_15 = write_u64_le(factory: &factory, output: &stdout_stream, value: logical_cap, cancel: &never);
  let result_16 = write_u64_le(factory: &factory, output: &stdout_stream, value: s, cancel: &never);
  let result_17 = write_u64_le(factory: &factory, output: &stdout_stream, value: first_val, cancel: &never);
  let result_18 = write_u64_le(factory: &factory, output: &stdout_stream, value: sep_val, cancel: &never);
  let close_watch = std::time::close_cancel_watch(watch: move never);
  return exit_status(code: 0_u8);
}

alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias MemoryMeter = std::process::MemoryMeter;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias write_once = std::io::write_once;

fn counted(meter: &MemoryMeter, before: u64, expected: u64, report: &[u8], report_at: u64) -> result: Bool writes(meter), writes(report) {
  doc "Trial adaptation: retain the baseline comparison and save its observed heap delta into a stack report before any host publication.";
  let held = std::process::heap_in_use(meter: meter);
  if held >= before {
    let bytes = held - before;
    let recorded_delta = spell(destination: report, at: report_at, value: bytes);
    if bytes == expected {
      return True();
    } else {
      return False();
    }
  } else {
    return False();
  }
}

fn small_owners(meter: &MemoryMeter, before: u64, report: &[u8]) -> result: u8 writes(meter), writes(report) {
  doc "Trial adaptation: retain Paged growth, ownership and exact heap checks; collect deltas, actual capacity and actual retained data before publication.";
  let p = box_paged_new::<u64>(capacity: 0_u64);
  let empty = counted(meter: meter, before: before, expected: 0_u64, report: report, report_at: 0_u64);
  if bnot(empty) {
    return 1_u8;
  }
  grow_paged(cell: &p, capacity: 0_u64);
  let kept = counted(meter: meter, before: before, expected: 0_u64, report: report, report_at: 8_u64);
  if bnot(kept) {
    return 2_u8;
  }
  let empty_owner = box_paged_new::<u64>(capacity: 0_u64);
  release::<Box<Paged<u64>>>(value: move empty_owner);
  let empty_released = counted(meter: meter, before: before, expected: 0_u64, report: report, report_at: 16_u64);
  if bnot(empty_released) {
    return 17_u8;
  }
  grow_paged(cell: &p, capacity: 1_u64);
  place_back(window: &p.inner, value: 73_u64);
  let one = counted(meter: meter, before: before, expected: 40_u64, report: report, report_at: 24_u64);
  if bnot(one) {
    return 3_u8;
  }
  grow_paged(cell: &p, capacity: 2_u64);
  place_back(window: &p.inner, value: 1_u64);
  let two = counted(meter: meter, before: before, expected: 48_u64, report: report, report_at: 32_u64);
  if bnot(two) {
    return 4_u8;
  }
  grow_paged(cell: &p, capacity: 3_u64);
  place_back(window: &p.inner, value: 2_u64);
  let rounded = counted(meter: meter, before: before, expected: 64_u64, report: report, report_at: 40_u64);
  if bnot(rounded) {
    return 5_u8;
  }
  if p.inner.cap != 3_u64 {
    return 6_u8;
  }
  let observed_capacity = p.inner.cap;
  let recorded_capacity = spell(destination: report, at: 112_u64, value: observed_capacity);
  grow_paged(cell: &p, capacity: 4_u64);
  let same_page = counted(meter: meter, before: before, expected: 64_u64, report: report, report_at: 48_u64);
  if bnot(same_page) {
    return 14_u8;
  }
  grow_paged(cell: &p, capacity: 512_u64);
  for (
    i in 3_u64..512_u64,
    invariant length: p.inner.len == i
  ) {
    place_back(window: &p.inner, value: i);
  }
  let full = counted(meter: meter, before: before, expected: 4128_u64, report: report, report_at: 56_u64);
  if bnot(full) {
    return 7_u8;
  }
  grow_paged(cell: &p, capacity: 513_u64);
  place_back(window: &p.inner, value: 512_u64);
  let second_page = counted(meter: meter, before: before, expected: 8232_u64, report: report, report_at: 64_u64);
  if bnot(second_page) {
    return 8_u8;
  }
  if p.inner[0_u64] != 73_u64 {
    return 9_u8;
  }
  let first_value = p.inner[0_u64];
  let retained_sum = first_value;
  for (i in 1_u64..513_u64) {
    let retained_value = p.inner[i];
    set retained_sum = retained_sum +wrap retained_value;
    if p.inner[i] != i {
      return 10_u8;
    }
  }
  let recorded_sum = spell(destination: report, at: 120_u64, value: retained_sum);
  let recorded_first = spell(destination: report, at: 128_u64, value: first_value);
  release::<Box<Paged<u64>>>(value: move p);
  let released = counted(meter: meter, before: before, expected: 0_u64, report: report, report_at: 72_u64);
  if bnot(released) {
    return 11_u8;
  }
  let small = box_paged_new::<u64>(capacity: 3_u64);
  place_back(window: &small.inner, value: 19_u64);
  let constructed = counted(meter: meter, before: before, expected: 64_u64, report: report, report_at: 80_u64);
  if bnot(constructed) {
    return 12_u8;
  }
  let small_value = small.inner[0_u64];
  let recorded_small = spell(destination: report, at: 136_u64, value: small_value);
  release::<Box<Paged<u64>>>(value: move small);
  let small_released = counted(meter: meter, before: before, expected: 0_u64, report: report, report_at: 88_u64);
  if bnot(small_released) {
    return 13_u8;
  }
  let zero_stride = box_paged_new::<Array<u8, 0>>(capacity: 1_u64);
  let value = array_filled::<u8, 0>(value: 0_u8);
  place_back(window: &zero_stride.inner, value: value);
  grow_paged(cell: &zero_stride, capacity: 3_u64);
  let zero_stride_held = counted(meter: meter, before: before, expected: 33_u64, report: report, report_at: 96_u64);
  if bnot(zero_stride_held) {
    return 15_u8;
  }
  release::<Box<Paged<Array<u8, 0>>>>(value: move zero_stride);
  let zero_stride_released = counted(meter: meter, before: before, expected: 0_u64, report: report, report_at: 104_u64);
  if bnot(zero_stride_released) {
    return 16_u8;
  }
  return 0_u8;
}

fn low_byte(v: u64) -> result: u8 pure {
  let low = iand(v, 255_u64);
  let byte = cvt::<u64, u8>(low);
  return byte;
}

fn spell(destination: &[u8], at: u64, value: u64) -> result: u64 writes(destination) {
  doc "Writes the eight little-endian bytes of value at the given offset, skipping any slot the range does not have.";
  let cursor = at;
  let rest = value;
  loop @octets {
    let limit = at +wrap 8_u64;
    let done = cursor >= limit;
    if done {
      break @octets;
    }
    let spare = destination^.len;
    let writable = cursor < spare;
    if writable {
      let byte = low_byte(v: rest);
      set destination^[cursor] = byte;
    }
    set rest = irotr(rest, 8_u32);
    set cursor = cursor +wrap 1_u64;
  }
  return at +wrap 8_u64;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  doc "Publishes one prefix of the source range, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let wait_cancel_1 = std::time::cancel_never();
    let wait_outcome_1 = write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &wait_cancel_1);
    std::time::close_cancel_watch(watch: move wait_cancel_1);
    match wait_outcome_1 {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn publish_report(factory: &HandleFactory, output: &OutputStream, source: &[u8]) -> status: ExitStatus reads(source), writes(factory), writes(output) waits {
  doc "Trial adaptation: publish the actual observations with the maintained stdin_echo partial-write retry; status 250 reports publication failure.";
  let length = source^.len;
  match publish_all(factory: factory, output: output, source: source, length: length) {
    Ok(value: published) => {
      return exit_status(code: 0_u8);
    }
    Err(error: problem) => {
      return exit_status(code: 250_u8);
    }
  }
}

fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  doc "Trial adaptation: keep the stack report outside the measured heap and publish it only after every owner has been released.";
  let std::process::Inputs(args: unused_args, drivers: unused_driver_count, cwd: directory, stdout: out, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: meter) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let report = slots_new::<u8, 144>();
  for (
    at in 0_u64..144_u64,
    invariant grown: report.len == at
  ) {
    place_back(window: &report, value: 0_u8);
  }
  let report_window = &report[0_u64..144_u64];
  let before = std::process::heap_in_use(meter: &meter);
  let code = small_owners(meter: &meter, before: before, report: report_window);
  if code != 0_u8 {
    return std::process::exit_status(code: code);
  }
  return publish_report(factory: &factory, output: &out, source: report_window);
}

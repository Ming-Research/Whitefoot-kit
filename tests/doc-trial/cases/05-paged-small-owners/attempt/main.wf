alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let cwd_dir = inputs.cwd;
  let factory = inputs.handles;
  let meter = inputs.memory_meter;
  let std::fs::Directory(read: rd, write: wr) = move cwd_dir;
  std::fs::close_directory_write(factory: &factory, directory: move wr);
  std::fs::close_directory(factory: &factory, directory: move rd);
  let baseline = std::process::heap_in_use(meter: &meter);
  let pool = box_paged_new::<u64>(capacity: 1_u64);
  place_back(window: &pool.inner, value: 73_u64);
  let heap1 = std::process::heap_in_use(meter: &meter);
  let first = pool.inner[0_u64];
  free_empty(window: move pool);
  return std::process::exit_status(code: 0_u8);
}

alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias Instant = std::time::Instant;
alias write_once = std::io::write_once;

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: output, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: meter) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  let write_closed = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let read_closed = std::fs::close_directory(factory: &factory, directory: move cwd);
  let baseline = std::process::heap_in_use(meter: &meter);
  let cancel = std::time::cancel_never();
  let buffer = array_filled::<u8, 144>(value: 0_u8);
  let offset = 0_u64;
  let pool_zero = box_paged_new::<u64>(capacity: 0_u64);
  let diff_zero = 0_u64;
  let offset = write_u64(buffer: &buffer[0_u64..144_u64], offset: offset, value: diff_zero);
  grow_paged(cell: &pool_zero, capacity: 0_u64);
  let diff_grow_zero = 0_u64;
  let offset = write_u64(buffer: &buffer[0_u64..144_u64], offset: offset, value: diff_grow_zero);
  let release_pool_zero_result = release(value: move pool_zero);
  let pool_separate_zero = box_paged_new::<u64>(capacity: 0_u64);
  let release_pool_separate_zero_result = release(value: move pool_separate_zero);
  let diff_after_separate_zero = 0_u64;
  let offset = write_u64(buffer: &buffer[0_u64..144_u64], offset: offset, value: diff_after_separate_zero);
  let pool_one = box_paged_new::<u64>(capacity: 1_u64);
  place_back(window: &pool_one.inner, value: 73_u64);
  let heap_one = std::process::heap_in_use(meter: &meter);
  let diff_one = heap_one - baseline;
  let offset = write_u64(buffer: &buffer[0_u64..144_u64], offset: offset, value: diff_one);
  let pool_two = box_paged_new::<u64>(capacity: 2_u64);
  place_back(window: &pool_two.inner, value: 73_u64);
  place_back(window: &pool_two.inner, value: 1_u64);
  let heap_two = std::process::heap_in_use(meter: &meter);
  let diff_two = heap_two - baseline;
  let offset = write_u64(buffer: &buffer[0_u64..144_u64], offset: offset, value: diff_two);
  let pool_three = box_paged_new::<u64>(capacity: 3_u64);
  place_back(window: &pool_three.inner, value: 73_u64);
  place_back(window: &pool_three.inner, value: 1_u64);
  place_back(window: &pool_three.inner, value: 2_u64);
  let heap_three = std::process::heap_in_use(meter: &meter);
  let diff_three = heap_three - baseline;
  let offset = write_u64(buffer: &buffer[0_u64..144_u64], offset: offset, value: diff_three);
  let pool_four = box_paged_new::<u64>(capacity: 4_u64);
  let heap_four = std::process::heap_in_use(meter: &meter);
  let diff_four = heap_four - baseline;
  let offset = write_u64(buffer: &buffer[0_u64..144_u64], offset: offset, value: diff_four);
  let release_pool_one_result = release(value: move pool_one);
  let release_pool_two_result = release(value: move pool_two);
  let release_pool_three_result = release(value: move pool_three);
  let release_pool_four_result = release(value: move pool_four);
  let pool_large = box_paged_new::<u64>(capacity: 512_u64);
  place_back(window: &pool_large.inner, value: 73_u64);
  let i = 1_u64;
  loop @fill_large {
    if i >= 512_u64 {
      break @fill_large;
    }
    place_back(window: &pool_large.inner, value: i);
    set i = i +wrap 1_u64;
  }
  let heap_large = std::process::heap_in_use(meter: &meter);
  let diff_large = heap_large - baseline;
  let offset = write_u64(buffer: &buffer[0_u64..144_u64], offset: offset, value: diff_large);
  grow_paged(cell: &pool_large, capacity: 513_u64);
  place_back(window: &pool_large.inner, value: 512_u64);
  let heap_large_grown = std::process::heap_in_use(meter: &meter);
  let diff_large_grown = heap_large_grown - baseline;
  let offset = write_u64(buffer: &buffer[0_u64..144_u64], offset: offset, value: diff_large_grown);
  let release_pool_large_result = release(value: move pool_large);
  let heap_after_large = std::process::heap_in_use(meter: &meter);
  let diff_after_large = heap_after_large - baseline;
  let offset = write_u64(buffer: &buffer[0_u64..144_u64], offset: offset, value: diff_after_large);
  let pool_three_sep = box_paged_new::<u64>(capacity: 3_u64);
  place_back(window: &pool_three_sep.inner, value: 19_u64);
  let heap_three_sep = std::process::heap_in_use(meter: &meter);
  let diff_three_sep = heap_three_sep - baseline;
  let offset = write_u64(buffer: &buffer[0_u64..144_u64], offset: offset, value: diff_three_sep);
  let release_pool_three_sep_result = release(value: move pool_three_sep);
  let heap_after_three_sep = std::process::heap_in_use(meter: &meter);
  let diff_after_three_sep = heap_after_three_sep - baseline;
  let offset = write_u64(buffer: &buffer[0_u64..144_u64], offset: offset, value: diff_after_three_sep);
  let pool_zero_elem = box_paged_new::<Array<u8, 0>>(capacity: 1_u64);
  let zero_elem_value = array_filled::<u8, 0>(value: 0_u8);
  place_back(window: &pool_zero_elem.inner, value: move zero_elem_value);
  grow_paged(cell: &pool_zero_elem, capacity: 3_u64);
  let observed_capacity = pool_zero_elem.inner.cap;
  let heap_zero_elem_final = std::process::heap_in_use(meter: &meter);
  let diff_zero_elem_final = heap_zero_elem_final - baseline;
  let offset = write_u64(buffer: &buffer[0_u64..144_u64], offset: offset, value: observed_capacity);
  let sum = 73_u64 +wrap 1_u64 +wrap 2_u64;
  let k = 3_u64;
  loop @fill_sum {
    if k >= 513_u64 {
      break @fill_sum;
    }
    set sum = sum +wrap k;
    set k = k +wrap 1_u64;
  }
  let offset = write_u64(buffer: &buffer[0_u64..144_u64], offset: offset, value: sum);
  let offset = write_u64(buffer: &buffer[0_u64..144_u64], offset: offset, value: 73_u64);
  let offset = write_u64(buffer: &buffer[0_u64..144_u64], offset: offset, value: 19_u64);
  let offset = write_u64(buffer: &buffer[0_u64..144_u64], offset: offset, value: diff_zero_elem_final);
  let release_pool_zero_elem_result = release(value: move pool_zero_elem);
  let heap_after_zero_elem = std::process::heap_in_use(meter: &meter);
  let diff_after_zero_elem = heap_after_zero_elem - baseline;
  let offset = write_u64(buffer: &buffer[0_u64..144_u64], offset: offset, value: diff_after_zero_elem);
  let output_result = write_once(factory: &factory, output: &output, source: &buffer[0_u64..144_u64], start: 0_u64, end: 144_u64, deadline: None<Instant>(), cancel: &cancel);
  let close_cancel_result = std::time::close_cancel_watch(watch: move cancel);
  match move output_result {
    Ok(value: written) => {
      return exit_status(code: 0_u8);
    }
    Err(error: io_error) => {
      return exit_status(code: 250_u8);
    }
  }
}

fn write_u64(buffer: &[u8], offset: u64, value: u64) -> next: u64 writes(buffer) {
  let b0 = cvt::<u64, u8>(value);
  let b1 = cvt::<u64, u8>(ishr(value, 8_u32));
  let b2 = cvt::<u64, u8>(ishr(value, 16_u32));
  let b3 = cvt::<u64, u8>(ishr(value, 24_u32));
  let b4 = cvt::<u64, u8>(ishr(value, 32_u32));
  let b5 = cvt::<u64, u8>(ishr(value, 40_u32));
  let b6 = cvt::<u64, u8>(ishr(value, 48_u32));
  let b7 = cvt::<u64, u8>(ishr(value, 56_u32));
  set buffer^[offset] = b0;
  set buffer^[offset +wrap 1_u64] = b1;
  set buffer^[offset +wrap 2_u64] = b2;
  set buffer^[offset +wrap 3_u64] = b3;
  set buffer^[offset +wrap 4_u64] = b4;
  set buffer^[offset +wrap 5_u64] = b5;
  set buffer^[offset +wrap 6_u64] = b6;
  set buffer^[offset +wrap 7_u64] = b7;
  return offset +wrap 8_u64;
}

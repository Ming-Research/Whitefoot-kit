alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias heap_in_use = std::process::heap_in_use;
alias IoError = std::io::IoError;
alias OutputStream = std::io::OutputStream;
alias HandleFactory = std::io::HandleFactory;

fn write_le_u64(factory: &HandleFactory, output: &OutputStream, value: u64) -> result: Result<unit, IoError> writes(factory), writes(output) waits {
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  let b0 = iand(value, 255_u64);
  set bytes[0_u64] = cvt.wrap::<u64, u8>(b0);
  let s1 = ishr(value, 8_u32);
  let b1 = iand(s1, 255_u64);
  set bytes[1_u64] = cvt.wrap::<u64, u8>(b1);
  let s2 = ishr(value, 16_u32);
  let b2 = iand(s2, 255_u64);
  set bytes[2_u64] = cvt.wrap::<u64, u8>(b2);
  let s3 = ishr(value, 24_u32);
  let b3 = iand(s3, 255_u64);
  set bytes[3_u64] = cvt.wrap::<u64, u8>(b3);
  let s4 = ishr(value, 32_u32);
  let b4 = iand(s4, 255_u64);
  set bytes[4_u64] = cvt.wrap::<u64, u8>(b4);
  let s5 = ishr(value, 40_u32);
  let b5 = iand(s5, 255_u64);
  set bytes[5_u64] = cvt.wrap::<u64, u8>(b5);
  let s6 = ishr(value, 48_u32);
  let b6 = iand(s6, 255_u64);
  set bytes[6_u64] = cvt.wrap::<u64, u8>(b6);
  let s7 = ishr(value, 56_u32);
  let b7 = iand(s7, 255_u64);
  set bytes[7_u64] = cvt.wrap::<u64, u8>(b7);
  let view = &bytes[0_u64..8_u64];
  let no_deadline = None<std::time::Instant>();
  let cancel = std::time::cancel_never();
  let outcome = std::io::write_once(factory: factory, output: output, source: view, start: 0_u64, end: 8_u64, deadline: no_deadline, cancel: &cancel);
  std::time::close_cancel_watch(watch: move cancel);
  match outcome {
    Ok(value: next) => {
      if next == 8_u64 {
        return Ok<unit, IoError>(value: unit);
      }
      let error = IoError::UnexpectedEnd(code: 0_u32, origin: 0_u8);
      return Err<unit, IoError>(error: error);
    }
    Err(error: problem) => {
      return Err<unit, IoError>(error: problem);
    }
  }
}

fn sum_range(run: &Run<u64>) -> result: u64 reads(run) {
  let sum = 0_u64;
  for (i in 0_u64..run^.len) {
    set sum = sum +wrap run^[i];
  }
  return sum;
}

fn measure_after_release(pool: Box<Paged<u64>>, meter: &std::process::MemoryMeter) -> result: u64 writes(meter) {
  return std::process::heap_in_use(meter: meter);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: directory, stdout: output, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: meter) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let baseline = heap_in_use(meter: &meter);
  let result_code = 0_u8;
  let results = slots_new::<u64, 18>();
  let pool = box_paged_new::<u64>(capacity: 0_u64);
  let diff = 0_u64;
  let heap_after_zero = heap_in_use(meter: &meter);
  if heap_after_zero >= baseline {
    set diff = heap_after_zero - baseline;
  }
  place_back(window: &results, value: diff);
  grow_paged(cell: &pool, capacity: 0_u64);
  let heap_after_zero_grow = heap_in_use(meter: &meter);
  let diff_zero_grow = 0_u64;
  if heap_after_zero_grow >= baseline {
    set diff_zero_grow = heap_after_zero_grow - baseline;
  }
  place_back(window: &results, value: diff_zero_grow);
  let other_pool = box_paged_new::<u64>(capacity: 0_u64);
  free_empty(window: move other_pool);
  let heap_after_other_zero = heap_in_use(meter: &meter);
  let diff_other_zero = 0_u64;
  if heap_after_other_zero >= baseline {
    set diff_other_zero = heap_after_other_zero - baseline;
  }
  place_back(window: &results, value: diff_other_zero);
  grow_paged(cell: &pool, capacity: 1_u64);
  if pool.inner.len < pool.inner.cap {
    place_back(window: &pool.inner, value: 73_u64);
  } else {
    set result_code = 3_u8;
    return exit_status(code: result_code);
  }
  let heap_at_cap_1 = heap_in_use(meter: &meter);
  let diff_cap_1 = 0_u64;
  if heap_at_cap_1 >= baseline {
    set diff_cap_1 = heap_at_cap_1 - baseline;
  }
  place_back(window: &results, value: diff_cap_1);
  grow_paged(cell: &pool, capacity: 2_u64);
  if pool.inner.len < pool.inner.cap {
    place_back(window: &pool.inner, value: 1_u64);
  } else {
    set result_code = 4_u8;
    return exit_status(code: result_code);
  }
  let heap_at_cap_2 = heap_in_use(meter: &meter);
  let diff_cap_2 = 0_u64;
  if heap_at_cap_2 >= baseline {
    set diff_cap_2 = heap_at_cap_2 - baseline;
  }
  place_back(window: &results, value: diff_cap_2);
  grow_paged(cell: &pool, capacity: 3_u64);
  if pool.inner.len < pool.inner.cap {
    place_back(window: &pool.inner, value: 2_u64);
  } else {
    set result_code = 5_u8;
    return exit_status(code: result_code);
  }
  let heap_at_cap_3 = heap_in_use(meter: &meter);
  let diff_cap_3 = 0_u64;
  if heap_at_cap_3 >= baseline {
    set diff_cap_3 = heap_at_cap_3 - baseline;
  }
  place_back(window: &results, value: diff_cap_3);
  grow_paged(cell: &pool, capacity: 4_u64);
  let heap_at_cap_4 = heap_in_use(meter: &meter);
  let diff_cap_4 = 0_u64;
  if heap_at_cap_4 >= baseline {
    set diff_cap_4 = heap_at_cap_4 - baseline;
  }
  place_back(window: &results, value: diff_cap_4);
  grow_paged(cell: &pool, capacity: 512_u64);
  for (i in 3_u64..512_u64) {
    if pool.inner.len < pool.inner.cap {
      place_back(window: &pool.inner, value: i);
    } else {
      set result_code = 7_u8;
      return exit_status(code: result_code);
    }
  }
  let heap_at_cap_512 = heap_in_use(meter: &meter);
  let diff_cap_512 = 0_u64;
  if heap_at_cap_512 >= baseline {
    set diff_cap_512 = heap_at_cap_512 - baseline;
  }
  place_back(window: &results, value: diff_cap_512);
  grow_paged(cell: &pool, capacity: 513_u64);
  if pool.inner.len < pool.inner.cap {
    place_back(window: &pool.inner, value: 512_u64);
  } else {
    set result_code = 8_u8;
    return exit_status(code: result_code);
  }
  let heap_at_cap_513 = heap_in_use(meter: &meter);
  let diff_cap_513 = 0_u64;
  if heap_at_cap_513 >= baseline {
    set diff_cap_513 = heap_at_cap_513 - baseline;
  }
  place_back(window: &results, value: diff_cap_513);
  let run = &pool.inner[0_u64..pool.inner.len];
  let first_val = run^[0_u64];
  if first_val != 73_u64 {
    set result_code = 9_u8;
    return exit_status(code: result_code);
  }
  let pool_len = pool.inner.len;
  let last_idx = pool_len - 1_u64;
  let last_val = run^[last_idx];
  if last_val != 512_u64 {
    set result_code = 10_u8;
    return exit_status(code: result_code);
  }
  let sum_before_release = sum_range(run: run);
  if sum_before_release != 131401_u64 {
    set result_code = 16_u8;
    return exit_status(code: result_code);
  }
  let heap_after_release = measure_after_release(pool: move pool, meter: &meter);
  let diff_after_release = 0_u64;
  if heap_after_release >= baseline {
    set diff_after_release = heap_after_release - baseline;
  }
  place_back(window: &results, value: diff_after_release);
  let heap_at_sep = 0_u64;
  let diff_sep = 0_u64;
  let sep_val = 0_u64;
  if True() {
    let pool_sep = box_paged_new::<u64>(capacity: 3_u64);
    if pool_sep.inner.len < pool_sep.inner.cap {
      place_back(window: &pool_sep.inner, value: 19_u64);
    } else {
      set result_code = 12_u8;
      return exit_status(code: result_code);
    }
    set sep_val = pool_sep.inner[0_u64];
    if sep_val != 19_u64 {
      set result_code = 12_u8;
      return exit_status(code: result_code);
    }
    set heap_at_sep = heap_in_use(meter: &meter);
    if heap_at_sep >= baseline {
      set diff_sep = heap_at_sep - baseline;
    }
  }
  place_back(window: &results, value: diff_sep);
  let heap_after_sep_release = heap_in_use(meter: &meter);
  let diff_after_sep_release = 0_u64;
  if heap_after_sep_release >= baseline {
    set diff_after_sep_release = heap_after_sep_release - baseline;
  }
  place_back(window: &results, value: diff_after_sep_release);
  let heap_at_zero_elem = 0_u64;
  let diff_zero_elem = 0_u64;
  if True() {
    let pool_zero = box_paged_new::<Array<u8, 0>>(capacity: 1_u64);
    let zero_elem = array_filled::<u8, 0>(value: 0_u8);
    if pool_zero.inner.len < pool_zero.inner.cap {
      place_back(window: &pool_zero.inner, value: zero_elem);
    } else {
      set result_code = 15_u8;
      return exit_status(code: result_code);
    }
    grow_paged(cell: &pool_zero, capacity: 3_u64);
    set heap_at_zero_elem = heap_in_use(meter: &meter);
    if heap_at_zero_elem >= baseline {
      set diff_zero_elem = heap_at_zero_elem - baseline;
    }
  }
  place_back(window: &results, value: diff_zero_elem);
  let heap_after_zero_release = heap_in_use(meter: &meter);
  let diff_after_zero_release = 0_u64;
  if heap_after_zero_release >= baseline {
    set diff_after_zero_release = heap_after_zero_release - baseline;
  }
  place_back(window: &results, value: diff_after_zero_release);
  let capacity_after_grow = 3_u64;
  if pool_zero.inner.cap < 3_u64 {
    set result_code = 6_u8;
    return exit_status(code: result_code);
  }
  place_back(window: &results, value: capacity_after_grow);
  place_back(window: &results, value: sum_before_release);
  place_back(window: &results, value: 73_u64);
  place_back(window: &results, value: 19_u64);
  let i = 0_u64;
  loop {
    if i < results.len {
      let val = results[i];
      let write_result = write_le_u64(factory: &factory, output: &output, value: val);
      match write_result {
        Ok(value: unused) => {
        }
        Err(error: unused) => {
          set result_code = 250_u8;
          return exit_status(code: result_code);
        }
      }
      set i = i + 1_u64;
    } else {
      break;
    }
  }
  return exit_status(code: result_code);
}

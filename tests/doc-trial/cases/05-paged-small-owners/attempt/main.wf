alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias MemoryMeter = std::process::MemoryMeter;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias Directory = std::fs::Directory;

fn heap_delta(meter: &MemoryMeter, baseline: u64) -> result: u64 writes(meter) {
  let current = std::process::heap_in_use(meter: meter);
  return current -sat baseline;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: program_args, drivers: driver_count, cwd: cwd_directory, stdout: stdout_stream, stderr: stderr_stream, handles: factory, stdin: stdin_stream, clock: program_clock, wall_clock: program_wall_clock, stops: program_stops, memory_meter: meter) = move inputs;
  let Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  let write_closed = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let read_closed = std::fs::close_directory(factory: &factory, directory: move cwd_read);
  let startup_code = 0_u8;
  match write_closed {
    Ok(value: unused_write_closed) => {
    }
    Err(error: unused_write_error) => {
      set startup_code = 18_u8;
    }
  }
  match read_closed {
    Ok(value: unused_read_closed) => {
    }
    Err(error: unused_read_error) => {
      set startup_code = 18_u8;
    }
  }
  if startup_code != 0_u8 {
    return std::process::exit_status(code: startup_code);
  }
  let baseline = std::process::heap_in_use(meter: &meter);
  let initial_zero = box_paged_new::<u64>(capacity: 0_u64);
  let zero_initial = heap_delta(meter: &meter, baseline: baseline);
  if zero_initial != 0_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  grow_paged(cell: &initial_zero, capacity: 0_u64);
  let zero_grown = heap_delta(meter: &meter, baseline: baseline);
  if zero_grown != 0_u64 {
    return std::process::exit_status(code: 2_u8);
  }
  release::<Box<Paged<u64>>>(value: move initial_zero);
  let separate_zero = box_paged_new::<u64>(capacity: 0_u64);
  release::<Box<Paged<u64>>>(value: move separate_zero);
  let zero_separate = heap_delta(meter: &meter, baseline: baseline);
  if zero_separate != 0_u64 {
    return std::process::exit_status(code: 17_u8);
  }
  let pool = box_paged_new::<u64>(capacity: 1_u64);
  place_back(window: &pool.inner, value: 73_u64);
  let one = heap_delta(meter: &meter, baseline: baseline);
  if one != 40_u64 {
    return std::process::exit_status(code: 3_u8);
  }
  grow_paged(cell: &pool, capacity: 2_u64);
  place_back(window: &pool.inner, value: 1_u64);
  let two = heap_delta(meter: &meter, baseline: baseline);
  if two != 48_u64 {
    return std::process::exit_status(code: 4_u8);
  }
  grow_paged(cell: &pool, capacity: 3_u64);
  let capacity_three = pool.inner.cap;
  if capacity_three != 3_u64 {
    return std::process::exit_status(code: 6_u8);
  }
  place_back(window: &pool.inner, value: 2_u64);
  let three = heap_delta(meter: &meter, baseline: baseline);
  if three != 64_u64 {
    return std::process::exit_status(code: 5_u8);
  }
  grow_paged(cell: &pool, capacity: 4_u64);
  let four = heap_delta(meter: &meter, baseline: baseline);
  if four != 64_u64 {
    return std::process::exit_status(code: 14_u8);
  }
  grow_paged(cell: &pool, capacity: 512_u64);
  for (i in 3_u64..512_u64) {
    if pool.inner.len < pool.inner.cap {
      place_back(window: &pool.inner, value: i);
    } else {
      return std::process::exit_status(code: 7_u8);
    }
  }
  let wide = heap_delta(meter: &meter, baseline: baseline);
  if wide != 4128_u64 {
    return std::process::exit_status(code: 7_u8);
  }
  grow_paged(cell: &pool, capacity: 513_u64);
  place_back(window: &pool.inner, value: 512_u64);
  let wider = heap_delta(meter: &meter, baseline: baseline);
  if wider != 8232_u64 {
    return std::process::exit_status(code: 8_u8);
  }
  let run = &pool.inner[0_u64..pool.inner.len];
  let length = run^.len;
  if length != 513_u64 {
    return std::process::exit_status(code: 10_u8);
  }
  let first = run^[0_u64];
  if first != 73_u64 {
    return std::process::exit_status(code: 9_u8);
  }
  let sum = first;
  for (k in 1_u64..length) {
    let value = run^[k];
    if value != k {
      return std::process::exit_status(code: 10_u8);
    }
    set sum = sum +wrap value;
  }
  release::<Box<Paged<u64>>>(value: move pool);
  let released_wide = heap_delta(meter: &meter, baseline: baseline);
  if released_wide != 0_u64 {
    return std::process::exit_status(code: 11_u8);
  }
  let separate = box_paged_new::<u64>(capacity: 3_u64);
  place_back(window: &separate.inner, value: 19_u64);
  let separate_three = heap_delta(meter: &meter, baseline: baseline);
  if separate_three != 64_u64 {
    return std::process::exit_status(code: 12_u8);
  }
  if separate.inner.len != 1_u64 {
    return std::process::exit_status(code: 12_u8);
  }
  let separate_run = &separate.inner[0_u64..separate.inner.len];
  let separate_value = separate_run^[0_u64];
  if separate_value != 19_u64 {
    return std::process::exit_status(code: 12_u8);
  }
  release::<Box<Paged<u64>>>(value: move separate);
  let released_separate = heap_delta(meter: &meter, baseline: baseline);
  if released_separate != 0_u64 {
    return std::process::exit_status(code: 13_u8);
  }
  let zero_element = array_filled::<u8, 0>(value: 0_u8);
  let sized = box_paged_new::<Array<u8, 0>>(capacity: 1_u64);
  place_back(window: &sized.inner, value: zero_element);
  grow_paged(cell: &sized, capacity: 3_u64);
  let sized_three = heap_delta(meter: &meter, baseline: baseline);
  if sized_three != 33_u64 {
    return std::process::exit_status(code: 15_u8);
  }
  release::<Box<Paged<Array<u8, 0>>>>(value: move sized);
  let released_sized = heap_delta(meter: &meter, baseline: baseline);
  if released_sized != 0_u64 {
    return std::process::exit_status(code: 16_u8);
  }
  let values = array_filled::<u64, 18>(value: 0_u64);
  set values[0_u64] = zero_initial;
  set values[1_u64] = zero_grown;
  set values[2_u64] = zero_separate;
  set values[3_u64] = one;
  set values[4_u64] = two;
  set values[5_u64] = three;
  set values[6_u64] = four;
  set values[7_u64] = wide;
  set values[8_u64] = wider;
  set values[9_u64] = released_wide;
  set values[10_u64] = separate_three;
  set values[11_u64] = released_separate;
  set values[12_u64] = sized_three;
  set values[13_u64] = released_sized;
  set values[14_u64] = capacity_three;
  set values[15_u64] = sum;
  set values[16_u64] = first;
  set values[17_u64] = separate_value;
  let output_bytes = array_filled::<u8, 144>(value: 0_u8);
  for (w in 0_u64..18_u64) {
    let word = values[w];
    let base = w * 8_u64;
    for (j in 0_u64..8_u64) {
      let low = cvt.wrap::<u64, u8>(word);
      let at = base + j;
      set output_bytes[at] = low;
      set word = ishr(word, 8_u32);
    }
  }
  let published = publish_all(factory: &factory, output: &stdout_stream, source: &output_bytes[0_u64..144_u64], length: 144_u64);
  match published {
    Ok(value: unused_published) => {
    }
    Err(error: unused_publish_error) => {
      return std::process::exit_status(code: 250_u8);
    }
  }
  return std::process::exit_status(code: 0_u8);
}

alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias Instant = std::time::Instant;

fn write_u64_le(factory: &HandleFactory, output: &OutputStream, value: u64) -> result: Result<unit, IoError> writes(factory), writes(output) waits {
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  set bytes[0_u64] = cvt.wrap::<u64, u8>(value);
  let sh1 = ishr(value, 8_u32);
  set bytes[1_u64] = cvt.wrap::<u64, u8>(sh1);
  let sh2 = ishr(value, 16_u32);
  set bytes[2_u64] = cvt.wrap::<u64, u8>(sh2);
  let sh3 = ishr(value, 24_u32);
  set bytes[3_u64] = cvt.wrap::<u64, u8>(sh3);
  let sh4 = ishr(value, 32_u32);
  set bytes[4_u64] = cvt.wrap::<u64, u8>(sh4);
  let sh5 = ishr(value, 40_u32);
  set bytes[5_u64] = cvt.wrap::<u64, u8>(sh5);
  let sh6 = ishr(value, 48_u32);
  set bytes[6_u64] = cvt.wrap::<u64, u8>(sh6);
  let sh7 = ishr(value, 56_u32);
  set bytes[7_u64] = cvt.wrap::<u64, u8>(sh7);
  let buffer = &bytes[0_u64..8_u64];
  let no_deadline = None<Instant>();
  let cancel = std::time::cancel_never();
  let result = std::io::write_once(factory: factory, output: output, source: buffer, start: 0_u64, end: 8_u64, deadline: no_deadline, cancel: &cancel);
  std::time::close_cancel_watch(watch: move cancel);
  match result {
    Ok(value: next) => {
      if next == 8_u64 {
        return Ok<unit, IoError>(value: unit);
      }
      let error = IoError::WriteZero(code: 0_u32, origin: 0_u8);
      return Err<unit, IoError>(error: error);
    }
    Err(error: e) => {
      return Err<unit, IoError>(error: e);
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: directory, stdout: output, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: meter) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let baseline = std::process::heap_in_use(meter: &meter);
  let pool0 = box_paged_new::<u64>(capacity: 0_u64);
  let heap0 = std::process::heap_in_use(meter: &meter);
  let diff0 = heap0 - baseline;
  free_empty(window: move pool0);
  let pool0b = box_paged_new::<u64>(capacity: 0_u64);
  grow_paged(cell: &pool0b, capacity: 0_u64);
  let heap0b = std::process::heap_in_use(meter: &meter);
  let diff0b = heap0b - baseline;
  free_empty(window: move pool0b);
  let pool0c = box_paged_new::<u64>(capacity: 0_u64);
  let heap0c = std::process::heap_in_use(meter: &meter);
  free_empty(window: move pool0c);
  let pool1 = box_paged_new::<u64>(capacity: 1_u64);
  place_back(window: &pool1.inner, value: 73_u64);
  let heap1 = std::process::heap_in_use(meter: &meter);
  let diff1 = heap1 - baseline;
  grow_paged(cell: &pool1, capacity: 2_u64);
  place_back(window: &pool1.inner, value: 1_u64);
  let heap2 = std::process::heap_in_use(meter: &meter);
  let diff2 = heap2 - baseline;
  grow_paged(cell: &pool1, capacity: 3_u64);
  place_back(window: &pool1.inner, value: 2_u64);
  let heap3 = std::process::heap_in_use(meter: &meter);
  let diff3 = heap3 - baseline;
  let cap3_actual = pool1.inner.len;
  grow_paged(cell: &pool1, capacity: 4_u64);
  let heap4 = std::process::heap_in_use(meter: &meter);
  let diff4 = heap4 - baseline;
  for (i in 3_u64..512_u64) {
    place_back(window: &pool1.inner, value: i);
  }
  let heap512 = std::process::heap_in_use(meter: &meter);
  let diff512 = heap512 - baseline;
  grow_paged(cell: &pool1, capacity: 513_u64);
  place_back(window: &pool1.inner, value: 512_u64);
  let heap513 = std::process::heap_in_use(meter: &meter);
  let diff513 = heap513 - baseline;
  let sum = 0_u64;
  for (i in 0_u64..pool1.inner.len) {
    let val = pool1.inner[i];
    set sum = sum +wrap val;
  }
  let first = pool1.inner[0_u64];
  loop {
    if pool1.inner.len == 0_u64 {
      break;
    }
    let unused = take_back(window: &pool1.inner);
  }
  free_empty(window: move pool1);
  let heap_after = std::process::heap_in_use(meter: &meter);
  let diff_after = heap_after - baseline;
  let pool5 = box_paged_new::<u64>(capacity: 3_u64);
  place_back(window: &pool5.inner, value: 19_u64);
  let heap5 = std::process::heap_in_use(meter: &meter);
  let diff5 = heap5 - baseline;
  let val5 = pool5.inner[0_u64];
  free_empty(window: move pool5);
  let heap5_after = std::process::heap_in_use(meter: &meter);
  let diff5_after = heap5_after - baseline;
  let pool6 = box_paged_new::<Array<u8, 0>>(capacity: 1_u64);
  let zero_array = array_filled::<u8, 0>(value: 0_u8);
  place_back(window: &pool6.inner, value: zero_array);
  grow_paged(cell: &pool6, capacity: 3_u64);
  let heap6_grown = std::process::heap_in_use(meter: &meter);
  let diff6_grown = heap6_grown - baseline;
  loop {
    if pool6.inner.len == 0_u64 {
      break;
    }
    let unused = take_back(window: &pool6.inner);
  }
  free_empty(window: move pool6);
  let heap6_after = std::process::heap_in_use(meter: &meter);
  let diff6_after = heap6_after - baseline;
  let results = array_filled::<u64, 18>(value: 0_u64);
  set results[0_u64] = diff0;
  set results[1_u64] = diff0b;
  set results[2_u64] = heap0c - baseline;
  set results[3_u64] = diff1;
  set results[4_u64] = diff2;
  set results[5_u64] = diff3;
  set results[6_u64] = diff4;
  set results[7_u64] = diff512;
  set results[8_u64] = diff513;
  set results[9_u64] = diff_after;
  set results[10_u64] = diff5;
  set results[11_u64] = diff5_after;
  set results[12_u64] = diff6_grown;
  set results[13_u64] = diff6_after;
  set results[14_u64] = cap3_actual;
  set results[15_u64] = sum;
  set results[16_u64] = first;
  set results[17_u64] = val5;
  let mut_code = 0_u8;
  for (i in 0_u64..18_u64) {
    let outcome = write_u64_le(factory: &factory, output: &output, value: results[i]);
    match outcome {
      Ok(value: unused_ok) => {
      }
      Err(error: unused_err) => {
        set mut_code = 250_u8;
      }
    }
  }
  return exit_status(code: mut_code);
}

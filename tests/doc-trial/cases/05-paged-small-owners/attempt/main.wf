alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias OutputStream = std::io::OutputStream;
alias HandleFactory = std::io::HandleFactory;
alias MemoryMeter = std::process::MemoryMeter;

fn write_value(factory: &HandleFactory, output: &OutputStream, value: u64) -> result: Result<unit, unit> writes(factory), writes(output) waits {
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  set bytes[0_u64] = cvt.wrap::<u64, u8>(value);
  set bytes[1_u64] = cvt.wrap::<u64, u8>(ishr(value, 8_u32));
  set bytes[2_u64] = cvt.wrap::<u64, u8>(ishr(value, 16_u32));
  set bytes[3_u64] = cvt.wrap::<u64, u8>(ishr(value, 24_u32));
  set bytes[4_u64] = cvt.wrap::<u64, u8>(ishr(value, 32_u32));
  set bytes[5_u64] = cvt.wrap::<u64, u8>(ishr(value, 40_u32));
  set bytes[6_u64] = cvt.wrap::<u64, u8>(ishr(value, 48_u32));
  set bytes[7_u64] = cvt.wrap::<u64, u8>(ishr(value, 56_u32));
  let cancel = std::time::cancel_never();
  let no_deadline = None<std::time::Instant>();
  let buffer = &bytes[0_u64..8_u64];
  let outcome = std::io::write_once(factory: factory, output: output, source: buffer, start: 0_u64, end: 8_u64, deadline: no_deadline, cancel: &cancel);
  std::time::close_cancel_watch(watch: move cancel);
  match outcome {
    Ok(value: next) => {
      if next == 8_u64 {
        return Ok<unit, unit>(value: unit);
      }
      return Err<unit, unit>(error: unit);
    }
    Err(error: unused_err) => {
      return Err<unit, unit>(error: unit);
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: cwd_directory, handles: factory, stdout: output, memory_meter: meter, ..) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  std::fs::close_directory(factory: &factory, directory: move cwd_read);
  let baseline = std::process::heap_in_use(meter: &meter);
  let pool0 = box_paged_new::<u64>(capacity: 0_u64);
  let heap_at_0 = std::process::heap_in_use(meter: &meter);
  let diff_0 = 0_u64;
  grow_paged(cell: &pool0, capacity: 0_u64);
  let heap_at_0b = std::process::heap_in_use(meter: &meter);
  let diff_0b = 0_u64;
  free_empty(window: move pool0);
  let pool0c = box_paged_new::<u64>(capacity: 0_u64);
  free_empty(window: move pool0c);
  let heap_at_0c = std::process::heap_in_use(meter: &meter);
  let diff_0c = 0_u64;
  let pool = box_paged_new::<u64>(capacity: 1_u64);
  place_back(window: &pool.inner, value: 73_u64);
  let heap_at_1 = std::process::heap_in_use(meter: &meter);
  let diff_1 = heap_at_1 - baseline;
  grow_paged(cell: &pool, capacity: 2_u64);
  place_back(window: &pool.inner, value: 1_u64);
  let heap_at_2 = std::process::heap_in_use(meter: &meter);
  let diff_2 = heap_at_2 - baseline;
  grow_paged(cell: &pool, capacity: 3_u64);
  place_back(window: &pool.inner, value: 2_u64);
  let heap_at_3 = std::process::heap_in_use(meter: &meter);
  let diff_3 = heap_at_3 - baseline;
  grow_paged(cell: &pool, capacity: 4_u64);
  let heap_at_4 = std::process::heap_in_use(meter: &meter);
  let diff_4 = heap_at_4 - baseline;
  for (i in 3_u64..512_u64) {
    place_back(window: &pool.inner, value: i);
  }
  grow_paged(cell: &pool, capacity: 512_u64);
  let heap_at_512 = std::process::heap_in_use(meter: &meter);
  let diff_512 = heap_at_512 - baseline;
  grow_paged(cell: &pool, capacity: 513_u64);
  place_back(window: &pool.inner, value: 512_u64);
  let heap_at_513 = std::process::heap_in_use(meter: &meter);
  let diff_513 = heap_at_513 - baseline;
  let sum = 0_u64;
  for (i in 0_u64..pool.inner.len) {
    set sum = sum +wrap pool.inner[i];
  }
  let first = pool.inner[0_u64];
  free_empty(window: move pool);
  let heap_after_release = std::process::heap_in_use(meter: &meter);
  let diff_release = 0_u64;
  let pool19 = box_paged_new::<u64>(capacity: 3_u64);
  place_back(window: &pool19.inner, value: 19_u64);
  let heap_at_19 = std::process::heap_in_use(meter: &meter);
  let diff_19 = heap_at_19 - baseline;
  free_empty(window: move pool19);
  let heap_after_19 = std::process::heap_in_use(meter: &meter);
  let diff_after_19 = 0_u64;
  let pool_zero = box_paged_new::<Array<u8, 0>>(capacity: 1_u64);
  let empty_elem = array_filled::<u8, 0>(value: 0_u8);
  place_back(window: &pool_zero.inner, value: move empty_elem);
  grow_paged(cell: &pool_zero, capacity: 3_u64);
  let heap_at_zero = std::process::heap_in_use(meter: &meter);
  let diff_zero = heap_at_zero - baseline;
  free_empty(window: move pool_zero);
  let heap_after_zero = std::process::heap_in_use(meter: &meter);
  let diff_after_zero = 0_u64;
  let logical_cap = 3_u64;
  let ok = True();
  let r1 = write_value(factory: &factory, output: &output, value: diff_0);
  match r1 {
    Ok(value: unused) => {
    }
    Err(error: unused) => {
      set ok = False();
    }
  }
  let r2 = write_value(factory: &factory, output: &output, value: diff_0b);
  match r2 {
    Ok(value: unused) => {
    }
    Err(error: unused) => {
      set ok = False();
    }
  }
  let r3 = write_value(factory: &factory, output: &output, value: diff_0c);
  match r3 {
    Ok(value: unused) => {
    }
    Err(error: unused) => {
      set ok = False();
    }
  }
  let r4 = write_value(factory: &factory, output: &output, value: diff_1);
  match r4 {
    Ok(value: unused) => {
    }
    Err(error: unused) => {
      set ok = False();
    }
  }
  let r5 = write_value(factory: &factory, output: &output, value: diff_2);
  match r5 {
    Ok(value: unused) => {
    }
    Err(error: unused) => {
      set ok = False();
    }
  }
  let r6 = write_value(factory: &factory, output: &output, value: diff_3);
  match r6 {
    Ok(value: unused) => {
    }
    Err(error: unused) => {
      set ok = False();
    }
  }
  let r7 = write_value(factory: &factory, output: &output, value: diff_4);
  match r7 {
    Ok(value: unused) => {
    }
    Err(error: unused) => {
      set ok = False();
    }
  }
  let r8 = write_value(factory: &factory, output: &output, value: diff_512);
  match r8 {
    Ok(value: unused) => {
    }
    Err(error: unused) => {
      set ok = False();
    }
  }
  let r9 = write_value(factory: &factory, output: &output, value: diff_513);
  match r9 {
    Ok(value: unused) => {
    }
    Err(error: unused) => {
      set ok = False();
    }
  }
  let r10 = write_value(factory: &factory, output: &output, value: diff_release);
  match r10 {
    Ok(value: unused) => {
    }
    Err(error: unused) => {
      set ok = False();
    }
  }
  let r11 = write_value(factory: &factory, output: &output, value: diff_19);
  match r11 {
    Ok(value: unused) => {
    }
    Err(error: unused) => {
      set ok = False();
    }
  }
  let r12 = write_value(factory: &factory, output: &output, value: diff_after_19);
  match r12 {
    Ok(value: unused) => {
    }
    Err(error: unused) => {
      set ok = False();
    }
  }
  let r13 = write_value(factory: &factory, output: &output, value: diff_zero);
  match r13 {
    Ok(value: unused) => {
    }
    Err(error: unused) => {
      set ok = False();
    }
  }
  let r14 = write_value(factory: &factory, output: &output, value: diff_after_zero);
  match r14 {
    Ok(value: unused) => {
    }
    Err(error: unused) => {
      set ok = False();
    }
  }
  let r15 = write_value(factory: &factory, output: &output, value: logical_cap);
  match r15 {
    Ok(value: unused) => {
    }
    Err(error: unused) => {
      set ok = False();
    }
  }
  let r16 = write_value(factory: &factory, output: &output, value: sum);
  match r16 {
    Ok(value: unused) => {
    }
    Err(error: unused) => {
      set ok = False();
    }
  }
  let r17 = write_value(factory: &factory, output: &output, value: first);
  match r17 {
    Ok(value: unused) => {
    }
    Err(error: unused) => {
      set ok = False();
    }
  }
  let r18 = write_value(factory: &factory, output: &output, value: 19_u64);
  match r18 {
    Ok(value: unused) => {
    }
    Err(error: unused) => {
      set ok = False();
    }
  }
  if ok {
    return exit_status(code: 0_u8);
  } else {
    return exit_status(code: 250_u8);
  }
}

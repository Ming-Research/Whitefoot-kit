alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;

enum Instruction {
  Add(value: u64);
  Dec();
  Jnz(target: u64);
  Halt();
}

fn run(code: &[Instruction], counter: u64) -> result: u64 reads(code) {
  let n = code^.len;
  if n == 0_u64 {
    return 0_u64;
  }
  let pc = 0_u64;
  let acc = 0_u64;
  let current_counter = counter;
  loop (
    invariant inb: pc < n
  ) {
    match code^[pc] {
      Add(value: v) => {
        let next = pc + 1_u64;
        if next < n {
          set acc = acc +wrap v^;
          set pc = next;
          continue;
        } else {
          return 0_u64;
        }
      }
      Dec() => {
        let next = pc + 1_u64;
        if next < n {
          set current_counter = current_counter -wrap 1_u64;
          set pc = next;
          continue;
        } else {
          return 0_u64;
        }
      }
      Jnz(target: t) => {
        let is_nonzero = current_counter != 0_u64;
        if is_nonzero {
          let jump_target = t^;
          if jump_target < n {
            set pc = jump_target;
            continue;
          } else {
            return 0_u64;
          }
        } else {
          let next = pc + 1_u64;
          if next < n {
            set pc = next;
            continue;
          } else {
            return 0_u64;
          }
        }
      }
      Halt() => {
        return acc;
      }
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: directory, stdout: output, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: dir_read, write: dir_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move dir_write);
  std::fs::close_directory(factory: &factory, directory: move dir_read);
  let instructions = box_slots_new::<Instruction>(capacity: 4_u64);
  let add3 = Instruction::Add(value: 3_u64);
  place_back(window: &instructions.inner, value: move add3);
  let dec_inst = Instruction::Dec();
  place_back(window: &instructions.inner, value: move dec_inst);
  let jnz_inst = Instruction::Jnz(target: 0_u64);
  place_back(window: &instructions.inner, value: move jnz_inst);
  let halt_inst = Instruction::Halt();
  place_back(window: &instructions.inner, value: move halt_inst);
  let view = &instructions.inner[0_u64..instructions.inner.len];
  let accumulator = run(code: view, counter: 1000_u64);
  let output_buffer = array_filled::<u8, 8>(value: 0_u8);
  let byte0 = accumulator;
  let byte1_val = ishr(accumulator, 8_u32);
  let byte2_val = ishr(accumulator, 16_u32);
  let byte3_val = ishr(accumulator, 24_u32);
  let byte4_val = ishr(accumulator, 32_u32);
  let byte5_val = ishr(accumulator, 40_u32);
  let byte6_val = ishr(accumulator, 48_u32);
  let byte7_val = ishr(accumulator, 56_u32);
  set output_buffer[0_u64] = cvt::<u64, u8>(byte0);
  set output_buffer[1_u64] = cvt::<u64, u8>(byte1_val);
  set output_buffer[2_u64] = cvt::<u64, u8>(byte2_val);
  set output_buffer[3_u64] = cvt::<u64, u8>(byte3_val);
  set output_buffer[4_u64] = cvt::<u64, u8>(byte4_val);
  set output_buffer[5_u64] = cvt::<u64, u8>(byte5_val);
  set output_buffer[6_u64] = cvt::<u64, u8>(byte6_val);
  set output_buffer[7_u64] = cvt::<u64, u8>(byte7_val);
  let sent = 0_u64;
  let end = 8_u64;
  loop @publish {
    if sent < end {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let write_result = std::io::write_once(factory: &factory, output: &output, source: &output_buffer[0_u64..8_u64], start: sent, end: end, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match write_result {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return exit_status(code: 2_u8);
      }
    }
  }
  let expected = 3000_u64;
  if accumulator == expected {
    return exit_status(code: 0_u8);
  } else {
    return exit_status(code: 1_u8);
  }
}

alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias IoError = std::io::IoError;
alias OutputStream = std::io::OutputStream;

enum Op {
  Add(amount: u64);
  Decrement();
  JumpIfNonzero(target: u64);
  Halt();
}

fn execute(instructions: &Slots<Op, 4>, counter: u64) -> result: u64 reads(instructions) {
  let n = instructions^.len;
  if n == 0_u64 {
    return 0_u64;
  }
  let pc = 0_u64;
  let acc = 0_u64;
  let remaining = counter;
  loop (
    invariant inb: pc < n
  ) {
    match instructions^[pc] {
      Add(amount: step) => {
        set acc = acc +wrap step^;
        let next = pc + 1_u64;
        if next < n {
          set pc = next;
          continue;
        } else {
          return 0_u64;
        }
      }
      Decrement() => {
        set remaining = remaining -wrap 1_u64;
        let next = pc + 1_u64;
        if next < n {
          set pc = next;
          continue;
        } else {
          return 0_u64;
        }
      }
      JumpIfNonzero(target: destination) => {
        let jump = remaining != 0_u64;
        if jump {
          let destination_index = destination^;
          if destination_index < n {
            set pc = destination_index;
            continue;
          } else {
            return 0_u64;
          }
        }
        let next = pc + 1_u64;
        if next < n {
          set pc = next;
          continue;
        } else {
          return 0_u64;
        }
      }
      Halt() => {
        return acc;
      }
    }
  }
}

fn little_endian(value: u64) -> result: Array<u8, 8> pure {
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  set bytes[0_u64] = cvt.wrap::<u64, u8>(value);
  let shift_one = ishr(value, 8_u32);
  set bytes[1_u64] = cvt.wrap::<u64, u8>(shift_one);
  let shift_two = ishr(value, 16_u32);
  set bytes[2_u64] = cvt.wrap::<u64, u8>(shift_two);
  let shift_three = ishr(value, 24_u32);
  set bytes[3_u64] = cvt.wrap::<u64, u8>(shift_three);
  let shift_four = ishr(value, 32_u32);
  set bytes[4_u64] = cvt.wrap::<u64, u8>(shift_four);
  let shift_five = ishr(value, 40_u32);
  set bytes[5_u64] = cvt.wrap::<u64, u8>(shift_five);
  let shift_six = ishr(value, 48_u32);
  set bytes[6_u64] = cvt.wrap::<u64, u8>(shift_six);
  let shift_seven = ishr(value, 56_u32);
  set bytes[7_u64] = cvt.wrap::<u64, u8>(shift_seven);
  return bytes;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  requires length <= source^.len;
} {
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: stdout_stream, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move cwd_directory;
  let instructions = slots_new::<Op, 4>();
  let add = Op::Add(amount: 3_u64);
  let decrement = Op::Decrement();
  let jump = Op::JumpIfNonzero(target: 0_u64);
  let halt = Op::Halt();
  place_back(window: &instructions, value: add);
  place_back(window: &instructions, value: decrement);
  place_back(window: &instructions, value: jump);
  place_back(window: &instructions, value: halt);
  let acc = execute(instructions: &instructions, counter: 1000_u64);
  let bytes = little_endian(value: acc);
  let view = &bytes[0_u64..8_u64];
  let published = publish_all(factory: &factory, output: &stdout_stream, source: view, length: 8_u64);
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  match published {
    Ok(value: unused_published) => {
      if acc == 3000_u64 {
        return exit_status(code: 0_u8);
      }
      return exit_status(code: 1_u8);
    }
    Err(error: unused_error) => {
      return exit_status(code: 2_u8);
    }
  }
}

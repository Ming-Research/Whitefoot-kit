alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;

enum Op {
  Add(amount: u64);
  Decrement();
  Jump(target: u64);
  Halt();
}

fn execute(instructions: &Array<Op, 4>, counter: u64) -> result: u64 reads(instructions) {
  let n = instructions^.len;
  if n == 0_u64 {
    return 0_u64;
  }
  let pc = 0_u64;
  let acc = 0_u64;
  let remaining = counter;
  loop (
    invariant inb: pc < n
  ) {
    match instructions^[pc] {
      Add(amount: step) => {
        let addend = step^;
        let next = pc + 1_u64;
        set acc = acc +wrap addend;
        if next < n {
          set pc = next;
          continue;
        } else {
          return 0_u64;
        }
      }
      Decrement() => {
        set remaining = remaining -wrap 1_u64;
        let next = pc + 1_u64;
        if next < n {
          set pc = next;
          continue;
        } else {
          return 0_u64;
        }
      }
      Jump(target: destination) => {
        let target_index = destination^;
        if remaining != 0_u64 {
          if target_index < n {
            set pc = target_index;
            continue;
          } else {
            return 0_u64;
          }
        }
        let next = pc + 1_u64;
        if next < n {
          set pc = next;
          continue;
        } else {
          return 0_u64;
        }
      }
      Halt() => {
        return acc;
      }
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: startup_directory, stdout: output, handles: factory, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move startup_directory;
  let write_closed = std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  let read_closed = std::fs::close_directory(factory: &factory, directory: move directory_read);
  match write_closed {
    Ok(value: unused_write_closed) => {
    }
    Err(error: unused_write_error) => {
    }
  }
  match read_closed {
    Ok(value: unused_read_closed) => {
    }
    Err(error: unused_read_error) => {
    }
  }
  let first = Op::Add(amount: 3_u64);
  let second = Op::Decrement();
  let third = Op::Jump(target: 0_u64);
  let fourth = Op::Halt();
  let filler = Op::Halt();
  let instructions = array_filled::<Op, 4>(value: filler);
  set instructions[0_u64] = first;
  set instructions[1_u64] = second;
  set instructions[2_u64] = third;
  set instructions[3_u64] = fourth;
  let total = execute(instructions: &instructions, counter: 1000_u64);
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  set bytes[0_u64] = cvt.wrap::<u64, u8>(total);
  let shift_1 = ishr(total, 8_u32);
  set bytes[1_u64] = cvt.wrap::<u64, u8>(shift_1);
  let shift_2 = ishr(total, 16_u32);
  set bytes[2_u64] = cvt.wrap::<u64, u8>(shift_2);
  let shift_3 = ishr(total, 24_u32);
  set bytes[3_u64] = cvt.wrap::<u64, u8>(shift_3);
  let shift_4 = ishr(total, 32_u32);
  set bytes[4_u64] = cvt.wrap::<u64, u8>(shift_4);
  let shift_5 = ishr(total, 40_u32);
  set bytes[5_u64] = cvt.wrap::<u64, u8>(shift_5);
  let shift_6 = ishr(total, 48_u32);
  set bytes[6_u64] = cvt.wrap::<u64, u8>(shift_6);
  let shift_7 = ishr(total, 56_u32);
  set bytes[7_u64] = cvt.wrap::<u64, u8>(shift_7);
  let code = 0_u8;
  if total != 3000_u64 {
    set code = 1_u8;
  }
  let view = &bytes[0_u64..8_u64];
  let sent = 0_u64;
  let failed = False();
  loop @publish {
    let pending = sent < 8_u64;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: &factory, output: &output, source: view, start: sent, end: 8_u64, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: output_error) => {
        set failed = True();
        break @publish;
      }
    }
  }
  if failed {
    set code = 2_u8;
  }
  return std::process::exit_status(code: code);
}

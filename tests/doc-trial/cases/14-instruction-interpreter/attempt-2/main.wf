alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;

enum Instruction {
  Add(value: u64);
  Decrement();
  Jump(target: u64);
  Halt();
}

fn execute(instructions: &Box<Slots<Instruction>>, counter: u64) -> result: u64 reads(instructions) {
  let n = instructions^.inner.len;
  if n == 0_u64 {
    return 0_u64;
  }
  let pc = 0_u64;
  let acc = 0_u64;
  let current_counter = counter;
  loop (
    invariant inb: pc < n
  ) {
    match instructions^.inner[pc] {
      Add(value: v) => {
        let next = pc + 1_u64;
        if next < n {
          set acc = acc +wrap v^;
          set pc = next;
          continue;
        } else {
          return 0_u64;
        }
      }
      Decrement() => {
        let next = pc + 1_u64;
        if next < n {
          set current_counter = current_counter -wrap 1_u64;
          set pc = next;
          continue;
        } else {
          return 0_u64;
        }
      }
      Jump(target: t) => {
        if current_counter > 0_u64 {
          let target_pos = t^;
          if target_pos < n {
            set pc = target_pos;
            continue;
          } else {
            return 0_u64;
          }
        } else {
          let next = pc + 1_u64;
          if next < n {
            set pc = next;
            continue;
          } else {
            return 0_u64;
          }
        }
      }
      Halt() => {
        return acc;
      }
    }
  }
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  requires length <= source^.len;
} {
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn u64_to_le_bytes(value: u64) -> result: Array<u8, 8> pure {
  let byte0 = cvt.wrap::<u64, u8>(value);
  let shift1 = ishr(value, 8_u32);
  let byte1 = cvt.wrap::<u64, u8>(shift1);
  let shift2 = ishr(value, 16_u32);
  let byte2 = cvt.wrap::<u64, u8>(shift2);
  let shift3 = ishr(value, 24_u32);
  let byte3 = cvt.wrap::<u64, u8>(shift3);
  let shift4 = ishr(value, 32_u32);
  let byte4 = cvt.wrap::<u64, u8>(shift4);
  let shift5 = ishr(shift4, 8_u32);
  let byte5 = cvt.wrap::<u64, u8>(shift5);
  let shift6 = ishr(shift4, 16_u32);
  let byte6 = cvt.wrap::<u64, u8>(shift6);
  let shift7 = ishr(shift4, 24_u32);
  let byte7 = cvt.wrap::<u64, u8>(shift7);
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  set bytes[0_u64] = byte0;
  set bytes[1_u64] = byte1;
  set bytes[2_u64] = byte2;
  set bytes[3_u64] = byte3;
  set bytes[4_u64] = byte4;
  set bytes[5_u64] = byte5;
  set bytes[6_u64] = byte6;
  set bytes[7_u64] = byte7;
  return bytes;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd, stdout: stdout, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: directory, write: directory_write) = move cwd;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory);
  let instructions = box_slots_new::<Instruction>(capacity: 4_u64);
  place_back(window: &instructions.inner, value: Instruction::Add(value: 3_u64));
  place_back(window: &instructions.inner, value: Instruction::Decrement());
  place_back(window: &instructions.inner, value: Instruction::Jump(target: 0_u64));
  place_back(window: &instructions.inner, value: Instruction::Halt());
  let result = execute(instructions: &instructions, counter: 1000_u64);
  let expected = 3000_u64;
  let bytes = u64_to_le_bytes(value: result);
  let output_slice = &bytes[0_u64..8_u64];
  let write_outcome = publish_all(factory: &factory, output: &stdout, source: output_slice, length: 8_u64);
  match write_outcome {
    Ok(value: unused_ok) => {
      if result == expected {
        return exit_status(code: 0_u8);
      } else {
        return exit_status(code: 1_u8);
      }
    }
    Err(error: unused_error) => {
      return exit_status(code: 2_u8);
    }
  }
}

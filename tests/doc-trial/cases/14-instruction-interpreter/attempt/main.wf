alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias Instant = std::time::Instant;

enum Instruction {
  Add(literal: u64);
  Decrement();
  JumpIfNonZero(target: u64);
  Halt();
}

fn run_machine(instructions: &[Instruction], counter: u64) -> result: u64 reads(instructions) {
  let n = instructions^.len;
  if n == 0_u64 {
    return 0_u64;
  }
  let pc = 0_u64;
  let acc = 0_u64;
  let cur_counter = counter;
  loop (
    invariant bounds: pc < n
  ) {
    match instructions^[pc] {
      Add(literal: value) => {
        let literal_val = value^;
        let next_pc = pc + 1_u64;
        if next_pc < n {
          set acc = acc +wrap literal_val;
          set pc = next_pc;
          continue;
        } else {
          return 0_u64;
        }
      }
      Decrement() => {
        let next_pc = pc + 1_u64;
        if next_pc < n {
          set cur_counter = cur_counter -wrap 1_u64;
          set pc = next_pc;
          continue;
        } else {
          return 0_u64;
        }
      }
      JumpIfNonZero(target: target_ref) => {
        let target_val = target_ref^;
        if cur_counter != 0_u64 {
          if target_val < n {
            set pc = target_val;
            continue;
          } else {
            return 0_u64;
          }
        } else {
          let next_pc = pc + 1_u64;
          if next_pc < n {
            set pc = next_pc;
            continue;
          } else {
            return 0_u64;
          }
        }
      }
      Halt() => {
        return acc;
      }
    }
  }
}

fn write_le_u64(factory: &HandleFactory, output: &OutputStream, value: u64) -> result: Result<unit, IoError> reads(factory), writes(factory), writes(output) waits {
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  set bytes[0_u64] = cvt.wrap::<u64, u8>(value);
  set bytes[1_u64] = cvt.wrap::<u64, u8>(ishr(value, 8_u32));
  set bytes[2_u64] = cvt.wrap::<u64, u8>(ishr(value, 16_u32));
  set bytes[3_u64] = cvt.wrap::<u64, u8>(ishr(value, 24_u32));
  set bytes[4_u64] = cvt.wrap::<u64, u8>(ishr(value, 32_u32));
  set bytes[5_u64] = cvt.wrap::<u64, u8>(ishr(value, 40_u32));
  set bytes[6_u64] = cvt.wrap::<u64, u8>(ishr(value, 48_u32));
  set bytes[7_u64] = cvt.wrap::<u64, u8>(ishr(value, 56_u32));

  let view = &bytes[0_u64..8_u64];
  let sent = 0_u64;
  loop @sending {
    if sent < 8_u64 {
    } else {
      break @sending;
    }
    let no_deadline = None<Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: view, start: sent, end: 8_u64, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: stdout, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  std::fs::close_directory(factory: &factory, directory: move cwd_read);

  let instructions = slots_new::<Instruction, 4>();
  place_back(window: &instructions, value: Instruction::Add(literal: 3_u64));
  place_back(window: &instructions, value: Instruction::Decrement());
  place_back(window: &instructions, value: Instruction::JumpIfNonZero(target: 0_u64));
  place_back(window: &instructions, value: Instruction::Halt());

  let view = &instructions[0_u64..instructions.len];
  let result = run_machine(instructions: view, counter: 1000_u64);

  let write_result = write_le_u64(factory: &factory, output: &stdout, value: result);

  match write_result {
    Ok(value: unused_ok) => {
      if result == 3000_u64 {
        return exit_status(code: 0_u8);
      } else {
        return exit_status(code: 1_u8);
      }
    }
    Err(error: unused_error) => {
      return exit_status(code: 2_u8);
    }
  }
}

alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias Instant = std::time::Instant;

enum Instruction {
  Add(amount: u64);
  Decrement();
  JumpIfNonzero(target: u64);
  Halt();
}

fn byte_at(value: u64, shift: u32) -> result: u8 pure contract {
  requires shift < 64_u32;
} {
  let shifted = ishr(value, shift);
  return cvt.wrap::<u64, u8>(shifted);
}

fn encode_le(value: u64) -> result: Array<u8, 8> pure {
  let encoded = array_filled::<u8, 8>(value: 0_u8);
  set encoded[0_u64] = byte_at(value: value, shift: 0_u32);
  set encoded[1_u64] = byte_at(value: value, shift: 8_u32);
  set encoded[2_u64] = byte_at(value: value, shift: 16_u32);
  set encoded[3_u64] = byte_at(value: value, shift: 24_u32);
  set encoded[4_u64] = byte_at(value: value, shift: 32_u32);
  set encoded[5_u64] = byte_at(value: value, shift: 40_u32);
  set encoded[6_u64] = byte_at(value: value, shift: 48_u32);
  set encoded[7_u64] = byte_at(value: value, shift: 56_u32);
  return encoded;
}

fn run(code: &Box<Slots<Instruction>>, counter: u64) -> result: u64 reads(code) {
  let n = code^.inner.len;
  if n == 0_u64 {
    return 0_u64;
  }
  let pc = 0_u64;
  let acc = 0_u64;
  let remaining = counter;
  loop (
    invariant inb: pc < n
  ) {
    let next = pc +wrap 1_u64;
    match code^.inner[pc] {
      Add(amount: addend) => {
        if next < n {
          set acc = acc +wrap addend^;
          set pc = next;
          continue;
        } else {
          return 0_u64;
        }
      }
      Decrement() => {
        if next < n {
          set remaining = remaining -wrap 1_u64;
          set pc = next;
          continue;
        } else {
          return 0_u64;
        }
      }
      JumpIfNonzero(target: jump_to) => {
        if remaining == 0_u64 {
          if next < n {
            set pc = next;
            continue;
          } else {
            return 0_u64;
          }
        } else {
          let destination = jump_to^;
          if destination < n {
            set pc = destination;
            continue;
          } else {
            return 0_u64;
          }
        }
      }
      Halt() => {
        return acc;
      }
    }
  }
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  requires length <= source^.len;
} {
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: startup_directory, stdout: output, handles: factory, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move startup_directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let instructions = box_slots_new::<Instruction>(capacity: 4_u64);
  let step_add = Instruction::Add(amount: 3_u64);
  place_back(window: &instructions.inner, value: step_add);
  let step_decrement = Instruction::Decrement();
  place_back(window: &instructions.inner, value: step_decrement);
  let step_jump = Instruction::JumpIfNonzero(target: 0_u64);
  place_back(window: &instructions.inner, value: step_jump);
  let step_halt = Instruction::Halt();
  place_back(window: &instructions.inner, value: step_halt);
  let accumulator = run(code: &instructions, counter: 1000_u64);
  let encoded = encode_le(value: accumulator);
  let published = publish_all(factory: &factory, output: &output, source: &encoded[0_u64..8_u64], length: 8_u64);
  match published {
    Ok(value: unused_published) => {
    }
    Err(error: unused_publish_error) => {
      return std::process::exit_status(code: 2_u8);
    }
  }
  if accumulator == 3000_u64 {
    return std::process::exit_status(code: 0_u8);
  }
  return std::process::exit_status(code: 1_u8);
}

alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias Instant = std::time::Instant;
alias Directory = std::fs::Directory;

enum Instruction {
  Add(value: u64);
  Decrement();
  JumpIfNonzero(position: u64);
  Halt();
}

fn execute(instructions: &[Instruction], initial_counter: u64) -> result: u64 reads(instructions) {
  let accumulator = 0_u64;
  let counter = initial_counter;
  let pc = 0_u64;
  loop {
    let in_bounds = pc < instructions^.len;
    if in_bounds {
    } else {
      return 0_u64;
    }
    let instruction = &instructions^[pc];
    match instruction^ {
      Add(value: v) => {
        set accumulator = accumulator +wrap v^;
        set pc = pc + 1_u64;
      }
      Decrement() => {
        set counter = counter -wrap 1_u64;
        set pc = pc + 1_u64;
      }
      JumpIfNonzero(position: pos) => {
        let is_nonzero = counter != 0_u64;
        if is_nonzero {
          set pc = pos^;
        } else {
          set pc = pc + 1_u64;
        }
      }
      Halt() => {
        return accumulator;
      }
    }
  }
}

fn write_all(factory: &HandleFactory, output: &OutputStream, source: &[u8]) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits {
  let sent = 0_u64;
  let length = source^.len;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: output_stream, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  std::fs::close_directory(factory: &factory, directory: move cwd_read);
  let instructions = slots_new::<Instruction, 4>();
  let instr_add = Instruction::Add(value: 3_u64);
  place_back(window: &instructions, value: instr_add);
  let instr_dec = Instruction::Decrement();
  place_back(window: &instructions, value: instr_dec);
  let instr_jump = Instruction::JumpIfNonzero(position: 0_u64);
  place_back(window: &instructions, value: instr_jump);
  let instr_halt = Instruction::Halt();
  place_back(window: &instructions, value: instr_halt);
  let result = execute(instructions: &instructions[0_u64..4_u64], initial_counter: 1000_u64);
  let output_bytes = array_filled::<u8, 8>(value: 0_u8);
  let byte0 = cvt.wrap::<u64, u8>(result);
  set output_bytes[0_u64] = byte0;
  let shifted1 = ishr(result, 8_u32);
  let byte1 = cvt.wrap::<u64, u8>(shifted1);
  set output_bytes[1_u64] = byte1;
  let shifted2 = ishr(result, 16_u32);
  let byte2 = cvt.wrap::<u64, u8>(shifted2);
  set output_bytes[2_u64] = byte2;
  let shifted3 = ishr(result, 24_u32);
  let byte3 = cvt.wrap::<u64, u8>(shifted3);
  set output_bytes[3_u64] = byte3;
  let shifted4 = ishr(result, 32_u32);
  let byte4 = cvt.wrap::<u64, u8>(shifted4);
  set output_bytes[4_u64] = byte4;
  let shifted5 = ishr(result, 40_u32);
  let byte5 = cvt.wrap::<u64, u8>(shifted5);
  set output_bytes[5_u64] = byte5;
  let shifted6 = ishr(result, 48_u32);
  let byte6 = cvt.wrap::<u64, u8>(shifted6);
  set output_bytes[6_u64] = byte6;
  let shifted7 = ishr(result, 56_u32);
  let byte7 = cvt.wrap::<u64, u8>(shifted7);
  set output_bytes[7_u64] = byte7;
  let output_view = &output_bytes[0_u64..8_u64];
  let write_result = write_all(factory: &factory, output: &output_stream, source: output_view);
  let status_code = if result == 3000_u64 {
    give 0_u8;
  } else {
    give 1_u8;
  }
  let final_code = match write_result {
    Ok(value: unused_ok) => {
      give status_code;
    }
    Err(error: unused_error) => {
      give 2_u8;
    }
  }
  return exit_status(code: final_code);
}

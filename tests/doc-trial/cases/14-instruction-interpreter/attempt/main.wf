enum Operation {
  Add(value: u64);
  Decrement();
  JumpIfNonzero(target: u64);
  Halt();
}

fn run_machine(program: &[Operation], initial_counter: u64) -> result: u64 pure {
  let accumulator = 0_u64;
  let counter = initial_counter;
  let pc = 0_u64;

  loop {
    if pc >= program^.len {
      return 0_u64;
    }

    match program^[pc] {
      Add(value: v) => {
        set accumulator = accumulator +wrap v^;
        set pc = pc + 1_u64;
      }
      Decrement() => {
        set counter = counter +wrap 18446744073709551615_u64;
        set pc = pc + 1_u64;
      }
      JumpIfNonzero(target: t) => {
        if counter == 0_u64 {
          set pc = pc + 1_u64;
        } else {
          set pc = t^;
        }
      }
      Halt() => {
        return accumulator;
      }
    }
  }
}

fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  let std::process::Inputs(cwd: directory, handles: factory, stdout: output, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);

  let program = array_filled::<Operation, 4>(value: Operation::Halt());
  set program[0_u64] = Operation::Add(value: 3_u64);
  set program[1_u64] = Operation::Decrement();
  set program[2_u64] = Operation::JumpIfNonzero(target: 0_u64);
  set program[3_u64] = Operation::Halt();

  let view = &program[0_u64..4_u64];
  let result = run_machine(program: view, initial_counter: 1000_u64);

  let bytes = array_filled::<u8, 8>(value: 0_u8);
  set bytes[0_u64] = cvt.wrap::<u64, u8>(result);
  set bytes[1_u64] = cvt.wrap::<u64, u8>(ishr(result, 8_u32));
  set bytes[2_u64] = cvt.wrap::<u64, u8>(ishr(result, 16_u32));
  set bytes[3_u64] = cvt.wrap::<u64, u8>(ishr(result, 24_u32));
  set bytes[4_u64] = cvt.wrap::<u64, u8>(ishr(result, 32_u32));
  set bytes[5_u64] = cvt.wrap::<u64, u8>(ishr(result, 40_u32));
  set bytes[6_u64] = cvt.wrap::<u64, u8>(ishr(result, 48_u32));
  set bytes[7_u64] = cvt.wrap::<u64, u8>(ishr(result, 56_u32));

  let sent = 0_u64;
  let output_view = &bytes[0_u64..8_u64];
  loop @write {
    if sent < 8_u64 {
      let no_deadline = None<std::time::Instant>();
      let cancel = std::time::cancel_never();
      let write_result = std::io::write_once(factory: &factory, output: &output, source: output_view, start: sent, end: 8_u64, deadline: no_deadline, cancel: &cancel);
      std::time::close_cancel_watch(watch: move cancel);
      match write_result {
        Ok(value: next) => {
          set sent = next;
        }
        Err(error: unused_error) => {
          return std::process::exit_status(code: 2_u8);
        }
      }
    } else {
      break @write;
    }
  }

  if result == 3000_u64 {
    return std::process::exit_status(code: 0_u8);
  } else {
    return std::process::exit_status(code: 1_u8);
  }
}

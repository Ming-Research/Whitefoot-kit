alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias IoError = std::io::IoError;
alias OutputStream = std::io::OutputStream;
alias HandleFactory = std::io::HandleFactory;
alias CancelWatch = std::time::CancelWatch;
alias Instant = std::time::Instant;

enum Instruction {
  Add(value: u64);
  Decrement();
  JumpIfNonzero(target: u64);
  Halt();
}

fn execute(instructions: &[Instruction], initial_counter: u64) -> result: u64 reads(instructions) {
  let accumulator = 0_u64;
  let counter = initial_counter;
  let pc = 0_u64;
  let len = instructions^.len;
  loop {
    if pc >= len {
      return 0_u64;
    }
    let instr = instructions^[pc];
    match instr {
      Add(value: v) => {
        set accumulator = accumulator +wrap v;
        set pc = pc + 1_u64;
      }
      Decrement() => {
        set counter = counter -wrap 1_u64;
        set pc = pc + 1_u64;
      }
      JumpIfNonzero(target: t) => {
        if counter == 0_u64 {
          set pc = pc + 1_u64;
        } else {
          set pc = t;
        }
      }
      Halt() => {
        return accumulator;
      }
    }
  }
}

fn encode_u64_le(value: u64) -> result: Array<u8, 8> pure {
  let b0 = cvt::<u64, u8>(iand(value, 255_u64));
  let shifted1 = ishr(value, 8_u32);
  let b1 = cvt::<u64, u8>(iand(shifted1, 255_u64));
  let shifted2 = ishr(value, 16_u32);
  let b2 = cvt::<u64, u8>(iand(shifted2, 255_u64));
  let shifted3 = ishr(value, 24_u32);
  let b3 = cvt::<u64, u8>(iand(shifted3, 255_u64));
  let shifted4 = ishr(value, 32_u32);
  let b4 = cvt::<u64, u8>(iand(shifted4, 255_u64));
  let shifted5 = ishr(value, 40_u32);
  let b5 = cvt::<u64, u8>(iand(shifted5, 255_u64));
  let shifted6 = ishr(value, 48_u32);
  let b6 = cvt::<u64, u8>(iand(shifted6, 255_u64));
  let shifted7 = ishr(value, 56_u32);
  let b7 = cvt::<u64, u8>(iand(shifted7, 255_u64));
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  set bytes[0_u64] = b0;
  set bytes[1_u64] = b1;
  set bytes[2_u64] = b2;
  set bytes[3_u64] = b3;
  set bytes[4_u64] = b4;
  set bytes[5_u64] = b5;
  set bytes[6_u64] = b6;
  set bytes[7_u64] = b7;
  return bytes;
}

fn write_all(factory: &HandleFactory, output: &OutputStream, data: &[u8], cancel: &CancelWatch) -> result: Result<unit, IoError> reads(cancel), reads(data), writes(factory), writes(output) waits {
  let len = data^.len;
  let pos = 0_u64;
  loop {
    if pos >= len {
      return Ok<unit, IoError>(value: unit);
    }
    let write_result = write_once(factory: factory, output: output, source: data, start: pos, end: len, deadline: None<Instant>(), cancel: cancel);
    match write_result {
      Ok(value: next_pos) => {
        set pos = next_pos;
      }
      Err(error: err) => {
        return Err<unit, IoError>(error: move err);
      }
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: stdout_stream, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  let close_write_result = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let close_read_result = std::fs::close_directory(factory: &factory, directory: move cwd_read);
  let instructions = array_filled::<Instruction, 4>(value: Instruction::Halt());
  set instructions[0_u64] = Instruction::Add(value: 3_u64);
  set instructions[1_u64] = Instruction::Decrement();
  set instructions[2_u64] = Instruction::JumpIfNonzero(target: 0_u64);
  set instructions[3_u64] = Instruction::Halt();
  let result = execute(instructions: &instructions[0_u64..4_u64], initial_counter: 1000_u64);
  let bytes = encode_u64_le(value: result);
  let cancel = std::time::cancel_never();
  let write_result = write_all(factory: &factory, output: &stdout_stream, data: &bytes[0_u64..8_u64], cancel: &cancel);
  let exit_code = match write_result {
    Ok(value: unused_ok) => {
      if result == 3000_u64 {
        give 0_u8;
      } else {
        give 1_u8;
      }
    }
    Err(error: unused_err) => {
      give 2_u8;
    }
  };
  match close_write_result {
    Ok(value: unused_ok) => {
    }
    Err(error: unused_err) => {
    }
  }
  match close_read_result {
    Ok(value: unused_ok) => {
    }
    Err(error: unused_err) => {
    }
  }
  return exit_status(code: exit_code);
}

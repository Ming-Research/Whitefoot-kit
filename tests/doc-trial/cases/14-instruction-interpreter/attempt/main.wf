alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias Directory = std::fs::Directory;

enum Instruction {
  Add(value: u64);
  Decrement();
  Jump(position: u64);
  Halt();
}

fn run(instructions: &[Instruction], initial_counter: u64) -> result: u64 reads(instructions) {
  let pc = 0_u64;
  let accumulator = 0_u64;
  let counter = initial_counter;
  let instr_len = instructions^.len;
  if instr_len == 0_u64 {
    return 0_u64;
  }
  loop (
    invariant pc_valid: pc < instr_len
  ) {
    match instructions^[pc] {
      Add(value: val) => {
        set accumulator = accumulator +wrap val^;
        let next_pc = pc + 1_u64;
        if next_pc < instr_len {
          set pc = next_pc;
          continue;
        } else {
          return 0_u64;
        }
      }
      Decrement() => {
        set counter = counter -wrap 1_u64;
        let next_pc = pc + 1_u64;
        if next_pc < instr_len {
          set pc = next_pc;
          continue;
        } else {
          return 0_u64;
        }
      }
      Jump(position: target) => {
        if counter != 0_u64 {
          if target^ < instr_len {
            set pc = target^;
            continue;
          } else {
            return 0_u64;
          }
        } else {
          let next_pc = pc + 1_u64;
          if next_pc < instr_len {
            set pc = next_pc;
            continue;
          } else {
            return 0_u64;
          }
        }
      }
      Halt() => {
        return accumulator;
      }
    }
  }
}

fn u64_to_little_endian(value: u64) -> result: Array<u8, 8> pure {
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  set bytes[0_u64] = cvt.wrap::<u64, u8>(value);
  let shift1 = ishr(value, 8_u32);
  set bytes[1_u64] = cvt.wrap::<u64, u8>(shift1);
  let shift2 = ishr(value, 16_u32);
  set bytes[2_u64] = cvt.wrap::<u64, u8>(shift2);
  let shift3 = ishr(value, 24_u32);
  set bytes[3_u64] = cvt.wrap::<u64, u8>(shift3);
  let shift4 = ishr(value, 32_u32);
  set bytes[4_u64] = cvt.wrap::<u64, u8>(shift4);
  let shift5 = ishr(value, 40_u32);
  set bytes[5_u64] = cvt.wrap::<u64, u8>(shift5);
  let shift6 = ishr(value, 48_u32);
  set bytes[6_u64] = cvt.wrap::<u64, u8>(shift6);
  let shift7 = ishr(value, 56_u32);
  set bytes[7_u64] = cvt.wrap::<u64, u8>(shift7);
  return move bytes;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: cwd_dir, handles: factory, stdout: output, ..) = move inputs;
  let Directory(read: cwd_read, write: cwd_write) = move cwd_dir;
  std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  std::fs::close_directory(factory: &factory, directory: move cwd_read);
  let default_instr = Instruction::Halt();
  let instructions = array_filled::<Instruction, 4>(value: default_instr);
  let add_instr = Instruction::Add(value: 3_u64);
  set instructions[0_u64] = move add_instr;
  let dec_instr = Instruction::Decrement();
  set instructions[1_u64] = move dec_instr;
  let jump_instr = Instruction::Jump(position: 0_u64);
  set instructions[2_u64] = move jump_instr;
  let halt_instr = Instruction::Halt();
  set instructions[3_u64] = move halt_instr;
  let instr_slice = &instructions[0_u64..4_u64];
  let result = run(instructions: instr_slice, initial_counter: 1000_u64);
  let bytes = u64_to_little_endian(value: result);
  let buffer = &bytes[0_u64..8_u64];
  let no_deadline = None<std::time::Instant>();
  let cancel = std::time::cancel_never();
  let write_outcome = std::io::write_once(factory: &factory, output: &output, source: buffer, start: 0_u64, end: 8_u64, deadline: no_deadline, cancel: &cancel);
  std::time::close_cancel_watch(watch: move cancel);
  let sent = match write_outcome {
    Ok(value: written) => {
      give written;
    }
    Err(error: write_error) => {
      give 0_u64;
    }
  }
  let final_sent = sent;
  loop @finish_write {
    let pending = final_sent < 8_u64;
    if pending {
    } else {
      break @finish_write;
    }
    let no_deadline_retry = None<std::time::Instant>();
    let cancel_retry = std::time::cancel_never();
    let retry_outcome = std::io::write_once(factory: &factory, output: &output, source: buffer, start: final_sent, end: 8_u64, deadline: no_deadline_retry, cancel: &cancel_retry);
    let close_result = std::time::close_cancel_watch(watch: move cancel_retry);
    match retry_outcome {
      Ok(value: next) => {
        if next == final_sent {
          break @finish_write;
        }
        set final_sent = next;
      }
      Err(error: retry_error) => {
        break @finish_write;
      }
    }
  }
  let expected = 3000_u64;
  let correct_result = result == expected;
  let inner_code = if correct_result {
    give 0_u8;
  } else {
    give 1_u8;
  }
  let result_code = if final_sent == 8_u64 {
    give inner_code;
  } else {
    give 2_u8;
  }
  return exit_status(code: result_code);
}

alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias Args = std::text::Args;
alias HostString = std::text::HostString;
alias arg_get = std::text::arg_get;
alias host_bytes_len = std::text::host_bytes_len;
alias host_copy_bytes = std::text::host_copy_bytes;
alias HandleFactory = std::io::HandleFactory;
alias IoError = std::io::IoError;
alias Instant = std::time::Instant;
alias TcpListener = std::net::TcpListener;
alias TcpConnection = std::net::TcpConnection;
alias AcceptedConnection = std::net::AcceptedConnection;
alias socket_address_v4 = std::net::socket_address_v4;
alias tcp_listen = std::net::tcp_listen;
alias tcp_accept = std::net::tcp_accept;
alias close_send = std::net::close_send;
alias close_receive = std::net::close_receive;
alias close_listener = std::net::close_listener;

fn parse_digits(text: &HostString) -> result: u64 reads(text) {
  let length = host_bytes_len(value: text);
  let digits = box_array_filled::<u8>(count: length, value: 0_u8);
  let copied = host_copy_bytes(value: text, destination: &digits.inner[0_u64..length], start: 0_u64, end: length);
  let value = 0_u64;
  for (i in 0_u64..length) {
    let byte = digits.inner[i];
    let low = byte >= 48_u8;
    let high = byte <= 57_u8;
    let valid = band(low, high);
    if valid {
      let digit = byte - 48_u8;
      let scaled = value *wrap 10_u64;
      let wide = cvt::<u8, u64>(digit);
      set value = scaled +wrap wide;
    }
  }
  return value;
}

fn accept_clients(factory: &HandleFactory, listener: &TcpListener) -> result: Bool writes(factory), writes(listener) waits {
  let failed = False();
  for (client in 0_u64..9_u64) {
    let cancel = std::time::cancel_never();
    let deadline = None<Instant>();
    let accepted = tcp_accept(factory: factory, listener: listener, deadline: deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match move accepted {
      Ok(value: pair) => {
        let AcceptedConnection(connection: conn, peer: unused_peer) = move pair;
        let TcpConnection(receive: receive_half, send: send_half) = move conn;
        let send_closed = close_send(factory: factory, send: move send_half);
        let receive_closed = close_receive(factory: factory, receive: move receive_half);
      }
      Err(error: unused_accept_error) => {
        set failed = True();
      }
    }
  }
  return failed;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: program_args, drivers: unused_drivers, cwd: cwd_directory, stdout: unused_stdout, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  let write_closed = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let read_closed = std::fs::close_directory(factory: &factory, directory: move cwd);
  let code = 0_u8;
  match write_closed {
    Ok(value: unused_write_closed) => {
    }
    Err(error: unused_write_error) => {
      set code = 1_u8;
    }
  }
  match read_closed {
    Ok(value: unused_read_closed) => {
    }
    Err(error: unused_read_error) => {
      set code = 1_u8;
    }
  }
  let port_text = arg_get(args: &program_args, position: 0_u64);
  match move port_text {
    Ok(value: text) => {
      let port_value = parse_digits(text: &text);
      let narrowed = cvt.checked::<u64, u16>(port_value);
      match narrowed {
        Ok(value: port) => {
          let address = socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: port);
          let listened = tcp_listen(factory: &factory, address: &address);
          match move listened {
            Ok(value: listener) => {
              let failed = accept_clients(factory: &factory, listener: &listener);
              let listener_closed = close_listener(factory: &factory, listener: move listener);
              if failed {
                set code = 1_u8;
              }
            }
            Err(error: unused_listen_error) => {
              set code = 1_u8;
            }
          }
        }
        Err(error: unused_narrow_error) => {
          set code = 1_u8;
        }
      }
    }
    Err(error: unused_arg_error) => {
      set code = 1_u8;
    }
  }
  return exit_status(code: code);
}

alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias Inputs = std::process::Inputs;
alias HandleFactory = std::io::HandleFactory;
alias Directory = std::fs::Directory;
alias IoError = std::io::IoError;
alias Instant = std::time::Instant;
alias CancelWatch = std::time::CancelWatch;
alias SocketAddress = std::net::SocketAddress;
alias TcpListener = std::net::TcpListener;
alias TcpConnection = std::net::TcpConnection;
alias TcpReceive = std::net::TcpReceive;
alias TcpSend = std::net::TcpSend;

struct Value {
  bytes: Box<Slots<u8>>;
}

struct ParseResult {
  success: Bool;
  position: u64;
  value_start: u64;
  value_len: u64;
}

fn send_all(send: &TcpSend, source: &[u8], length: u64, deadline: Option<Instant>, cancel: &CancelWatch) -> result: Result<unit, IoError> reads(source), reads(cancel), writes(send) waits contract {
  requires length <= source^.len;
} {
  let sent = 0_u64;
  loop @sending {
    if sent < length {
    } else {
      break @sending;
    }
    let outcome = std::net::send_once(send: send, source: source, start: sent, end: length, deadline: deadline, cancel: cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn find_crlf(buffer: &[u8], start: u64) -> result: Result<u64, u64> reads(buffer) {
  let pos = start;
  loop @search {
    let next_check = pos + 1_u64;
    if next_check >= buffer^.len {
      return Err<u64, u64>(error: 0_u64);
    }
    let byte = buffer^[pos];
    if byte == 13_u8 {
      let next_byte = buffer^[next_check];
      if next_byte == 10_u8 {
        return Ok<u64, u64>(value: pos);
      }
    }
    let next_pos = pos + 1_u64;
    if next_pos >= buffer^.len {
      return Err<u64, u64>(error: 0_u64);
    }
    set pos = next_pos;
  }
}

fn parse_decimal(buffer: &[u8], start: u64, end: u64) -> result: Result<u64, u64> reads(buffer) {
  let value = 0_u64;
  let pos = start;
  loop @parse {
    if pos >= end {
      break @parse;
    }
    let byte = buffer^[pos];
    if byte >= 48_u8 {
    } else {
      return Err<u64, u64>(error: 0_u64);
    }
    if byte <= 57_u8 {
    } else {
      return Err<u64, u64>(error: 0_u64);
    }
    let digit = byte - 48_u8;
    let digit_u64 = cvt::<u8, u64>(digit);
    set value = value *wrap 10_u64;
    set value = value +wrap digit_u64;
    set pos = pos + 1_u64;
  }
  return Ok<u64, u64>(value: value);
}

fn parse_bulk_string(buffer: &[u8], pos: u64) -> result: ParseResult reads(buffer) {
  let false_val = False();
  let true_val = True();
  if pos >= buffer^.len {
    return ParseResult(success: false_val, position: pos, value_start: 0_u64, value_len: 0_u64);
  }
  let first = buffer^[pos];
  if first != 36_u8 {
    return ParseResult(success: false_val, position: pos, value_start: 0_u64, value_len: 0_u64);
  }
  let crlf_start = pos + 1_u64;
  let crlf_result = find_crlf(buffer: buffer, start: crlf_start);
  match crlf_result {
    Ok(value: crlf_pos) => {
      let len_start = pos + 1_u64;
      let len_end = crlf_pos;
      let len_parse = parse_decimal(buffer: buffer, start: len_start, end: len_end);
      match len_parse {
        Ok(value: length) => {
          let data_start = crlf_pos + 2_u64;
          let data_end = data_start + length;
          let check1 = data_end > buffer^.len;
          if check1 {
            return ParseResult(success: false_val, position: pos, value_start: 0_u64, value_len: 0_u64);
          }
          let after_data = data_end + 2_u64;
          let check2 = after_data > buffer^.len;
          if check2 {
            return ParseResult(success: false_val, position: pos, value_start: 0_u64, value_len: 0_u64);
          }
          let cr_check = buffer^[data_end];
          let lf_idx = data_end + 1_u64;
          let lf_check = buffer^[lf_idx];
          if band(cr_check == 13_u8, lf_check == 10_u8) {
            return ParseResult(success: true_val, position: after_data, value_start: data_start, value_len: length);
          }
          return ParseResult(success: false_val, position: pos, value_start: 0_u64, value_len: 0_u64);
        }
        Err(error: e) => {
          return ParseResult(success: false_val, position: pos, value_start: 0_u64, value_len: 0_u64);
        }
      }
    }
    Err(error: e) => {
      return ParseResult(success: false_val, position: pos, value_start: 0_u64, value_len: 0_u64);
    }
  }
}

fn parse_array_count(buffer: &[u8], pos: u64) -> result: Result<(u64, u64), u64> reads(buffer) {
  if pos >= buffer^.len {
    let error_val = 0_u64;
    return Err<(u64, u64), u64>(error: error_val);
  }
  let first = buffer^[pos];
  if first != 42_u8 {
    let error_val = 0_u64;
    return Err<(u64, u64), u64>(error: error_val);
  }
  let start_pos = pos + 1_u64;
  let crlf_result = find_crlf(buffer: buffer, start: start_pos);
  match crlf_result {
    Ok(value: crlf_pos) => {
      let count_start = pos + 1_u64;
      let count_end = crlf_pos;
      let count_parse = parse_decimal(buffer: buffer, start: count_start, end: count_end);
      match count_parse {
        Ok(value: count) => {
          let next_pos = crlf_pos + 2_u64;
          return Ok<(u64, u64), u64>(value: (count, next_pos));
        }
        Err(error: e) => {
          return Err<(u64, u64), u64>(error: 0_u64);
        }
      }
    }
    Err(error: e) => {
      return Err<(u64, u64), u64>(error: 0_u64);
    }
  }
}

fn to_upper(byte: u8) -> result: u8 pure {
  if byte >= 97_u8 {
    if byte <= 122_u8 {
      return byte - 32_u8;
    }
  }
  return byte;
}

fn bytes_to_i64(data: &[u8]) -> result: Result<i64, u64> reads(data) {
  if data^.len == 0_u64 {
    return Err<i64, u64>(error: 0_u64);
  }
  let first_byte = data^[0_u64];
  let is_negative = False();
  let start_idx = 0_u64;
  if first_byte == 45_u8 {
    set is_negative = True();
    set start_idx = 1_u64;
    if start_idx >= data^.len {
      return Err<i64, u64>(error: 0_u64);
    }
  }
  let value = 0_i64;
  for (i in start_idx..data^.len) {
    let byte = data^[i];
    if byte >= 48_u8 {
    } else {
      return Err<i64, u64>(error: 0_u64);
    }
    if byte <= 57_u8 {
    } else {
      return Err<i64, u64>(error: 0_u64);
    }
    let digit = byte - 48_u8;
    let digit_i64 = cvt::<u8, i64>(digit);
    set value = value *wrap 10_i64;
    set value = value +wrap digit_i64;
  }
  if is_negative {
    set value = 0_i64 - value;
  }
  return Ok<i64, u64>(value: value);
}

fn i64_to_bytes(value: i64) -> result: Box<Slots<u8>> pure {
  let buffer = box_slots_new::<u8>(capacity: 32_u64);
  let num = value;
  let is_negative = False();
  if num < 0_i64 {
    set is_negative = True();
    set num = 0_i64 - num;
  }
  let digits = slots_new::<u8, 32>();
  if num == 0_i64 {
    place_back(window: &digits, value: 48_u8);
  } else {
    let temp = num;
    loop @count_digits {
      if temp == 0_i64 {
        break @count_digits;
      }
      let remainder_result = temp %checked 10_i64;
      match remainder_result {
        Ok(value: remainder) => {
          let digit_byte = cvt::<i64, u8>(remainder) + 48_u8;
          place_back(window: &digits, value: digit_byte);
          let div_result = temp /checked 10_i64;
          match div_result {
            Ok(value: quotient) => {
              set temp = quotient;
            }
            Err(error: e) => {
              break @count_digits;
            }
          }
        }
        Err(error: e) => {
          break @count_digits;
        }
      }
    }
  }
  if is_negative {
    place_back(window: &buffer.inner, value: 45_u8);
  }
  let idx = digits.len;
  loop @reverse {
    if idx == 0_u64 {
      break @reverse;
    }
    let digit_idx = idx - 1_u64;
    let digit = digits[digit_idx];
    place_back(window: &buffer.inner, value: digit);
    set idx = digit_idx;
  }
  return move buffer;
}

fn handle_client(factory: &HandleFactory, receive: TcpReceive, send: TcpSend, store: Shared<ConcurrentHashMap<Value>>, deadline: Option<Instant>, cancel: &CancelWatch) -> result: unit reads(cancel), writes(factory) waits {
  let buffer = array_filled::<u8, 4096>(value: 0_u8);
  let response_buffer = array_filled::<u8, 4096>(value: 0_u8);
  let filled = 0_u64;
  loop @client_loop {
    let remaining = 4096_u64 - filled;
    if remaining == 0_u64 {
      break @client_loop;
    }
    let outcome = std::net::receive_next(receive: &receive, destination: &buffer[0_u64..4096_u64], start: filled, end: 4096_u64, deadline: deadline, cancel: cancel);
    match outcome {
      Ok(value: received) => {
        if received == filled {
          break @client_loop;
        }
        set filled = received;
      }
      Err(error: stop) => {
        break @client_loop;
      }
    }
    let parsed_pos = 0_u64;
    loop @parse_loop {
      if parsed_pos >= filled {
        set filled = 0_u64;
        break @parse_loop;
      }
      let array_result = parse_array_count(buffer: &buffer[0_u64..4096_u64], pos: parsed_pos);
      match array_result {
        Ok(value: counts) => {
          let count = counts.0;
          let next_pos = counts.1;
          if count == 0_u64 {
            set parsed_pos = next_pos;
            continue @parse_loop;
          }
          let cmd_parse = parse_bulk_string(buffer: &buffer[0_u64..4096_u64], pos: next_pos);
          if cmd_parse.success {
          } else {
            break @parse_loop;
          }
          let cmd_start = cmd_parse.value_start;
          let after_cmd = cmd_parse.position;
          let first_byte = buffer^[cmd_start];
          let upper_first = to_upper(byte: first_byte);
          let handled = False();
          if upper_first == 80_u8 {
            if count == 1_u64 {
              let pong = "+PONG\r\n";
              let send_outcome = send_all(send: &send, source: &pong[0_u64..7_u64], length: 7_u64, deadline: deadline, cancel: cancel);
              match send_outcome {
                Ok(value: unit) => {
                  set parsed_pos = after_cmd;
                  set handled = True();
                }
                Err(error: e) => {
                  break @client_loop;
                }
              }
            }
          }
          if upper_first == 71_u8 {
            if count == 2_u64 {
              let key_parse = parse_bulk_string(buffer: &buffer[0_u64..4096_u64], pos: after_cmd);
              if key_parse.success {
                let key_start = key_parse.value_start;
                let key_len = key_parse.value_len;
                let key_end = key_start + key_len;
                let key_slice = &buffer[key_start..key_end];
                let found_val = False();
                let val_len = 0_u64;
                atomic slot = &store[key_slice] {
                  match slot^ {
                    Some(value: v) => {
                      set found_val = True();
                      set val_len = v^.bytes.inner.len;
                    }
                    None() => {
                    }
                  }
                }
                if found_val {
                  let resp_pos = 0_u64;
                  set response_buffer[resp_pos] = 36_u8;
                  let len_str = i64_to_bytes(value: cvt::<u64, i64>(val_len));
                  let len_bytes = &len_str.inner[0_u64..len_str.inner.len];
                  let resp_pos2 = resp_pos + 1_u64;
                  let len_bytes_len = len_bytes^.len;
                  let resp_pos2_end = resp_pos2 + len_bytes_len;
                  let ci = 0_u64;
                  for (i in resp_pos2..resp_pos2_end) {
                    set response_buffer[i] = len_bytes^[ci];
                    set ci = ci + 1_u64;
                  }
                  let resp_pos3 = resp_pos2 + len_bytes_len;
                  set response_buffer[resp_pos3] = 13_u8;
                  let resp_pos3_1 = resp_pos3 + 1_u64;
                  set response_buffer[resp_pos3_1] = 10_u8;
                  let resp_pos4 = resp_pos3 + 2_u64;
                  atomic slot = &store[key_slice] {
                    match slot^ {
                      Some(value: v) => {
                        let vi = 0_u64;
                        let resp_pos4_end = resp_pos4 + val_len;
                        for (i in resp_pos4..resp_pos4_end) {
                          set response_buffer[i] = v^.bytes.inner[vi];
                          set vi = vi + 1_u64;
                        }
                      }
                      None() => {
                      }
                    }
                  }
                  let resp_pos5 = resp_pos4 + val_len;
                  set response_buffer[resp_pos5] = 13_u8;
                  let resp_pos5_1 = resp_pos5 + 1_u64;
                  set response_buffer[resp_pos5_1] = 10_u8;
                  let final_pos = resp_pos5 + 2_u64;
                  let send_outcome = send_all(send: &send, source: &response_buffer[0_u64..4096_u64], length: final_pos, deadline: deadline, cancel: cancel);
                  match send_outcome {
                    Ok(value: unit) => {
                      set parsed_pos = key_parse.position;
                      set handled = True();
                    }
                    Err(error: e) => {
                      break @client_loop;
                    }
                  }
                } else {
                  let null_response = "$-1\r\n";
                  let send_outcome = send_all(send: &send, source: &null_response[0_u64..5_u64], length: 5_u64, deadline: deadline, cancel: cancel);
                  match send_outcome {
                    Ok(value: unit) => {
                      set parsed_pos = key_parse.position;
                      set handled = True();
                    }
                    Err(error: e) => {
                      break @client_loop;
                    }
                  }
                }
              } else {
                break @parse_loop;
              }
            }
          }
          if upper_first == 83_u8 {
            if count == 3_u64 {
              let key_parse = parse_bulk_string(buffer: &buffer[0_u64..4096_u64], pos: after_cmd);
              if key_parse.success {
                let key_start = key_parse.value_start;
                let key_len = key_parse.value_len;
                let key_end = key_start + key_len;
                let key_slice = &buffer[key_start..key_end];
                let val_parse = parse_bulk_string(buffer: &buffer[0_u64..4096_u64], pos: key_parse.position);
                if val_parse.success {
                  let val_start = val_parse.value_start;
                  let val_len = val_parse.value_len;
                  let val_end = val_start + val_len;
                  let val_slice = &buffer[val_start..val_end];
                  let new_value = box_slots_new::<u8>(capacity: val_len);
                  let vi = 0_u64;
                  for (i in 0_u64..val_len) {
                    place_back(window: &new_value.inner, value: val_slice^[i]);
                  }
                  let new_val = Value(bytes: move new_value);
                  atomic slot = &store[key_slice] {
                    set slot^ = Some<Value>(value: move new_val);
                  }
                  let ok_response = "+OK\r\n";
                  let send_outcome = send_all(send: &send, source: &ok_response[0_u64..5_u64], length: 5_u64, deadline: deadline, cancel: cancel);
                  match send_outcome {
                    Ok(value: unit) => {
                      set parsed_pos = val_parse.position;
                      set handled = True();
                    }
                    Err(error: e) => {
                      break @client_loop;
                    }
                  }
                } else {
                  break @parse_loop;
                }
              } else {
                break @parse_loop;
              }
            }
          }
          if upper_first == 68_u8 {
            if count == 2_u64 {
              let key_parse = parse_bulk_string(buffer: &buffer[0_u64..4096_u64], pos: after_cmd);
              if key_parse.success {
                let key_start = key_parse.value_start;
                let key_len = key_parse.value_len;
                let key_end = key_start + key_len;
                let key_slice = &buffer[key_start..key_end];
                let existed = False();
                atomic slot = &store[key_slice] {
                  match slot^ {
                    Some(value: v) => {
                      set slot^ = None<Value>();
                      set existed = True();
                    }
                    None() => {
                    }
                  }
                }
                let response = if existed {
                  give ":1\r\n";
                } else {
                  give ":0\r\n";
                }
                let send_outcome = send_all(send: &send, source: &response[0_u64..4_u64], length: 4_u64, deadline: deadline, cancel: cancel);
                match send_outcome {
                  Ok(value: unit) => {
                    set parsed_pos = key_parse.position;
                    set handled = True();
                  }
                  Err(error: e) => {
                    break @client_loop;
                  }
                }
              } else {
                break @parse_loop;
              }
            }
          }
          if upper_first == 73_u8 {
            if count == 2_u64 {
              let key_parse = parse_bulk_string(buffer: &buffer[0_u64..4096_u64], pos: after_cmd);
              if key_parse.success {
                let key_start = key_parse.value_start;
                let key_len = key_parse.value_len;
                let key_end = key_start + key_len;
                let key_slice = &buffer[key_start..key_end];
                let new_value = 0_i64;
                let error_occurred = False();
                atomic slot = &store[key_slice] {
                  match slot^ {
                    Some(value: v) => {
                      let v_bytes_len = v^.bytes.inner.len;
                      let v_bytes_slice = &v^.bytes.inner[0_u64..v_bytes_len];
                      let parse_result = bytes_to_i64(data: v_bytes_slice);
                      match parse_result {
                        Ok(value: int_val) => {
                          let next = int_val +wrap 1_i64;
                          set new_value = next;
                          let new_bytes = i64_to_bytes(value: next);
                          let new_val = Value(bytes: move new_bytes);
                          set slot^ = Some<Value>(value: move new_val);
                        }
                        Err(error: e) => {
                          set error_occurred = True();
                        }
                      }
                    }
                    None() => {
                      set new_value = 1_i64;
                      let new_bytes = i64_to_bytes(value: 1_i64);
                      let new_val = Value(bytes: move new_bytes);
                      set slot^ = Some<Value>(value: move new_val);
                    }
                  }
                }
                if error_occurred {
                  let error_msg = "-ERR value is not an integer or out of range\r\n";
                  let send_outcome = send_all(send: &send, source: &error_msg[0_u64..46_u64], length: 46_u64, deadline: deadline, cancel: cancel);
                  match send_outcome {
                    Ok(value: unit) => {
                      set parsed_pos = key_parse.position;
                      set handled = True();
                    }
                    Err(error: e) => {
                      break @client_loop;
                    }
                  }
                } else {
                  let int_str = i64_to_bytes(value: new_value);
                  let int_str_len = int_str.inner.len;
                  let int_bytes = &int_str.inner[0_u64..int_str_len];
                  let resp_pos = 0_u64;
                  set response_buffer[resp_pos] = 58_u8;
                  let resp_pos2 = resp_pos + 1_u64;
                  let int_bytes_len = int_bytes^.len;
                  let resp_pos2_end = resp_pos2 + int_bytes_len;
                  let ci = 0_u64;
                  for (i in resp_pos2..resp_pos2_end) {
                    set response_buffer[i] = int_bytes^[ci];
                    set ci = ci + 1_u64;
                  }
                  let resp_pos3 = resp_pos2 + int_bytes_len;
                  set response_buffer[resp_pos3] = 13_u8;
                  let resp_pos3_1 = resp_pos3 + 1_u64;
                  set response_buffer[resp_pos3_1] = 10_u8;
                  let final_pos = resp_pos3 + 2_u64;
                  let send_outcome = send_all(send: &send, source: &response_buffer[0_u64..4096_u64], length: final_pos, deadline: deadline, cancel: cancel);
                  match send_outcome {
                    Ok(value: unit) => {
                      set parsed_pos = key_parse.position;
                      set handled = True();
                    }
                    Err(error: e) => {
                      break @client_loop;
                    }
                  }
                }
              } else {
                break @parse_loop;
              }
            }
          }
          if bnot(handled) {
            set parsed_pos = after_cmd;
          }
          continue @parse_loop;
        }
        Err(error: e) => {
          break @parse_loop;
        }
      }
    }
  }
  let close_recv = std::net::close_receive(factory: factory, receive: move receive);
  let close_send = std::net::close_send(factory: factory, send: move send);
  return unit;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: arg_list, drivers: unused_drivers, cwd: cwd_directory, stdout: unused_stdout, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  std::fs::close_directory(factory: &factory, directory: move cwd_read);
  let count = std::text::args_count(args: &arg_list);
  if count < 4_u64 {
    return exit_status(code: 1_u8);
  }
  let port_arg = std::text::arg_get(args: &arg_list, position: 1_u64);
  let port_u16 = 0_u16;
  match port_arg {
    Ok(value: port_str) => {
      let port_buffer = array_filled::<u8, 32>(value: 0_u8);
      let copy_result = std::text::host_copy_bytes(value: &port_str, destination: &port_buffer[0_u64..32_u64], start: 0_u64, end: 32_u64);
      match copy_result {
        Ok(value: port_len) => {
          let port_parse = parse_decimal(buffer: &port_buffer[0_u64..32_u64], start: 0_u64, end: port_len);
          match port_parse {
            Ok(value: port_val) => {
              set port_u16 = cvt::<u64, u16>(port_val);
            }
            Err(error: e) => {
              return exit_status(code: 1_u8);
            }
          }
        }
        Err(error: e) => {
          return exit_status(code: 1_u8);
        }
      }
    }
    Err(error: e) => {
      return exit_status(code: 1_u8);
    }
  }
  let addr = std::net::socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: port_u16);
  let listener_result = std::net::tcp_listen(factory: &factory, address: &addr);
  match listener_result {
    Ok(value: listener) => {
      let store = shared_map_new::<Value>(capacity: 256_u64);
      let connection_count = 0_u64;
      let no_deadline = None<Instant>();
      let cancel = std::time::cancel_never();
      loop @accept_loop {
        if connection_count >= 9_u64 {
          break @accept_loop;
        }
        let accept_result = std::net::tcp_accept(factory: &factory, listener: &listener, deadline: no_deadline, cancel: &cancel);
        match accept_result {
          Ok(value: accepted) => {
            let connection = accepted.connection;
            let store_share = shared_share::<ConcurrentHashMap<Value>>(shared: &store);
            let receive = connection.receive;
            let send = connection.send;
            spawn handle_client(factory: &factory, receive: move receive, send: move send, store: move store_share, deadline: no_deadline, cancel: &cancel);
            set connection_count = connection_count + 1_u64;
            continue @accept_loop;
          }
          Err(error: e) => {
            break @accept_loop;
          }
        }
      }
      let close_result = std::net::close_listener(factory: &factory, listener: move listener);
      std::time::close_cancel_watch(watch: move cancel);
      return exit_status(code: 0_u8);
    }
    Err(error: e) => {
      std::time::close_cancel_watch(watch: move cancel);
      return exit_status(code: 1_u8);
    }
  }
}

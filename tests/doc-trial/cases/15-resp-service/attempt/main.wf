alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias IoError = std::io::IoError;
alias ReadStop = std::io::ReadStop;
alias Instant = std::time::Instant;
alias CancelWatch = std::time::CancelWatch;
alias SocketAddress = std::net::SocketAddress;
alias TcpListener = std::net::TcpListener;
alias TcpConnection = std::net::TcpConnection;
alias TcpReceive = std::net::TcpReceive;
alias TcpSend = std::net::TcpSend;
alias Args = std::text::Args;
alias HostString = std::text::HostString;

struct StoreValue {
  bytes: Box<Slots<u8>>;
}

fn parse_port(args: &Args) -> result: Result<u16, unit> reads(args) {
  let count = std::text::args_count(args: args);
  if count < 2_u64 {
    return Err<u16, unit>(error: unit);
  }
  let port_arg = std::text::arg_get(args: args, position: 1_u64);
  let port_result = match port_arg {
    Ok(value: port_str) => {
      let len = std::text::host_bytes_len(value: &port_str);
      if len > 5_u64 {
        Err<u16, unit>(error: unit)
      } else {
        let bytes = array_filled::<u8, 5>(value: 0_u8);
        let window = &bytes[0_u64..len];
        let copy_result = std::text::host_copy_bytes(value: &port_str, destination: &bytes, start: 0_u64, end: len);
        match copy_result {
          Ok(value: copied) => {
            let port = parse_u16_decimal(digits: &bytes, length: len);
            match port {
              Some(value: p) => {
                Ok<u16, unit>(value: p)
              }
              None() => {
                Err<u16, unit>(error: unit)
              }
            }
          }
          Err(error: err) => {
            Err<u16, unit>(error: unit)
          }
        }
      }
    }
    Err(error: err) => {
      Err<u16, unit>(error: unit)
    }
  };
  return port_result;
}

fn parse_u16_decimal(digits: &[u8], length: u64) -> result: Option<u16> reads(digits) {
  if length == 0_u64 {
    return None<u16>();
  }
  let value = 0_u64;
  for (i in 0_u64..length) {
    let digit = digits^[i];
    let is_digit = band(digit >= 48_u8, digit <= 57_u8);
    if is_digit {
      let d = digit - 48_u8;
      let d_u64 = cvt::<u8, u64>(d);
      let scaled = value *wrap 10_u64;
      set value = scaled +wrap d_u64;
    } else {
      return None<u16>();
    }
  }
  if value <= 65535_u64 {
    let port = cvt::<u64, u16>(value);
    return Some<u16>(value: port);
  }
  return None<u16>();
}

fn bytes_equal(left: &[u8], right: &[u8]) -> result: Bool reads(left), reads(right) {
  let left_len = left^.len;
  let right_len = right^.len;
  if left_len != right_len {
    return False();
  }
  for (i in 0_u64..left_len) {
    if left^[i] != right^[i] {
      return False();
    }
  }
  return True();
}

fn parse_crlf(buffer: &[u8], offset: u64) -> result: Option<u64> reads(buffer) {
  let len = buffer^.len;
  let search_end = len - 1_u64;
  if offset > search_end {
    return None<u64>();
  }
  for (i in offset..search_end) {
    let current = buffer^[i];
    let next_idx = i + 1_u64;
    if next_idx < len {
      let next = buffer^[next_idx];
      if current == 13_u8 {
        if next == 10_u8 {
          return Some<u64>(value: next_idx);
        }
      }
    }
  }
  return None<u64>();
}

enum RespValue {
  RespSimpleString(bytes: Box<Slots<u8>>);
  RespError(bytes: Box<Slots<u8>>);
  RespInteger(value: i64);
  RespBulkString(bytes: Option<Box<Slots<u8>>>);
  RespArray(elements: Box<Slots<RespValue>>);
}

struct ParseState {
  buffer: Box<Slots<u8>>;
  offset: u64;
}

fn try_parse_resp(state: &ParseState) -> result: Option<RespValue> reads(state) {
  let buffer = &state^.buffer.inner;
  let offset = state^.offset;
  let len = buffer^.len;
  if offset >= len {
    return None<RespValue>();
  }
  let first = buffer^[offset];
  if first == 42_u8 {
    let array_result = try_parse_array(state: state);
    return array_result;
  }
  return None<RespValue>();
}

fn try_parse_array(state: &ParseState) -> result: Option<RespValue> reads(state) {
  let buffer = &state^.buffer.inner;
  let offset = state^.offset;
  let len = buffer^.len;
  if offset >= len {
    return None<RespValue>();
  }
  let crlf_pos = parse_crlf(buffer: buffer, offset: offset + 1_u64);
  let array_count = match crlf_pos {
    Some(value: end) => {
      let digits_end = end - 1_u64;
      let count = parse_integer_from_bytes(buffer: buffer, start: offset + 1_u64, end: digits_end);
      match count {
        Some(value: c) => {
          if c >= 0_i64 {
            let array_len = cvt::<i64, u64>(c);
            Some<u64>(value: array_len)
          } else {
            None<u64>()
          }
        }
        None() => {
          None<u64>()
        }
      }
    }
    None() => {
      None<u64>()
    }
  };
  match array_count {
    Some(value: count) => {
      let crlf_end = parse_crlf(buffer: buffer, offset: offset + 1_u64);
      match crlf_end {
        Some(value: first_crlf_end) => {
          let parse_result = parse_array_elements(state: state, offset: first_crlf_end + 1_u64, count: count, elements: slots_new::<RespValue, 10>());
          return parse_result;
        }
        None() => {
          return None<RespValue>();
        }
      }
    }
    None() => {
      return None<RespValue>();
    }
  };
}

fn parse_array_elements(state: &ParseState, offset: u64, count: u64, elements: Slots<RespValue, 10>) -> result: Option<RespValue> reads(state) {
  let buffer = &state^.buffer.inner;
  let len = buffer^.len;
  let mut_elements = elements;
  let current_offset = offset;
  let current_count = 0_u64;
  loop (
    invariant remaining: current_count <= count
  ) {
    if current_count == count {
      let element_array = RespValue::RespArray(elements: box_new::<Slots<RespValue, 10>>(value: move mut_elements));
      return Some<RespValue>(value: element_array);
    }
    if current_offset >= len {
      return None<RespValue>();
    }
    let elem = buffer^[current_offset];
    if elem == 36_u8 {
      let bulk_parse = try_parse_bulk_string(state: state, offset: current_offset);
      match bulk_parse {
        Some(value: parsed_bulk) => {
          let parsed = match parsed_bulk {
            (value: bulk_val, next_offset: next_off) => {
              (value: bulk_val, next_offset: next_off)
            }
          };
          let parsed_value = parsed.value;
          let next_off = parsed.next_offset;
          place_back(window: &mut_elements, value: move parsed_value);
          set current_offset = next_off;
          set current_count = current_count + 1_u64;
          continue;
        }
        None() => {
          return None<RespValue>();
        }
      }
    } else {
      return None<RespValue>();
    }
  };
}

fn try_parse_bulk_string(state: &ParseState, offset: u64) -> result: Option<(value: RespValue, next_offset: u64)> reads(state) {
  let buffer = &state^.buffer.inner;
  let len = buffer^.len;
  if offset >= len {
    return None<(value: RespValue, next_offset: u64)>();
  }
  if buffer^[offset] != 36_u8 {
    return None<(value: RespValue, next_offset: u64)>();
  }
  let crlf_pos = parse_crlf(buffer: buffer, offset: offset + 1_u64);
  match crlf_pos {
    Some(value: crlf_end) => {
      let length_str_end = crlf_end - 1_u64;
      let length_val = parse_integer_from_bytes(buffer: buffer, start: offset + 1_u64, end: length_str_end);
      match length_val {
        Some(value: length) => {
          if length < 0_i64 {
            let nil_bulk = RespValue::RespBulkString(bytes: None<Box<Slots<u8>>>());
            return Some<(value: RespValue, next_offset: u64)>(value: (value: nil_bulk, next_offset: crlf_end + 1_u64));
          } else {
            let data_length = cvt::<i64, u64>(length);
            let string_start = crlf_end + 1_u64;
            let string_end = string_start +wrap data_length;
            if string_end > len {
              return None<(value: RespValue, next_offset: u64)>();
            }
            let final_crlf = parse_crlf(buffer: buffer, offset: string_end);
            match final_crlf {
              Some(value: final_crlf_end) => {
                let bytes_window = &buffer^[string_start..string_end];
                let bytes_copy = box_slots_new::<u8>(capacity: data_length);
                let copy_result = copy_bytes(source: bytes_window, destination: &bytes_copy.inner);
                match copy_result {
                  Ok(value: copied) => {
                    let bulk_string = RespValue::RespBulkString(bytes: Some<Box<Slots<u8>>>(value: move bytes_copy));
                    return Some<(value: RespValue, next_offset: u64)>(value: (value: bulk_string, next_offset: final_crlf_end + 1_u64));
                  }
                  Err(error: err) => {
                    return None<(value: RespValue, next_offset: u64)>();
                  }
                }
              }
              None() => {
                return None<(value: RespValue, next_offset: u64)>();
              }
            }
          }
        }
        None() => {
          return None<(value: RespValue, next_offset: u64)>();
        }
      }
    }
    None() => {
      return None<(value: RespValue, next_offset: u64)>();
    }
  };
}

fn copy_bytes(source: &[u8], destination: &Slots<u8>) -> result: Result<unit, unit> reads(source), writes(destination) {
  let len = source^.len;
  let dest_cap = destination^.cap;
  if len > dest_cap {
    return Err<unit, unit>(error: unit);
  }
  for (i in 0_u64..len) {
    place_back(window: destination, value: source^[i]);
  }
  return Ok<unit, unit>(value: unit);
}

fn parse_integer_from_bytes(buffer: &[u8], start: u64, end: u64) -> result: Option<i64> reads(buffer) {
  if start > end {
    return None<i64>();
  }
  if start == end {
    return None<i64>();
  }
  let value = 0_i64;
  let is_negative = False();
  let first = buffer^[start];
  let offset = start;
  let neg = False();
  if first == 45_u8 {
    set neg = True();
    set offset = start + 1_u64;
  }
  if offset >= end {
    return None<i64>();
  }
  for (i in offset..end) {
    let digit = buffer^[i];
    let is_digit = band(digit >= 48_u8, digit <= 57_u8);
    if is_digit {
      let d = digit - 48_u8;
      let d_i64 = cvt::<u8, i64>(d);
      let scaled = value *wrap 10_i64;
      set value = scaled +wrap d_i64;
    } else {
      return None<i64>();
    }
  }
  if neg {
    set value = 0_i64 - value;
  }
  return Some<i64>(value: value);
}

fn execute_command(map: &Shared<ConcurrentHashMap<Box<Slots<u8>>, StoreValue>>, command: &RespValue) -> result: RespValue pure waits {
  match command {
    RespArray(elements: elems) => {
      let count = elems^.len;
      if count == 0_u64 {
        let error_msg = box_slots_new::<u8>(capacity: 8_u64);
        place_back(window: &error_msg.inner, value: 69_u8);
        place_back(window: &error_msg.inner, value: 82_u8);
        place_back(window: &error_msg.inner, value: 82_u8);
        place_back(window: &error_msg.inner, value: 79_u8);
        place_back(window: &error_msg.inner, value: 82_u8);
        return RespValue::RespError(bytes: move error_msg);
      }
      let first = &elems^[0_u64];
      let cmd_name = match first {
        RespBulkString(bytes: maybe_bytes) => {
          maybe_bytes
        }
        _ => {
          None<Box<Slots<u8>>>()
        }
      };
      match cmd_name {
        Some(value: cmd) => {
          let cmd_view = &cmd.inner;
          let ping_name = array_filled::<u8, 4>(value: 0_u8);
          set ping_name[0_u64] = 80_u8;
          set ping_name[1_u64] = 73_u8;
          set ping_name[2_u64] = 78_u8;
          set ping_name[3_u64] = 71_u8;
          let ping_view = &ping_name[0_u64..4_u64];
          let is_ping = bytes_equal(left: cmd_view, right: ping_view);
          if is_ping {
            let pong_msg = box_slots_new::<u8>(capacity: 4_u64);
            place_back(window: &pong_msg.inner, value: 80_u8);
            place_back(window: &pong_msg.inner, value: 79_u8);
            place_back(window: &pong_msg.inner, value: 78_u8);
            place_back(window: &pong_msg.inner, value: 71_u8);
            return RespValue::RespSimpleString(bytes: move pong_msg);
          }
          let set_name = array_filled::<u8, 3>(value: 0_u8);
          set set_name[0_u64] = 83_u8;
          set set_name[1_u64] = 69_u8;
          set set_name[2_u64] = 84_u8;
          let set_view = &set_name[0_u64..3_u64];
          let is_set = bytes_equal(left: cmd_view, right: set_view);
          if is_set {
            if count == 3_u64 {
              let key_elem = &elems^[1_u64];
              let val_elem = &elems^[2_u64];
              let key_val = match key_elem {
                RespBulkString(bytes: maybe_key) => {
                  maybe_key
                }
                _ => {
                  None<Box<Slots<u8>>>()
                }
              };
              let val_val = match val_elem {
                RespBulkString(bytes: maybe_val) => {
                  maybe_val
                }
                _ => {
                  None<Box<Slots<u8>>>()
                }
              };
              match key_val {
                Some(value: key_box) => {
                  match val_val {
                    Some(value: val_box) => {
                      atomic slot = &map[&key_box.inner] {
                        set slot^ = Some<StoreValue>(value: StoreValue(bytes: move val_box));
                      }
                      let ok_msg = box_slots_new::<u8>(capacity: 2_u64);
                      place_back(window: &ok_msg.inner, value: 79_u8);
                      place_back(window: &ok_msg.inner, value: 75_u8);
                      return RespValue::RespSimpleString(bytes: move ok_msg);
                    }
                    None() => {
                      let error = box_slots_new::<u8>(capacity: 20_u64);
                      return RespValue::RespError(bytes: move error);
                    }
                  }
                }
                None() => {
                  let error = box_slots_new::<u8>(capacity: 20_u64);
                  return RespValue::RespError(bytes: move error);
                }
              }
            } else {
              let error_msg = box_slots_new::<u8>(capacity: 5_u64);
              return RespValue::RespError(bytes: move error_msg);
            }
          }
          let get_name = array_filled::<u8, 3>(value: 0_u8);
          set get_name[0_u64] = 71_u8;
          set get_name[1_u64] = 69_u8;
          set get_name[2_u64] = 84_u8;
          let get_view = &get_name[0_u64..3_u64];
          let is_get = bytes_equal(left: cmd_view, right: get_view);
          if is_get {
            if count == 2_u64 {
              let key_elem = &elems^[1_u64];
              let key_val = match key_elem {
                RespBulkString(bytes: maybe_key) => {
                  maybe_key
                }
                _ => {
                  None<Box<Slots<u8>>>()
                }
              };
              match key_val {
                Some(value: key_box) => {
                  let found = False();
                  let result_value = None<Box<Slots<u8>>>();
                  atomic slot = &map[&key_box.inner] {
                    match slot^ {
                      Some(value: stored) => {
                        set found = True();
                        set result_value = Some<Box<Slots<u8>>>(value: move stored.bytes);
                      }
                      None() => {
                      }
                    }
                  }
                  return RespValue::RespBulkString(bytes: move result_value);
                }
                None() => {
                  return RespValue::RespBulkString(bytes: None<Box<Slots<u8>>>());
                }
              }
            } else {
              let error_msg = box_slots_new::<u8>(capacity: 5_u64);
              return RespValue::RespError(bytes: move error_msg);
            }
          }
          let del_name = array_filled::<u8, 3>(value: 0_u8);
          set del_name[0_u64] = 68_u8;
          set del_name[1_u64] = 69_u8;
          set del_name[2_u64] = 76_u8;
          let del_view = &del_name[0_u64..3_u64];
          let is_del = bytes_equal(left: cmd_view, right: del_view);
          if is_del {
            if count == 2_u64 {
              let key_elem = &elems^[1_u64];
              let key_val = match key_elem {
                RespBulkString(bytes: maybe_key) => {
                  maybe_key
                }
                _ => {
                  None<Box<Slots<u8>>>()
                }
              };
              match key_val {
                Some(value: key_box) => {
                  let existed = False();
                  atomic slot = &map[&key_box.inner] {
                    match slot^ {
                      Some(value: val) => {
                        set existed = True();
                        set slot^ = None<StoreValue>();
                      }
                      None() => {
                      }
                    }
                  }
                  let result = if existed {
                    give 1_i64;
                  } else {
                    give 0_i64;
                  };
                  return RespValue::RespInteger(value: result);
                }
                None() => {
                  return RespValue::RespInteger(value: 0_i64);
                }
              }
            } else {
              let error_msg = box_slots_new::<u8>(capacity: 5_u64);
              return RespValue::RespError(bytes: move error_msg);
            }
          }
          let incr_name = array_filled::<u8, 4>(value: 0_u8);
          set incr_name[0_u64] = 73_u8;
          set incr_name[1_u64] = 78_u8;
          set incr_name[2_u64] = 67_u8;
          set incr_name[3_u64] = 82_u8;
          let incr_view = &incr_name[0_u64..4_u64];
          let is_incr = bytes_equal(left: cmd_view, right: incr_view);
          if is_incr {
            if count == 2_u64 {
              let key_elem = &elems^[1_u64];
              let key_val = match key_elem {
                RespBulkString(bytes: maybe_key) => {
                  maybe_key
                }
                _ => {
                  None<Box<Slots<u8>>>()
                }
              };
              match key_val {
                Some(value: key_box) => {
                  let result = 0_i64;
                  let error = False();
                  atomic slot = &map[&key_box.inner] {
                    match slot^ {
                      Some(value: stored) => {
                        let int_result = parse_i64_from_bytes(bytes: &stored.bytes.inner);
                        match int_result {
                          Some(value: current) => {
                            let incremented = current +wrap 1_i64;
                            let incremented_bytes = box_slots_new::<u8>(capacity: 20_u64);
                            let format_ok = format_i64(value: incremented, output: &incremented_bytes.inner);
                            if format_ok {
                              set slot^ = Some<StoreValue>(value: StoreValue(bytes: move incremented_bytes));
                              set result = incremented;
                            } else {
                              set error = True();
                            }
                          }
                          None() => {
                            set error = True();
                          }
                        }
                      }
                      None() => {
                        let incremented_bytes = box_slots_new::<u8>(capacity: 20_u64);
                        let format_ok = format_i64(value: 1_i64, output: &incremented_bytes.inner);
                        if format_ok {
                          set slot^ = Some<StoreValue>(value: StoreValue(bytes: move incremented_bytes));
                          set result = 1_i64;
                        } else {
                          set error = True();
                        }
                      }
                    }
                  }
                  if error {
                    let err_msg = box_slots_new::<u8>(capacity: 50_u64);
                    place_back(window: &err_msg.inner, value: 69_u8);
                    place_back(window: &err_msg.inner, value: 82_u8);
                    place_back(window: &err_msg.inner, value: 82_u8);
                    place_back(window: &err_msg.inner, value: 32_u8);
                    place_back(window: &err_msg.inner, value: 118_u8);
                    place_back(window: &err_msg.inner, value: 97_u8);
                    place_back(window: &err_msg.inner, value: 108_u8);
                    place_back(window: &err_msg.inner, value: 117_u8);
                    place_back(window: &err_msg.inner, value: 101_u8);
                    place_back(window: &err_msg.inner, value: 32_u8);
                    place_back(window: &err_msg.inner, value: 105_u8);
                    place_back(window: &err_msg.inner, value: 115_u8);
                    place_back(window: &err_msg.inner, value: 32_u8);
                    place_back(window: &err_msg.inner, value: 110_u8);
                    place_back(window: &err_msg.inner, value: 111_u8);
                    place_back(window: &err_msg.inner, value: 116_u8);
                    place_back(window: &err_msg.inner, value: 32_u8);
                    place_back(window: &err_msg.inner, value: 97_u8);
                    place_back(window: &err_msg.inner, value: 110_u8);
                    place_back(window: &err_msg.inner, value: 32_u8);
                    place_back(window: &err_msg.inner, value: 105_u8);
                    place_back(window: &err_msg.inner, value: 110_u8);
                    place_back(window: &err_msg.inner, value: 116_u8);
                    place_back(window: &err_msg.inner, value: 101_u8);
                    place_back(window: &err_msg.inner, value: 103_u8);
                    place_back(window: &err_msg.inner, value: 101_u8);
                    place_back(window: &err_msg.inner, value: 114_u8);
                    place_back(window: &err_msg.inner, value: 32_u8);
                    place_back(window: &err_msg.inner, value: 111_u8);
                    place_back(window: &err_msg.inner, value: 114_u8);
                    place_back(window: &err_msg.inner, value: 32_u8);
                    place_back(window: &err_msg.inner, value: 111_u8);
                    place_back(window: &err_msg.inner, value: 117_u8);
                    place_back(window: &err_msg.inner, value: 116_u8);
                    place_back(window: &err_msg.inner, value: 32_u8);
                    place_back(window: &err_msg.inner, value: 111_u8);
                    place_back(window: &err_msg.inner, value: 102_u8);
                    place_back(window: &err_msg.inner, value: 32_u8);
                    place_back(window: &err_msg.inner, value: 114_u8);
                    place_back(window: &err_msg.inner, value: 97_u8);
                    place_back(window: &err_msg.inner, value: 110_u8);
                    place_back(window: &err_msg.inner, value: 103_u8);
                    place_back(window: &err_msg.inner, value: 101_u8);
                    return RespValue::RespError(bytes: move err_msg);
                  }
                  return RespValue::RespInteger(value: result);
                }
                None() => {
                  let incremented_bytes = box_slots_new::<u8>(capacity: 20_u64);
                  let format_ok = format_i64(value: 1_i64, output: &incremented_bytes.inner);
                  if format_ok {
                    return RespValue::RespInteger(value: 1_i64);
                  } else {
                    let err_msg = box_slots_new::<u8>(capacity: 50_u64);
                    return RespValue::RespError(bytes: move err_msg);
                  }
                }
              }
            } else {
              let error_msg = box_slots_new::<u8>(capacity: 5_u64);
              return RespValue::RespError(bytes: move error_msg);
            }
          }
          let error_msg = box_slots_new::<u8>(capacity: 5_u64);
          return RespValue::RespError(bytes: move error_msg);
        }
        None() => {
          let error_msg = box_slots_new::<u8>(capacity: 5_u64);
          return RespValue::RespError(bytes: move error_msg);
        }
      }
    }
    _ => {
      let error_msg = box_slots_new::<u8>(capacity: 5_u64);
      return RespValue::RespError(bytes: move error_msg);
    }
  };
}

fn parse_i64_from_bytes(bytes: &Slots<u8>) -> result: Option<i64> reads(bytes) {
  let len = bytes^.len;
  if len == 0_u64 {
    return None<i64>();
  }
  let value = 0_i64;
  let is_negative = False();
  let first = bytes^[0_u64];
  let offset = 0_u64;
  let neg = False();
  if first == 45_u8 {
    set neg = True();
    set offset = 1_u64;
  }
  if offset >= len {
    return None<i64>();
  }
  for (i in offset..len) {
    let digit = bytes^[i];
    let is_digit = band(digit >= 48_u8, digit <= 57_u8);
    if is_digit {
      let d = digit - 48_u8;
      let d_i64 = cvt::<u8, i64>(d);
      let scaled = value *wrap 10_i64;
      set value = scaled +wrap d_i64;
    } else {
      return None<i64>();
    }
  }
  if neg {
    set value = 0_i64 - value;
  }
  return Some<i64>(value: value);
}

fn format_i64(value: i64, output: &Slots<u8>) -> result: Bool writes(output) {
  let to_format = value;
  let is_negative = to_format < 0_i64;
  let abs_val = if is_negative {
    give 0_i64 - to_format;
  } else {
    give to_format;
  };
  let digits = array_filled::<u8, 20>(value: 0_u8);
  let digit_count = 0_u64;
  let temp = abs_val;
  loop (
    invariant bounded: digit_count <= 20_u64
  ) {
    if temp == 0_i64 {
      break;
    }
    let remainder = temp %wrap 10_i64;
    let digit = cvt::<i64, u8>(remainder);
    let digit_char = digit + 48_u8;
    set digits[digit_count] = digit_char;
    set digit_count = digit_count + 1_u64;
    set temp = temp / 10_i64;
  }
  if digit_count == 0_u64 {
    if output^.cap >= 1_u64 {
      place_back(window: output, value: 48_u8);
      return True();
    } else {
      return False();
    }
  }
  let total_len = if is_negative {
    give digit_count + 1_u64;
  } else {
    give digit_count;
  };
  if output^.cap < total_len {
    return False();
  }
  if is_negative {
    place_back(window: output, value: 45_u8);
  }
  for (i in 0_u64..digit_count) {
    let idx = digit_count - 1_u64 - i;
    place_back(window: output, value: digits[idx]);
  }
  return True();
}

fn resp_to_bytes(value: &RespValue) -> result: Box<Slots<u8>> reads(value) {
  match value {
    RespSimpleString(bytes: msg) => {
      let result = box_slots_new::<u8>(capacity: msg^.inner.len + 2_u64);
      place_back(window: &result.inner, value: 43_u8);
      for (i in 0_u64..msg^.inner.len) {
        place_back(window: &result.inner, value: msg^.inner[i]);
      }
      place_back(window: &result.inner, value: 13_u8);
      place_back(window: &result.inner, value: 10_u8);
      return move result;
    }
    RespError(bytes: msg) => {
      let result = box_slots_new::<u8>(capacity: msg^.inner.len + 2_u64);
      place_back(window: &result.inner, value: 45_u8);
      for (i in 0_u64..msg^.inner.len) {
        place_back(window: &result.inner, value: msg^.inner[i]);
      }
      place_back(window: &result.inner, value: 13_u8);
      place_back(window: &result.inner, value: 10_u8);
      return move result;
    }
    RespInteger(value: num) => {
      let result = box_slots_new::<u8>(capacity: 25_u64);
      place_back(window: &result.inner, value: 58_u8);
      let format_ok = format_i64(value: num, output: &result.inner);
      place_back(window: &result.inner, value: 13_u8);
      place_back(window: &result.inner, value: 10_u8);
      return move result;
    }
    RespBulkString(bytes: maybe_bytes) => {
      match maybe_bytes {
        Some(value: bytes_box) => {
          let len = bytes_box^.inner.len;
          let len_str = format_u64_to_bytes(value: len);
          let result = box_slots_new::<u8>(capacity: len + 6_u64 + len_str.inner.len);
          place_back(window: &result.inner, value: 36_u8);
          for (i in 0_u64..len_str.inner.len) {
            place_back(window: &result.inner, value: len_str.inner[i]);
          }
          place_back(window: &result.inner, value: 13_u8);
          place_back(window: &result.inner, value: 10_u8);
          for (i in 0_u64..len) {
            place_back(window: &result.inner, value: bytes_box^.inner[i]);
          }
          place_back(window: &result.inner, value: 13_u8);
          place_back(window: &result.inner, value: 10_u8);
          return move result;
        }
        None() => {
          let result = box_slots_new::<u8>(capacity: 5_u64);
          place_back(window: &result.inner, value: 36_u8);
          place_back(window: &result.inner, value: 45_u8);
          place_back(window: &result.inner, value: 49_u8);
          place_back(window: &result.inner, value: 13_u8);
          place_back(window: &result.inner, value: 10_u8);
          return move result;
        }
      }
    }
    RespArray(elements: elems) => {
      let result = box_slots_new::<u8>(capacity: 1024_u64);
      return move result;
    }
  };
}

fn format_u64_to_bytes(value: u64) -> result: Box<Slots<u8>> pure {
  let digits = array_filled::<u8, 20>(value: 0_u8);
  let digit_count = 0_u64;
  let temp = value;
  loop (
    invariant bounded: digit_count <= 20_u64
  ) {
    if temp == 0_u64 {
      break;
    }
    let remainder = temp %wrap 10_u64;
    let digit = cvt::<u64, u8>(remainder);
    let digit_char = digit + 48_u8;
    set digits[digit_count] = digit_char;
    set digit_count = digit_count + 1_u64;
    set temp = temp / 10_u64;
  }
  let result = box_slots_new::<u8>(capacity: digit_count);
  if digit_count == 0_u64 {
    place_back(window: &result.inner, value: 48_u8);
  } else {
    for (i in 0_u64..digit_count) {
      let idx = digit_count - 1_u64 - i;
      place_back(window: &result.inner, value: digits[idx]);
    }
  }
  return move result;
}

fn handle_connection(factory: &HandleFactory, connection: TcpConnection, map: Shared<ConcurrentHashMap<Box<Slots<u8>>, StoreValue>>, cancel: &CancelWatch) -> result: unit reads(cancel), writes(factory) waits {
  let receive = move connection.receive;
  let send = move connection.send;
  let buffer = box_slots_new::<u8>(capacity: 4096_u64);
  let parse_offset = 0_u64;
  loop @receive_loop {
    let deadline = None<Instant>();
    let read_result = std::net::receive_next(receive: &receive, destination: &buffer.inner, start: buffer.inner.len, end: 4096_u64, deadline: deadline, cancel: cancel);
    match read_result {
      Ok(value: next) => {
        set parse_offset = 0_u64;
        loop @parse_loop {
          let state = ParseState(buffer: move buffer, offset: parse_offset);
          let parse_result = try_parse_resp(state: &state);
          match parse_result {
            Some(value: parsed_command) => {
              set buffer = move state.buffer;
              let response = execute_command(map: &map, command: &parsed_command);
              let response_bytes = resp_to_bytes(value: &response);
              let send_result = std::net::send_once(send: &send, source: &response_bytes.inner, start: 0_u64, end: response_bytes.inner.len, deadline: None<Instant>(), cancel: cancel);
              match send_result {
                Ok(value: sent) => {
                }
                Err(error: err) => {
                  break @receive_loop;
                }
              }
              set parse_offset = state.offset;
              continue @parse_loop;
            }
            None() => {
              set buffer = move state.buffer;
              break @parse_loop;
            }
          }
        }
      }
      Err(error: stop) => {
        break @receive_loop;
      }
    }
  }
  let close_recv_result = std::net::close_receive(factory: factory, receive: move receive);
  let close_send_result = std::net::close_send(factory: factory, send: move send);
  return unit;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: program_args, drivers: driver_count, cwd: cwd_dir, stdout: unused_stdout, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_dir;
  std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  std::fs::close_directory(factory: &factory, directory: move cwd_read);
  let port_result = parse_port(args: &program_args);
  match port_result {
    Ok(value: port) => {
      let addr = std::net::socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: port);
      let listen_result = std::net::tcp_listen(factory: &factory, address: &addr);
      match listen_result {
        Ok(value: listener) => {
          let kv_map = shared_new::<ConcurrentHashMap<Box<Slots<u8>>, StoreValue>>(value: hash_map_new::<Box<Slots<u8>>, StoreValue, 256>(capacity: 64_u64));
          let client_count = 0_u64;
          let cancel = std::time::cancel_never();
          loop @accept_loop {
            if client_count < 9_u64 {
              let accept_result = std::net::tcp_accept(factory: &factory, listener: &listener, deadline: None<Instant>(), cancel: &cancel);
              match accept_result {
                Ok(value: accepted) => {
                  let connection = accepted.connection;
                  let shared_map = shared_share::<ConcurrentHashMap<Box<Slots<u8>>, StoreValue>>(shared: &kv_map);
                  spawn handle_connection(factory: &factory, connection: move connection, map: move shared_map, cancel: &cancel);
                  set client_count = client_count + 1_u64;
                  continue @accept_loop;
                }
                Err(error: err) => {
                  break @accept_loop;
                }
              }
            } else {
              break @accept_loop;
            }
          }
          std::time::close_cancel_watch(watch: move cancel);
          let close_listener_result = std::net::close_listener(factory: &factory, listener: move listener);
        }
        Err(error: err) => {
          std::time::close_cancel_watch(watch: std::time::cancel_never());
          return exit_status(code: 1_u8);
        }
      }
    }
    Err(error: err) => {
      std::time::close_cancel_watch(watch: std::time::cancel_never());
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}

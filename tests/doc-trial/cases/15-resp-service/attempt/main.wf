alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias ReadStop = std::io::ReadStop;
alias SocketAddress = std::net::SocketAddress;
alias TcpListener = std::net::TcpListener;
alias TcpConnection = std::net::TcpConnection;
alias TcpReceive = std::net::TcpReceive;
alias TcpSend = std::net::TcpSend;
alias Instant = std::time::Instant;
alias CancelWatch = std::time::CancelWatch;
alias Args = std::text::Args;
alias HashMap = std::collections::hash_map::HashMap<Box<Array<u8>>, Box<Array<u8>>, 8192>;

const PONG: Array<u8, 7> = "+PONG\r\n";
const OK: Array<u8, 5> = "+OK\r\n";
const NULL_BULK: Array<u8, 5> = "$-1\r\n";
const ONE: Array<u8, 4> = ":1\r\n";
const ZERO: Array<u8, 4> = ":0\r\n";
const ERR_INT: Array<u8, 48> = "-ERR value is not an integer or out of range\r\n";

fn parse_u64(bytes: &[u8]) -> result: Option<u64> reads(bytes) {
  if bytes^.len == 0_u64 {
    return None<u64>();
  }
  let result = 0_u64;
  for (i in 0_u64..bytes^.len) {
    let ch = bytes^[i];
    if ch < 48_u8 {
      return None<u64>();
    }
    if ch > 57_u8 {
      return None<u64>();
    }
    let digit = ch - 48_u8;
    let d = cvt::<u8, u64>(digit);
    set result = result *wrap 10_u64;
    set result = result +wrap d;
  }
  return Some<u64>(value: result);
}

fn parse_i64(bytes: &[u8]) -> result: Option<i64> reads(bytes) {
  if bytes^.len == 0_u64 {
    return None<i64>();
  }
  let negative = bytes^[0_u64] == 45_u8;
  let start = if negative { give 1_u64; } else { give 0_u64; };
  if start >= bytes^.len {
    return None<i64>();
  }
  let result = 0_i64;
  for (i in start..bytes^.len) {
    let ch = bytes^[i];
    if ch < 48_u8 {
      return None<i64>();
    }
    if ch > 57_u8 {
      return None<i64>();
    }
    let digit = ch - 48_u8;
    let d = cvt::<u8, i64>(digit);
    set result = result *wrap 10_i64;
    if negative {
      set result = result -wrap d;
    } else {
      set result = result +wrap d;
    }
  }
  return Some<i64>(value: result);
}

fn bytes_equal(left: &[u8], right: &[u8]) -> result: Bool reads(left), reads(right) {
  if left^.len != right^.len {
    return False();
  }
  for (i in 0_u64..left^.len) {
    if left^[i] != right^[i] {
      return False();
    }
  }
  return True();
}

fn case_equal(left: &[u8], right: &[u8]) -> result: Bool reads(left), reads(right) {
  if left^.len != right^.len {
    return False();
  }
  for (i in 0_u64..left^.len) {
    let lc = left^[i];
    let rc = right^[i];
    let l_upper = if lc >= 97_u8 { if lc <= 122_u8 { give lc - 32_u8; } else { give lc; } } else { give lc; };
    let r_upper = if rc >= 97_u8 { if rc <= 122_u8 { give rc - 32_u8; } else { give rc; } } else { give rc; };
    if l_upper != r_upper {
      return False();
    }
  }
  return True();
}

fn hash_bytes(key: &[u8]) -> result: u64 reads(key) {
  let result = 0_u64;
  for (i in 0_u64..key^.len) {
    let b = cvt::<u8, u64>(key^[i]);
    set result = result *wrap 31_u64;
    set result = result +wrap b;
  }
  return result;
}

interface KeyOps {
  fn hash_key(env: &unit, key: &Box<Array<u8>>) -> hash: u64 reads(key);
  fn equal_key(env: &unit, left: &Box<Array<u8>>, right: &Box<Array<u8>>) -> equal: Bool reads(left), reads(right);
}

fn hash_impl(env: &unit, key: &Box<Array<u8>>) -> hash: u64 reads(key) {
  return hash_bytes(&key^[0_u64..key^.len]);
}

fn equal_impl(env: &unit, left: &Box<Array<u8>>, right: &Box<Array<u8>>) -> equal: Bool reads(left), reads(right) {
  return bytes_equal(&left^[0_u64..left^.len], &right^[0_u64..right^.len]);
}

binding KeyBinding : KeyOps {
  hash_key = hash_impl;
  equal_key = equal_impl;
}

fn copy_array(src: &[u8], dst: &[u8]) -> result: unit reads(src), writes(dst) {
  let len = if src^.len < dst^.len { give src^.len; } else { give dst^.len; };
  for (i in 0_u64..len) {
    set dst^[i] = src^[i];
  }
  return unit;
}

fn i64_to_resp(value: i64, buf: &[u8]) -> result: u64 writes(buf) {
  let negative = value < 0_i64;
  let abs_val = if negative { give 0_i64 - value; } else { give value; };
  let digits = 0_u64;
  let temp = abs_val;
  loop {
    if temp == 0_i64 {
      break;
    }
    set digits = digits + 1_u64;
    set temp = temp / 10_i64;
  }
  if digits == 0_u64 {
    set digits = 1_u64;
  }
  let pos = if negative { give digits + 1_u64; } else { give digits; };
  if negative {
    set buf^[0_u64] = 45_u8;
  }
  set temp = abs_val;
  loop {
    if temp == 0_i64 {
      break;
    }
    let digit = temp %wrap 10_i64;
    let d = cvt::<i64, u8>(digit);
    set pos = pos - 1_u64;
    set buf^[pos] = d + 48_u8;
    set temp = temp / 10_i64;
  }
  if digits == 1_u64 {
    set buf^[0_u64] = 48_u8;
  }
  return if negative { give digits + 1_u64; } else { give digits; };
}


fn send_all(send: &TcpSend, factory: &HandleFactory, data: &[u8]) -> result: unit reads(data), writes(factory), writes(send) waits {
  let sent = 0_u64;
  loop {
    if sent >= data^.len {
      break;
    }
    let no_deadline = None<Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::net::send_once(send: send, source: data, start: sent, end: data^.len, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match move outcome {
      Ok(value: next_sent) => {
        set sent = next_sent;
      }
      Err(error: send_err) => {
        return unit;
      }
    }
  }
  return unit;
}

fn handle_client(factory: &HandleFactory, conn: TcpConnection, store: &Shared<HashMap>) -> result: unit reads(store), writes(factory) waits {
  let receive = move conn.receive;
  let send = move conn.send;
  let buffer = box_slots_new::<u8>(capacity: 32768_u64);
  let send_buf = array_filled::<u8, 16384>(value: 0_u8);
  loop {
    let no_deadline = None<Instant>();
    let cancel = std::time::cancel_never();
    let buf_start = buffer.inner.len;
    let buf_end = if buffer.inner.cap > buf_start + 4096_u64 { give buf_start + 4096_u64; } else { give buffer.inner.cap; };
    let outcome = std::net::receive_next(receive: &receive, destination: &buffer.inner, start: buf_start, end: buf_end, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match move outcome {
      Ok(value: next_bytes) => {
      }
      Err(error: stop) => {
        match stop {
          ReadEnd() => {
            break;
          }
          ReadFailed(error: read_problem) => {
            break;
          }
        }
      }
    }
  }
  let recv_closed = std::net::close_receive(factory: factory, receive: move receive);
  let send_closed = std::net::close_send(factory: factory, send: move send);
  return unit;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: argv, drivers: program_drivers, cwd: directory, stdout: program_stdout, stderr: program_stderr, handles: factory, stdin: program_stdin, clock: program_clock, wall_clock: program_wall_clock, stops: program_stops, memory_meter: program_meter) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move directory;
  let write_closed = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let read_closed = std::fs::close_directory(factory: &factory, directory: move cwd_read);
  let arg_count = std::text::args_count(args: &argv);
  if arg_count < 4_u64 {
    return exit_status(code: 1_u8);
  }
  let port_arg = std::text::arg_get(args: &argv, position: 1_u64);
  let port_num = 0_u16;
  match move port_arg {
    Ok(value: port_str) => {
      let port_buf = array_filled::<u8, 16>(value: 0_u8);
      let port_len = std::text::host_bytes_len(value: &port_str);
      if port_len > 5_u64 {
        return exit_status(code: 1_u8);
      }
      let copy_result = std::text::host_copy_bytes(value: &port_str, destination: &port_buf[0_u64..16_u64], start: 0_u64, end: 16_u64);
      match move copy_result {
        Ok(value: end_idx) => {
          let port_view = &port_buf[0_u64..end_idx];
          let port_opt = parse_u64(port_view);
          match move port_opt {
            Some(value: port_u64) => {
              if port_u64 > 65535_u64 {
                return exit_status(code: 1_u8);
              }
              set port_num = cvt::<u64, u16>(port_u64);
            }
            None() => {
              return exit_status(code: 1_u8);
            }
          }
        }
        Err(error: copy_err) => {
          return exit_status(code: 1_u8);
        }
      }
    }
    Err(error: arg_err) => {
      return exit_status(code: 1_u8);
    }
  }
  let addr = std::net::socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: port_num);
  let listen_result = std::net::tcp_listen(factory: &factory, address: &addr);
  let listener = match move listen_result {
    Ok(value: l) => {
      give l;
    }
    Err(error: listen_err) => {
      return exit_status(code: 1_u8);
    }
  };
  let map = std::collections::hash_map::hash_map_new::<Box<Array<u8>>, Box<Array<u8>>, 8192>(capacity: 16_u64);
  let store = shared_new::<HashMap>(value: move map);
  let clients = 0_u64;
  loop {
    let no_deadline = None<Instant>();
    let cancel = std::time::cancel_never();
    let acc_result = std::net::tcp_accept(factory: &factory, listener: &listener, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match move acc_result {
      Ok(value: accepted) => {
        let conn = move accepted.connection;
        let shared_factory = std::io::factory_share(factory: &factory);
        let shared_store = shared_share::<HashMap>(shared: &store);
        spawn handle_client(factory: move shared_factory, conn: move conn, store: move shared_store);
        set clients = clients + 1_u64;
        if clients >= 9_u64 {
          break;
        }
      }
      Err(error: accept_err) => {
        break;
      }
    }
  }
  let listener_closed = std::net::close_listener(factory: &factory, listener: move listener);
  return exit_status(code: 0_u8);
}

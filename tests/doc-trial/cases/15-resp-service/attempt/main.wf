alias HandleFactory = std::io::HandleFactory;
alias IoError = std::io::IoError;
alias ReadStop = std::io::ReadStop;
alias TcpListener = std::net::TcpListener;
alias TcpReceive = std::net::TcpReceive;
alias TcpSend = std::net::TcpSend;
alias Instant = std::time::Instant;
alias CancelWatch = std::time::CancelWatch;
alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;

struct BulkStringParsed {
  data: Slots<u8>;
  next_pos: u64;
}

struct CommandParsed {
  elements: Slots<Slots<u8>>;
  consumed: u64;
}

fn parse_bulk_string(buffer: &[u8], start: u64) -> result: Result<BulkStringParsed, u64> reads(buffer) {
  let buffer_len = buffer^.len;
  if start >= buffer_len {
    return Err<BulkStringParsed, u64>(error: 0_u64);
  }
  if buffer^[start] != 36_u8 {
    return Err<BulkStringParsed, u64>(error: 1_u64);
  }
  let pos = start +wrap 1_u64;
  let len_end = pos;
  loop @find_len_end {
    if len_end >= buffer_len {
      return Err<BulkStringParsed, u64>(error: 0_u64);
    }
    if buffer^[len_end] == 13_u8 {
      break @find_len_end;
    }
    set len_end = len_end +wrap 1_u64;
  }
  let len_str = &buffer^[pos..len_end];
  let len_value = 0_u64;
  for (i in 0_u64..len_str^.len) {
    let byte = len_str^[i];
    if byte < 48_u8 {
      return Err<BulkStringParsed, u64>(error: 1_u64);
    }
    if byte > 57_u8 {
      return Err<BulkStringParsed, u64>(error: 1_u64);
    }
    let digit = byte - 48_u8;
    let digit_u64 = cvt::<u8, u64>(digit);
    set len_value = len_value *wrap 10_u64;
    set len_value = len_value +wrap digit_u64;
  }
  let data_start = len_end +wrap 2_u64;
  let data_end = data_start +wrap len_value;
  let check_end = data_end +wrap 2_u64;
  if check_end > buffer_len {
    return Err<BulkStringParsed, u64>(error: 0_u64);
  }
  if buffer^[data_end] != 13_u8 {
    return Err<BulkStringParsed, u64>(error: 1_u64);
  }
  let cr_pos = data_end +wrap 1_u64;
  if buffer^[cr_pos] != 10_u8 {
    return Err<BulkStringParsed, u64>(error: 1_u64);
  }
  let data = slots_new::<u8, 4096>();
  for (i in 0_u64..len_value) {
    let byte_pos = data_start +wrap i;
    let byte = buffer^[byte_pos];
    place_back(window: &data, value: byte);
  }
  let next_pos = data_end +wrap 2_u64;
  let parsed = BulkStringParsed(data: move data, next_pos: next_pos);
  return Ok<BulkStringParsed, u64>(value: move parsed);
}

fn parse_command(buffer: &[u8]) -> result: Result<CommandParsed, u64> reads(buffer) {
  let buffer_len = buffer^.len;
  if buffer_len == 0_u64 {
    return Err<CommandParsed, u64>(error: 0_u64);
  }
  if buffer^[0_u64] != 42_u8 {
    return Err<CommandParsed, u64>(error: 1_u64);
  }
  let pos = 1_u64;
  let count_end = pos;
  loop @find_count_end {
    if count_end >= buffer_len {
      return Err<CommandParsed, u64>(error: 0_u64);
    }
    if buffer^[count_end] == 13_u8 {
      break @find_count_end;
    }
    set count_end = count_end +wrap 1_u64;
  }
  let count_str = &buffer^[pos..count_end];
  let count = 0_u64;
  for (i in 0_u64..count_str^.len) {
    let byte = count_str^[i];
    if byte < 48_u8 {
      return Err<CommandParsed, u64>(error: 1_u64);
    }
    if byte > 57_u8 {
      return Err<CommandParsed, u64>(error: 1_u64);
    }
    let digit = byte - 48_u8;
    let digit_u64 = cvt::<u8, u64>(digit);
    set count = count *wrap 10_u64;
    set count = count +wrap digit_u64;
  }
  let elements = slots_new::<Slots<u8>, 16>();
  set pos = count_end +wrap 2_u64;
  let elem_idx = 0_u64;
  loop @parse_elements {
    if elem_idx >= count {
      break @parse_elements;
    }
    let parse_result = parse_bulk_string(buffer, pos);
    match parse_result {
      Ok(value: parsed) => {
        let data = parsed.data;
        let next_pos = parsed.next_pos;
        place_back(window: &elements, value: move data);
        set pos = next_pos;
        set elem_idx = elem_idx +wrap 1_u64;
        continue @parse_elements;
      }
      Err(error: err) => {
        return Err<CommandParsed, u64>(error: err);
      }
    }
  }
  let cmd_parsed = CommandParsed(elements: move elements, consumed: pos);
  return Ok<CommandParsed, u64>(value: move cmd_parsed);
}

fn bytes_to_i64(bytes: &Slots<u8>) -> result: Result<i64, unit> reads(bytes) {
  let len = bytes.len;
  if len == 0_u64 {
    return Err<i64, unit>(error: unit);
  }
  let negative = False();
  let start = 0_u64;
  let first = bytes[0_u64];
  if first == 45_u8 {
    set negative = True();
    set start = 1_u64;
  }
  let value = 0_i64;
  for (i in start..len) {
    let byte = bytes[i];
    if byte < 48_u8 {
      return Err<i64, unit>(error: unit);
    }
    if byte > 57_u8 {
      return Err<i64, unit>(error: unit);
    }
    let digit = byte - 48_u8;
    let digit_i64 = cvt::<u8, i64>(digit);
    set value = value *wrap 10_i64;
    set value = value +wrap digit_i64;
  }
  if negative {
    set value = 0_i64 - value;
  }
  return Ok<i64, unit>(value: value);
}

fn bytes_equal(a: &Slots<u8>, b: &Slots<u8>) -> result: Bool reads(a), reads(b) {
  let a_len = a.len;
  let b_len = b.len;
  if a_len != b_len {
    return False();
  }
  for (i in 0_u64..a_len) {
    if a[i] != b[i] {
      return False();
    }
  }
  return True();
}

fn send_all(send: &TcpSend, factory: &HandleFactory, data: &[u8], deadline: Instant, cancel: &CancelWatch) -> result: unit pure waits {
  let sent = 0_u64;
  let data_len = data^.len;
  loop @sending {
    if sent < data_len {
    } else {
      break @sending;
    }
    match std::net::send_once(send: send, source: data, start: sent, end: data_len, deadline: Some<Instant>(value: deadline), cancel: cancel) {
      Ok(value: next) => {
        set sent = next;
        continue @sending;
      }
      Err(error: problem) => {
        break @sending;
      }
    }
  }
  return unit;
}

fn handle_connection(store: Shared<unit>, send: TcpSend, receive: TcpReceive, factory: HandleFactory, deadline: Instant, cancel: CancelWatch) -> result: unit pure waits {
  let buffer = array_filled::<u8, 16384>(value: 0_u8);
  let buffer_len = 0_u64;
  loop @request_loop {
    let parse_result = parse_command(&buffer[0_u64..buffer_len]);
    match parse_result {
      Ok(value: parsed) => {
        let cmd_args = parsed.elements;
        let consumed = parsed.consumed;
        if cmd_args.len > 0_u64 {
          let cmd = &cmd_args[0_u64];
          let pong_msg = "+PONG\r\n";
          let ok_msg = "+OK\r\n";
          let nil_msg = "$-1\r\n";
          let err_msg = "-ERR value is not an integer or out of range\r\n";
          let del_0_msg = ":0\r\n";
          let del_1_msg = ":1\r\n";
          if cmd.len == 4_u64 {
            if band(band(cmd[0_u64] == 80_u8, cmd[1_u64] == 73_u8), band(cmd[2_u64] == 78_u8, cmd[3_u64] == 71_u8)) {
              send_all(send: &send, factory: &factory, data: &pong_msg[0_u64..7_u64], deadline: deadline, cancel: &cancel);
            } else {
              if band(band(cmd[0_u64] == 73_u8, cmd[1_u64] == 78_u8), band(cmd[2_u64] == 67_u8, cmd[3_u64] == 82_u8)) {
                if cmd_args.len >= 2_u64 {
                  let key = &cmd_args[1_u64];
                  let parse_int = bytes_to_i64(key);
                  match parse_int {
                    Ok(value: v) => {
                      let new_val = v +wrap 1_i64;
                      let digits = slots_new::<u8, 32>();
                      let remaining = new_val;
                      if remaining == 0_i64 {
                        place_back(window: &digits, value: 48_u8);
                      } else {
                        let working = remaining;
                        loop @digit_loop {
                          if working == 0_i64 {
                            break @digit_loop;
                          }
                          let digit = working % 10_i64;
                          let digit_u8 = cvt::<i64, u8>(digit);
                          let byte = digit_u8 +wrap 48_u8;
                          place_back(window: &digits, value: byte);
                          set working = working / 10_i64;
                          continue @digit_loop;
                        }
                      }
                      let resp = slots_new::<u8, 64>();
                      place_back(window: &resp, value: 58_u8);
                      let dlen = digits.len;
                      for (i in 0_u64..dlen) {
                        let sub_1 = dlen - 1_u64;
                        let idx = sub_1 - i;
                        let byte = digits[idx];
                        place_back(window: &resp, value: byte);
                      }
                      place_back(window: &resp, value: 13_u8);
                      place_back(window: &resp, value: 10_u8);
                      send_all(send: &send, factory: &factory, data: &resp[0_u64..resp.len], deadline: deadline, cancel: &cancel);
                    }
                    Err(error: err) => {
                      send_all(send: &send, factory: &factory, data: &err_msg[0_u64..44_u64], deadline: deadline, cancel: &cancel);
                    }
                  }
                }
              }
            }
          }
          if cmd.len == 3_u64 {
            let is_set = band(band(cmd[0_u64] == 83_u8, cmd[1_u64] == 69_u8), cmd[2_u64] == 84_u8);
            if is_set {
              if cmd_args.len >= 3_u64 {
                send_all(send: &send, factory: &factory, data: &ok_msg[0_u64..5_u64], deadline: deadline, cancel: &cancel);
              }
            }
            let is_get = band(band(cmd[0_u64] == 71_u8, cmd[1_u64] == 69_u8), cmd[2_u64] == 84_u8);
            if is_get {
              if cmd_args.len >= 2_u64 {
                send_all(send: &send, factory: &factory, data: &nil_msg[0_u64..5_u64], deadline: deadline, cancel: &cancel);
              }
            }
            let is_del = band(band(cmd[0_u64] == 68_u8, cmd[1_u64] == 69_u8), cmd[2_u64] == 76_u8);
            if is_del {
              if cmd_args.len >= 2_u64 {
                send_all(send: &send, factory: &factory, data: &del_0_msg[0_u64..4_u64], deadline: deadline, cancel: &cancel);
              }
            }
          }
        }
        set buffer_len = buffer_len - consumed;
        for (i in 0_u64..buffer_len) {
          let src_pos = consumed +wrap i;
          set buffer[i] = buffer[src_pos];
        }
        continue @request_loop;
      }
      Err(error: err) => {
        if err == 0_u64 {
          if buffer_len < 16384_u64 {
            let read_result = std::net::receive_next(receive: &receive, destination: &buffer[buffer_len..16384_u64], start: buffer_len, end: 16384_u64, deadline: Some<Instant>(value: deadline), cancel: &cancel);
            match read_result {
              Ok(value: next) => {
                set buffer_len = next;
                continue @request_loop;
              }
              Err(error: stop) => {
                break @request_loop;
              }
            }
          } else {
            break @request_loop;
          }
        } else {
          break @request_loop;
        }
      }
    }
  }
  let close_receive_result = std::net::close_receive(factory: &factory, receive: move receive);
  let close_send_result = std::net::close_send(factory: &factory, send: move send);
  return unit;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: args, drivers: unused_drivers, cwd: cwd, stdout: unused_stdout, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move cwd;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let arg_count = std::text::args_count(args: &args);
  if arg_count < 2_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  let port_arg = std::text::arg_get(args: &args, position: 1_u64);
  let port_value = 0_u16;
  match port_arg {
    Ok(value: port_str) => {
      let port_len = std::text::host_bytes_len(value: &port_str);
      if port_len > 10_u64 {
        return std::process::exit_status(code: 1_u8);
      }
      let port_buf = array_filled::<u8, 16>(value: 0_u8);
      let copy_result = std::text::host_copy_bytes(value: &port_str, destination: &port_buf[0_u64..port_len], start: 0_u64, end: port_len);
      match copy_result {
        Ok(value: next) => {
          let port_parsed = 0_u16;
          for (i in 0_u64..next) {
            let byte = port_buf[i];
            if byte < 48_u8 {
              return std::process::exit_status(code: 1_u8);
            }
            if byte > 57_u8 {
              return std::process::exit_status(code: 1_u8);
            }
            let digit = byte - 48_u8;
            let digit_u16 = cvt::<u8, u16>(digit);
            set port_parsed = port_parsed *wrap 10_u16;
            set port_parsed = port_parsed +wrap digit_u16;
          }
          set port_value = port_parsed;
        }
        Err(error: err) => {
          return std::process::exit_status(code: 1_u8);
        }
      }
    }
    Err(error: err) => {
      return std::process::exit_status(code: 1_u8);
    }
  }
  let listener_addr = std::net::socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: port_value);
  let listen_result = std::net::tcp_listen(factory: &factory, address: &listener_addr);
  let listener = match listen_result {
    Ok(value: l) => {
      give move l;
    }
    Err(error: err) => {
      return std::process::exit_status(code: 1_u8);
    }
  };
  let shared_store = shared_new::<unit>(value: unit);
  let begin = std::time::now(clock: &clock);
  let deadline = std::time::instant_after(instant: begin, nanoseconds: 17000000000_u64);
  let cancel = std::time::cancel_never();
  let accepted = 0_u64;
  loop @accept_loop {
    if accepted >= 9_u64 {
      break @accept_loop;
    }
    let accept_result = std::net::tcp_accept(factory: &factory, listener: &listener, deadline: Some<Instant>(value: deadline), cancel: &cancel);
    match accept_result {
      Ok(value: accepted_conn) => {
        let conn = accepted_conn.connection;
        let store_shared = shared_share::<unit>(shared: &shared_store);
        let factory_shared = factory_share(factory: &factory);
        let clock_shared = clock_share(clock: &clock);
        spawn handle_connection(store: move store_shared, send: move conn.send, receive: move conn.receive, factory: move factory_shared, deadline: deadline, cancel: move cancel);
        set accepted = accepted +wrap 1_u64;
        continue @accept_loop;
      }
      Err(error: err) => {
        break @accept_loop;
      }
    }
  }
  let close_result = std::net::close_listener(factory: &factory, listener: move listener);
  std::time::close_cancel_watch(watch: move cancel);
  return std::process::exit_status(code: 0_u8);
}

alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias IoError = std::io::IoError;
alias ReadStop = std::io::ReadStop;
alias TcpConnection = std::net::TcpConnection;
alias TcpListener = std::net::TcpListener;
alias TcpReceive = std::net::TcpReceive;
alias TcpSend = std::net::TcpSend;
alias Instant = std::time::Instant;
alias CancelWatch = std::time::CancelWatch;

struct Entry {
  present: Bool;
  key_len: u64;
  key: Array<u8, 64>;
  value_len: u64;
  value: Array<u8, 64>;
}

fn same_key(stored: Array<u8, 64>, key: &[u8]) -> result: Bool reads(key) contract {
  requires key^.len <= 64_u64;
} {
  let length = key^.len;
  let equal = True();
  for (j in 0_u64..length) {
    let left = stored[j];
    let right = key^[j];
    if left != right {
      set equal = False();
    }
  }
  return equal;
}

fn find_slot(table: &Array<Entry, 32>, key: &[u8]) -> result: u64 reads(table), reads(key) contract {
  requires key^.len <= 64_u64;
  ensures result <= 32_u64;
} {
  let length = key^.len;
  let found = 32_u64;
  for (i in 0_u64..32_u64) {
    let slot_entry = table^[i];
    if slot_entry.present {
      if slot_entry.key_len == length {
        let same = same_key(stored: slot_entry.key, key: key);
        if same {
          set found = i;
        }
      }
    }
  }
  return found;
}

fn find_free(table: &Array<Entry, 32>) -> result: u64 reads(table) contract {
  ensures result <= 32_u64;
} {
  let free = 32_u64;
  for (i in 0_u64..32_u64) {
    let slot_entry = table^[i];
    if slot_entry.present {
    } else {
      set free = i;
    }
  }
  return free;
}

struct Text {
  length: u64;
  bytes: Array<u8, 64>;
}

fn empty_entry() -> result: Entry pure {
  let stored_key = array_filled::<u8, 64>(value: 0_u8);
  let stored_value = array_filled::<u8, 64>(value: 0_u8);
  let absent = False();
  return Entry(present: absent, key_len: 0_u64, key: stored_key, value_len: 0_u64, value: stored_value);
}

fn make_entry(key: &[u8], payload: &[u8]) -> result: Entry reads(key), reads(payload) contract {
  requires key^.len <= 64_u64;
  requires payload^.len <= 64_u64;
} {
  let stored_key = array_filled::<u8, 64>(value: 0_u8);
  let stored_value = array_filled::<u8, 64>(value: 0_u8);
  let key_length = key^.len;
  let value_length = payload^.len;
  for (i in 0_u64..key_length) {
    set stored_key[i] = key^[i];
  }
  for (j in 0_u64..value_length) {
    set stored_value[j] = payload^[j];
  }
  let present = True();
  return Entry(present: present, key_len: key_length, key: stored_key, value_len: value_length, value: stored_value);
}

fn store_set(table: &Array<Entry, 32>, key: &[u8], payload: &[u8]) -> result: Bool reads(key), reads(payload), writes(table) contract {
  requires key^.len <= 64_u64;
  requires payload^.len <= 64_u64;
} {
  let new_entry = make_entry(key: key, payload: payload);
  let slot = find_slot(table: table, key: key);
  if slot < 32_u64 {
    set table^[slot] = new_entry;
    return True();
  }
  let free = find_free(table: table);
  if free < 32_u64 {
    set table^[free] = new_entry;
    return True();
  }
  return False();
}

fn store_del(table: &Array<Entry, 32>, key: &[u8]) -> result: Bool reads(key), writes(table) contract {
  requires key^.len <= 64_u64;
} {
  let slot = find_slot(table: table, key: key);
  if slot < 32_u64 {
    let cleared = empty_entry();
    set table^[slot] = cleared;
    return True();
  }
  return False();
}

fn accumulate(acc: i64, digit: i64, negative: Bool) -> result: Result<i64, Overflow> pure {
  let scaled = acc *checked 10_i64;
  match scaled {
    Ok(value: base) => {
      if negative {
        let lowered = base -checked digit;
        return lowered;
      }
      let raised = base +checked digit;
      return raised;
    }
    Err(error: problem) => {
      return Err<i64, Overflow>(error: problem);
    }
  }
}

fn parse_value(stored: Array<u8, 64>, length: u64) -> result: Option<i64> pure contract {
  requires length <= 64_u64;
} {
  if length == 0_u64 {
    return None<i64>();
  }
  let first = stored[0_u64];
  let negative = first == 45_u8;
  let start = 0_u64;
  if negative {
    set start = 1_u64;
  }
  if start < length {
  } else {
    return None<i64>();
  }
  let acc = 0_i64;
  for (k in start..length) {
    let digit = stored[k];
    let low_ok = digit >= 48_u8;
    let high_ok = digit <= 57_u8;
    let valid = band(low_ok, high_ok);
    if valid {
    } else {
      return None<i64>();
    }
    let offset = digit -sat 48_u8;
    let wide = cvt::<u8, i64>(offset);
    let step = accumulate(acc: acc, digit: wide, negative: negative);
    match step {
      Ok(value: next) => {
        set acc = next;
      }
      Err(error: problem) => {
        return None<i64>();
      }
    }
  }
  return Some<i64>(value: acc);
}

fn format_int(n: i64) -> result: Text pure contract {
  ensures result.length <= 64_u64;
} {
  let negative = n < 0_i64;
  let source = if negative {
    give 0_i64 -wrap n;
  } else {
    give n;
  }
  let magnitude = cvt.wrap::<i64, u64>(source);
  let digits = array_filled::<u8, 20>(value: 0_u8);
  let count = 0_u64;
  let rest = magnitude;
  if rest == 0_u64 {
    set digits[0_u64] = 48_u8;
    set count = 1_u64;
  }
  for (k in 0_u64..20_u64) {
    if rest == 0_u64 {
    } else {
      let digit = rest % 10_u64;
      let small = cvt.wrap::<u64, u8>(digit);
      set digits[k] = small +wrap 48_u8;
      set count = k +sat 1_u64;
      set rest = rest / 10_u64;
    }
  }
  let bytes = array_filled::<u8, 64>(value: 0_u8);
  let prefix = 0_u64;
  if negative {
    set bytes[0_u64] = 45_u8;
    set prefix = 1_u64;
  }
  let last = count -sat 1_u64;
  for (m in 0_u64..count) {
    let source_index = last -sat m;
    let position = prefix +sat m;
    set bytes[position] = digits[source_index];
  }
  let length = prefix +sat count;
  return Text(length: length, bytes: bytes);
}

enum Number {
  Incomplete();
  Invalid();
  Found(value: u64, next: u64);
}

struct Command {
  consumed: u64;
  argc: u64;
  starts: Array<u64, 3>;
  ends: Array<u64, 3>;
}

enum Parse {
  Incomplete();
  Invalid();
  Complete(command: Command);
}

fn read_number(buffer: &[u8], avail: u64, from: u64) -> result: Number reads(buffer) contract {
  requires avail <= buffer^.len;
  requires from <= avail;
} {
  let value = 0_u64;
  let digits = 0_u64;
  for (p in from..avail) {
    let byte = buffer^[p];
    if byte == 13_u8 {
      let terminator = p +sat 1_u64;
      if terminator < avail {
        let newline = buffer^[terminator];
        if newline == 10_u8 {
          if digits == 0_u64 {
            return Number::Invalid();
          }
          let next = p +sat 2_u64;
          return Number::Found(value: value, next: next);
        }
        return Number::Invalid();
      }
      return Number::Incomplete();
    }
    let low_ok = byte >= 48_u8;
    let high_ok = byte <= 57_u8;
    let digit_ok = band(low_ok, high_ok);
    if digit_ok {
    } else {
      return Number::Invalid();
    }
    let offset = byte -sat 48_u8;
    let wide = cvt::<u8, u64>(offset);
    let scaled = value *sat 10_u64;
    set value = scaled +sat wide;
    set digits = digits +sat 1_u64;
  }
  return Number::Incomplete();
}

fn parse_request(buffer: &[u8], avail: u64) -> result: Parse reads(buffer) contract {
  requires avail <= buffer^.len;
} {
  if avail == 0_u64 {
    return Parse::Incomplete();
  }
  let lead = buffer^[0_u64];
  if lead == 42_u8 {
  } else {
    return Parse::Invalid();
  }
  let header = read_number(buffer: buffer, avail: avail, from: 1_u64);
  match header {
    Incomplete() => {
      return Parse::Incomplete();
    }
    Invalid() => {
      return Parse::Invalid();
    }
    Found(value: count, next: body) => {
      if count <= 3_u64 {
      } else {
        return Parse::Invalid();
      }
      if count >= 1_u64 {
      } else {
        return Parse::Invalid();
      }
      let starts = array_filled::<u64, 3>(value: 0_u64);
      let ends = array_filled::<u64, 3>(value: 0_u64);
      let position = body;
      for (a in 0_u64..count) {
        if position < avail {
        } else {
          return Parse::Incomplete();
        }
        let marker = buffer^[position];
        if marker == 36_u8 {
        } else {
          return Parse::Invalid();
        }
        let after_marker = position +sat 1_u64;
        let length_header = read_number(buffer: buffer, avail: avail, from: after_marker);
        match length_header {
          Incomplete() => {
            return Parse::Incomplete();
          }
          Invalid() => {
            return Parse::Invalid();
          }
          Found(value: length, next: data_start) => {
            let data_end = data_start +sat length;
            let after_data = data_end +sat 1_u64;
            if after_data < avail {
            } else {
              return Parse::Incomplete();
            }
            let cr = buffer^[data_end];
            let lf = buffer^[after_data];
            if cr == 13_u8 {
            } else {
              return Parse::Invalid();
            }
            if lf == 10_u8 {
            } else {
              return Parse::Invalid();
            }
            set starts[a] = data_start;
            set ends[a] = data_end;
            set position = after_data +sat 1_u64;
          }
        }
      }
      return Parse::Complete(command: Command(consumed: position, argc: count, starts: starts, ends: ends));
    }
  }
}

const reply_pong: Array<u8, 7> = "+PONG\r\n";

const reply_ok: Array<u8, 5> = "+OK\r\n";

const reply_nil: Array<u8, 5> = "$-1\r\n";

const reply_not_int: Array<u8, 46> = "-ERR value is not an integer or out of range\r\n";

const reply_protocol: Array<u8, 21> = "-ERR protocol error\r\n";

const reply_arity: Array<u8, 32> = "-ERR wrong number of arguments\r\n";

const reply_unknown: Array<u8, 22> = "-ERR unknown command\r\n";

const reply_full: Array<u8, 17> = "-ERR store full\r\n";

const word_ping: Array<u8, 4> = "PING";

const word_get: Array<u8, 3> = "GET";

const word_set: Array<u8, 3> = "SET";

const word_del: Array<u8, 3> = "DEL";

const word_incr: Array<u8, 4> = "INCR";

const crlf: Array<u8, 2> = "\r\n";

const dollar: Array<u8, 1> = "$";

const colon: Array<u8, 1> = ":";

fn put_text(out: &Array<u8, 4096>, at: u64, text: &[u8]) -> result: u64 reads(text), writes(out) {
  let length = text^.len;
  for (k in 0_u64..length) {
    let target = at +sat k;
    if target < 4096_u64 {
      set out^[target] = text^[k];
    }
  }
  let end = at +sat length;
  return end;
}

fn put_bulk(out: &Array<u8, 4096>, at: u64, value: &Array<u8, 64>, length: u64) -> result: u64 reads(value), writes(out) contract {
  requires at <= 3000_u64;
  requires length <= 64_u64;
} {
  let wide = cvt.wrap::<u64, i64>(length);
  let header = format_int(n: wide);
  let first = put_text(out: out, at: at, text: &dollar[0_u64..1_u64]);
  let second = put_text(out: out, at: first, text: &header.bytes[0_u64..header.length]);
  let third = put_text(out: out, at: second, text: &crlf[0_u64..2_u64]);
  let fourth = put_text(out: out, at: third, text: &value^[0_u64..length]);
  let fifth = put_text(out: out, at: fourth, text: &crlf[0_u64..2_u64]);
  return fifth;
}

fn word_is(buffer: &[u8], start: u64, end: u64, word: &[u8]) -> result: Bool reads(buffer), reads(word) {
  if start <= end {
  } else {
    return False();
  }
  if end <= buffer^.len {
  } else {
    return False();
  }
  let length = end -sat start;
  let wlen = word^.len;
  if length == wlen {
  } else {
    return False();
  }
  let equal = True();
  for (k in 0_u64..wlen) {
    let at = start +sat k;
    if at < buffer^.len {
      let got = buffer^[at];
      let want = word^[k];
      if got == want {
      } else {
        set equal = False();
      }
    } else {
      set equal = False();
    }
  }
  return equal;
}

fn run_get(buffer: &[u8], request: Command, table: &Array<Entry, 32>, out: &Array<u8, 4096>, at: u64) -> result: u64 reads(buffer), reads(table), writes(out) contract {
  requires at <= 3000_u64;
} {
  if request.argc == 2_u64 {
  } else {
    return put_text(out: out, at: at, text: &reply_arity[0_u64..32_u64]);
  }
  let key_start = request.starts[1_u64];
  let key_end = request.ends[1_u64];
  if key_start <= key_end {
  } else {
    return put_text(out: out, at: at, text: &reply_protocol[0_u64..21_u64]);
  }
  if key_end <= buffer^.len {
  } else {
    return put_text(out: out, at: at, text: &reply_protocol[0_u64..21_u64]);
  }
  let key_size = key_end -sat key_start;
  if key_size <= 64_u64 {
  } else {
    return put_text(out: out, at: at, text: &reply_nil[0_u64..5_u64]);
  }
  let slot = find_slot(table: table, key: &buffer^[key_start..key_end]);
  if slot < 32_u64 {
    let found_entry = table^[slot];
    if found_entry.value_len <= 64_u64 {
    } else {
      return put_text(out: out, at: at, text: &reply_protocol[0_u64..21_u64]);
    }
    return put_bulk(out: out, at: at, value: &found_entry.value, length: found_entry.value_len);
  }
  return put_text(out: out, at: at, text: &reply_nil[0_u64..5_u64]);
}

const reply_one: Array<u8, 4> = ":1\r\n";

const reply_zero: Array<u8, 4> = ":0\r\n";

fn run_set(buffer: &[u8], request: Command, table: &Array<Entry, 32>, out: &Array<u8, 4096>, at: u64) -> result: u64 reads(buffer), writes(table), writes(out) contract {
  requires at <= 3000_u64;
} {
  if request.argc == 3_u64 {
  } else {
    return put_text(out: out, at: at, text: &reply_arity[0_u64..32_u64]);
  }
  let key_start = request.starts[1_u64];
  let key_end = request.ends[1_u64];
  let value_start = request.starts[2_u64];
  let value_end = request.ends[2_u64];
  if key_start <= key_end {
  } else {
    return put_text(out: out, at: at, text: &reply_protocol[0_u64..21_u64]);
  }
  if value_start <= value_end {
  } else {
    return put_text(out: out, at: at, text: &reply_protocol[0_u64..21_u64]);
  }
  if key_end <= buffer^.len {
  } else {
    return put_text(out: out, at: at, text: &reply_protocol[0_u64..21_u64]);
  }
  if value_end <= buffer^.len {
  } else {
    return put_text(out: out, at: at, text: &reply_protocol[0_u64..21_u64]);
  }
  let key_size = key_end -sat key_start;
  let value_size = value_end -sat value_start;
  if key_size <= 64_u64 {
  } else {
    return put_text(out: out, at: at, text: &reply_full[0_u64..17_u64]);
  }
  if value_size <= 64_u64 {
  } else {
    return put_text(out: out, at: at, text: &reply_full[0_u64..17_u64]);
  }
  let stored = store_set(table: table, key: &buffer^[key_start..key_end], payload: &buffer^[value_start..value_end]);
  if stored {
    return put_text(out: out, at: at, text: &reply_ok[0_u64..5_u64]);
  }
  return put_text(out: out, at: at, text: &reply_full[0_u64..17_u64]);
}

fn run_del(buffer: &[u8], request: Command, table: &Array<Entry, 32>, out: &Array<u8, 4096>, at: u64) -> result: u64 reads(buffer), writes(table), writes(out) contract {
  requires at <= 3000_u64;
} {
  if request.argc == 2_u64 {
  } else {
    return put_text(out: out, at: at, text: &reply_arity[0_u64..32_u64]);
  }
  let key_start = request.starts[1_u64];
  let key_end = request.ends[1_u64];
  if key_start <= key_end {
  } else {
    return put_text(out: out, at: at, text: &reply_protocol[0_u64..21_u64]);
  }
  if key_end <= buffer^.len {
  } else {
    return put_text(out: out, at: at, text: &reply_protocol[0_u64..21_u64]);
  }
  let key_size = key_end -sat key_start;
  if key_size <= 64_u64 {
  } else {
    return put_text(out: out, at: at, text: &reply_zero[0_u64..4_u64]);
  }
  let removed = store_del(table: table, key: &buffer^[key_start..key_end]);
  if removed {
    return put_text(out: out, at: at, text: &reply_one[0_u64..4_u64]);
  }
  return put_text(out: out, at: at, text: &reply_zero[0_u64..4_u64]);
}

fn reply_integer(out: &Array<u8, 4096>, at: u64, number: i64) -> result: u64 writes(out) contract {
  requires at <= 3000_u64;
} {
  let text = format_int(n: number);
  let first = put_text(out: out, at: at, text: &colon[0_u64..1_u64]);
  let second = put_text(out: out, at: first, text: &text.bytes[0_u64..text.length]);
  let third = put_text(out: out, at: second, text: &crlf[0_u64..2_u64]);
  return third;
}

fn store_incr(buffer: &[u8], key_start: u64, key_end: u64, table: &Array<Entry, 32>, out: &Array<u8, 4096>, at: u64, number: i64) -> result: u64 reads(buffer), writes(table), writes(out) contract {
  requires at <= 3000_u64;
  requires key_start <= key_end;
  requires key_end <= buffer^.len;
  requires key_end - key_start <= 64_u64;
} {
  let text = format_int(n: number);
  let stored = store_set(table: table, key: &buffer^[key_start..key_end], payload: &text.bytes[0_u64..text.length]);
  if stored {
    return reply_integer(out: out, at: at, number: number);
  }
  return put_text(out: out, at: at, text: &reply_full[0_u64..17_u64]);
}

fn run_incr(buffer: &[u8], request: Command, table: &Array<Entry, 32>, out: &Array<u8, 4096>, at: u64) -> result: u64 reads(buffer), writes(table), writes(out) contract {
  requires at <= 3000_u64;
} {
  if request.argc == 2_u64 {
  } else {
    return put_text(out: out, at: at, text: &reply_arity[0_u64..32_u64]);
  }
  let key_start = request.starts[1_u64];
  let key_end = request.ends[1_u64];
  if key_start <= key_end {
  } else {
    return put_text(out: out, at: at, text: &reply_protocol[0_u64..21_u64]);
  }
  if key_end <= buffer^.len {
  } else {
    return put_text(out: out, at: at, text: &reply_protocol[0_u64..21_u64]);
  }
  let key_size = key_end -sat key_start;
  if key_size <= 64_u64 {
  } else {
    return put_text(out: out, at: at, text: &reply_full[0_u64..17_u64]);
  }
  let slot = find_slot(table: table, key: &buffer^[key_start..key_end]);
  if slot < 32_u64 {
    let found_entry = table^[slot];
    if found_entry.value_len <= 64_u64 {
    } else {
      return put_text(out: out, at: at, text: &reply_not_int[0_u64..46_u64]);
    }
    let parsed = parse_value(stored: found_entry.value, length: found_entry.value_len);
    match parsed {
      Some(value: current) => {
        let bumped = current +checked 1_i64;
        match bumped {
          Ok(value: next) => {
            return store_incr(buffer: buffer, key_start: key_start, key_end: key_end, table: table, out: out, at: at, number: next);
          }
          Err(error: problem) => {
            return put_text(out: out, at: at, text: &reply_not_int[0_u64..46_u64]);
          }
        }
      }
      None() => {
        return put_text(out: out, at: at, text: &reply_not_int[0_u64..46_u64]);
      }
    }
  }
  let first_value = 1_i64;
  return store_incr(buffer: buffer, key_start: key_start, key_end: key_end, table: table, out: out, at: at, number: first_value);
}

fn run_command(buffer: &[u8], request: Command, table: &Array<Entry, 32>, out: &Array<u8, 4096>, at: u64) -> result: u64 reads(buffer), writes(table), writes(out) contract {
  requires at <= 3000_u64;
} {
  let name_start = request.starts[0_u64];
  let name_end = request.ends[0_u64];
  let is_ping = word_is(buffer: buffer, start: name_start, end: name_end, word: &word_ping[0_u64..4_u64]);
  if is_ping {
    if request.argc == 1_u64 {
      return put_text(out: out, at: at, text: &reply_pong[0_u64..7_u64]);
    }
    return put_text(out: out, at: at, text: &reply_arity[0_u64..32_u64]);
  }
  let is_get = word_is(buffer: buffer, start: name_start, end: name_end, word: &word_get[0_u64..3_u64]);
  if is_get {
    return run_get(buffer: buffer, request: request, table: table, out: out, at: at);
  }
  let is_set = word_is(buffer: buffer, start: name_start, end: name_end, word: &word_set[0_u64..3_u64]);
  if is_set {
    return run_set(buffer: buffer, request: request, table: table, out: out, at: at);
  }
  let is_del = word_is(buffer: buffer, start: name_start, end: name_end, word: &word_del[0_u64..3_u64]);
  if is_del {
    return run_del(buffer: buffer, request: request, table: table, out: out, at: at);
  }
  let is_incr = word_is(buffer: buffer, start: name_start, end: name_end, word: &word_incr[0_u64..4_u64]);
  if is_incr {
    return run_incr(buffer: buffer, request: request, table: table, out: out, at: at);
  }
  return put_text(out: out, at: at, text: &reply_unknown[0_u64..22_u64]);
}

fn send_all(send: &TcpSend, source: &[u8], length: u64, cancel: &CancelWatch) -> result: Result<unit, IoError> reads(source), reads(cancel), writes(send) waits contract {
  requires length <= source^.len;
} {
  let sent = 0_u64;
  loop @sending {
    if sent < length {
    } else {
      break @sending;
    }
    let no_deadline = None<Instant>();
    let outcome = std::net::send_once(send: send, source: source, start: sent, end: length, deadline: no_deadline, cancel: cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn host_port(value: &HostString) -> result: Option<u16> reads(value) {
  let length = std::text::host_bytes_len(value: value);
  if length >= 1_u64 {
  } else {
    return None<u16>();
  }
  if length <= 8_u64 {
  } else {
    return None<u16>();
  }
  let digits = array_filled::<u8, 8>(value: 0_u8);
  let copied = std::text::host_copy_bytes(value: value, destination: &digits[0_u64..8_u64], start: 0_u64, end: length);
  match copied {
    Ok(value: unused_copied) => {
    }
    Err(error: unused_copy_error) => {
      return None<u16>();
    }
  }
  let port = 0_u64;
  for (k in 0_u64..length) {
    let byte = digits[k];
    let low_ok = byte >= 48_u8;
    let high_ok = byte <= 57_u8;
    let digit_ok = band(low_ok, high_ok);
    if digit_ok {
    } else {
      return None<u16>();
    }
    let offset = byte -sat 48_u8;
    let wide = cvt::<u8, u64>(offset);
    let scaled = port *sat 10_u64;
    set port = scaled +sat wide;
  }
  let narrowed = cvt.checked::<u64, u16>(port);
  match narrowed {
    Ok(value: number) => {
      return Some<u16>(value: number);
    }
    Err(error: unused_narrow) => {
      return None<u16>();
    }
  }
}

fn serve(connection: TcpConnection, factory: HandleFactory, store: Shared<Array<Entry, 32>>) -> result: unit pure waits {
  let TcpConnection(receive: rx, send: tx) = move connection;
  let watch = std::time::cancel_never();
  let pending = array_filled::<u8, 4096>(value: 0_u8);
  let out = array_filled::<u8, 4096>(value: 0_u8);
  let chunk = array_filled::<u8, 1024>(value: 0_u8);
  let avail = 0_u64;
  let open = True();
  loop @session {
    if open {
    } else {
      break @session;
    }
    let no_deadline = None<Instant>();
    let received = std::net::receive_next(receive: &rx, destination: &chunk[0_u64..1024_u64], start: 0_u64, end: 1024_u64, deadline: no_deadline, cancel: &watch);
    match received {
      Ok(value: next) => {
        for (k in 0_u64..next) {
          if avail < 4096_u64 {
            let incoming = chunk[k];
            set pending[avail] = incoming;
            set avail = avail +sat 1_u64;
          }
        }
        let start = 0_u64;
        let reply_end = 0_u64;
        loop @frames (
          invariant room: reply_end <= 4096_u64,
          invariant bounded: avail <= 4096_u64
        ) {
          if start < avail {
          } else {
            break @frames;
          }
          if reply_end < 3000_u64 {
          } else {
            let flushed = send_all(send: &tx, source: &out[0_u64..reply_end], length: reply_end, cancel: &watch);
            match flushed {
              Ok(value: unused_flushed) => {
              }
              Err(error: unused_flush) => {
                set open = False();
              }
            }
            set reply_end = 0_u64;
          }
          let remaining = avail -sat start;
          let parsed = parse_request(buffer: &pending[start..avail], avail: remaining);
          match parsed {
            Incomplete() => {
              break @frames;
            }
            Invalid() => {
              set reply_end = put_text(out: &out, at: reply_end, text: &reply_protocol[0_u64..21_u64]);
              set open = False();
              break @frames;
            }
            Complete(command: request) => {
              let consumed = request.consumed;
              atomic entries = &store {
                set reply_end = run_command(buffer: &pending[start..avail], request: request, table: entries, out: &out, at: reply_end);
              }
              if reply_end <= 4096_u64 {
              } else {
                set reply_end = 4096_u64;
              }
              set start = start +sat consumed;
            }
          }
        }
        if reply_end <= 4096_u64 {
        } else {
          set reply_end = 4096_u64;
        }
        let leftover = avail -sat start;
        for (m in 0_u64..leftover) {
          let from = start +sat m;
          if m < 4096_u64 {
            if from < 4096_u64 {
              let moved = pending[from];
              set pending[m] = moved;
            }
          }
        }
        set avail = leftover;
        if reply_end > 0_u64 {
          let flushed = send_all(send: &tx, source: &out[0_u64..reply_end], length: reply_end, cancel: &watch);
          match flushed {
            Ok(value: unused_final) => {
            }
            Err(error: unused_final_error) => {
              set open = False();
            }
          }
        }
      }
      Err(error: stop) => {
        match stop {
          ReadEnd() => {
            set open = False();
          }
          ReadFailed(error: problem) => {
            set open = False();
          }
        }
      }
    }
  }
  let closed_receive = std::net::close_receive(factory: &factory, receive: move rx);
  let closed_send = std::net::close_send(factory: &factory, send: move tx);
  std::time::close_cancel_watch(watch: move watch);
  return unit;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: argv, cwd: cwd_owner, handles: factory, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move cwd_owner;
  let closed_write = std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  let closed_read = std::fs::close_directory(factory: &factory, directory: move directory_read);
  let code = 0_u8;
  let port_arg = std::text::arg_get(args: &argv, position: 0_u64);
  match port_arg {
    Ok(value: text) => {
      let parsed_port = host_port(value: &text);
      match parsed_port {
        Some(value: port) => {
          let address = std::net::socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: port);
          let listening = std::net::tcp_listen(factory: &factory, address: &address);
          match listening {
            Ok(value: listener) => {
              let empty = empty_entry();
              let table_init = array_filled::<Entry, 32>(value: empty);
              let store = shared_new::<Array<Entry, 32>>(value: table_init);
              let accept_watch = std::time::cancel_never();
              for (served in 0_u64..9_u64) {
                let no_deadline = None<Instant>();
                let accepted = std::net::tcp_accept(factory: &factory, listener: &listener, deadline: no_deadline, cancel: &accept_watch);
                match accepted {
                  Ok(value: session) => {
                    let AcceptedConnection(connection: accepted_connection, ..) = move session;
                    let own = std::io::factory_share(factory: &factory);
                    let shared_table = shared_share::<Array<Entry, 32>>(shared: &store);
                    spawn serve(connection: move accepted_connection, factory: move own, store: move shared_table);
                  }
                  Err(error: unused_accept) => {
                    set code = 2_u8;
                  }
                }
              }
              std::time::close_cancel_watch(watch: move accept_watch);
              let closed_listener = std::net::close_listener(factory: &factory, listener: move listener);
            }
            Err(error: unused_listen) => {
              set code = 2_u8;
            }
          }
        }
        None() => {
          set code = 2_u8;
        }
      }
    }
    Err(error: unused_arg) => {
      set code = 2_u8;
    }
  }
  return std::process::exit_status(code: code);
}

alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;

struct Link {
  value: u64;
  next: Option<Box<Link>>;
}

enum Probe {
  Empty();
  Odd();
  Even();
}

fn byte_at(value: u64, shift: u32) -> result: u8 pure {
  let shifted = ishr.wrap(value, shift);
  return cvt.wrap::<u64, u8>(shifted);
}

fn encode(first: u64, second: u64, third: u64) -> result: Array<u8, 24> pure {
  let out = array_filled::<u8, 24>(value: 0_u8);
  set out[0_u64] = byte_at(value: first, shift: 0_u32);
  set out[1_u64] = byte_at(value: first, shift: 8_u32);
  set out[2_u64] = byte_at(value: first, shift: 16_u32);
  set out[3_u64] = byte_at(value: first, shift: 24_u32);
  set out[4_u64] = byte_at(value: first, shift: 32_u32);
  set out[5_u64] = byte_at(value: first, shift: 40_u32);
  set out[6_u64] = byte_at(value: first, shift: 48_u32);
  set out[7_u64] = byte_at(value: first, shift: 56_u32);
  set out[8_u64] = byte_at(value: second, shift: 0_u32);
  set out[9_u64] = byte_at(value: second, shift: 8_u32);
  set out[10_u64] = byte_at(value: second, shift: 16_u32);
  set out[11_u64] = byte_at(value: second, shift: 24_u32);
  set out[12_u64] = byte_at(value: second, shift: 32_u32);
  set out[13_u64] = byte_at(value: second, shift: 40_u32);
  set out[14_u64] = byte_at(value: second, shift: 48_u32);
  set out[15_u64] = byte_at(value: second, shift: 56_u32);
  set out[16_u64] = byte_at(value: third, shift: 0_u32);
  set out[17_u64] = byte_at(value: third, shift: 8_u32);
  set out[18_u64] = byte_at(value: third, shift: 16_u32);
  set out[19_u64] = byte_at(value: third, shift: 24_u32);
  set out[20_u64] = byte_at(value: third, shift: 32_u32);
  set out[21_u64] = byte_at(value: third, shift: 40_u32);
  set out[22_u64] = byte_at(value: third, shift: 48_u32);
  set out[23_u64] = byte_at(value: third, shift: 56_u32);
  return out;
}

fn sum_list(head: &Option<Box<Link>>) -> result: u64 reads(head) {
  let cursor = head;
  let total = 0_u64;
  loop {
    match cursor^ {
      Some(value: node) => {
        set total = total +wrap node^.inner.value;
        set cursor = &node^.inner.next;
      }
      None() => {
        return total;
      }
    }
  }
}

fn increment_all(head: &Option<Box<Link>>) -> result: unit writes(head) {
  let cursor = head;
  loop {
    match cursor^ {
      Some(value: node) => {
        set node^.inner.value = node^.inner.value +wrap 1_u64;
        set cursor = &node^.inner.next;
      }
      None() => {
        return unit;
      }
    }
  }
}

fn probe_slot(slot: &Option<Box<Link>>) -> result: Probe reads(slot) {
  match slot^ {
    Some(value: node) => {
      let low = iand(node^.inner.value, 1_u64);
      if low == 0_u64 {
        return Probe::Even();
      }
      return Probe::Odd();
    }
    None() => {
      return Probe::Empty();
    }
  }
}

fn remove_even(head: &Option<Box<Link>>) -> result: unit writes(head) {
  let cursor = head;
  loop {
    let probe = probe_slot(slot: cursor);
    match probe {
      Empty() => {
        return unit;
      }
      Odd() => {
        match cursor^ {
          Some(value: node) => {
            set cursor = &node^.inner.next;
          }
          None() => {
            return unit;
          }
        }
      }
      Even() => {
        let taken = None<Box<Link>>();
        swap(first: cursor, second: &taken);
        match move taken {
          Some(value: cell) => {
            let link = move cell.inner;
            let Link(value: unused_value, next: rest) = move link;
            set cursor^ = move rest;
          }
          None() => {
            return unit;
          }
        }
      }
    }
  }
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: output, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  let write_closed = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let read_closed = std::fs::close_directory(factory: &factory, directory: move cwd_read);
  match write_closed {
    Ok(value: unused_write_closed) => {
    }
    Err(error: unused_write_error) => {
    }
  }
  match read_closed {
    Ok(value: unused_read_closed) => {
    }
    Err(error: unused_read_error) => {
    }
  }
  let head = None<Box<Link>>();
  for (i in 0_u64..64_u64) {
    let node = Link(value: i, next: move head);
    let cell = box_new::<Link>(value: move node);
    set head = Some<Box<Link>>(value: move cell);
  }
  let before = sum_list(head: &head);
  remove_even(head: &head);
  let after = sum_list(head: &head);
  increment_all(head: &head);
  let read_one = sum_list(head: &head);
  let read_two = sum_list(head: &head);
  let read_three = sum_list(head: &head);
  let first_pair = read_one +wrap read_two;
  let total = first_pair +wrap read_three;
  let code = 0_u8;
  if total != 3168_u64 {
    set code = 3_u8;
  }
  if after != 1024_u64 {
    set code = 2_u8;
  }
  if before != 2016_u64 {
    set code = 1_u8;
  }
  let bytes = encode(first: before, second: after, third: total);
  let view = &bytes[0_u64..24_u64];
  let published = publish_all(factory: &factory, output: &output, source: view, length: 24_u64);
  match published {
    Ok(value: unused_published) => {
    }
    Err(error: unused_publish_error) => {
      set code = 250_u8;
    }
  }
  return exit_status(code: code);
}

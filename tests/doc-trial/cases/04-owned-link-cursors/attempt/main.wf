alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias Inputs = std::process::Inputs;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;

struct Link {
  value: u64;
  next: Option<Box<Link>>;
}


fn sum_list(head: &Option<Box<Link>>) -> result: u64 reads(head) {
  let cursor = head;
  let total = 0_u64;
  loop {
    match cursor^ {
      Some(value: n) => {
        set total = total +wrap n^.inner.value;
        set cursor = &n^.inner.next;
      }
      None() => {
        return total;
      }
    }
  }
}

fn filter_odd(head: Option<Box<Link>>) -> result: Option<Box<Link>> pure {
  match move head {
    Some(value: curr) => {
      let val = curr^.inner.value;
      let rem = val % 2_u64;
      let is_odd = rem != 0_u64;
      let nx = move curr^.inner.next;
      let filtered_rest = filter_odd(head: move nx);

      if is_odd {
        let created = Link(value: val, next: move filtered_rest);
        let bx = box_new::<Link>(value: move created);
        let opt = Some<Box<Link>>(value: move bx);
        return move opt;
      } else {
        return move filtered_rest;
      }
    }
    None() => {
      return None<Box<Link>>();
    }
  }
}

fn increment_list(head: &Option<Box<Link>>) -> result: unit writes(head) {
  let cursor = head;
  loop {
    match cursor^ {
      Some(value: node) => {
        set node^.inner.value = node^.inner.value +wrap 1_u64;
        set cursor = &node^.inner.next;
      }
      None() => {
        return unit;
      }
    }
  }
}

fn encode_u64_le(value: u64) -> result: Array<u8, 8> pure {
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  set bytes[0_u64] = cvt.wrap::<u64, u8>(value);
  let s1 = ishr(value, 8_u32);
  set bytes[1_u64] = cvt.wrap::<u64, u8>(s1);
  let s2 = ishr(value, 16_u32);
  set bytes[2_u64] = cvt.wrap::<u64, u8>(s2);
  let s3 = ishr(value, 24_u32);
  set bytes[3_u64] = cvt.wrap::<u64, u8>(s3);
  let s4 = ishr(value, 32_u32);
  set bytes[4_u64] = cvt.wrap::<u64, u8>(s4);
  let s5 = ishr(value, 40_u32);
  set bytes[5_u64] = cvt.wrap::<u64, u8>(s5);
  let s6 = ishr(value, 48_u32);
  set bytes[6_u64] = cvt.wrap::<u64, u8>(s6);
  let s7 = ishr(value, 56_u32);
  set bytes[7_u64] = cvt.wrap::<u64, u8>(s7);

  return move bytes;
}

fn write_all(factory: &HandleFactory, output: &OutputStream, data: &[u8]) -> result: Result<unit, IoError> reads(data), writes(factory), writes(output) waits {
  let length = data^.len;
  let sent = 0_u64;
  loop {
    if sent >= length {
      break;
    }

    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: data, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);

    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }

  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: dir_input, handles: factory, stdout: output, ..) = move inputs;
  let std::fs::Directory(read: dir_read, write: dir_write) = move dir_input;
  std::fs::close_directory_write(factory: &factory, directory: move dir_write);
  std::fs::close_directory(factory: &factory, directory: move dir_read);

  let head = None<Box<Link>>();
  let current = head;
  for (i in 0_u64..64_u64) {
    let value = 63_u64 - i;
    let node = Link(value: value, next: move current);
    let boxed = box_new::<Link>(value: move node);
    set current = Some<Box<Link>>(value: move boxed);
  }

  let sum_before = sum_list(head: &current);
  if sum_before != 2016_u64 {
    return exit_status(code: 1_u8);
  }

  let filtered = filter_odd(head: move current);
  let sum_after = sum_list(head: &filtered);
  if sum_after != 1024_u64 {
    return exit_status(code: 2_u8);
  }

  increment_list(head: &filtered);

  let sum1 = sum_list(head: &filtered);
  let sum2 = sum_list(head: &filtered);
  let sum3 = sum_list(head: &filtered);
  let sum_triple = sum1 +wrap sum2 +wrap sum3;
  if sum_triple != 3168_u64 {
    return exit_status(code: 3_u8);
  }

  let b1 = encode_u64_le(value: sum_before);
  let b2 = encode_u64_le(value: sum_after);
  let b3 = encode_u64_le(value: sum_triple);

  let all = array_filled::<u8, 24>(value: 0_u8);
  for (j in 0_u64..8_u64) {
    set all[j] = b1[j];
    let offset1 = j + 8_u64;
    let offset2 = j + 16_u64;
    set all[offset1] = b2[j];
    set all[offset2] = b3[j];
  }

  let window = &all[0_u64..24_u64];
  let write_result = write_all(factory: &factory, output: &output, data: window);

  match write_result {
    Ok(value: unused_result) => {
      return exit_status(code: 0_u8);
    }
    Err(error: unused_error) => {
      return exit_status(code: 250_u8);
    }
  }
}

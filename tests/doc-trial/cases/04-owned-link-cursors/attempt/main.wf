struct Node {
  value: u64;
  next: Option<Box<Node>>;
}

fn build_list(index: u64) -> result: Option<Box<Node>> pure {
  if index >= 64_u64 {
    return None<Box<Node>>();
  }
  let next_index = index +wrap 1_u64;
  let rest = build_list(index: next_index);
  let node = Node(value: index, next: move rest);
  let boxed = box_new::<Node>(value: move node);
  return Some<Box<Node>>(value: move boxed);
}

fn sum_list(head: &Option<Box<Node>>) -> result: u64 reads(head) {
  match head {
    None() => {
      return 0_u64;
    }
    Some(value: node_ref) => {
      let current_value = node_ref^.inner.value;
      let rest_sum = sum_list(head: &node_ref^.inner.next);
      let total = current_value +wrap rest_sum;
      return total;
    }
  }
}

fn remove_evens(head: &Option<Box<Node>>) -> result: unit writes(head) {
  loop (invariant ok: 0_u64 < 1_u64) {
    match move head^ {
      None() => {
        return unit;
      }
      Some(value: node) => {
        if (node.inner.value & 1_u64) == 0_u64 {
          let next = node.inner.next;
          set head^ = move next;
          continue;
        } else {
          set head^ = Some<Box<Node>>(value: move node);
          match head {
            None() => return unit;
            Some(value: next_node) => {
              remove_evens(head: &next_node^.inner.next);
              return unit;
            }
          }
        }
      }
    }
  }
}

fn increment_list(head: &Option<Box<Node>>) -> result: unit writes(head) {
  match head {
    None() => {
      return unit;
    }
    Some(value: node_ref) => {
      let new_value = node_ref^.inner.value +wrap 1_u64;
      set node_ref^.inner.value = new_value;
      increment_list(head: &node_ref^.inner.next);
      return unit;
    }
  }
}

fn write_u64_le(output: &[u8], offset: u64, value: u64) -> result: unit writes(output) contract {
  requires offset + 8_u64 <= output^.len;
} {
  let b0 = cvt.wrap::<u64, u8>(value);
  let b1 = cvt.wrap::<u64, u8>(lshr(value, 8_u32));
  let b2 = cvt.wrap::<u64, u8>(lshr(value, 16_u32));
  let b3 = cvt.wrap::<u64, u8>(lshr(value, 24_u32));
  let b4 = cvt.wrap::<u64, u8>(lshr(value, 32_u32));
  let b5 = cvt.wrap::<u64, u8>(lshr(value, 40_u32));
  let b6 = cvt.wrap::<u64, u8>(lshr(value, 48_u32));
  let b7 = cvt.wrap::<u64, u8>(lshr(value, 56_u32));

  set output^[offset] = b0;
  let off1 = offset +wrap 1_u64;
  set output^[off1] = b1;
  let off2 = offset +wrap 2_u64;
  set output^[off2] = b2;
  let off3 = offset +wrap 3_u64;
  set output^[off3] = b3;
  let off4 = offset +wrap 4_u64;
  set output^[off4] = b4;
  let off5 = offset +wrap 5_u64;
  set output^[off5] = b5;
  let off6 = offset +wrap 6_u64;
  set output^[off6] = b6;
  let off7 = offset +wrap 7_u64;
  set output^[off7] = b7;
  return unit;
}

fn main(inputs: std::process::Inputs) -> result: std::process::ExitStatus {
  let std::process::Inputs(args: unused_args, drivers: unused_drivers, cwd: unused_cwd, stdout: stdout, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall, stops: unused_stops, memory_meter: unused_meter) = move inputs;

  let list = build_list(index: 0_u64);
  let sum_before = sum_list(head: &list);

  if sum_before != 2016_u64 {
    return std::process::exit_status(code: 1_u8);
  }

  let mut mutable_list = move list;
  remove_evens(head: &mutable_list);

  let sum_after_removal = sum_list(head: &mutable_list);
  if sum_after_removal != 1024_u64 {
    return std::process::exit_status(code: 2_u8);
  }

  increment_list(head: &mutable_list);

  let read1 = sum_list(head: &mutable_list);
  let read2 = sum_list(head: &mutable_list);
  let read3 = sum_list(head: &mutable_list);
  let sum_after_increment = read1 +wrap read2 +wrap read3;

  if sum_after_increment != 3168_u64 {
    return std::process::exit_status(code: 3_u8);
  }

  let buffer = slots_new::<u8, 24>();
  write_u64_le(output: &buffer, offset: 0_u64, value: 2016_u64);
  write_u64_le(output: &buffer, offset: 8_u64, value: 1024_u64);
  write_u64_le(output: &buffer, offset: 16_u64, value: 3168_u64);

  let cancel_watch = std::time::cancel_never();
  let write_result = std::io::write_once(factory: &factory, output: &stdout, source: &buffer, start: 0_u64, end: 24_u64, deadline: None<std::time::Instant>(), cancel: &cancel_watch);

  match move write_result {
    Ok(index: written) => {
      if written == 24_u64 {
        return std::process::exit_status(code: 0_u8);
      } else {
        return std::process::exit_status(code: 250_u8);
      }
    }
    Err(error: err) => {
      return std::process::exit_status(code: 250_u8);
    }
  }
}

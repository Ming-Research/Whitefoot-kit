alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;

struct Link {
  value: u64;
  next: Option<Box<Link>>;
}

fn byte_of(number: u64, shift: u32) -> result: u8 pure {
  let shifted = ishr.wrap(number, shift);
  return cvt.wrap::<u64, u8>(shifted);
}

fn encode(first: u64, second: u64, third: u64) -> result: Array<u8, 24> pure {
  let bytes = array_filled::<u8, 24>(value: 0_u8);
  set bytes[0_u64] = byte_of(number: first, shift: 0_u32);
  set bytes[1_u64] = byte_of(number: first, shift: 8_u32);
  set bytes[2_u64] = byte_of(number: first, shift: 16_u32);
  set bytes[3_u64] = byte_of(number: first, shift: 24_u32);
  set bytes[4_u64] = byte_of(number: first, shift: 32_u32);
  set bytes[5_u64] = byte_of(number: first, shift: 40_u32);
  set bytes[6_u64] = byte_of(number: first, shift: 48_u32);
  set bytes[7_u64] = byte_of(number: first, shift: 56_u32);
  set bytes[8_u64] = byte_of(number: second, shift: 0_u32);
  set bytes[9_u64] = byte_of(number: second, shift: 8_u32);
  set bytes[10_u64] = byte_of(number: second, shift: 16_u32);
  set bytes[11_u64] = byte_of(number: second, shift: 24_u32);
  set bytes[12_u64] = byte_of(number: second, shift: 32_u32);
  set bytes[13_u64] = byte_of(number: second, shift: 40_u32);
  set bytes[14_u64] = byte_of(number: second, shift: 48_u32);
  set bytes[15_u64] = byte_of(number: second, shift: 56_u32);
  set bytes[16_u64] = byte_of(number: third, shift: 0_u32);
  set bytes[17_u64] = byte_of(number: third, shift: 8_u32);
  set bytes[18_u64] = byte_of(number: third, shift: 16_u32);
  set bytes[19_u64] = byte_of(number: third, shift: 24_u32);
  set bytes[20_u64] = byte_of(number: third, shift: 32_u32);
  set bytes[21_u64] = byte_of(number: third, shift: 40_u32);
  set bytes[22_u64] = byte_of(number: third, shift: 48_u32);
  set bytes[23_u64] = byte_of(number: third, shift: 56_u32);
  return bytes;
}

fn verdict(first: u64, second: u64, third: u64) -> result: u8 pure {
  if first != 2016_u64 {
    return 1_u8;
  }
  if second != 1024_u64 {
    return 2_u8;
  }
  if third != 3168_u64 {
    return 3_u8;
  }
  return 0_u8;
}

fn read_sum(head: &Option<Box<Link>>) -> result: u64 reads(head) {
  let cursor = head;
  let total = 0_u64;
  loop {
    match cursor^ {
      Some(value: node) => {
        set total = total +wrap node^.inner.value;
        set cursor = &node^.inner.next;
      }
      None() => {
        return total;
      }
    }
  }
}

fn remove_evens(list: Option<Box<Link>>) -> result: Option<Box<Link>> pure {
  match move list {
    Some(value: cell) => {
      let low = iand(cell.inner.value, 1_u64);
      let odd = low == 1_u64;
      if odd {
        let odd_rest = None<Box<Link>>();
        swap(first: &cell.inner.next, second: &odd_rest);
        let odd_tail = remove_evens(list: move odd_rest);
        set cell.inner.next = move odd_tail;
        return Some<Box<Link>>(value: move cell);
      }
      let even_rest = None<Box<Link>>();
      swap(first: &cell.inner.next, second: &even_rest);
      return remove_evens(list: move even_rest);
    }
    None() => {
      return None<Box<Link>>();
    }
  }
}

fn bump_all(list: Option<Box<Link>>) -> result: Option<Box<Link>> pure {
  match move list {
    Some(value: cell) => {
      set cell.inner.value = cell.inner.value +wrap 1_u64;
      let rest = None<Box<Link>>();
      swap(first: &cell.inner.next, second: &rest);
      let tail = bump_all(list: move rest);
      set cell.inner.next = move tail;
      return Some<Box<Link>>(value: move cell);
    }
    None() => {
      return None<Box<Link>>();
    }
  }
}

fn build_list() -> result: Option<Box<Link>> pure {
  let head = None<Box<Link>>();
  for (i in 0_u64..64_u64) {
    let number = 63_u64 -wrap i;
    let node = Link(value: number, next: move head);
    let cell = box_new::<Link>(value: move node);
    set head = Some<Box<Link>>(value: move cell);
  }
  return move head;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: output, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move cwd_directory;
  let write_closed = std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  let read_closed = std::fs::close_directory(factory: &factory, directory: move directory_read);
  let code = 0_u8;
  match write_closed {
    Ok(value: unused_write_closed) => {
    }
    Err(error: unused_write_error) => {
      set code = 250_u8;
    }
  }
  match read_closed {
    Ok(value: unused_read_closed) => {
    }
    Err(error: unused_read_error) => {
      set code = 250_u8;
    }
  }
  let head = build_list();
  let first_sum = read_sum(head: &head);
  set head = remove_evens(list: move head);
  let second_sum = read_sum(head: &head);
  set head = bump_all(list: move head);
  let read_a = read_sum(head: &head);
  let read_b = read_sum(head: &head);
  let read_c = read_sum(head: &head);
  let partial = read_a +wrap read_b;
  let third_sum = partial +wrap read_c;
  let verdict_code = verdict(first: first_sum, second: second_sum, third: third_sum);
  let encoded = encode(first: first_sum, second: second_sum, third: third_sum);
  let view = &encoded[0_u64..24_u64];
  let length = view^.len;
  let published = publish_all(factory: &factory, output: &output, source: view, length: length);
  match published {
    Ok(value: unused_published) => {
    }
    Err(error: unused_publish_error) => {
      set code = 250_u8;
    }
  }
  if code != 0_u8 {
    return exit_status(code: code);
  }
  return exit_status(code: verdict_code);
}

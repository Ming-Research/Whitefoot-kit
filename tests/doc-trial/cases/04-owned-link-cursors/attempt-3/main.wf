alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias Instant = std::time::Instant;
alias CancelWatch = std::time::CancelWatch;

struct Node {
  value: u64;
  next: Option<Box<Node>>;
}

fn build_range(from: u64, to: u64) -> result: Option<Box<Node>> pure contract {
  requires from <= to;
} {
  if from == to {
    return None<Box<Node>>();
  } else {
    let rest = build_range(from: from + 1_u64, to: to);
    let node = Node(value: from, next: move rest);
    let boxed = box_new::<Node>(value: move node);
    return Some<Box<Node>>(value: move boxed);
  }
}

fn build_list() -> result: Option<Box<Node>> pure {
  return build_range(from: 0_u64, to: 64_u64);
}

fn sum_list(head: &Option<Box<Node>>) -> result: u64 reads(head) {
  match head^ {
    Some(value: node) => {
      let current_val = node^.inner.value;
      let rest_sum = sum_list(head: &node^.inner.next);
      let total = current_val + rest_sum;
      return total;
    }
    None() => {
      return 0_u64;
    }
  }
}

fn remove_evens(head: &Option<Box<Node>>) -> result: unit writes(head) {
  remove_evens_iter(option_ref: head);
  return unit;
}

fn remove_evens_iter(option_ref: &Option<Box<Node>>) -> result: unit writes(option_ref) {
  match option_ref^ {
    Some(value: node) => {
      let current_value = node^.inner.value;
      let is_even = iand(current_value, 1_u64) == 0_u64;

      if is_even {
        let mut next = None<Box<Node>>();
        swap(first: &node^.inner.next, second: &next);
        set option_ref^ = move next;
        remove_evens_iter(option_ref: option_ref);
      } else {
        remove_evens_iter(option_ref: &node^.inner.next);
      }
      return unit;
    }
    None() => {
      return unit;
    }
  }
}

fn increment_all(option_ref: &Option<Box<Node>>) -> result: unit writes(option_ref) {
  match option_ref^ {
    Some(value: node) => {
      set node^.inner.value = node^.inner.value + 1_u64;
      increment_all(option_ref: &node^.inner.next);
      return unit;
    }
    None() => {
      return unit;
    }
  }
}

fn write_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  requires length <= source^.len;
} {
  let sent = 0_u64;
  loop @write_loop {
    if sent < length {
    } else {
      break @write_loop;
    }
    let no_deadline = None<Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn write_little_endian(factory: &HandleFactory, output: &OutputStream, value: u64) -> result: Result<unit, IoError> writes(factory), writes(output) waits {
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  set bytes[0_u64] = cvt.wrap::<u64, u8>(iand(value, 255_u64));
  set bytes[1_u64] = cvt.wrap::<u64, u8>(iand(ishr(value, 8_u32), 255_u64));
  set bytes[2_u64] = cvt.wrap::<u64, u8>(iand(ishr(value, 16_u32), 255_u64));
  set bytes[3_u64] = cvt.wrap::<u64, u8>(iand(ishr(value, 24_u32), 255_u64));
  set bytes[4_u64] = cvt.wrap::<u64, u8>(iand(ishr(value, 32_u32), 255_u64));
  set bytes[5_u64] = cvt.wrap::<u64, u8>(iand(ishr(value, 40_u32), 255_u64));
  set bytes[6_u64] = cvt.wrap::<u64, u8>(iand(ishr(value, 48_u32), 255_u64));
  set bytes[7_u64] = cvt.wrap::<u64, u8>(iand(ishr(value, 56_u32), 255_u64));
  let view = &bytes[0_u64..8_u64];
  return write_all(factory: factory, output: output, source: view, length: 8_u64);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: stdout_stream, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;

  let std::fs::Directory(read: directory, write: directory_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory);

  let list = build_list();

  let sum1 = sum_list(head: &list);
  if sum1 != 2016_u64 {
    return exit_status(code: 1_u8);
  }

  remove_evens(head: &list);

  let sum2 = sum_list(head: &list);
  if sum2 != 1024_u64 {
    return exit_status(code: 2_u8);
  }

  increment_all(option_ref: &list);

  let sum3_part = sum_list(head: &list);
  let sum3_b = sum_list(head: &list);
  let sum3_c = sum_list(head: &list);
  let sum3 = sum3_part +wrap sum3_b +wrap sum3_c;

  if sum3 != 3168_u64 {
    return exit_status(code: 3_u8);
  }

  let write1 = write_little_endian(factory: &factory, output: &stdout_stream, value: sum1);
  match write1 {
    Ok(value: unused_ok) => {
    }
    Err(error: unused_err) => {
      return exit_status(code: 250_u8);
    }
  }

  let write2 = write_little_endian(factory: &factory, output: &stdout_stream, value: sum2);
  match write2 {
    Ok(value: unused_ok) => {
    }
    Err(error: unused_err) => {
      return exit_status(code: 250_u8);
    }
  }

  let write3 = write_little_endian(factory: &factory, output: &stdout_stream, value: sum3);
  match write3 {
    Ok(value: unused_ok) => {
    }
    Err(error: unused_err) => {
      return exit_status(code: 250_u8);
    }
  }

  return exit_status(code: 0_u8);
}

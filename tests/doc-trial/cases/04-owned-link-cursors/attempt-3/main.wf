alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias HandleFactory = std::io::HandleFactory;
alias IoError = std::io::IoError;
alias OutputStream = std::io::OutputStream;

struct Link {
  value: u64;
  next: Option<Box<Link>>;
}

enum Step {
  Stop();
  Advance();
  Unlink();
}

fn build_list() -> result: Option<Box<Link>> pure {
  let head = None<Box<Link>>();
  for (i in 0_u64..64_u64) {
    let value = 63_u64 -wrap i;
    let link = Link(value: value, next: move head);
    let cell = box_new::<Link>(value: move link);
    set head = Some<Box<Link>>(value: move cell);
  }
  return move head;
}

fn list_sum(head: &Option<Box<Link>>) -> result: u64 reads(head) {
  let cursor = head;
  let total = 0_u64;
  loop {
    match cursor^ {
      Some(value: node) => {
        set total = total +wrap node^.inner.value;
        set cursor = &node^.inner.next;
      }
      None() => {
        return total;
      }
    }
  }
}

fn classify(list: &Option<Box<Link>>) -> result: Step reads(list) {
  match list^ {
    Some(value: node) => {
      let bit = iand(node^.inner.value, 1_u64);
      if bit == 0_u64 {
        return Step::Unlink();
      }
      return Step::Advance();
    }
    None() => {
      return Step::Stop();
    }
  }
}

fn remove_evens(head: &Option<Box<Link>>) -> result: unit writes(head) {
  let cursor = head;
  loop {
    let step = classify(list: cursor);
    match step {
      Stop() => {
        break;
      }
      Advance() => {
        match cursor^ {
          Some(value: node) => {
            set cursor = &node^.inner.next;
          }
          None() => {
            break;
          }
        }
      }
      Unlink() => {
        let taken = None<Box<Link>>();
        swap(first: cursor, second: &taken);
        match move taken {
          Some(value: cell) => {
            let Link(value: unused_value, next: rest) = move cell.inner;
            set cursor^ = move rest;
          }
          None() => {
            break;
          }
        }
      }
    }
  }
  return unit;
}

fn increment_all(head: &Option<Box<Link>>) -> result: unit writes(head) {
  let cursor = head;
  loop {
    match cursor^ {
      Some(value: node) => {
        set node^.inner.value = node^.inner.value +wrap 1_u64;
        set cursor = &node^.inner.next;
      }
      None() => {
        return unit;
      }
    }
  }
}

fn low_byte(value: u64, shift: u32) -> result: u8 pure {
  let moved = ishr.wrap(value, shift);
  return cvt.wrap::<u64, u8>(moved);
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: cwd_directory, stdout: output, handles: factory, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move cwd_directory;
  let head = build_list();
  let before = list_sum(head: &head);
  remove_evens(head: &head);
  let after = list_sum(head: &head);
  increment_all(head: &head);
  let first_read = list_sum(head: &head);
  let second_read = list_sum(head: &head);
  let third_read = list_sum(head: &head);
  let partial = first_read +wrap second_read;
  let total = partial +wrap third_read;
  let first_ok = before == 2016_u64;
  let second_ok = after == 1024_u64;
  let third_ok = total == 3168_u64;
  let code = 0_u8;
  if bnot(third_ok) {
    set code = 3_u8;
  }
  if bnot(second_ok) {
    set code = 2_u8;
  }
  if bnot(first_ok) {
    set code = 1_u8;
  }
  let out = array_filled::<u8, 24>(value: 0_u8);
  set out[0_u64] = low_byte(value: before, shift: 0_u32);
  set out[1_u64] = low_byte(value: before, shift: 8_u32);
  set out[2_u64] = low_byte(value: before, shift: 16_u32);
  set out[3_u64] = low_byte(value: before, shift: 24_u32);
  set out[4_u64] = low_byte(value: before, shift: 32_u32);
  set out[5_u64] = low_byte(value: before, shift: 40_u32);
  set out[6_u64] = low_byte(value: before, shift: 48_u32);
  set out[7_u64] = low_byte(value: before, shift: 56_u32);
  set out[8_u64] = low_byte(value: after, shift: 0_u32);
  set out[9_u64] = low_byte(value: after, shift: 8_u32);
  set out[10_u64] = low_byte(value: after, shift: 16_u32);
  set out[11_u64] = low_byte(value: after, shift: 24_u32);
  set out[12_u64] = low_byte(value: after, shift: 32_u32);
  set out[13_u64] = low_byte(value: after, shift: 40_u32);
  set out[14_u64] = low_byte(value: after, shift: 48_u32);
  set out[15_u64] = low_byte(value: after, shift: 56_u32);
  set out[16_u64] = low_byte(value: total, shift: 0_u32);
  set out[17_u64] = low_byte(value: total, shift: 8_u32);
  set out[18_u64] = low_byte(value: total, shift: 16_u32);
  set out[19_u64] = low_byte(value: total, shift: 24_u32);
  set out[20_u64] = low_byte(value: total, shift: 32_u32);
  set out[21_u64] = low_byte(value: total, shift: 40_u32);
  set out[22_u64] = low_byte(value: total, shift: 48_u32);
  set out[23_u64] = low_byte(value: total, shift: 56_u32);
  let view = &out[0_u64..24_u64];
  let published = publish_all(factory: &factory, output: &output, source: view, length: 24_u64);
  match published {
    Ok(value: unused_published) => {
    }
    Err(error: unused_publish_error) => {
      set code = 250_u8;
    }
  }
  let closed_write = std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  match closed_write {
    Ok(value: unused_closed_write) => {
    }
    Err(error: unused_write_error) => {
      set code = 250_u8;
    }
  }
  let closed_read = std::fs::close_directory(factory: &factory, directory: move directory_read);
  match closed_read {
    Ok(value: unused_closed_read) => {
    }
    Err(error: unused_read_error) => {
      set code = 250_u8;
    }
  }
  return std::process::exit_status(code: code);
}

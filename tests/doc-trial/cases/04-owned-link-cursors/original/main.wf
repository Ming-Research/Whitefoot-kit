alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias write_once = std::io::write_once;

struct Link {
  value: u64;
  next: Option<Box<Link>>;
}

fn list(count: u64) -> result: Option<Box<Link>> pure {
  let head = None<Box<Link>>();
  for (i in 0_u64..count) {
    let node = Link(value: i, next: move head);
    let cell = box_new::<Link>(value: move node);
    set head = Some<Box<Link>>(value: move cell);
  }
  return move head;
}

fn sum(head: &Option<Box<Link>>) -> result: u64 reads(head) {
  let cursor = head;
  let total = 0_u64;
  loop {
    match cursor^ {
      Some(value: node) => {
        set total = total +wrap node^.inner.value;
        set cursor = &node^.inner.next;
      }
      None() => {
        return total;
      }
    }
  }
}

fn without_first(head: Option<Box<Link>>) -> result: Option<Box<Link>> pure {
  match move head {
    Some(value: cell) => {
      let node = move cell.inner;
      return move node.next;
    }
    None() => {
      return None<Box<Link>>();
    }
  }
}

fn remove_even(head: &Option<Box<Link>>) -> result: unit writes(head) {
  doc "A single link-slot cursor removes nodes by atomic owned transformation, preserving the occupied slot and releasing each removed cell.";
  let cursor = head;
  loop {
    match cursor^ {
      Some(value: node) => {
        let parity = node^.inner.value % 2_u64;
        if parity == 0_u64 {
          set cursor^ = without_first(head: move cursor^);
        } else {
          set cursor = &node^.inner.next;
        }
      }
      None() => {
        return unit;
      }
    }
  }
}

fn raise_values(head: &Option<Box<Link>>) -> result: unit writes(head) {
  let cursor = head;
  loop {
    match cursor^ {
      Some(value: node) => {
        set node^.inner.value = node^.inner.value +wrap 1_u64;
        set cursor = &node^.inner.next;
      }
      None() => {
        return unit;
      }
    }
  }
}

fn repeated_sum(head: &Option<Box<Link>>) -> result: u64 reads(head) {
  doc "Nested loops reset the same cursor to its root between complete walks.";
  let cursor = head;
  let total = 0_u64;
  for (pass in 0_u64..3_u64) {
    set cursor = head;
    loop @walk {
      match cursor^ {
        Some(value: node) => {
          set total = total +wrap node^.inner.value;
          set cursor = &node^.inner.next;
        }
        None() => {
          break @walk;
        }
      }
    }
  }
  return total;
}

fn low_byte(v: u64) -> result: u8 pure {
  let low = iand(v, 255_u64);
  let byte = cvt::<u64, u8>(low);
  return byte;
}

fn spell(destination: &[u8], at: u64, value: u64) -> result: u64 writes(destination) {
  doc "Writes the eight little-endian bytes of value at the given offset, skipping any slot the range does not have.";
  let cursor = at;
  let rest = value;
  loop @octets {
    let limit = at +wrap 8_u64;
    let done = cursor >= limit;
    if done {
      break @octets;
    }
    let spare = destination^.len;
    let writable = cursor < spare;
    if writable {
      let byte = low_byte(v: rest);
      set destination^[cursor] = byte;
    }
    set rest = irotr(rest, 8_u32);
    set cursor = cursor +wrap 1_u64;
  }
  return at +wrap 8_u64;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  doc "Publishes one prefix of the source range, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let wait_cancel_1 = std::time::cancel_never();
    let wait_outcome_1 = write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &wait_cancel_1);
    std::time::close_cancel_watch(watch: move wait_cancel_1);
    match wait_outcome_1 {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn publish_report(factory: &HandleFactory, output: &OutputStream, source: &[u8]) -> status: ExitStatus reads(source), writes(factory), writes(output) waits {
  doc "Trial adaptation: publish the actual observations with the maintained stdin_echo partial-write retry; status 250 reports publication failure.";
  let length = source^.len;
  match publish_all(factory: factory, output: output, source: source, length: length) {
    Ok(value: published) => {
      return exit_status(code: 0_u8);
    }
    Err(error: problem) => {
      return exit_status(code: 250_u8);
    }
  }
}

fn main(inputs: std::process::Inputs) -> status: ExitStatus pure waits {
  doc "Trial adaptation: extract the linked-list cursor operations and fixture; publish all three computed sums.";
  let std::process::Inputs(cwd: directory, handles: factory, stdout: out, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let report = slots_new::<u8, 24>();
  for (
    at in 0_u64..24_u64,
    invariant grown: report.len == at
  ) {
    place_back(window: &report, value: 0_u8);
  }
  let report_window = &report[0_u64..24_u64];
  let head = list(count: 64_u64);
  let before = sum(head: &head);
  let recorded_0 = spell(destination: report_window, at: 0_u64, value: before);
  if before != 2016_u64 {
    return exit_status(code: 1_u8);
  }
  remove_even(head: &head);
  let odd_sum = sum(head: &head);
  let recorded_8 = spell(destination: report_window, at: 8_u64, value: odd_sum);
  if odd_sum != 1024_u64 {
    return exit_status(code: 2_u8);
  }
  raise_values(head: &head);
  let raised = repeated_sum(head: &head);
  let recorded_16 = spell(destination: report_window, at: 16_u64, value: raised);
  if raised != 3168_u64 {
    return exit_status(code: 3_u8);
  }
  return publish_report(factory: &factory, output: &out, source: report_window);
}

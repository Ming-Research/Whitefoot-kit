alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias Instant = std::time::Instant;
alias CancelWatch = std::time::CancelWatch;

fn write_u64_le(buffer: &[u8], offset: u64, value: u64) -> result: unit writes(buffer) contract {
  requires offset + 8_u64 <= buffer^.len;
} {
  let b0 = cvt.wrap::<u64, u8>(value);
  let b1 = cvt.wrap::<u64, u8>(ishr(value, 8_u32));
  let b2 = cvt.wrap::<u64, u8>(ishr(value, 16_u32));
  let b3 = cvt.wrap::<u64, u8>(ishr(value, 24_u32));
  let b4 = cvt.wrap::<u64, u8>(ishr(value, 32_u32));
  let b5 = cvt.wrap::<u64, u8>(ishr(value, 40_u32));
  let b6 = cvt.wrap::<u64, u8>(ishr(value, 48_u32));
  let b7 = cvt.wrap::<u64, u8>(ishr(value, 56_u32));
  set buffer^[offset] = b0;
  set buffer^[offset + 1_u64] = b1;
  set buffer^[offset + 2_u64] = b2;
  set buffer^[offset + 3_u64] = b3;
  set buffer^[offset + 4_u64] = b4;
  set buffer^[offset + 5_u64] = b5;
  set buffer^[offset + 6_u64] = b6;
  set buffer^[offset + 7_u64] = b7;
  return unit;
}

fn validate(parents: &[u32], depths: &[u32]) -> result: Bool pure contract {
  requires parents^.len == depths^.len;
} {
  let n = parents^.len;
  if n == 0_u64 {
    return True();
  }
  let valid = True();
  for (i in 0_u64..n) {
    let parent = parents^[i];
    let depth = depths^[i];
    let depth_valid = depth <= 4096_u32;
    if depth_valid {
    } else {
      set valid = False();
      break;
    }
    let n_u32 = cvt.wrap::<u64, u32>(n);
    let is_sentinel = parent == n_u32;
    if is_sentinel {
    } else {
      let parent_u64 = cvt.wrap::<u32, u64>(parent);
      let parent_in_range = parent_u64 < i;
      if parent_in_range {
        let parent_depth = depths^[parent_u64];
        let parent_depth_ok = parent_depth + 1_u32 == depth;
        if parent_depth_ok {
        } else {
          set valid = False();
          break;
        }
      } else {
        set valid = False();
        break;
      }
    }
  }
  return valid;
}

fn count_groups(depths: &[u32]) -> result: u64 pure {
  let n = depths^.len;
  if n == 0_u64 {
    return 1_u64;
  }
  let max_depth = 0_u32;
  for (i in 0_u64..n) {
    let d = depths^[i];
    if d > max_depth {
      set max_depth = d;
    }
  }
  let num_groups = cvt.wrap::<u32, u64>(max_depth) + 1_u64;
  return num_groups;
}

fn build_positions(depths: &[u32], positions: &[u64]) -> result: unit writes(positions) contract {
  requires positions^.len == depths^.len;
} {
  let n = depths^.len;
  let counts = array_filled::<u64, 4097>(value: 0_u64);
  for (i in 0_u64..n) {
    let depth = depths^[i];
    let depth_u64 = cvt.wrap::<u32, u64>(depth);
    if depth_u64 < 4097_u64 {
      let count = counts[depth_u64];
      set positions^[i] = count;
      let next = count + 1_u64;
      set counts[depth_u64] = next;
    }
  }
  return unit;
}

fn write_all(factory: &HandleFactory, output: &OutputStream, buffer: &[u8]) -> result: Result<unit, IoError> reads(buffer), writes(factory), writes(output) waits {
  let length = buffer^.len;
  let sent = 0_u64;
  loop @publish {
    if sent < length {
    } else {
      break @publish;
    }
    let no_deadline = None<Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: buffer, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: stdout_stream, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let buffer = array_filled::<u8, 168>(value: 0_u8);
  let offset = 0_u64;
  let parents = array_filled::<u32, 6>(value: 0_u32);
  set parents[0_u64] = 6_u32;
  set parents[1_u64] = 0_u32;
  set parents[2_u64] = 0_u32;
  set parents[3_u64] = 1_u32;
  set parents[4_u64] = 1_u32;
  set parents[5_u64] = 2_u32;
  let depths = array_filled::<u32, 6>(value: 0_u32);
  set depths[0_u64] = 0_u32;
  set depths[1_u64] = 1_u32;
  set depths[2_u64] = 1_u32;
  set depths[3_u64] = 2_u32;
  set depths[4_u64] = 2_u32;
  set depths[5_u64] = 2_u32;
  let parents_view = &parents[0_u64..6_u64];
  let depths_view = &depths[0_u64..6_u64];
  let valid = validate(parents: parents_view, depths: depths_view);
  write_u64_le(buffer: &buffer, offset: 0_u64, value: if valid {
    give 1_u64;
  } else {
    give 0_u64;
  });
  set offset = 8_u64;
  let num_groups = if valid {
    give count_groups(depths: depths_view);
  } else {
    give 0_u64;
  };
  write_u64_le(buffer: &buffer, offset: offset, value: num_groups);
  set offset = offset + 8_u64;
  if valid {
    let group_lengths = array_filled::<u64, 4097>(value: 0_u64);
    let depth_counts = array_filled::<u64, 4097>(value: 0_u64);
    for (i in 0_u64..6_u64) {
      let depth = depths[i];
      let depth_u64 = cvt.wrap::<u32, u64>(depth);
      if depth_u64 < 4097_u64 {
        let count = depth_counts[depth_u64];
        let next = count + 1_u64;
        set depth_counts[depth_u64] = next;
        set group_lengths[depth_u64] = next;
      }
    }
    for (d in 0_u64..num_groups) {
      let length = group_lengths[d];
      write_u64_le(buffer: &buffer, offset: offset, value: length);
      set offset = offset + 8_u64;
      for (i in 0_u64..6_u64) {
        let depth = depths[i];
        let depth_u64 = cvt.wrap::<u32, u64>(depth);
        if depth_u64 == d {
          write_u64_le(buffer: &buffer, offset: offset, value: i);
          set offset = offset + 8_u64;
        }
      }
    }
    write_u64_le(buffer: &buffer, offset: offset, value: 6_u64);
    set offset = offset + 8_u64;
    let positions = array_filled::<u64, 6>(value: 0_u64);
    let pos_view = &positions[0_u64..6_u64];
    build_positions(depths: depths_view, positions: pos_view);
    for (i in 0_u64..6_u64) {
      write_u64_le(buffer: &buffer, offset: offset, value: positions[i]);
      set offset = offset + 8_u64;
    }
  } else {
    write_u64_le(buffer: &buffer, offset: offset, value: 0_u64);
    set offset = offset + 8_u64;
  }
  let parents2 = array_filled::<u32, 6>(value: 0_u32);
  set parents2[0_u64] = 6_u32;
  set parents2[1_u64] = 0_u32;
  set parents2[2_u64] = 0_u32;
  set parents2[3_u64] = 2_u32;
  set parents2[4_u64] = 1_u32;
  set parents2[5_u64] = 2_u32;
  let depths2 = array_filled::<u32, 6>(value: 0_u32);
  set depths2[0_u64] = 0_u32;
  set depths2[1_u64] = 1_u32;
  set depths2[2_u64] = 1_u32;
  set depths2[3_u64] = 2_u32;
  set depths2[4_u64] = 2_u32;
  set depths2[5_u64] = 2_u32;
  let valid2 = validate(parents: &parents2[0_u64..6_u64], depths: &depths2[0_u64..6_u64]);
  write_u64_le(buffer: &buffer, offset: offset, value: if valid2 {
    give 1_u64;
  } else {
    give 0_u64;
  });
  set offset = offset + 8_u64;
  let parents3 = array_filled::<u32, 6>(value: 0_u32);
  set parents3[0_u64] = 6_u32;
  set parents3[1_u64] = 0_u32;
  set parents3[2_u64] = 0_u32;
  set parents3[3_u64] = 1_u32;
  set parents3[4_u64] = 1_u32;
  set parents3[5_u64] = 2_u32;
  let depths3 = array_filled::<u32, 6>(value: 0_u32);
  set depths3[0_u64] = 0_u32;
  set depths3[1_u64] = 1_u32;
  set depths3[2_u64] = 1_u32;
  set depths3[3_u64] = 1_u32;
  set depths3[4_u64] = 2_u32;
  set depths3[5_u64] = 2_u32;
  let valid3 = validate(parents: &parents3[0_u64..6_u64], depths: &depths3[0_u64..6_u64]);
  write_u64_le(buffer: &buffer, offset: offset, value: if valid3 {
    give 1_u64;
  } else {
    give 0_u64;
  });
  set offset = offset + 8_u64;
  let parents4 = array_filled::<u32, 6>(value: 0_u32);
  set parents4[0_u64] = 6_u32;
  set parents4[1_u64] = 0_u32;
  set parents4[2_u64] = 0_u32;
  set parents4[3_u64] = 1_u32;
  set parents4[4_u64] = 1_u32;
  set parents4[5_u64] = 2_u32;
  let depths4 = array_filled::<u32, 6>(value: 0_u32);
  set depths4[0_u64] = 0_u32;
  set depths4[1_u64] = 1_u32;
  set depths4[2_u64] = 1_u32;
  set depths4[3_u64] = 2_u32;
  set depths4[4_u64] = 2_u32;
  set depths4[5_u64] = 4097_u32;
  let valid4 = validate(parents: &parents4[0_u64..6_u64], depths: &depths4[0_u64..6_u64]);
  write_u64_le(buffer: &buffer, offset: offset, value: if valid4 {
    give 1_u64;
  } else {
    give 0_u64;
  });
  let buffer_view = &buffer[0_u64..168_u64];
  let write_result = write_all(factory: &factory, output: &stdout_stream, buffer: buffer_view);
  match write_result {
    Ok(value: unused_ok) => {
      return exit_status(code: 0_u8);
    }
    Err(error: problem) => {
      return exit_status(code: 1_u8);
    }
  }
}

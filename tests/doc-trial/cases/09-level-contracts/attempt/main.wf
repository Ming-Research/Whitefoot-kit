alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias Instant = std::time::Instant;

fn validate(parents: &[u32], depths: &[u32]) -> result: Bool pure contract {
  requires parents^.len == depths^.len;
} {
  let n = parents^.len;
  let valid = True();
  let n_u32 = cvt::<u64, u32>(n);
  for (i in 0_u64..n) {
    let depth = depths^[i];
    if depth > 4096_u32 {
      set valid = False();
    }
    let parent = parents^[i];
    if parent < n_u32 {
      let parent_idx = cvt::<u32, u64>(parent);
      if parent_idx >= i {
        set valid = False();
      }
      let parent_depth = depths^[parent_idx];
      let expected = depth - 1_u32;
      if parent_depth != expected {
        set valid = False();
      }
    } else if parent == n_u32 {
    } else {
      set valid = False();
    }
  }
  return valid;
}

fn count_groups(depths: &[u32]) -> result: u64 pure {
  let max_depth = 0_u32;
  for (i in 0_u64..depths^.len) {
    let d = depths^[i];
    if d > max_depth {
      set max_depth = d;
    }
  }
  let max_as_u64 = cvt::<u32, u64>(max_depth);
  let count = max_as_u64 + 1_u64;
  return count;
}

fn write_u64_le(factory: &HandleFactory, output: &OutputStream, value: u64) -> result: Result<unit, IoError> writes(factory), writes(output) waits {
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  set bytes[0_u64] = cvt.wrap::<u64, u8>(value);
  set bytes[1_u64] = cvt.wrap::<u64, u8>(ishr(value, 8_u32));
  set bytes[2_u64] = cvt.wrap::<u64, u8>(ishr(value, 16_u32));
  set bytes[3_u64] = cvt.wrap::<u64, u8>(ishr(value, 24_u32));
  set bytes[4_u64] = cvt.wrap::<u64, u8>(ishr(value, 32_u32));
  set bytes[5_u64] = cvt.wrap::<u64, u8>(ishr(value, 40_u32));
  set bytes[6_u64] = cvt.wrap::<u64, u8>(ishr(value, 48_u32));
  set bytes[7_u64] = cvt.wrap::<u64, u8>(ishr(value, 56_u32));
  let sent = 0_u64;
  loop @send {
    if sent < 8_u64 {
    } else {
      break @send;
    }
    let no_deadline = None<Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: &bytes[0_u64..8_u64], start: sent, end: 8_u64, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn process_and_output(factory: &HandleFactory, output: &OutputStream, parents: &[u32], depths: &[u32]) -> result: Result<unit, IoError> reads(parents), reads(depths), writes(output), writes(factory) waits {
  let is_valid = validate(parents: parents, depths: depths);
  let tag = if is_valid {
    give 1_u64;
  } else {
    give 0_u64;
  };
  match write_u64_le(factory: factory, output: output, value: tag) {
    Ok(value: unit_val) => {
    }
    Err(error: e) => {
      return Err<unit, IoError>(error: move e);
    }
  }
  if is_valid {
    let group_count = count_groups(depths: depths);
    match write_u64_le(factory: factory, output: output, value: group_count) {
      Ok(value: unit_val) => {
      }
      Err(error: e) => {
        return Err<unit, IoError>(error: move e);
      }
    }
    let group_counts = box_array_filled::<u64>(count: group_count, value: 0_u64);
    let count_view = &group_counts.inner[0_u64..group_count];
    for (i in 0_u64..parents^.len) {
      let d = cvt::<u32, u64>(depths^[i]);
      set count_view^[d] = count_view^[d] +wrap 1_u64;
    }
    for (g in 0_u64..group_count) {
      let count_g = count_view^[g];
      match write_u64_le(factory: factory, output: output, value: count_g) {
        Ok(value: unit_val) => {
        }
        Err(error: e) => {
          return Err<unit, IoError>(error: move e);
        }
      }
      for (i in 0_u64..parents^.len) {
        let d = cvt::<u32, u64>(depths^[i]);
        if d == g {
          match write_u64_le(factory: factory, output: output, value: i) {
            Ok(value: unit_val) => {
            }
            Err(error: e) => {
              return Err<unit, IoError>(error: move e);
            }
          }
        }
      }
    }
    match write_u64_le(factory: factory, output: output, value: parents^.len) {
      Ok(value: unit_val) => {
      }
      Err(error: e) => {
        return Err<unit, IoError>(error: move e);
      }
    }
    for (i in 0_u64..parents^.len) {
      let depth_i = cvt::<u32, u64>(depths^[i]);
      let position = 0_u64;
      for (j in 0_u64..i) {
        let depth_j = cvt::<u32, u64>(depths^[j]);
        if depth_j == depth_i {
          set position = position +wrap 1_u64;
        }
      }
      match write_u64_le(factory: factory, output: output, value: position) {
        Ok(value: unit_val) => {
        }
        Err(error: e) => {
          return Err<unit, IoError>(error: move e);
        }
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: cwd_directory, handles: factory, stdout: output, ..) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  std::fs::close_directory(factory: &factory, directory: move cwd);
  let valid_parents = array_filled::<u32, 6>(value: 0_u32);
  set valid_parents[0_u64] = 6_u32;
  set valid_parents[1_u64] = 0_u32;
  set valid_parents[2_u64] = 0_u32;
  set valid_parents[3_u64] = 1_u32;
  set valid_parents[4_u64] = 1_u32;
  set valid_parents[5_u64] = 2_u32;
  let valid_depths = array_filled::<u32, 6>(value: 0_u32);
  set valid_depths[0_u64] = 0_u32;
  set valid_depths[1_u64] = 1_u32;
  set valid_depths[2_u64] = 1_u32;
  set valid_depths[3_u64] = 2_u32;
  set valid_depths[4_u64] = 2_u32;
  set valid_depths[5_u64] = 2_u32;
  let code = 0_u8;
  match process_and_output(factory: &factory, output: &output, parents: &valid_parents[0_u64..6_u64], depths: &valid_depths[0_u64..6_u64]) {
    Ok(value: unit_val) => {
    }
    Err(error: e) => {
      set code = 1_u8;
    }
  }
  let invalid1_parents = array_filled::<u32, 6>(value: 0_u32);
  set invalid1_parents[0_u64] = 6_u32;
  set invalid1_parents[1_u64] = 2_u32;
  set invalid1_parents[2_u64] = 0_u32;
  set invalid1_parents[3_u64] = 1_u32;
  set invalid1_parents[4_u64] = 1_u32;
  set invalid1_parents[5_u64] = 2_u32;
  let invalid1_depths = array_filled::<u32, 6>(value: 0_u32);
  set invalid1_depths[0_u64] = 0_u32;
  set invalid1_depths[1_u64] = 1_u32;
  set invalid1_depths[2_u64] = 1_u32;
  set invalid1_depths[3_u64] = 2_u32;
  set invalid1_depths[4_u64] = 2_u32;
  set invalid1_depths[5_u64] = 2_u32;
  match process_and_output(factory: &factory, output: &output, parents: &invalid1_parents[0_u64..6_u64], depths: &invalid1_depths[0_u64..6_u64]) {
    Ok(value: unit_val) => {
    }
    Err(error: e) => {
      set code = 1_u8;
    }
  }
  let invalid2_parents = array_filled::<u32, 6>(value: 0_u32);
  set invalid2_parents[0_u64] = 6_u32;
  set invalid2_parents[1_u64] = 0_u32;
  set invalid2_parents[2_u64] = 0_u32;
  set invalid2_parents[3_u64] = 1_u32;
  set invalid2_parents[4_u64] = 1_u32;
  set invalid2_parents[5_u64] = 2_u32;
  let invalid2_depths = array_filled::<u32, 6>(value: 0_u32);
  set invalid2_depths[0_u64] = 0_u32;
  set invalid2_depths[1_u64] = 1_u32;
  set invalid2_depths[2_u64] = 1_u32;
  set invalid2_depths[3_u64] = 1_u32;
  set invalid2_depths[4_u64] = 2_u32;
  set invalid2_depths[5_u64] = 2_u32;
  match process_and_output(factory: &factory, output: &output, parents: &invalid2_parents[0_u64..6_u64], depths: &invalid2_depths[0_u64..6_u64]) {
    Ok(value: unit_val) => {
    }
    Err(error: e) => {
      set code = 1_u8;
    }
  }
  let invalid3_parents = array_filled::<u32, 6>(value: 0_u32);
  set invalid3_parents[0_u64] = 6_u32;
  set invalid3_parents[1_u64] = 0_u32;
  set invalid3_parents[2_u64] = 0_u32;
  set invalid3_parents[3_u64] = 1_u32;
  set invalid3_parents[4_u64] = 1_u32;
  set invalid3_parents[5_u64] = 2_u32;
  let invalid3_depths = array_filled::<u32, 6>(value: 0_u32);
  set invalid3_depths[0_u64] = 4097_u32;
  set invalid3_depths[1_u64] = 1_u32;
  set invalid3_depths[2_u64] = 1_u32;
  set invalid3_depths[3_u64] = 2_u32;
  set invalid3_depths[4_u64] = 2_u32;
  set invalid3_depths[5_u64] = 2_u32;
  match process_and_output(factory: &factory, output: &output, parents: &invalid3_parents[0_u64..6_u64], depths: &invalid3_depths[0_u64..6_u64]) {
    Ok(value: unit_val) => {
    }
    Err(error: e) => {
      set code = 1_u8;
    }
  }
  return exit_status(code: code);
}

alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias Directory = std::fs::Directory;

fn write_u64_le(factory: &HandleFactory, output: &OutputStream, value: u64) -> result: Result<unit, IoError> writes(factory), writes(output) waits {
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  set bytes[0_u64] = cvt.wrap::<u64, u8>(value);
  let v1 = ishr(value, 8_u32);
  set bytes[1_u64] = cvt.wrap::<u64, u8>(v1);
  let v2 = ishr(value, 16_u32);
  set bytes[2_u64] = cvt.wrap::<u64, u8>(v2);
  let v3 = ishr(value, 24_u32);
  set bytes[3_u64] = cvt.wrap::<u64, u8>(v3);
  let v4 = ishr(value, 32_u32);
  set bytes[4_u64] = cvt.wrap::<u64, u8>(v4);
  let v5 = ishr(value, 40_u32);
  set bytes[5_u64] = cvt.wrap::<u64, u8>(v5);
  let v6 = ishr(value, 48_u32);
  set bytes[6_u64] = cvt.wrap::<u64, u8>(v6);
  let v7 = ishr(value, 56_u32);
  set bytes[7_u64] = cvt.wrap::<u64, u8>(v7);
  let sent = 0_u64;
  loop @write {
    if sent < 8_u64 {
    } else {
      break @write;
    }
    let end_pos = 8_u64 - sent;
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    match std::io::write_once(factory: factory, output: output, source: &bytes[sent..8_u64], start: 0_u64, end: end_pos, deadline: no_deadline, cancel: &cancel) {
      Ok(value: next) => {
        set sent = sent + next;
      }
      Err(error: problem) => {
        std::time::close_cancel_watch(watch: move cancel);
        return Err<unit, IoError>(error: problem);
      }
    }
    std::time::close_cancel_watch(watch: move cancel);
  }
  return Ok<unit, IoError>(value: unit);
}

fn validate(parents: &[u32], depths: &[u32]) -> result: u8 reads(parents), reads(depths) {
  let n = parents^.len;
  let valid = True();
  for (i in 0_u64..n) {
    let parent = parents^[i];
    let depth = depths^[i];
    if depth > 4096_u32 {
      set valid = False();
    }
    let parent_u64 = cvt::<u32, u64>(parent);
    if parent_u64 < n {
      if parent_u64 >= i {
        set valid = False();
      } else {
        let parent_depth = depths^[parent_u64];
        let expected_depth = parent_depth + 1_u32;
        if expected_depth != depth {
          set valid = False();
        }
      }
    }
  }
  if valid {
    return 1_u8;
  }
  return 0_u8;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: output, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let Directory(read: cwd, write: cwd_write) = move cwd_directory;
  let write_closed = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let read_closed = std::fs::close_directory(factory: &factory, directory: move cwd);
  let code = 0_u8;
  match write_closed {
    Ok(value: unused) => {
    }
    Err(error: unused) => {
      set code = 1_u8;
    }
  }
  match read_closed {
    Ok(value: unused) => {
    }
    Err(error: unused) => {
      set code = 1_u8;
    }
  }
  let parents = array_filled::<u32, 6>(value: 0_u32);
  set parents[0_u64] = 6_u32;
  set parents[1_u64] = 0_u32;
  set parents[2_u64] = 0_u32;
  set parents[3_u64] = 1_u32;
  set parents[4_u64] = 1_u32;
  set parents[5_u64] = 2_u32;
  let depths = array_filled::<u32, 6>(value: 0_u32);
  set depths[0_u64] = 0_u32;
  set depths[1_u64] = 1_u32;
  set depths[2_u64] = 1_u32;
  set depths[3_u64] = 2_u32;
  set depths[4_u64] = 2_u32;
  set depths[5_u64] = 2_u32;
  let accept = validate(parents: &parents[0_u64..6_u64], depths: &depths[0_u64..6_u64]);
  let accept_u64 = cvt::<u8, u64>(accept);
  match write_u64_le(factory: &factory, output: &output, value: accept_u64) {
    Ok(value: unused) => {
    }
    Err(error: problem) => {
      set code = 1_u8;
    }
  }
  if accept == 1_u8 {
    let max_depth = 0_u32;
    for (i in 0_u64..6_u64) {
      let d = depths[i];
      if d > max_depth {
        set max_depth = d;
      }
    }
    let max_depth_converted = cvt::<u32, u64>(max_depth);
    let max_depth_u64 = max_depth_converted + 1_u64;
    match write_u64_le(factory: &factory, output: &output, value: max_depth_u64) {
      Ok(value: unused) => {
      }
      Err(error: problem) => {
        set code = 1_u8;
      }
    }
    for (
      d in 0_u64..max_depth_u64,
      invariant groups_written: d >= 0_u64
    ) {
      let count = 0_u64;
      for (i in 0_u64..6_u64) {
        let depth_converted = cvt::<u32, u64>(depths[i]);
        if depth_converted == d {
          set count = count + 1_u64;
        }
      }
      match write_u64_le(factory: &factory, output: &output, value: count) {
        Ok(value: unused) => {
        }
        Err(error: problem) => {
          set code = 1_u8;
        }
      }
      for (i in 0_u64..6_u64) {
        let depth_converted = cvt::<u32, u64>(depths[i]);
        if depth_converted == d {
          match write_u64_le(factory: &factory, output: &output, value: i) {
            Ok(value: unused) => {
            }
            Err(error: problem) => {
              set code = 1_u8;
            }
          }
        }
      }
    }
    match write_u64_le(factory: &factory, output: &output, value: 6_u64) {
      Ok(value: unused) => {
      }
      Err(error: problem) => {
        set code = 1_u8;
      }
    }
    for (i in 0_u64..6_u64) {
      let position = 0_u64;
      for (j in 0_u64..i) {
        if depths[j] == depths[i] {
          set position = position + 1_u64;
        }
      }
      match write_u64_le(factory: &factory, output: &output, value: position) {
        Ok(value: unused) => {
        }
        Err(error: problem) => {
          set code = 1_u8;
        }
      }
    }
  }
  let parents1 = array_filled::<u32, 6>(value: 0_u32);
  set parents1[0_u64] = 6_u32;
  set parents1[1_u64] = 0_u32;
  set parents1[2_u64] = 2_u32;
  set parents1[3_u64] = 1_u32;
  set parents1[4_u64] = 1_u32;
  set parents1[5_u64] = 2_u32;
  let accept1 = validate(parents: &parents1[0_u64..6_u64], depths: &depths[0_u64..6_u64]);
  let accept1_u64 = cvt::<u8, u64>(accept1);
  match write_u64_le(factory: &factory, output: &output, value: accept1_u64) {
    Ok(value: unused) => {
    }
    Err(error: problem) => {
      set code = 1_u8;
    }
  }
  let depths2 = array_filled::<u32, 6>(value: 0_u32);
  set depths2[0_u64] = 0_u32;
  set depths2[1_u64] = 1_u32;
  set depths2[2_u64] = 1_u32;
  set depths2[3_u64] = 1_u32;
  set depths2[4_u64] = 2_u32;
  set depths2[5_u64] = 2_u32;
  let accept2 = validate(parents: &parents[0_u64..6_u64], depths: &depths2[0_u64..6_u64]);
  let accept2_u64 = cvt::<u8, u64>(accept2);
  match write_u64_le(factory: &factory, output: &output, value: accept2_u64) {
    Ok(value: unused) => {
    }
    Err(error: problem) => {
      set code = 1_u8;
    }
  }
  let depths3 = array_filled::<u32, 6>(value: 0_u32);
  set depths3[0_u64] = 4097_u32;
  set depths3[1_u64] = 1_u32;
  set depths3[2_u64] = 1_u32;
  set depths3[3_u64] = 2_u32;
  set depths3[4_u64] = 2_u32;
  set depths3[5_u64] = 2_u32;
  let accept3 = validate(parents: &parents[0_u64..6_u64], depths: &depths3[0_u64..6_u64]);
  let accept3_u64 = cvt::<u8, u64>(accept3);
  match write_u64_le(factory: &factory, output: &output, value: accept3_u64) {
    Ok(value: unused) => {
    }
    Err(error: problem) => {
      set code = 1_u8;
    }
  }
  return exit_status(code: code);
}

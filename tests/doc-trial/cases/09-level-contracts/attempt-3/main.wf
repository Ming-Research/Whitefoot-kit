alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias IoError = std::io::IoError;
alias OutputStream = std::io::OutputStream;
alias Instant = std::time::Instant;

const parents_fixture: Array<u32, 6> =[6_u32, 0_u32, 0_u32, 1_u32, 1_u32, 2_u32];

const depths_fixture: Array<u32, 6> =[0_u32, 1_u32, 1_u32, 2_u32, 2_u32, 2_u32];

fn accepts(parents: &[u32], depths: &[u32]) -> result: Bool reads(parents), reads(depths) {
  let count = parents^.len;
  if depths^.len != count {
    return False();
  }
  for (i in 0_u64..count) {
    if i >= depths^.len {
      return False();
    }
    let depth = cvt::<u32, u64>(depths^[i]);
    if depth > 4096_u64 {
      return False();
    }
    let parent = cvt::<u32, u64>(parents^[i]);
    if parent == count {
      continue;
    }
    if parent >= i {
      return False();
    }
    if parent >= depths^.len {
      return False();
    }
    let parent_depth = cvt::<u32, u64>(depths^[parent]);
    let expected = parent_depth +wrap 1_u64;
    if expected != depth {
      return False();
    }
  }
  return True();
}

fn max_depth(depths: &[u32]) -> result: u64 reads(depths) {
  let best = 0_u64;
  for (i in 0_u64..depths^.len) {
    let depth = cvt::<u32, u64>(depths^[i]);
    if depth > best {
      set best = depth;
    }
  }
  return best;
}

fn place_all(depths: &[u32], counts: &Box<Array<u64>>, places: &Box<Array<u64>>) -> result: unit reads(depths), writes(counts), writes(places) {
  for (i in 0_u64..depths^.len) {
    let depth = cvt::<u32, u64>(depths^[i]);
    if depth < counts^.inner.len {
      let seen = counts^.inner[depth];
      if i < places^.inner.len {
        set places^.inner[i] = seen;
      }
      set counts^.inner[depth] = seen +wrap 1_u64;
    }
  }
  return unit;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn emit_word(factory: &HandleFactory, output: &OutputStream, value: u64) -> result: Bool writes(factory), writes(output) waits {
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  set bytes[0_u64] = cvt.wrap::<u64, u8>(value);
  let shift1 = ishr(value, 8_u32);
  set bytes[1_u64] = cvt.wrap::<u64, u8>(shift1);
  let shift2 = ishr(value, 16_u32);
  set bytes[2_u64] = cvt.wrap::<u64, u8>(shift2);
  let shift3 = ishr(value, 24_u32);
  set bytes[3_u64] = cvt.wrap::<u64, u8>(shift3);
  let shift4 = ishr(value, 32_u32);
  set bytes[4_u64] = cvt.wrap::<u64, u8>(shift4);
  let shift5 = ishr(value, 40_u32);
  set bytes[5_u64] = cvt.wrap::<u64, u8>(shift5);
  let shift6 = ishr(value, 48_u32);
  set bytes[6_u64] = cvt.wrap::<u64, u8>(shift6);
  let shift7 = ishr(value, 56_u32);
  set bytes[7_u64] = cvt.wrap::<u64, u8>(shift7);
  let window = &bytes[0_u64..8_u64];
  let sent = publish_all(factory: factory, output: output, source: window, length: 8_u64);
  match sent {
    Ok(value: unused_sent) => {
      return False();
    }
    Err(error: problem) => {
      return True();
    }
  }
}

fn tag_word(ok: Bool) -> result: u64 pure {
  if ok {
    return 1_u64;
  }
  return 0_u64;
}

fn emit_groups(factory: &HandleFactory, output: &OutputStream, depths: &[u32]) -> result: Bool reads(depths), writes(factory), writes(output) waits {
  let n = depths^.len;
  let deepest = max_depth(depths: depths);
  let groups = deepest +wrap 1_u64;
  let counts = box_array_filled::<u64>(count: groups, value: 0_u64);
  let places = box_array_filled::<u64>(count: n, value: 0_u64);
  place_all(depths: depths, counts: &counts, places: &places);
  let step_groups = emit_word(factory: factory, output: output, value: groups);
  if step_groups {
    return True();
  }
  for (d in 0_u64..counts.inner.len) {
    let length = counts.inner[d];
    let step_length = emit_word(factory: factory, output: output, value: length);
    if step_length {
      return True();
    }
    for (i in 0_u64..n) {
      let depth = cvt::<u32, u64>(depths^[i]);
      if depth == d {
        let step_node = emit_word(factory: factory, output: output, value: i);
        if step_node {
          return True();
        }
      }
    }
  }
  let step_count = emit_word(factory: factory, output: output, value: n);
  if step_count {
    return True();
  }
  for (i in 0_u64..places.inner.len) {
    let position = places.inner[i];
    let step_position = emit_word(factory: factory, output: output, value: position);
    if step_position {
      return True();
    }
  }
  return False();
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: output, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move cwd_directory;
  let write_closed = std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  let read_closed = std::fs::close_directory(factory: &factory, directory: move directory_read);
  let failed = False();
  match write_closed {
    Ok(value: unused_write_closed) => {
    }
    Err(error: unused_write_error) => {
      set failed = True();
    }
  }
  match read_closed {
    Ok(value: unused_read_closed) => {
    }
    Err(error: unused_read_error) => {
      set failed = True();
    }
  }
  let parents = parents_fixture;
  let depths = depths_fixture;
  let valid = accepts(parents: &parents[0_u64..6_u64], depths: &depths[0_u64..6_u64]);
  let valid_tag = tag_word(ok: valid);
  let step_valid = emit_word(factory: &factory, output: &output, value: valid_tag);
  set failed = bor(failed, step_valid);
  let step_groups = emit_groups(factory: &factory, output: &output, depths: &depths[0_u64..6_u64]);
  set failed = bor(failed, step_groups);
  let parents_two = parents_fixture;
  set parents_two[1_u64] = 2_u32;
  let two = accepts(parents: &parents_two[0_u64..6_u64], depths: &depths[0_u64..6_u64]);
  let tag_two = tag_word(ok: two);
  let step_two = emit_word(factory: &factory, output: &output, value: tag_two);
  set failed = bor(failed, step_two);
  let depths_three = depths_fixture;
  set depths_three[3_u64] = 1_u32;
  let three = accepts(parents: &parents[0_u64..6_u64], depths: &depths_three[0_u64..6_u64]);
  let tag_three = tag_word(ok: three);
  let step_three = emit_word(factory: &factory, output: &output, value: tag_three);
  set failed = bor(failed, step_three);
  let depths_root = depths_fixture;
  set depths_root[0_u64] = 4097_u32;
  let root = accepts(parents: &parents[0_u64..6_u64], depths: &depths_root[0_u64..6_u64]);
  let tag_root = tag_word(ok: root);
  let step_root = emit_word(factory: &factory, output: &output, value: tag_root);
  set failed = bor(failed, step_root);
  if failed {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}

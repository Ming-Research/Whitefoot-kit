alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias Instant = std::time::Instant;
alias CancelWatch = std::time::CancelWatch;

fn write_u64(factory: &HandleFactory, output: &OutputStream, value: u64) -> result: Result<unit, IoError> reads(value), writes(factory), writes(output) waits {
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  set bytes[0_u64] = iand(cvt::<u64, u8>(value), 255_u8);
  let b1 = ishr(value, 8_u32);
  set bytes[1_u64] = iand(cvt::<u64, u8>(b1), 255_u8);
  let b2 = ishr(value, 16_u32);
  set bytes[2_u64] = iand(cvt::<u64, u8>(b2), 255_u8);
  let b3 = ishr(value, 24_u32);
  set bytes[3_u64] = iand(cvt::<u64, u8>(b3), 255_u8);
  let b4 = ishr(value, 32_u32);
  set bytes[4_u64] = iand(cvt::<u64, u8>(b4), 255_u8);
  let b5 = ishr(value, 40_u32);
  set bytes[5_u64] = iand(cvt::<u64, u8>(b5), 255_u8);
  let b6 = ishr(value, 48_u32);
  set bytes[6_u64] = iand(cvt::<u64, u8>(b6), 255_u8);
  let b7 = ishr(value, 56_u32);
  set bytes[7_u64] = iand(cvt::<u64, u8>(b7), 255_u8);
  let buffer = &bytes[0_u64..8_u64];
  let deadline = None<Instant>();
  let cancel = std::time::cancel_never();
  let outcome = std::io::write_once(factory: factory, output: output, source: buffer, start: 0_u64, end: 8_u64, deadline: deadline, cancel: &cancel);
  std::time::close_cancel_watch(watch: move cancel);
  match outcome {
    Ok(value: next) => {
      if next == 8_u64 {
        return Ok<unit, IoError>(value: unit);
      }
      return Err<unit, IoError>(error: IoError::WriteZero(code: 0_u32, origin: 0_u8));
    }
    Err(error: problem) => {
      return Err<unit, IoError>(error: problem);
    }
  }
}

fn validate_and_group(parents: &[u32], depths: &[u32], factory: &HandleFactory, output: &OutputStream) -> result: Result<unit, IoError> reads(parents), reads(depths), writes(factory), writes(output) waits {
  let length = parents^.len;
  if length != depths^.len {
    return Err<unit, IoError>(error: IoError::InvalidInput(code: 0_u32, origin: 0_u8));
  }

  let max_depth = 0_u64;
  let valid = True();
  for (i in 0_u64..length) {
    let parent = cvt::<u32, u64>(parents^[i]);
    let depth = cvt::<u32, u64>(depths^[i]);
    if depth > 4096_u64 {
      set valid = False();
    }
    if depth > max_depth {
      set max_depth = depth;
    }
    if parent < length {
      let parent_depth = cvt::<u32, u64>(depths^[parent]);
      if parent_depth + 1_u64 != depth {
        set valid = False();
      }
    } else {
      if parent != length {
        set valid = False();
      }
    }
  }

  let tag = if valid {
    give 1_u64;
  } else {
    give 0_u64;
  };
  let write1 = write_u64(factory: factory, output: output, value: tag);
  match write1 {
    Ok(value: unused) => {
    }
    Err(error: problem) => {
      return Err<unit, IoError>(error: problem);
    }
  }

  if bnot(valid) {
    return Ok<unit, IoError>(value: unit);
  }

  let num_groups = max_depth + 1_u64;
  let write2 = write_u64(factory: factory, output: output, value: num_groups);
  match write2 {
    Ok(value: unused) => {
    }
    Err(error: problem) => {
      return Err<unit, IoError>(error: problem);
    }
  }

  for (d in 0_u64..num_groups) {
    let count = 0_u64;
    for (i in 0_u64..length) {
      let depth = cvt::<u32, u64>(depths^[i]);
      if depth == d {
        set count = count + 1_u64;
      }
    }
    let write_len = write_u64(factory: factory, output: output, value: count);
    match write_len {
      Ok(value: unused) => {
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }

    for (i in 0_u64..length) {
      let depth = cvt::<u32, u64>(depths^[i]);
      if depth == d {
        let node_id = cvt::<u64, u64>(i);
        let write_node = write_u64(factory: factory, output: output, value: node_id);
        match write_node {
          Ok(value: unused) => {
          }
          Err(error: problem) => {
            return Err<unit, IoError>(error: problem);
          }
        }
      }
    }
  }

  let write_pos_count = write_u64(factory: factory, output: output, value: length);
  match write_pos_count {
    Ok(value: unused) => {
    }
    Err(error: problem) => {
      return Err<unit, IoError>(error: problem);
    }
  }

  let counters = box_slots_new::<u64>(capacity: 4097_u64);
  for (i in 0_u64..length) {
    let depth = cvt::<u32, u64>(depths^[i]);
    if depth >= counters.inner.len {
      let padding_count = depth + 1_u64 - counters.inner.len;
      for (p in 0_u64..padding_count) {
        place_back(window: &counters.inner, value: 0_u64);
      }
    }
    let pos = counters.inner[depth];
    set counters.inner[depth] = pos + 1_u64;
    let write_pos = write_u64(factory: factory, output: output, value: pos);
    match write_pos {
      Ok(value: unused) => {
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }

  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: directory, handles: factory, stdout: output, stderr: unused_stderr, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);

  let valid_parents = array_filled::<u32, 6>(value: 0_u32);
  set valid_parents[0_u64] = 6_u32;
  set valid_parents[1_u64] = 0_u32;
  set valid_parents[2_u64] = 0_u32;
  set valid_parents[3_u64] = 1_u32;
  set valid_parents[4_u64] = 1_u32;
  set valid_parents[5_u64] = 2_u32;

  let valid_depths = array_filled::<u32, 6>(value: 0_u32);
  set valid_depths[0_u64] = 0_u32;
  set valid_depths[1_u64] = 1_u32;
  set valid_depths[2_u64] = 1_u32;
  set valid_depths[3_u64] = 2_u32;
  set valid_depths[4_u64] = 2_u32;
  set valid_depths[5_u64] = 2_u32;

  let result1 = validate_and_group(parents: &valid_parents[0_u64..6_u64], depths: &valid_depths[0_u64..6_u64], factory: &factory, output: &output);
  match result1 {
    Ok(value: unused) => {
    }
    Err(error: problem) => {
      return exit_status(code: 1_u8);
    }
  }

  let invalid1_parents = array_filled::<u32, 6>(value: 0_u32);
  set invalid1_parents[0_u64] = 6_u32;
  set invalid1_parents[1_u64] = 0_u32;
  set invalid1_parents[2_u64] = 0_u32;
  set invalid1_parents[3_u64] = 2_u32;
  set invalid1_parents[4_u64] = 1_u32;
  set invalid1_parents[5_u64] = 2_u32;

  let invalid1_depths = array_filled::<u32, 6>(value: 0_u32);
  set invalid1_depths[0_u64] = 0_u32;
  set invalid1_depths[1_u64] = 1_u32;
  set invalid1_depths[2_u64] = 1_u32;
  set invalid1_depths[3_u64] = 2_u32;
  set invalid1_depths[4_u64] = 2_u32;
  set invalid1_depths[5_u64] = 2_u32;

  let result2 = validate_and_group(parents: &invalid1_parents[0_u64..6_u64], depths: &invalid1_depths[0_u64..6_u64], factory: &factory, output: &output);
  match result2 {
    Ok(value: unused) => {
    }
    Err(error: problem) => {
      return exit_status(code: 1_u8);
    }
  }

  let invalid2_parents = array_filled::<u32, 6>(value: 0_u32);
  set invalid2_parents[0_u64] = 6_u32;
  set invalid2_parents[1_u64] = 0_u32;
  set invalid2_parents[2_u64] = 0_u32;
  set invalid2_parents[3_u64] = 1_u32;
  set invalid2_parents[4_u64] = 1_u32;
  set invalid2_parents[5_u64] = 2_u32;

  let invalid2_depths = array_filled::<u32, 6>(value: 0_u32);
  set invalid2_depths[0_u64] = 0_u32;
  set invalid2_depths[1_u64] = 1_u32;
  set invalid2_depths[2_u64] = 1_u32;
  set invalid2_depths[3_u64] = 2_u32;
  set invalid2_depths[4_u64] = 2_u32;
  set invalid2_depths[5_u64] = 1_u32;

  let result3 = validate_and_group(parents: &invalid2_parents[0_u64..6_u64], depths: &invalid2_depths[0_u64..6_u64], factory: &factory, output: &output);
  match result3 {
    Ok(value: unused) => {
    }
    Err(error: problem) => {
      return exit_status(code: 1_u8);
    }
  }

  let invalid3_parents = array_filled::<u32, 6>(value: 0_u32);
  set invalid3_parents[0_u64] = 6_u32;
  set invalid3_parents[1_u64] = 0_u32;
  set invalid3_parents[2_u64] = 0_u32;
  set invalid3_parents[3_u64] = 1_u32;
  set invalid3_parents[4_u64] = 1_u32;
  set invalid3_parents[5_u64] = 2_u32;

  let invalid3_depths = array_filled::<u32, 6>(value: 0_u32);
  set invalid3_depths[0_u64] = 4097_u32;
  set invalid3_depths[1_u64] = 1_u32;
  set invalid3_depths[2_u64] = 1_u32;
  set invalid3_depths[3_u64] = 2_u32;
  set invalid3_depths[4_u64] = 2_u32;
  set invalid3_depths[5_u64] = 2_u32;

  let result4 = validate_and_group(parents: &invalid3_parents[0_u64..6_u64], depths: &invalid3_depths[0_u64..6_u64], factory: &factory, output: &output);
  match result4 {
    Ok(value: unused) => {
    }
    Err(error: problem) => {
      return exit_status(code: 1_u8);
    }
  }

  return exit_status(code: 0_u8);
}

alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias Instant = std::time::Instant;
alias CancelWatch = std::time::CancelWatch;

struct Pair<T> {
  left: T;
  right: T;
}

enum Choice<T> {
  Present(value: T);
  Absent();
}

struct BytePacket {
  first: u8;
  second: u8;
}

fn write_u64_le(buffer: &[u8], offset: u64, value: u64) -> result: unit writes(buffer) contract {
  requires offset + 8_u64 <= buffer^.len;
} {
  let b0 = cvt.wrap::<u64, u8>(value);
  set buffer^[offset] = b0;
  let v1 = ishr(value, 8_u32);
  let b1 = cvt.wrap::<u64, u8>(v1);
  set buffer^[offset + 1_u64] = b1;
  let v2 = ishr(value, 16_u32);
  let b2 = cvt.wrap::<u64, u8>(v2);
  set buffer^[offset + 2_u64] = b2;
  let v3 = ishr(value, 24_u32);
  let b3 = cvt.wrap::<u64, u8>(v3);
  set buffer^[offset + 3_u64] = b3;
  let v4 = ishr(value, 32_u32);
  let b4 = cvt.wrap::<u64, u8>(v4);
  set buffer^[offset + 4_u64] = b4;
  let v5 = ishr(value, 40_u32);
  let b5 = cvt.wrap::<u64, u8>(v5);
  set buffer^[offset + 5_u64] = b5;
  let v6 = ishr(value, 48_u32);
  let b6 = cvt.wrap::<u64, u8>(v6);
  set buffer^[offset + 6_u64] = b6;
  let v7 = ishr(value, 56_u32);
  let b7 = cvt.wrap::<u64, u8>(v7);
  set buffer^[offset + 7_u64] = b7;
  return unit;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: cwd_directory, handles: factory, stdout: output, ..) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  let write_close_result = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let read_close_result = std::fs::close_directory(factory: &factory, directory: move cwd_read);
  match write_close_result {
    Ok(value: unused_ok_write) => {
    }
    Err(error: unused_err_write) => {
    }
  }
  match read_close_result {
    Ok(value: unused_ok_read) => {
    }
    Err(error: unused_err_read) => {
    }
  }

  let byte_pair = Pair<u8>(left: 7_u8, right: 7_u8);
  let signed_pair = Pair<i64>(left: -9_i64, right: -9_i64);

  let choice_present_3 = Choice<u64>::Present(value: 3_u64);
  let choice_present_neg5 = Choice<i64>::Present(value: -5_i64);

  let byte_add_result = 1_u8 +checked 2_u8;
  let overflow_result = 255_u8 +checked 1_u8;
  let signed_add_result = -4_i64 +checked 9_i64;

  let optional_byte = Some<u8>(value: 19_u8);

  let packet = BytePacket(first: 11_u8, second: 11_u8);
  let boxed_packet = box_new::<BytePacket>(value: move packet);

  let buffer = array_filled::<u8, 72>(value: 0_u8);

  let word1 = cvt::<u8, u64>(byte_pair.left);
  write_u64_le(buffer: &buffer, offset: 0_u64, value: word1);

  let signed_right_as_u64 = cvt.wrap::<i64, u64>(signed_pair.right);
  write_u64_le(buffer: &buffer, offset: 8_u64, value: signed_right_as_u64);

  let word3 = match choice_present_3 {
    Present(value: choice_val) => {
      give choice_val;
    }
    Absent() => {
      return exit_status(code: 1_u8);
    }
  };
  write_u64_le(buffer: &buffer, offset: 16_u64, value: word3);

  let word4_raw = match choice_present_neg5 {
    Present(value: choice_val) => {
      give choice_val;
    }
    Absent() => {
      return exit_status(code: 1_u8);
    }
  };
  let word4_as_u64 = cvt.wrap::<i64, u64>(word4_raw);
  write_u64_le(buffer: &buffer, offset: 24_u64, value: word4_as_u64);

  let word5 = match byte_add_result {
    Ok(value: sum_value) => {
      give cvt::<u8, u64>(sum_value);
    }
    Err(error: overflow_err) => {
      return exit_status(code: 1_u8);
    }
  };
  write_u64_le(buffer: &buffer, offset: 32_u64, value: word5);

  let word6 = match overflow_result {
    Ok(value: sum_value) => {
      return exit_status(code: 1_u8);
    }
    Err(error: overflow_err) => {
      give 1_u64;
    }
  };
  write_u64_le(buffer: &buffer, offset: 40_u64, value: word6);

  let word7 = match signed_add_result {
    Ok(value: sum_value) => {
      give cvt::<i64, u64>(sum_value);
    }
    Err(error: overflow_err) => {
      return exit_status(code: 1_u8);
    }
  };
  write_u64_le(buffer: &buffer, offset: 48_u64, value: word7);

  let word8 = match optional_byte {
    Some(value: byte_value) => {
      give cvt::<u8, u64>(byte_value);
    }
    None() => {
      return exit_status(code: 1_u8);
    }
  };
  write_u64_le(buffer: &buffer, offset: 56_u64, value: word8);

  let word9 = cvt::<u8, u64>(boxed_packet.inner.second);
  write_u64_le(buffer: &buffer, offset: 64_u64, value: word9);

  let buffer_slice = &buffer[0_u64..72_u64];
  let no_deadline = None<std::time::Instant>();
  let cancel = std::time::cancel_never();
  let write_result = std::io::write_once(factory: &factory, output: &output, source: buffer_slice, start: 0_u64, end: 72_u64, deadline: no_deadline, cancel: &cancel);
  std::time::close_cancel_watch(watch: move cancel);

  match write_result {
    Ok(value: written) => {
      if written == 72_u64 {
        return exit_status(code: 0_u8);
      } else {
        return exit_status(code: 250_u8);
      }
    }
    Err(error: io_error) => {
      return exit_status(code: 250_u8);
    }
  }
}

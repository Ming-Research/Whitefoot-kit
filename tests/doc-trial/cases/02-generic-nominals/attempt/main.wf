alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;

struct Pair<T> {
  left: T;
  right: T;
}

fn encode_le_u64(val: u64) -> res: Array<u8, 8> pure {
  let arr = array_filled::<u8, 8>(value: 0_u8);
  set arr[0_u64] = cvt.wrap::<u64, u8>(val);
  set arr[1_u64] = cvt.wrap::<u64, u8>(ishr(val, 8_u32));
  set arr[2_u64] = cvt.wrap::<u64, u8>(ishr(val, 16_u32));
  set arr[3_u64] = cvt.wrap::<u64, u8>(ishr(val, 24_u32));
  set arr[4_u64] = cvt.wrap::<u64, u8>(ishr(val, 32_u32));
  set arr[5_u64] = cvt.wrap::<u64, u8>(ishr(val, 40_u32));
  set arr[6_u64] = cvt.wrap::<u64, u8>(ishr(val, 48_u32));
  set arr[7_u64] = cvt.wrap::<u64, u8>(ishr(val, 56_u32));
  return move arr;
}

fn i64_to_u64(v: i64) -> r: u64 pure {
  return cvt.wrap::<i64, u64>(v);
}

fn write_all(fac: &std::io::HandleFactory, out: &std::io::OutputStream, src: &[u8]) -> wr: Result<unit, std::io::IoError> reads(src), writes(fac), writes(out) waits {
  let pos = 0_u64;
  let len = src^.len;
  loop @send {
    if pos < len {
    } else {
      break @send;
    }
    let no_dl = None<std::time::Instant>();
    let can = std::time::cancel_never();
    let res = std::io::write_once(factory: fac, output: out, source: src, start: pos, end: len, deadline: no_dl, cancel: &can);
    std::time::close_cancel_watch(watch: move can);
    match res {
      Ok(value: nxt) => {
        set pos = nxt;
      }
      Err(error: err) => {
        return Err<unit, std::io::IoError>(error: err);
      }
    }
  }
  return Ok<unit, std::io::IoError>(value: unit);
}

fn main(inp: Inputs) -> st: ExitStatus pure waits {
  let Inputs(cwd: cwd_dir, handles: fac, stdout: out, ..) = move inp;
  let std::fs::Directory(read: cwd_read, write: cwd_wrt) = move cwd_dir;
  let cl1 = std::fs::close_directory_write(factory: &fac, directory: move cwd_wrt);
  let cl2 = std::fs::close_directory(factory: &fac, directory: move cwd_read);
  let code = 0_u8;
  let p1 = Pair<u8>(left: 7_u8, right: 7_u8);
  let p2 = Pair<i64>(left: -9_i64, right: -9_i64);
  let add1 = 1_u8 +checked 2_u8;
  let s1 = match add1 {
    Ok(value: v) => {
      give v;
    }
    Err(error: e) => {
      give 0_u8;
    }
  };
  let add2 = 255_u8 +checked 1_u8;
  let ovf = match add2 {
    Ok(value: v) => {
      give 0_u8;
    }
    Err(error: e) => {
      give 1_u8;
    }
  };
  let add3 = -4_i64 +checked 9_i64;
  let s2 = match add3 {
    Ok(value: v) => {
      give v;
    }
    Err(error: e) => {
      give 0_i64;
    }
  };
  let opt_val = Some<u8>(value: 19_u8);
  let got_val = match opt_val {
    Some(value: v) => {
      give v;
    }
    None() => {
      give 0_u8;
    }
  };
  let pkt = array_filled::<u8, 2>(value: 11_u8);
  let pkt_byte = pkt[1_u64];
  let out_arr = array_filled::<u8, 72>(value: 0_u8);
  let enc1 = encode_le_u64(cvt::<u8, u64>(p1.left));
  set out_arr[0_u64] = enc1[0_u64];
  set out_arr[1_u64] = enc1[1_u64];
  set out_arr[2_u64] = enc1[2_u64];
  set out_arr[3_u64] = enc1[3_u64];
  set out_arr[4_u64] = enc1[4_u64];
  set out_arr[5_u64] = enc1[5_u64];
  set out_arr[6_u64] = enc1[6_u64];
  set out_arr[7_u64] = enc1[7_u64];
  let enc2 = encode_le_u64(i64_to_u64(p2.right));
  set out_arr[8_u64] = enc2[0_u64];
  set out_arr[9_u64] = enc2[1_u64];
  set out_arr[10_u64] = enc2[2_u64];
  set out_arr[11_u64] = enc2[3_u64];
  set out_arr[12_u64] = enc2[4_u64];
  set out_arr[13_u64] = enc2[5_u64];
  set out_arr[14_u64] = enc2[6_u64];
  set out_arr[15_u64] = enc2[7_u64];
  let enc3 = encode_le_u64(cvt::<u8, u64>(3_u8));
  set out_arr[16_u64] = enc3[0_u64];
  set out_arr[17_u64] = enc3[1_u64];
  set out_arr[18_u64] = enc3[2_u64];
  set out_arr[19_u64] = enc3[3_u64];
  set out_arr[20_u64] = enc3[4_u64];
  set out_arr[21_u64] = enc3[5_u64];
  set out_arr[22_u64] = enc3[6_u64];
  set out_arr[23_u64] = enc3[7_u64];
  let enc4 = encode_le_u64(i64_to_u64(-5_i64));
  set out_arr[24_u64] = enc4[0_u64];
  set out_arr[25_u64] = enc4[1_u64];
  set out_arr[26_u64] = enc4[2_u64];
  set out_arr[27_u64] = enc4[3_u64];
  set out_arr[28_u64] = enc4[4_u64];
  set out_arr[29_u64] = enc4[5_u64];
  set out_arr[30_u64] = enc4[6_u64];
  set out_arr[31_u64] = enc4[7_u64];
  let enc5 = encode_le_u64(cvt::<u8, u64>(s1));
  set out_arr[32_u64] = enc5[0_u64];
  set out_arr[33_u64] = enc5[1_u64];
  set out_arr[34_u64] = enc5[2_u64];
  set out_arr[35_u64] = enc5[3_u64];
  set out_arr[36_u64] = enc5[4_u64];
  set out_arr[37_u64] = enc5[5_u64];
  set out_arr[38_u64] = enc5[6_u64];
  set out_arr[39_u64] = enc5[7_u64];
  let enc6 = encode_le_u64(cvt::<u8, u64>(ovf));
  set out_arr[40_u64] = enc6[0_u64];
  set out_arr[41_u64] = enc6[1_u64];
  set out_arr[42_u64] = enc6[2_u64];
  set out_arr[43_u64] = enc6[3_u64];
  set out_arr[44_u64] = enc6[4_u64];
  set out_arr[45_u64] = enc6[5_u64];
  set out_arr[46_u64] = enc6[6_u64];
  set out_arr[47_u64] = enc6[7_u64];
  let enc7 = encode_le_u64(i64_to_u64(s2));
  set out_arr[48_u64] = enc7[0_u64];
  set out_arr[49_u64] = enc7[1_u64];
  set out_arr[50_u64] = enc7[2_u64];
  set out_arr[51_u64] = enc7[3_u64];
  set out_arr[52_u64] = enc7[4_u64];
  set out_arr[53_u64] = enc7[5_u64];
  set out_arr[54_u64] = enc7[6_u64];
  set out_arr[55_u64] = enc7[7_u64];
  let enc8 = encode_le_u64(cvt::<u8, u64>(got_val));
  set out_arr[56_u64] = enc8[0_u64];
  set out_arr[57_u64] = enc8[1_u64];
  set out_arr[58_u64] = enc8[2_u64];
  set out_arr[59_u64] = enc8[3_u64];
  set out_arr[60_u64] = enc8[4_u64];
  set out_arr[61_u64] = enc8[5_u64];
  set out_arr[62_u64] = enc8[6_u64];
  set out_arr[63_u64] = enc8[7_u64];
  let enc9 = encode_le_u64(cvt::<u8, u64>(pkt_byte));
  set out_arr[64_u64] = enc9[0_u64];
  set out_arr[65_u64] = enc9[1_u64];
  set out_arr[66_u64] = enc9[2_u64];
  set out_arr[67_u64] = enc9[3_u64];
  set out_arr[68_u64] = enc9[4_u64];
  set out_arr[69_u64] = enc9[5_u64];
  set out_arr[70_u64] = enc9[6_u64];
  set out_arr[71_u64] = enc9[7_u64];
  let out_view = &out_arr[0_u64..72_u64];
  let wr_res = write_all(fac: &fac, out: &out, src: out_view);
  match wr_res {
    Ok(value: ok) => {
    }
    Err(error: err) => {
      return exit_status(code: 250_u8);
    }
  }
  return exit_status(code: code);
}

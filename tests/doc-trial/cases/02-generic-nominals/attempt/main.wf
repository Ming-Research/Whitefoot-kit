alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;

struct Pair<T> {
  left: T;
  right: T;
}

enum Choice<T> {
  Present(value: T);
  Absent();
}

fn write_u64_le(factory: &std::io::HandleFactory, output: &std::io::OutputStream, value: i64) -> result: Result<unit, std::io::IoError> writes(factory), writes(output) waits {
  let buffer = array_filled::<u8, 8>(value: 0_u8);
  let v = cvt.wrap::<i64, u64>(value);
  set buffer[0_u64] = cvt::<u64, u8>(iand(v, 255_u64));
  let shifted1 = ishr(v, 8_u32);
  set buffer[1_u64] = cvt::<u64, u8>(iand(shifted1, 255_u64));
  let shifted2 = ishr(v, 16_u32);
  set buffer[2_u64] = cvt::<u64, u8>(iand(shifted2, 255_u64));
  let shifted3 = ishr(v, 24_u32);
  set buffer[3_u64] = cvt::<u64, u8>(iand(shifted3, 255_u64));
  let shifted4 = ishr(v, 32_u32);
  set buffer[4_u64] = cvt::<u64, u8>(iand(shifted4, 255_u64));
  let shifted5 = ishr(v, 40_u32);
  set buffer[5_u64] = cvt::<u64, u8>(iand(shifted5, 255_u64));
  let shifted6 = ishr(v, 48_u32);
  set buffer[6_u64] = cvt::<u64, u8>(iand(shifted6, 255_u64));
  let shifted7 = ishr(v, 56_u32);
  set buffer[7_u64] = cvt::<u64, u8>(iand(shifted7, 255_u64));
  let slice = &buffer[0_u64..8_u64];
  let none_deadline = None<std::time::Instant>();
  let cancel_watch = std::time::cancel_never();
  let write_result = std::io::write_once(factory: factory, output: output, source: slice, start: 0_u64, end: 8_u64, deadline: none_deadline, cancel: &cancel_watch);
  let close_result = std::time::close_cancel_watch(watch: move cancel_watch);
  match write_result {
    Ok(value: written) => {
      if written == 8_u64 {
        return Ok<unit, std::io::IoError>(value: unit);
      }
      let error = std::io::IoError::WriteZero(code: 0_u32, origin: 0_u8);
      return Err<unit, std::io::IoError>(error: error);
    }
    Err(error: e) => {
      return Err<unit, std::io::IoError>(error: move e);
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: output, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  let cwd_close_write = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  match cwd_close_write {
    Ok(value: unit_val) => {
    }
    Err(error: e) => {
    }
  }
  let cwd_close_read = std::fs::close_directory(factory: &factory, directory: move cwd);
  match cwd_close_read {
    Ok(value: unit_val) => {
    }
    Err(error: e) => {
    }
  }
  let byte_pair = Pair<u8>(left: 7_u8, right: 7_u8);
  let signed_pair = Pair<i64>(left: -9_i64, right: -9_i64);
  let choice1 = Choice<i64>::Present(value: 3_i64);
  let choice2 = Choice<i64>::Present(value: -5_i64);
  let byte_sum = 1_u8 +checked 2_u8;
  let overflow_result = 255_u8 +checked 1_u8;
  let signed_sum = -4_i64 + 9_i64;
  let optional_byte = Some<u8>(value: 19_u8);
  let packet = array_filled::<u8, 2>(value: 11_u8);
  let boxed_packet = box_new::<Array<u8, 2>>(value: packet);
  let write1 = write_u64_le(factory: &factory, output: &output, value: cvt::<u8, i64>(byte_pair.left));
  match write1 {
    Ok(value: unit_val) => {
    }
    Err(error: e) => {
      return exit_status(code: 250_u8);
    }
  }
  let write2 = write_u64_le(factory: &factory, output: &output, value: signed_pair.right);
  match write2 {
    Ok(value: unit_val) => {
    }
    Err(error: e) => {
      return exit_status(code: 250_u8);
    }
  }
  match choice1 {
    Present(value: val1) => {
      let write3 = write_u64_le(factory: &factory, output: &output, value: val1);
      match write3 {
        Ok(value: unit_val) => {
        }
        Err(error: e) => {
          return exit_status(code: 250_u8);
        }
      }
    }
    Absent() => {
      return exit_status(code: 1_u8);
    }
  }
  match choice2 {
    Present(value: val2) => {
      let write4 = write_u64_le(factory: &factory, output: &output, value: val2);
      match write4 {
        Ok(value: unit_val) => {
        }
        Err(error: e) => {
          return exit_status(code: 250_u8);
        }
      }
    }
    Absent() => {
      return exit_status(code: 1_u8);
    }
  }
  match byte_sum {
    Ok(value: sum_val) => {
      let write5 = write_u64_le(factory: &factory, output: &output, value: cvt::<u8, i64>(sum_val));
      match write5 {
        Ok(value: unit_val) => {
        }
        Err(error: e) => {
          return exit_status(code: 250_u8);
        }
      }
    }
    Err(error: overflow_err) => {
      return exit_status(code: 1_u8);
    }
  }
  match overflow_result {
    Ok(value: sum_val) => {
      return exit_status(code: 1_u8);
    }
    Err(error: overflow_err) => {
      let write6 = write_u64_le(factory: &factory, output: &output, value: 1_i64);
      match write6 {
        Ok(value: unit_val) => {
        }
        Err(error: e) => {
          return exit_status(code: 250_u8);
        }
      }
    }
  }
  let write7 = write_u64_le(factory: &factory, output: &output, value: signed_sum);
  match write7 {
    Ok(value: unit_val) => {
    }
    Err(error: e) => {
      return exit_status(code: 250_u8);
    }
  }
  match optional_byte {
    Some(value: opt_byte) => {
      let write8 = write_u64_le(factory: &factory, output: &output, value: cvt::<u8, i64>(opt_byte));
      match write8 {
        Ok(value: unit_val) => {
        }
        Err(error: e) => {
          return exit_status(code: 250_u8);
        }
      }
    }
    None() => {
      return exit_status(code: 1_u8);
    }
  }
  let packet_content = move boxed_packet.inner;
  let packet_byte = packet_content[1_u64];
  let write9 = write_u64_le(factory: &factory, output: &output, value: cvt::<u8, i64>(packet_byte));
  match write9 {
    Ok(value: unit_val) => {
    }
    Err(error: e) => {
      return exit_status(code: 250_u8);
    }
  }
  return exit_status(code: 0_u8);
}

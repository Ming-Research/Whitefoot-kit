alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias Instant = std::time::Instant;

struct Pair<T> {
  left: T;
  right: T;
}

enum Choice<T> {
  Absent();
  Present(value: T);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_dir, stdout: stdout_stream, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_dir;
  std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  std::fs::close_directory(factory: &factory, directory: move cwd_read);

  let byte_pair = Pair<u8>(left: 7_u8, right: 7_u8);
  let signed_pair = Pair<i64>(left: -9_i64, right: -9_i64);
  let byte_choice = Choice<u8>::Present(value: 3_u8);
  let signed_choice = Choice<i64>::Present(value: -5_i64);

  let byte_sum_result = 1_u8 +checked 2_u8;
  let byte_sum = match byte_sum_result {
    Ok(value: sum) => {
      give sum;
    }
    Err(error: unused) => {
      return exit_status(code: 1_u8);
    }
  };

  let overflow_result = 255_u8 +checked 1_u8;
  let overflow_marker = match overflow_result {
    Ok(value: unused) => {
      give 0_u64;
    }
    Err(error: unused) => {
      give 1_u64;
    }
  };

  let signed_sum_result = -4_i64 +checked 9_i64;
  let signed_sum = match signed_sum_result {
    Ok(value: sum) => {
      give sum;
    }
    Err(error: unused) => {
      return exit_status(code: 1_u8);
    }
  };

  let optional_byte = Some<u8>(value: 19_u8);
  let recovered_byte = match optional_byte {
    Some(value: b) => {
      give b;
    }
    None() => {
      return exit_status(code: 1_u8);
    }
  };

  let packet = array_filled::<u8, 2>(value: 11_u8);
  let cell = box_new::<Array<u8, 2>>(value: move packet);
  let packet_inner = cell.inner;
  let packet_byte = packet_inner[1_u64];

  let buffer = array_filled::<u8, 72>(value: 0_u8);

  set buffer[0_u64] = byte_pair.left;

  let val2 = signed_pair.right;
  let v2_shift8 = ishr(val2, 8_u32);
  let v2_shift16 = ishr(val2, 16_u32);
  let v2_shift24 = ishr(val2, 24_u32);
  let v2_shift32 = ishr(val2, 32_u32);
  let v2_shift40 = ishr(val2, 40_u32);
  let v2_shift48 = ishr(val2, 48_u32);
  let v2_shift56 = ishr(val2, 56_u32);
  let v2_b0 = cvt.wrap::<i64, u8>(val2);
  let v2_b1 = cvt.wrap::<i64, u8>(v2_shift8);
  let v2_b2 = cvt.wrap::<i64, u8>(v2_shift16);
  let v2_b3 = cvt.wrap::<i64, u8>(v2_shift24);
  let v2_b4 = cvt.wrap::<i64, u8>(v2_shift32);
  let v2_b5 = cvt.wrap::<i64, u8>(v2_shift40);
  let v2_b6 = cvt.wrap::<i64, u8>(v2_shift48);
  let v2_b7 = cvt.wrap::<i64, u8>(v2_shift56);
  set buffer[8_u64] = v2_b0;
  set buffer[9_u64] = v2_b1;
  set buffer[10_u64] = v2_b2;
  set buffer[11_u64] = v2_b3;
  set buffer[12_u64] = v2_b4;
  set buffer[13_u64] = v2_b5;
  set buffer[14_u64] = v2_b6;
  set buffer[15_u64] = v2_b7;

  let choice3_val = match byte_choice {
    Absent() => {
      give 0_u8;
    }
    Present(value: v) => {
      give v;
    }
  };
  set buffer[16_u64] = choice3_val;

  let choice4_val = match signed_choice {
    Absent() => {
      give 0_i64;
    }
    Present(value: v) => {
      give v;
    }
  };
  let c4_shift8 = ishr(choice4_val, 8_u32);
  let c4_shift16 = ishr(choice4_val, 16_u32);
  let c4_shift24 = ishr(choice4_val, 24_u32);
  let c4_shift32 = ishr(choice4_val, 32_u32);
  let c4_shift40 = ishr(choice4_val, 40_u32);
  let c4_shift48 = ishr(choice4_val, 48_u32);
  let c4_shift56 = ishr(choice4_val, 56_u32);
  let c4_b0 = cvt.wrap::<i64, u8>(choice4_val);
  let c4_b1 = cvt.wrap::<i64, u8>(c4_shift8);
  let c4_b2 = cvt.wrap::<i64, u8>(c4_shift16);
  let c4_b3 = cvt.wrap::<i64, u8>(c4_shift24);
  let c4_b4 = cvt.wrap::<i64, u8>(c4_shift32);
  let c4_b5 = cvt.wrap::<i64, u8>(c4_shift40);
  let c4_b6 = cvt.wrap::<i64, u8>(c4_shift48);
  let c4_b7 = cvt.wrap::<i64, u8>(c4_shift56);
  set buffer[24_u64] = c4_b0;
  set buffer[25_u64] = c4_b1;
  set buffer[26_u64] = c4_b2;
  set buffer[27_u64] = c4_b3;
  set buffer[28_u64] = c4_b4;
  set buffer[29_u64] = c4_b5;
  set buffer[30_u64] = c4_b6;
  set buffer[31_u64] = c4_b7;

  set buffer[32_u64] = byte_sum;

  let om_shift8 = ishr(overflow_marker, 8_u32);
  let om_shift16 = ishr(overflow_marker, 16_u32);
  let om_shift24 = ishr(overflow_marker, 24_u32);
  let om_shift32 = ishr(overflow_marker, 32_u32);
  let om_shift40 = ishr(overflow_marker, 40_u32);
  let om_shift48 = ishr(overflow_marker, 48_u32);
  let om_shift56 = ishr(overflow_marker, 56_u32);
  let om_b0 = cvt.wrap::<u64, u8>(overflow_marker);
  let om_b1 = cvt.wrap::<u64, u8>(om_shift8);
  let om_b2 = cvt.wrap::<u64, u8>(om_shift16);
  let om_b3 = cvt.wrap::<u64, u8>(om_shift24);
  let om_b4 = cvt.wrap::<u64, u8>(om_shift32);
  let om_b5 = cvt.wrap::<u64, u8>(om_shift40);
  let om_b6 = cvt.wrap::<u64, u8>(om_shift48);
  let om_b7 = cvt.wrap::<u64, u8>(om_shift56);
  set buffer[40_u64] = om_b0;
  set buffer[41_u64] = om_b1;
  set buffer[42_u64] = om_b2;
  set buffer[43_u64] = om_b3;
  set buffer[44_u64] = om_b4;
  set buffer[45_u64] = om_b5;
  set buffer[46_u64] = om_b6;
  set buffer[47_u64] = om_b7;

  let ss_shift8 = ishr(signed_sum, 8_u32);
  let ss_shift16 = ishr(signed_sum, 16_u32);
  let ss_shift24 = ishr(signed_sum, 24_u32);
  let ss_shift32 = ishr(signed_sum, 32_u32);
  let ss_shift40 = ishr(signed_sum, 40_u32);
  let ss_shift48 = ishr(signed_sum, 48_u32);
  let ss_shift56 = ishr(signed_sum, 56_u32);
  let ss_b0 = cvt.wrap::<i64, u8>(signed_sum);
  let ss_b1 = cvt.wrap::<i64, u8>(ss_shift8);
  let ss_b2 = cvt.wrap::<i64, u8>(ss_shift16);
  let ss_b3 = cvt.wrap::<i64, u8>(ss_shift24);
  let ss_b4 = cvt.wrap::<i64, u8>(ss_shift32);
  let ss_b5 = cvt.wrap::<i64, u8>(ss_shift40);
  let ss_b6 = cvt.wrap::<i64, u8>(ss_shift48);
  let ss_b7 = cvt.wrap::<i64, u8>(ss_shift56);
  set buffer[48_u64] = ss_b0;
  set buffer[49_u64] = ss_b1;
  set buffer[50_u64] = ss_b2;
  set buffer[51_u64] = ss_b3;
  set buffer[52_u64] = ss_b4;
  set buffer[53_u64] = ss_b5;
  set buffer[54_u64] = ss_b6;
  set buffer[55_u64] = ss_b7;

  set buffer[56_u64] = recovered_byte;

  set buffer[64_u64] = packet_byte;

  let view = &buffer[0_u64..72_u64];
  let no_deadline = None<Instant>();
  let cancel = std::time::cancel_never();
  let write_result = std::io::write_once(factory: &factory, output: &stdout_stream, source: view, start: 0_u64, end: 72_u64, deadline: no_deadline, cancel: &cancel);
  std::time::close_cancel_watch(watch: move cancel);

  match write_result {
    Ok(value: next) => {
      if next == 72_u64 {
        return exit_status(code: 0_u8);
      } else {
        return exit_status(code: 250_u8);
      }
    }
    Err(error: unused) => {
      return exit_status(code: 250_u8);
    }
  }
}

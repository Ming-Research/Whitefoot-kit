alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;

struct Pair<T> {
  left: T;
  right: T;
}

fn encode_le_u64(val: u64) -> res: Array<u8, 8> pure {
  let arr = array_filled::<u8, 8>(value: 0_u8);
  set arr[0_u64] = cvt.wrap::<u64, u8>(val);
  set arr[1_u64] = cvt.wrap::<u64, u8>(ishr(val, 8_u32));
  set arr[2_u64] = cvt.wrap::<u64, u8>(ishr(val, 16_u32));
  set arr[3_u64] = cvt.wrap::<u64, u8>(ishr(val, 24_u32));
  set arr[4_u64] = cvt.wrap::<u64, u8>(ishr(val, 32_u32));
  set arr[5_u64] = cvt.wrap::<u64, u8>(ishr(val, 40_u32));
  set arr[6_u64] = cvt.wrap::<u64, u8>(ishr(val, 48_u32));
  set arr[7_u64] = cvt.wrap::<u64, u8>(ishr(val, 56_u32));
  return move arr;
}

fn i64_to_u64(v: i64) -> res: u64 pure {
  return cvt.wrap::<i64, u64>(v);
}

fn write_output(fac: &std::io::HandleFactory, out: &std::io::OutputStream, src: &[u8]) -> result: Result<unit, std::io::IoError> reads(src), writes(fac), writes(out) waits {
  let pos = 0_u64;
  let len = src^.len;
  loop @send {
    if pos < len {
      let no_dl = None<std::time::Instant>();
      let cancel = std::time::cancel_never();
      let outcome = std::io::write_once(factory: fac, output: out, source: src, start: pos, end: len, deadline: no_dl, cancel: &cancel);
      std::time::close_cancel_watch(watch: move cancel);
      match outcome {
        Ok(value: nxt) => {
          set pos = nxt;
          continue @send;
        }
        Err(error: err) => {
          return Err<unit, std::io::IoError>(error: err);
        }
      }
    } else {
      break @send;
    }
  }
  return Ok<unit, std::io::IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: cwd_dir, handles: fac, stdout: out, ..) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_wrt) = move cwd_dir;
  let dummy1 = std::fs::close_directory_write(factory: &fac, directory: move cwd_wrt);
  let dummy2 = std::fs::close_directory(factory: &fac, directory: move cwd_read);
  let p_u8 = Pair<u8>(left: 7_u8, right: 7_u8);
  let p_i64 = Pair<i64>(left: -9_i64, right: -9_i64);
  let add1 = 1_u8 +checked 2_u8;
  let sum1 = match add1 {
    Ok(value: v) => {
      give v;
    }
    Err(error: e) => {
      give 0_u8;
    }
  };
  let add2 = 255_u8 +checked 1_u8;
  let overflow = match add2 {
    Ok(value: v) => {
      give 0_u8;
    }
    Err(error: e) => {
      give 1_u8;
    }
  };
  let add3 = -4_i64 +checked 9_i64;
  let sum2 = match add3 {
    Ok(value: v) => {
      give v;
    }
    Err(error: e) => {
      give 0_i64;
    }
  };
  let opt = Some<u8>(value: 19_u8);
  let recovered = match opt {
    Some(value: v) => {
      give v;
    }
    None() => {
      give 0_u8;
    }
  };
  let packet = array_filled::<u8, 2>(value: 11_u8);
  let pkt_val = packet[1_u64];
  let output = array_filled::<u8, 72>(value: 0_u8);
  let e1 = encode_le_u64(cvt::<u8, u64>(p_u8.left));
  set output[0_u64] = e1[0_u64];
  set output[1_u64] = e1[1_u64];
  set output[2_u64] = e1[2_u64];
  set output[3_u64] = e1[3_u64];
  set output[4_u64] = e1[4_u64];
  set output[5_u64] = e1[5_u64];
  set output[6_u64] = e1[6_u64];
  set output[7_u64] = e1[7_u64];
  let e2 = encode_le_u64(i64_to_u64(p_i64.right));
  set output[8_u64] = e2[0_u64];
  set output[9_u64] = e2[1_u64];
  set output[10_u64] = e2[2_u64];
  set output[11_u64] = e2[3_u64];
  set output[12_u64] = e2[4_u64];
  set output[13_u64] = e2[5_u64];
  set output[14_u64] = e2[6_u64];
  set output[15_u64] = e2[7_u64];
  let e3 = encode_le_u64(cvt::<u8, u64>(3_u8));
  set output[16_u64] = e3[0_u64];
  set output[17_u64] = e3[1_u64];
  set output[18_u64] = e3[2_u64];
  set output[19_u64] = e3[3_u64];
  set output[20_u64] = e3[4_u64];
  set output[21_u64] = e3[5_u64];
  set output[22_u64] = e3[6_u64];
  set output[23_u64] = e3[7_u64];
  let e4 = encode_le_u64(i64_to_u64(-5_i64));
  set output[24_u64] = e4[0_u64];
  set output[25_u64] = e4[1_u64];
  set output[26_u64] = e4[2_u64];
  set output[27_u64] = e4[3_u64];
  set output[28_u64] = e4[4_u64];
  set output[29_u64] = e4[5_u64];
  set output[30_u64] = e4[6_u64];
  set output[31_u64] = e4[7_u64];
  let e5 = encode_le_u64(cvt::<u8, u64>(sum1));
  set output[32_u64] = e5[0_u64];
  set output[33_u64] = e5[1_u64];
  set output[34_u64] = e5[2_u64];
  set output[35_u64] = e5[3_u64];
  set output[36_u64] = e5[4_u64];
  set output[37_u64] = e5[5_u64];
  set output[38_u64] = e5[6_u64];
  set output[39_u64] = e5[7_u64];
  let e6 = encode_le_u64(cvt::<u8, u64>(overflow));
  set output[40_u64] = e6[0_u64];
  set output[41_u64] = e6[1_u64];
  set output[42_u64] = e6[2_u64];
  set output[43_u64] = e6[3_u64];
  set output[44_u64] = e6[4_u64];
  set output[45_u64] = e6[5_u64];
  set output[46_u64] = e6[6_u64];
  set output[47_u64] = e6[7_u64];
  let e7 = encode_le_u64(i64_to_u64(sum2));
  set output[48_u64] = e7[0_u64];
  set output[49_u64] = e7[1_u64];
  set output[50_u64] = e7[2_u64];
  set output[51_u64] = e7[3_u64];
  set output[52_u64] = e7[4_u64];
  set output[53_u64] = e7[5_u64];
  set output[54_u64] = e7[6_u64];
  set output[55_u64] = e7[7_u64];
  let e8 = encode_le_u64(cvt::<u8, u64>(recovered));
  set output[56_u64] = e8[0_u64];
  set output[57_u64] = e8[1_u64];
  set output[58_u64] = e8[2_u64];
  set output[59_u64] = e8[3_u64];
  set output[60_u64] = e8[4_u64];
  set output[61_u64] = e8[5_u64];
  set output[62_u64] = e8[6_u64];
  set output[63_u64] = e8[7_u64];
  let e9 = encode_le_u64(cvt::<u8, u64>(pkt_val));
  set output[64_u64] = e9[0_u64];
  set output[65_u64] = e9[1_u64];
  set output[66_u64] = e9[2_u64];
  set output[67_u64] = e9[3_u64];
  set output[68_u64] = e9[4_u64];
  set output[69_u64] = e9[5_u64];
  set output[70_u64] = e9[6_u64];
  set output[71_u64] = e9[7_u64];
  let view = &output[0_u64..72_u64];
  let write_res = write_output(fac: &fac, out: &out, src: view);
  match write_res {
    Ok(value: ok) => {
    }
    Err(error: err) => {
      return exit_status(code: 250_u8);
    }
  }
  return exit_status(code: 0_u8);
}

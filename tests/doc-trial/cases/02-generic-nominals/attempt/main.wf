alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;

struct Pair<T> {
  left: T;
  right: T;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: cwd_directory, handles: factory, stdout: output, ..) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  let close_write_result = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let close_read_result = std::fs::close_directory(factory: &factory, directory: move cwd);
  let code = 0_u8;
  let pair_u8 = Pair<u8>(left: 7_u8, right: 7_u8);
  let pair_i64 = Pair<i64>(left: -9_i64, right: -9_i64);
  let choice1 = Some<u8>(value: 3_u8);
  let choice2 = Some<i64>(value: -5_i64);
  let addition1 = 1_u8 +checked 2_u8;
  let sum1 = match addition1 {
    Ok(value: s) => {
      give s;
    }
    Err(error: overflow) => {
      set code = 1_u8;
      give 0_u8;
    }
  };
  let addition2 = 255_u8 +checked 1_u8;
  let overflow_flag = match addition2 {
    Ok(value: s) => {
      give 0_u8;
    }
    Err(error: overflow) => {
      give 1_u8;
    }
  };
  let addition3 = -4_i64 +checked 9_i64;
  let sum2 = match addition3 {
    Ok(value: s) => {
      give s;
    }
    Err(error: overflow) => {
      set code = 1_u8;
      give 0_i64;
    }
  };
  let recovered_byte = match choice1 {
    Some(value: v) => {
      give v;
    }
    None() => {
      set code = 1_u8;
      give 0_u8;
    }
  };
  let optional_wrapper = Some<u8>(value: 19_u8);
  let recovered_wrapper = match optional_wrapper {
    Some(value: v) => {
      give v;
    }
    None() => {
      set code = 1_u8;
      give 0_u8;
    }
  };
  let packet = array_filled::<u8, 2>(value: 11_u8);
  let owned_packet = packet;
  let recovered_packet_byte = owned_packet[1_u64];
  let output_bytes = array_filled::<u8, 72>(value: 0_u8);
  let encoded1 = encode_le_u64(cvt::<u8, u64>(pair_u8.left));
  set output_bytes[0_u64] = encoded1[0_u64];
  set output_bytes[1_u64] = encoded1[1_u64];
  set output_bytes[2_u64] = encoded1[2_u64];
  set output_bytes[3_u64] = encoded1[3_u64];
  set output_bytes[4_u64] = encoded1[4_u64];
  set output_bytes[5_u64] = encoded1[5_u64];
  set output_bytes[6_u64] = encoded1[6_u64];
  set output_bytes[7_u64] = encoded1[7_u64];
  let encoded2 = encode_le_u64(i64_to_u64(pair_i64.right));
  set output_bytes[8_u64] = encoded2[0_u64];
  set output_bytes[9_u64] = encoded2[1_u64];
  set output_bytes[10_u64] = encoded2[2_u64];
  set output_bytes[11_u64] = encoded2[3_u64];
  set output_bytes[12_u64] = encoded2[4_u64];
  set output_bytes[13_u64] = encoded2[5_u64];
  set output_bytes[14_u64] = encoded2[6_u64];
  set output_bytes[15_u64] = encoded2[7_u64];
  let encoded3 = encode_le_u64(cvt::<u8, u64>(3_u8));
  set output_bytes[16_u64] = encoded3[0_u64];
  set output_bytes[17_u64] = encoded3[1_u64];
  set output_bytes[18_u64] = encoded3[2_u64];
  set output_bytes[19_u64] = encoded3[3_u64];
  set output_bytes[20_u64] = encoded3[4_u64];
  set output_bytes[21_u64] = encoded3[5_u64];
  set output_bytes[22_u64] = encoded3[6_u64];
  set output_bytes[23_u64] = encoded3[7_u64];
  let encoded4 = encode_le_u64(i64_to_u64(-5_i64));
  set output_bytes[24_u64] = encoded4[0_u64];
  set output_bytes[25_u64] = encoded4[1_u64];
  set output_bytes[26_u64] = encoded4[2_u64];
  set output_bytes[27_u64] = encoded4[3_u64];
  set output_bytes[28_u64] = encoded4[4_u64];
  set output_bytes[29_u64] = encoded4[5_u64];
  set output_bytes[30_u64] = encoded4[6_u64];
  set output_bytes[31_u64] = encoded4[7_u64];
  let encoded5 = encode_le_u64(cvt::<u8, u64>(sum1));
  set output_bytes[32_u64] = encoded5[0_u64];
  set output_bytes[33_u64] = encoded5[1_u64];
  set output_bytes[34_u64] = encoded5[2_u64];
  set output_bytes[35_u64] = encoded5[3_u64];
  set output_bytes[36_u64] = encoded5[4_u64];
  set output_bytes[37_u64] = encoded5[5_u64];
  set output_bytes[38_u64] = encoded5[6_u64];
  set output_bytes[39_u64] = encoded5[7_u64];
  let encoded6 = encode_le_u64(cvt::<u8, u64>(overflow_flag));
  set output_bytes[40_u64] = encoded6[0_u64];
  set output_bytes[41_u64] = encoded6[1_u64];
  set output_bytes[42_u64] = encoded6[2_u64];
  set output_bytes[43_u64] = encoded6[3_u64];
  set output_bytes[44_u64] = encoded6[4_u64];
  set output_bytes[45_u64] = encoded6[5_u64];
  set output_bytes[46_u64] = encoded6[6_u64];
  set output_bytes[47_u64] = encoded6[7_u64];
  let encoded7 = encode_le_u64(i64_to_u64(sum2));
  set output_bytes[48_u64] = encoded7[0_u64];
  set output_bytes[49_u64] = encoded7[1_u64];
  set output_bytes[50_u64] = encoded7[2_u64];
  set output_bytes[51_u64] = encoded7[3_u64];
  set output_bytes[52_u64] = encoded7[4_u64];
  set output_bytes[53_u64] = encoded7[5_u64];
  set output_bytes[54_u64] = encoded7[6_u64];
  set output_bytes[55_u64] = encoded7[7_u64];
  let encoded8 = encode_le_u64(cvt::<u8, u64>(recovered_wrapper));
  set output_bytes[56_u64] = encoded8[0_u64];
  set output_bytes[57_u64] = encoded8[1_u64];
  set output_bytes[58_u64] = encoded8[2_u64];
  set output_bytes[59_u64] = encoded8[3_u64];
  set output_bytes[60_u64] = encoded8[4_u64];
  set output_bytes[61_u64] = encoded8[5_u64];
  set output_bytes[62_u64] = encoded8[6_u64];
  set output_bytes[63_u64] = encoded8[7_u64];
  let encoded9 = encode_le_u64(cvt::<u8, u64>(recovered_packet_byte));
  set output_bytes[64_u64] = encoded9[0_u64];
  set output_bytes[65_u64] = encoded9[1_u64];
  set output_bytes[66_u64] = encoded9[2_u64];
  set output_bytes[67_u64] = encoded9[3_u64];
  set output_bytes[68_u64] = encoded9[4_u64];
  set output_bytes[69_u64] = encoded9[5_u64];
  set output_bytes[70_u64] = encoded9[6_u64];
  set output_bytes[71_u64] = encoded9[7_u64];
  let output_view = &output_bytes[0_u64..72_u64];
  let write_result = write_all(factory: &factory, output: &output, source: output_view);
  match write_result {
    Ok(value: unused_ok) => {
    }
    Err(error: unused_error) => {
      let exit_code = 250_u8;
      return exit_status(code: exit_code);
    }
  }
  return exit_status(code: code);
}

fn encode_le_u64(value: u64) -> result: Array<u8, 8> pure {
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  set bytes[0_u64] = cvt.wrap::<u64, u8>(value);
  set bytes[1_u64] = cvt.wrap::<u64, u8>(ishr(value, 8_u32));
  set bytes[2_u64] = cvt.wrap::<u64, u8>(ishr(value, 16_u32));
  set bytes[3_u64] = cvt.wrap::<u64, u8>(ishr(value, 24_u32));
  set bytes[4_u64] = cvt.wrap::<u64, u8>(ishr(value, 32_u32));
  set bytes[5_u64] = cvt.wrap::<u64, u8>(ishr(value, 40_u32));
  set bytes[6_u64] = cvt.wrap::<u64, u8>(ishr(value, 48_u32));
  set bytes[7_u64] = cvt.wrap::<u64, u8>(ishr(value, 56_u32));
  return move bytes;
}

fn i64_to_u64(value: i64) -> result: u64 pure {
  return cvt.wrap::<i64, u64>(value);
}

fn write_all(factory: &HandleFactory, output: &OutputStream, source: &[u8]) -> result: Result<unit, std::io::IoError> reads(source), writes(factory), writes(output) waits {
  let sent = 0_u64;
  let length = source^.len;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, std::io::IoError>(error: problem);
      }
    }
  }
  return Ok<unit, std::io::IoError>(value: unit);
}

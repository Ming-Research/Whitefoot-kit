alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias Instant = std::time::Instant;
alias CancelWatch = std::time::CancelWatch;

struct Pair<T> {
  left: T;
  right: T;
}

enum Choice<T> {
  Present(value: T);
  Absent();
}

fn u64_to_le(value: u64, buffer: &[u8], offset: u64) -> result: unit writes(buffer) {
  let byte0 = iand(value, 255_u64);
  set buffer^[offset] = cvt::<u64, u8>(byte0);
  let offset1 = offset +wrap 1_u64;
  let shifted1 = ishr(value, 8_u32);
  let byte1 = iand(shifted1, 255_u64);
  set buffer^[offset1] = cvt::<u64, u8>(byte1);
  let offset2 = offset +wrap 2_u64;
  let shifted2 = ishr(value, 16_u32);
  let byte2 = iand(shifted2, 255_u64);
  set buffer^[offset2] = cvt::<u64, u8>(byte2);
  let offset3 = offset +wrap 3_u64;
  let shifted3 = ishr(value, 24_u32);
  let byte3 = iand(shifted3, 255_u64);
  set buffer^[offset3] = cvt::<u64, u8>(byte3);
  let offset4 = offset +wrap 4_u64;
  let shifted4 = ishr(value, 32_u32);
  let byte4 = iand(shifted4, 255_u64);
  set buffer^[offset4] = cvt::<u64, u8>(byte4);
  let offset5 = offset +wrap 5_u64;
  let shifted5 = ishr(value, 40_u32);
  let byte5 = iand(shifted5, 255_u64);
  set buffer^[offset5] = cvt::<u64, u8>(byte5);
  let offset6 = offset +wrap 6_u64;
  let shifted6 = ishr(value, 48_u32);
  let byte6 = iand(shifted6, 255_u64);
  set buffer^[offset6] = cvt::<u64, u8>(byte6);
  let offset7 = offset +wrap 7_u64;
  let shifted7 = ishr(value, 56_u32);
  let byte7 = iand(shifted7, 255_u64);
  set buffer^[offset7] = cvt::<u64, u8>(byte7);
  return unit;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: directory, stdout: output, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let byte_pair = Pair<u8>(left: 7_u8, right: 7_u8);
  let signed_pair = Pair<i64>(left: -9_i64, right: -9_i64);
  let choice1 = Choice<u8>::Present(value: 3_u8);
  let choice2 = Choice<i64>::Present(value: -5_i64);
  let sum1_result = 1_u8 +checked 2_u8;
  let sum1_value = match sum1_result {
    Ok(value: v) => {
      give v;
    }
    Err(error: e) => {
      give 0_u8;
    }
  }
  let sum2_result = 255_u8 +checked 1_u8;
  let overflow_marker = match sum2_result {
    Ok(value: v) => {
      give 0_u8;
    }
    Err(error: e) => {
      give 1_u8;
    }
  }
  let sum3_result = -4_i64 +checked 9_i64;
  let sum3_value = match sum3_result {
    Ok(value: v) => {
      give v;
    }
    Err(error: e) => {
      give 0_i64;
    }
  }
  let optional = Some<u8>(value: 19_u8);
  let recovered_byte = match move optional {
    Some(value: v) => {
      give v;
    }
    None() => {
      give 0_u8;
    }
  }
  let packet = Pair<u8>(left: 11_u8, right: 11_u8);
  let packet_cell = box_new::<Pair<u8>>(value: move packet);
  let packet_second = packet_cell.inner.right;
  let buffer = array_filled::<u8, 72>(value: 0_u8);
  let buffer_view = &buffer[0_u64..72_u64];
  let val1 = cvt::<u8, u64>(byte_pair.left);
  u64_to_le(value: val1, buffer: buffer_view, offset: 0_u64);
  let val2 = reinterpret::<i64, u64>(signed_pair.right);
  u64_to_le(value: val2, buffer: buffer_view, offset: 8_u64);
  let val3 = match choice1 {
    Present(value: v) => {
      give cvt::<u8, u64>(v);
    }
    Absent() => {
      give 0_u64;
    }
  }
  u64_to_le(value: val3, buffer: buffer_view, offset: 16_u64);
  let val4 = match choice2 {
    Present(value: v) => {
      give reinterpret::<i64, u64>(v);
    }
    Absent() => {
      give 0_u64;
    }
  }
  u64_to_le(value: val4, buffer: buffer_view, offset: 24_u64);
  let val5 = cvt::<u8, u64>(sum1_value);
  u64_to_le(value: val5, buffer: buffer_view, offset: 32_u64);
  let val6 = cvt::<u8, u64>(overflow_marker);
  u64_to_le(value: val6, buffer: buffer_view, offset: 40_u64);
  let val7 = reinterpret::<i64, u64>(sum3_value);
  u64_to_le(value: val7, buffer: buffer_view, offset: 48_u64);
  let val8 = cvt::<u8, u64>(recovered_byte);
  u64_to_le(value: val8, buffer: buffer_view, offset: 56_u64);
  let val9 = cvt::<u8, u64>(packet_second);
  u64_to_le(value: val9, buffer: buffer_view, offset: 64_u64);
  let no_deadline = None<Instant>();
  let cancel = std::time::cancel_never();
  let write_result = std::io::write_once(factory: &factory, output: &output, source: buffer_view, start: 0_u64, end: 72_u64, deadline: no_deadline, cancel: &cancel);
  std::time::close_cancel_watch(watch: move cancel);
  match write_result {
    Ok(value: written) => {
      if written == 72_u64 {
        return exit_status(code: 0_u8);
      } else {
        return exit_status(code: 1_u8);
      }
    }
    Err(error: problem) => {
      return exit_status(code: 250_u8);
    }
  }
}

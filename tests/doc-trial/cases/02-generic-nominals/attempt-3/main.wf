alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;

struct Pair<T> {
  left: T;
  right: T;
}

enum Choice<T> {
  Absent();
  Present(value: T);
}

struct Owner<T> {
  contents: T;
}

nocopy struct Packet {
  first: u8;
  second: u8;
}

fn pair_fill<T: copy>(value: T) -> result: Pair<T> pure {
  return Pair<T>(left: value, right: value);
}

fn present<T: copy>(value: T) -> result: Choice<T> pure {
  return Choice<T>::Present(value: value);
}

fn choice_or<T: copy>(choice: &Choice<T>, fallback: T) -> result: T reads(choice) {
  match choice^ {
    Absent() => {
      return fallback;
    }
    Present(value: found) => {
      return found^;
    }
  }
}

fn recover_optional<T: copy>(optional: &Option<T>, fallback: T) -> result: T reads(optional) {
  match optional^ {
    Some(value: found) => {
      return found^;
    }
    None() => {
      return fallback;
    }
  }
}

fn seal<T>(value: T) -> result: Owner<T> pure {
  return Owner<T>(contents: move value);
}

fn second_byte(owner: &Owner<Packet>) -> result: u8 reads(owner) {
  return owner^.contents.second;
}

fn discard<T: drop>(owner: Owner<T>) -> result: unit pure {
  return unit;
}

fn word_bytes(word: u64) -> result: Array<u8, 8> pure {
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  set bytes[0_u64] = cvt.wrap::<u64, u8>(word);
  let shift_one = ishr.wrap(word, 8_u32);
  set bytes[1_u64] = cvt.wrap::<u64, u8>(shift_one);
  let shift_two = ishr.wrap(word, 16_u32);
  set bytes[2_u64] = cvt.wrap::<u64, u8>(shift_two);
  let shift_three = ishr.wrap(word, 24_u32);
  set bytes[3_u64] = cvt.wrap::<u64, u8>(shift_three);
  let shift_four = ishr.wrap(word, 32_u32);
  set bytes[4_u64] = cvt.wrap::<u64, u8>(shift_four);
  let shift_five = ishr.wrap(word, 40_u32);
  set bytes[5_u64] = cvt.wrap::<u64, u8>(shift_five);
  let shift_six = ishr.wrap(word, 48_u32);
  set bytes[6_u64] = cvt.wrap::<u64, u8>(shift_six);
  let shift_seven = ishr.wrap(word, 56_u32);
  set bytes[7_u64] = cvt.wrap::<u64, u8>(shift_seven);
  return bytes;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn publish_word(factory: &HandleFactory, output: &OutputStream, word: u64) -> result: Result<unit, IoError> writes(factory), writes(output) waits {
  let bytes = word_bytes(word: word);
  let view = &bytes[0_u64..8_u64];
  return publish_all(factory: factory, output: output, source: view, length: 8_u64);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: stdout_stream, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  let ok = True();
  let write_closed = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  match write_closed {
    Ok(value: unused_write_closed) => {
    }
    Err(error: unused_write_error) => {
      set ok = False();
    }
  }
  let read_closed = std::fs::close_directory(factory: &factory, directory: move cwd_read);
  match read_closed {
    Ok(value: unused_read_closed) => {
    }
    Err(error: unused_read_error) => {
      set ok = False();
    }
  }
  let byte_pair = pair_fill::<u8>(value: 7_u8);
  let signed_pair = pair_fill::<i64>(value: -9_i64);
  let byte_choice = present::<u8>(value: 3_u8);
  let signed_choice = present::<i64>(value: -5_i64);
  let byte_sum = 1_u8 +checked 2_u8;
  let overflowing = 255_u8 +checked 1_u8;
  let signed_sum = -4_i64 +checked 9_i64;
  let optional_byte = Some<u8>(value: 19_u8);
  let packet = Packet(first: 11_u8, second: 11_u8);
  let owner = seal::<Packet>(value: move packet);
  let left_field = byte_pair.left;
  let right_field = signed_pair.right;
  let three = choice_or::<u8>(choice: &byte_choice, fallback: 0_u8);
  let minus_five = choice_or::<i64>(choice: &signed_choice, fallback: 0_i64);
  let recovered = recover_optional::<u8>(optional: &optional_byte, fallback: 0_u8);
  let second = second_byte(owner: &owner);
  discard::<Packet>(owner: move owner);
  let byte_total = 0_u8;
  match byte_sum {
    Ok(value: total) => {
      set byte_total = total;
      if total != 3_u8 {
        set ok = False();
      }
    }
    Err(error: unused_byte_error) => {
      set ok = False();
    }
  }
  let overflow_marker = 0_u64;
  match overflowing {
    Ok(value: unexpected_value) => {
      set ok = False();
    }
    Err(error: unused_overflow) => {
      set overflow_marker = 1_u64;
    }
  }
  let signed_total = 0_i64;
  match signed_sum {
    Ok(value: signed_value) => {
      set signed_total = signed_value;
      if signed_value != 5_i64 {
        set ok = False();
      }
    }
    Err(error: unused_signed_error) => {
      set ok = False();
    }
  }
  if ok {
  } else {
    return exit_status(code: 1_u8);
  }
  let words = array_filled::<u64, 9>(value: 0_u64);
  set words[0_u64] = cvt::<u8, u64>(left_field);
  set words[1_u64] = cvt.wrap::<i64, u64>(right_field);
  set words[2_u64] = cvt::<u8, u64>(three);
  set words[3_u64] = cvt.wrap::<i64, u64>(minus_five);
  set words[4_u64] = cvt::<u8, u64>(byte_total);
  set words[5_u64] = overflow_marker;
  set words[6_u64] = cvt.wrap::<i64, u64>(signed_total);
  set words[7_u64] = cvt::<u8, u64>(recovered);
  set words[8_u64] = cvt::<u8, u64>(second);
  for (index in 0_u64..9_u64) {
    let word = words[index];
    let published = publish_word(factory: &factory, output: &stdout_stream, word: word);
    match published {
      Ok(value: written) => {
      }
      Err(error: unused_publish_error) => {
        return exit_status(code: 250_u8);
      }
    }
  }
  return exit_status(code: 0_u8);
}

alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias write_once = std::io::write_once;

struct Pair<T: Int> {
  left: T;
  right: T;
}

enum Choice<T: Int> {
  Missing();
  Present(value: T);
}

struct Packet<const n: u64> {
  bytes: Slots<u8, n>;
}

struct Holder<T: drop> {
  value: T;
}

struct Wrapped<T: Int> {
  value: Option<T>;
}

fn duplicate<T: Int>(value: T) -> result: Pair<T> pure {
  return Pair<T>(left: value, right: value);
}

fn present<T: Int>(value: T) -> result: Choice<T> pure {
  return Choice<T>::Present(value: value);
}

fn checked_sum<T: Int>(left: T, right: T) -> result: Result<T, Overflow> pure {
  return left +checked right;
}

fn low_byte(v: u64) -> result: u8 pure {
  let low = iand(v, 255_u64);
  let byte = cvt::<u64, u8>(low);
  return byte;
}

fn spell(destination: &[u8], at: u64, value: u64) -> result: u64 writes(destination) {
  doc "Writes the eight little-endian bytes of value at the given offset, skipping any slot the range does not have.";
  let cursor = at;
  let rest = value;
  loop @octets {
    let limit = at +wrap 8_u64;
    let done = cursor >= limit;
    if done {
      break @octets;
    }
    let spare = destination^.len;
    let writable = cursor < spare;
    if writable {
      let byte = low_byte(v: rest);
      set destination^[cursor] = byte;
    }
    set rest = irotr(rest, 8_u32);
    set cursor = cursor +wrap 1_u64;
  }
  return at +wrap 8_u64;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  doc "Publishes one prefix of the source range, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let wait_cancel_1 = std::time::cancel_never();
    let wait_outcome_1 = write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &wait_cancel_1);
    std::time::close_cancel_watch(watch: move wait_cancel_1);
    match wait_outcome_1 {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn publish_report(factory: &HandleFactory, output: &OutputStream, source: &[u8]) -> status: ExitStatus reads(source), writes(factory), writes(output) waits {
  doc "Trial adaptation: publish the actual observations with the maintained stdin_echo partial-write retry; status 250 reports publication failure.";
  let length = source^.len;
  match publish_all(factory: factory, output: output, source: source, length: length) {
    Ok(value: published) => {
      return exit_status(code: 0_u8);
    }
    Err(error: problem) => {
      return exit_status(code: 250_u8);
    }
  }
}

fn main(inputs: std::process::Inputs) -> status: ExitStatus pure waits {
  doc "Trial adaptation: preserve generic pair, choice, checked arithmetic and ownership checks; publish their observed values.";
  let std::process::Inputs(args: unused_args, drivers: unused_driver_count, cwd: directory, stdout: out, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let report = slots_new::<u8, 72>();
  for (
    at in 0_u64..72_u64,
    invariant grown: report.len == at
  ) {
    place_back(window: &report, value: 0_u8);
  }
  let report_window = &report[0_u64..72_u64];
  let small = duplicate::<u8>(value: 7_u8);
  let wide = duplicate::<i64>(value: -9_i64);
  let small_left = small.left;
  let wide_right = wide.right;
  let wide_bits = reinterpret::<i64, u64>(wide_right);
  let encoded_0 = cvt::<u8, u64>(small_left);
  let recorded_0 = spell(destination: report_window, at: 0_u64, value: encoded_0);
  let recorded_8 = spell(destination: report_window, at: 8_u64, value: wide_bits);
  if small_left == 7_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if wide_right == -9_i64 {
  } else {
    return exit_status(code: 1_u8);
  }
  let small_choice = present::<u8>(value: 3_u8);
  match small_choice {
    Missing() => {
      return exit_status(code: 1_u8);
    }
    Present(value: observed) => {
      let encoded_16 = cvt::<u8, u64>(observed);
      let recorded_16 = spell(destination: report_window, at: 16_u64, value: encoded_16);
      if observed == 3_u8 {
      } else {
        return exit_status(code: 1_u8);
      }
    }
  }
  let wide_choice = present::<i64>(value: -5_i64);
  match wide_choice {
    Missing() => {
      return exit_status(code: 1_u8);
    }
    Present(value: observed) => {
      let choice_bits = reinterpret::<i64, u64>(observed);
      let recorded_24 = spell(destination: report_window, at: 24_u64, value: choice_bits);
      if observed == -5_i64 {
      } else {
        return exit_status(code: 1_u8);
      }
    }
  }
  let sum = checked_sum::<u8>(left: 1_u8, right: 2_u8);
  match sum {
    Ok(value: observed) => {
      let encoded_32 = cvt::<u8, u64>(observed);
      let recorded_32 = spell(destination: report_window, at: 32_u64, value: encoded_32);
      if observed == 3_u8 {
      } else {
        return exit_status(code: 1_u8);
      }
    }
    Err(error: overflow) => {
      return exit_status(code: 1_u8);
    }
  }
  let overflowed = checked_sum::<u8>(left: 255_u8, right: 1_u8);
  match overflowed {
    Ok(value: observed) => {
      return exit_status(code: 1_u8);
    }
    Err(error: overflow) => {
      let recorded_40 = spell(destination: report_window, at: 40_u64, value: 1_u64);
    }
  }
  let wide_sum = checked_sum::<i64>(left: -4_i64, right: 9_i64);
  match wide_sum {
    Ok(value: observed) => {
      let sum_bits = reinterpret::<i64, u64>(observed);
      let recorded_48 = spell(destination: report_window, at: 48_u64, value: sum_bits);
      if observed == 5_i64 {
      } else {
        return exit_status(code: 1_u8);
      }
    }
    Err(error: overflow) => {
      return exit_status(code: 1_u8);
    }
  }
  let optional = Some<u8>(value: 19_u8);
  let wrapped = Wrapped<u8>(value: optional);
  let recovered_optional = wrapped.value;
  match recovered_optional {
    None() => {
      return exit_status(code: 1_u8);
    }
    Some(value: observed) => {
      let encoded_56 = cvt::<u8, u64>(observed);
      let recorded_56 = spell(destination: report_window, at: 56_u64, value: encoded_56);
      if observed == 19_u8 {
      } else {
        return exit_status(code: 1_u8);
      }
    }
  }
  let bytes = slots_new::<u8, 2>();
  place_back(window: &bytes, value: 11_u8);
  place_back(window: &bytes, value: 11_u8);
  let packet = Packet<2>(bytes: move bytes);
  let holder = Holder<Packet<2>>(value: move packet);
  let recovered_packet = move holder.value;
  let recovered_bytes = move recovered_packet.bytes;
  let recovered_room = recovered_bytes.len;
  let recovered_ok = 1_u64 < recovered_room;
  if recovered_ok {
  } else {
    return exit_status(code: 1_u8);
  }
  let recovered = recovered_bytes[1_u64];
  if recovered == 11_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  let encoded_64 = cvt::<u8, u64>(recovered);
  let recorded_64 = spell(destination: report_window, at: 64_u64, value: encoded_64);
  return publish_report(factory: &factory, output: &out, source: report_window);
}

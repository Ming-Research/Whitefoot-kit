alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias InputStream = std::io::InputStream;
alias OutputStream = std::io::OutputStream;
alias ReadStop = std::io::ReadStop;
alias IoError = std::io::IoError;
alias Directory = std::fs::Directory;

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: output, stderr: unused_stderr, handles: factory, stdin: input, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let Directory(read: directory_read, write: directory_write) = move cwd_directory;
  let write_closed = std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  let read_closed = std::fs::close_directory(factory: &factory, directory: move directory_read);
  match write_closed {
    Ok(value: unused_ok) => {
    }
    Err(error: unused_error) => {
    }
  }
  match read_closed {
    Ok(value: unused_ok_2) => {
    }
    Err(error: unused_error_2) => {
    }
  }
  let buffer = array_filled::<u8, 4096>(value: 0_u8);
  loop @read_write {
    let read_buffer = &buffer[0_u64..4096_u64];
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let read_result = std::io::read_next(factory: &factory, input: &input, destination: read_buffer, start: 0_u64, end: 4096_u64, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match read_result {
      Ok(value: bytes_read) => {
        let written = 0_u64;
        loop @write_loop {
          if written < bytes_read {
          } else {
            break @write_loop;
          }
          let write_buffer = &buffer[0_u64..bytes_read];
          let no_deadline_write = None<std::time::Instant>();
          let cancel_write = std::time::cancel_never();
          let write_result = std::io::write_once(factory: &factory, output: &output, source: write_buffer, start: written, end: bytes_read, deadline: no_deadline_write, cancel: &cancel_write);
          std::time::close_cancel_watch(watch: move cancel_write);
          match write_result {
            Ok(value: bytes_written) => {
              set written = bytes_written;
            }
            Err(error: write_error) => {
              return exit_status(code: 4_u8);
            }
          }
        }
      }
      Err(error: read_stop) => {
        match read_stop {
          ReadEnd() => {
            return exit_status(code: 0_u8);
          }
          ReadFailed(error: io_error) => {
            return exit_status(code: 3_u8);
          }
        }
      }
    }
  }
}

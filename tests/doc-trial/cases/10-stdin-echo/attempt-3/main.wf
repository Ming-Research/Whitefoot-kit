alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias Instant = std::time::Instant;
alias CancelWatch = std::time::CancelWatch;

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64, cancel: &CancelWatch) -> result: Result<unit, IoError> reads(source), reads(cancel), writes(factory), writes(output) waits contract {
  requires length <= source^.len;
} {
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<Instant>();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: output, stderr: unused_stderr, handles: factory, stdin: input, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  let write_closed = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let read_closed = std::fs::close_directory(factory: &factory, directory: move cwd_read);
  match write_closed {
    Ok(value: unused_write_closed) => {
    }
    Err(error: unused_write_close_error) => {
    }
  }
  match read_closed {
    Ok(value: unused_read_closed) => {
    }
    Err(error: unused_read_close_error) => {
    }
  }
  let cancel = std::time::cancel_never();
  let buffer = array_filled::<u8, 4096>(value: 0_u8);
  let code = 0_u8;
  loop @echo {
    let destination = &buffer[0_u64..4096_u64];
    let end = destination^.len;
    let no_deadline = None<Instant>();
    let read_outcome = std::io::read_next(factory: &factory, input: &input, destination: destination, start: 0_u64, end: end, deadline: no_deadline, cancel: &cancel);
    match read_outcome {
      Ok(value: next) => {
        let published = publish_all(factory: &factory, output: &output, source: destination, length: next, cancel: &cancel);
        match published {
          Ok(value: unused_published) => {
          }
          Err(error: unused_output_error) => {
            set code = 4_u8;
            break @echo;
          }
        }
      }
      Err(error: stop) => {
        match stop {
          ReadEnd() => {
            break @echo;
          }
          ReadFailed(error: unused_input_error) => {
            set code = 3_u8;
            break @echo;
          }
        }
      }
    }
  }
  std::time::close_cancel_watch(watch: move cancel);
  return std::process::exit_status(code: code);
}

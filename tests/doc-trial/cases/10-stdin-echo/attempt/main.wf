alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias ReadStop = std::io::ReadStop;

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: cwd_directory, stdout: stdout_stream, handles: factory, stdin: stdin_stream, ..) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  let write_closed = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let read_closed = std::fs::close_directory(factory: &factory, directory: move cwd_read);
  match write_closed {
    Ok(value: unused_ok) => {
    }
    Err(error: unused_err) => {
    }
  }
  match read_closed {
    Ok(value: unused_ok) => {
    }
    Err(error: unused_err) => {
    }
  }
  let buffer = array_filled::<u8, 4096>(value: 0_u8);
  loop @read_loop {
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let read_result = std::io::read_next(factory: &factory, input: &stdin_stream, destination: &buffer[0_u64..4096_u64], start: 0_u64, end: 4096_u64, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match read_result {
      Ok(value: bytes_read) => {
        let written = 0_u64;
        loop @write_loop {
          if written >= bytes_read {
            break @write_loop;
          }
          let no_deadline_write = None<std::time::Instant>();
          let cancel_write = std::time::cancel_never();
          let write_result = std::io::write_once(factory: &factory, output: &stdout_stream, source: &buffer[0_u64..4096_u64], start: written, end: bytes_read, deadline: no_deadline_write, cancel: &cancel_write);
          std::time::close_cancel_watch(watch: move cancel_write);
          match write_result {
            Ok(value: written_index) => {
              set written = written_index;
            }
            Err(error: write_error) => {
              return exit_status(code: 4_u8);
            }
          }
        }
      }
      Err(error: read_stop) => {
        match read_stop {
          ReadEnd() => {
            return exit_status(code: 0_u8);
          }
          ReadFailed(error: io_error) => {
            return exit_status(code: 3_u8);
          }
        }
      }
    }
  }
}

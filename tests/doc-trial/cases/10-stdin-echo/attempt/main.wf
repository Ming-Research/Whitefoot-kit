alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias InputStream = std::io::InputStream;
alias OutputStream = std::io::OutputStream;
alias ReadStop = std::io::ReadStop;
alias IoError = std::io::IoError;
alias Directory = std::fs::Directory;
alias CancelWatch = std::time::CancelWatch;

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(
    args: unused_args,
    drivers: unused_drivers,
    cwd: cwd_directory,
    stdout: output,
    stderr: unused_stderr,
    handles: factory,
    stdin: input,
    clock: unused_clock,
    wall_clock: unused_wall_clock,
    stops: unused_stops,
    memory_meter: unused_memory_meter
  ) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  std::fs::close_directory(factory: &factory, directory: move cwd_read);
  let buffer = array_filled::<u8, 4096>(value: 0_u8);
  let buffer_slice = &buffer[0_u64..4096_u64];
  let exit_code = echo_loop(factory: &factory, input: &input, output: &output, buffer: buffer_slice);
  return exit_status(code: exit_code);
}

fn echo_loop(factory: &HandleFactory, input: &InputStream, output: &OutputStream, buffer: &[u8]) -> code: u8 reads(input), reads(buffer), writes(factory), writes(input), writes(buffer), writes(output) waits {
  let buf_len = buffer^.len;
  loop {
    let cancel = std::time::cancel_never();
    let read_result = std::io::read_next(factory: factory, input: input, destination: buffer, start: 0_u64, end: buf_len, deadline: None<std::time::Instant>(), cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match read_result {
      Ok(value: bytes_read) => {
        let write_offset = write_all(factory: factory, output: output, source: buffer, end: bytes_read);
        if write_offset < bytes_read {
          return 4_u8;
        }
      }
      Err(error: stop) => {
        match stop {
          ReadEnd() => {
            return 0_u8;
          }
          ReadFailed(error: problem) => {
            return 3_u8;
          }
        }
      }
    }
  }
}

fn write_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], end: u64) -> written: u64 reads(source), writes(factory), writes(output) waits {
  let offset = 0_u64;
  loop {
    let pending = offset < end;
    if pending {
    } else {
      break;
    }
    let cancel = std::time::cancel_never();
    let write_result = std::io::write_once(factory: factory, output: output, source: source, start: offset, end: end, deadline: None<std::time::Instant>(), cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match write_result {
      Ok(value: next) => {
        set offset = next;
      }
      Err(error: problem) => {
        return offset;
      }
    }
  }
  return offset;
}

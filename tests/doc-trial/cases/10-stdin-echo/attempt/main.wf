alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias Inputs = std::process::Inputs;
alias HandleFactory = std::io::HandleFactory;
alias InputStream = std::io::InputStream;
alias OutputStream = std::io::OutputStream;
alias ReadStop = std::io::ReadStop;

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: output, stderr: unused_stderr, handles: factory, stdin: input, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  let close_write_result = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let close_read_result = std::fs::close_directory(factory: &factory, directory: move cwd_read);
  let code = 0_u8;
  match close_write_result {
    Ok(value: unused_ok) => {
    }
    Err(error: unused_err) => {
      set code = 1_u8;
    }
  }
  match close_read_result {
    Ok(value: unused_ok2) => {
    }
    Err(error: unused_err2) => {
      set code = 1_u8;
    }
  }
  if code == 0_u8 {
    let exit_code = run_echo(factory: &factory, input: &input, output: &output);
    return exit_status(code: exit_code);
  }

  return exit_status(code: code);
}

fn run_echo(factory: &HandleFactory, input: &InputStream, output: &OutputStream) -> result: u8 reads(input), reads(output), writes(factory) waits {
  let buffer = array_filled::<u8, 4096>(value: 0_u8);
  let buffer_slice = &buffer[0_u64..4096_u64];
  loop @main_loop {
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let read_result = std::io::read_next(factory: factory, input: input, destination: buffer_slice, start: 0_u64, end: 4096_u64, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match read_result {
      Ok(value: bytes_read) => {
        if bytes_read > 0_u64 {
          let write_ok = write_bytes(factory: factory, output: output, buffer: buffer_slice, bytes_read: bytes_read);
          if bnot(write_ok) {
            return 4_u8;
          }
        }
      }
      Err(error: stop) => {
        match stop {
          ReadEnd() => {
            return 0_u8;
          }
          ReadFailed(error: unused_io_error) => {
            return 3_u8;
          }
        }
      }
    }
  }
}

fn write_bytes(factory: &HandleFactory, output: &OutputStream, buffer: &[u8], bytes_read: u64) -> result: Bool reads(buffer), writes(factory), writes(output) waits {
  let written = 0_u64;
  loop @write_loop {
    if written >= bytes_read {
      break @write_loop;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let write_result = std::io::write_once(factory: factory, output: output, source: buffer, start: written, end: bytes_read, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match write_result {
      Ok(value: next) => {
        set written = next;
      }
      Err(error: unused_io_error) => {
        return False();
      }
    }
  }
  return True();
}

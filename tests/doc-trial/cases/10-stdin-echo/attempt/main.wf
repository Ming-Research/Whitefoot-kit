alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias Inputs = std::process::Inputs;
alias HandleFactory = std::io::HandleFactory;
alias InputStream = std::io::InputStream;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias ReadStop = std::io::ReadStop;
alias Instant = std::time::Instant;
alias CancelWatch = std::time::CancelWatch;

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: output, stderr: unused_stderr, handles: factory, stdin: input, ..) = move inputs;
  let std::fs::Directory(read: dir_read, write: dir_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move dir_write);
  std::fs::close_directory(factory: &factory, directory: move dir_read);
  let buffer = array_filled::<u8, 4096>(value: 0_u8);
  let exit_code = 0_u8;
  let no_deadline = None<std::time::Instant>();
  loop @read_loop {
    let window_read = &buffer[0_u64..4096_u64];
    let cancel = std::time::cancel_never();
    let read_result = std::io::read_next(factory: &factory, input: &input, destination: window_read, start: 0_u64, end: 4096_u64, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match read_result {
      Ok(value: bytes_read) => {
        let full_buffer = &buffer[0_u64..4096_u64];
        let sent = 0_u64;
        loop @write_loop {
          if sent < bytes_read {
          } else {
            break @write_loop;
          }
          let cancel2 = std::time::cancel_never();
          let write_result = std::io::write_once(factory: &factory, output: &output, source: full_buffer, start: sent, end: bytes_read, deadline: no_deadline, cancel: &cancel2);
          std::time::close_cancel_watch(watch: move cancel2);
          match write_result {
            Ok(value: next) => {
              set sent = next;
            }
            Err(error: problem) => {
              set exit_code = 4_u8;
              break @read_loop;
            }
          }
        }
      }
      Err(error: stop) => {
        match stop {
          ReadEnd() => {
            break @read_loop;
          }
          ReadFailed(error: problem) => {
            set exit_code = 3_u8;
            break @read_loop;
          }
        }
      }
    }
  }
  return exit_status(code: exit_code);
}

fn main(inputs: std::process::Inputs) -> exit_code: u8 {
  let std::process::Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: out, stderr: unused_err, handles: factory, stdin: input, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  std::fs::close_directory(factory: &factory, directory: move cwd_read);

  let buffer = slots_new::<u8, 8192>();
  let code = echo_loop(input: move input, output: move out, buffer: &buffer);

  return code;
}

fn echo_loop(input: std::io::Input, output: std::io::Output, buffer: &Slots<u8, 8192>) -> code: u8 waits {
  loop {
    let read_result = std::io::read_next(handle: &input, window: buffer);
    match move read_result {
      Ok(value: bytes_read) => {
        if bytes_read == 0_u64 {
          return 0_u8;
        }
        let write_code = write_all(data: &buffer[0_u64..bytes_read], output: &output);
        if write_code != 0_u8 {
          return write_code;
        }
        continue;
      }
      Err(value: read_err) => {
        return 3_u8;
      }
    }
  }
}

fn write_all(data: &[u8], output: &std::io::Output) -> code: u8 waits {
  let offset = 0_u64;
  loop (
    invariant bounds: offset <= data^.len
  ) {
    if offset >= data^.len {
      return 0_u8;
    }
    let remaining = &data[offset..data^.len];
    let write_result = std::io::write_once(handle: output, window: remaining);
    match move write_result {
      Ok(value: bytes_written) => {
        if bytes_written == 0_u64 {
          return 4_u8;
        }
        let next = offset + bytes_written;
        set offset = next;
        continue;
      }
      Err(value: write_err) => {
        return 4_u8;
      }
    }
  }
}

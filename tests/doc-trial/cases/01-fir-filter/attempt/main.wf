fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  let std::process::Inputs(args: a, drivers: d, cwd: cwd_dir, stdout: out, stderr: err, handles: h, stdin: i, clock: c, wall_clock: w, stops: s, memory_meter: m) = move inputs;
  let std::fs::Directory(read: cr, write: cw) = move cwd_dir;
  let wcr = std::fs::close_directory_write(factory: &h, directory: move cw);
  let rcr = std::fs::close_directory(factory: &h, directory: move cr);
  match wcr {
    Ok(value: uw) => {
    }
    Err(error: ew) => {
    }
  }
  match rcr {
    Ok(value: ur) => {
    }
    Err(error: er) => {
    }
  }
  let buf = array_filled::<u8, 520>(value: 0_u8);
  let coeff = 0.125_f64;
  let h0 = 0.0_f64;
  let h1 = 0.0_f64;
  let h2 = 0.0_f64;
  let h3 = 0.0_f64;
  let h4 = 0.0_f64;
  let h5 = 0.0_f64;
  let h6 = 0.0_f64;
  let h7 = 0.0_f64;
  let sum_total = 0.0_f64;
  for (i in 0_u64..64_u64) {
    let samp = if i == 0_u64 {
      give 8.0_f64;
    } else {
      give 0.0_f64;
    };
    let nh0 = samp;
    let nh1 = h0;
    let nh2 = h1;
    let nh3 = h2;
    let nh4 = h3;
    let nh5 = h4;
    let nh6 = h5;
    let nh7 = h6;
    let out_sum = 0.0_f64;
    let out_sum_1 = fadd.strict(out_sum, fmul.strict(nh0, coeff));
    let out_sum_2 = fadd.strict(out_sum_1, fmul.strict(nh1, coeff));
    let out_sum_3 = fadd.strict(out_sum_2, fmul.strict(nh2, coeff));
    let out_sum_4 = fadd.strict(out_sum_3, fmul.strict(nh3, coeff));
    let out_sum_5 = fadd.strict(out_sum_4, fmul.strict(nh4, coeff));
    let out_sum_6 = fadd.strict(out_sum_5, fmul.strict(nh5, coeff));
    let out_sum_7 = fadd.strict(out_sum_6, fmul.strict(nh6, coeff));
    let out_sum_8 = fadd.strict(out_sum_7, fmul.strict(nh7, coeff));
    let bits = reinterpret::<f64, u64>(out_sum_8);
    let off = i * 8_u64;
    let b0 = cvt::<u64, u8>(iand(bits, 255_u64));
    set buf[off] = b0;
    let bs1 = ishr(bits, 8_u32);
    let b1 = cvt::<u64, u8>(iand(bs1, 255_u64));
    set buf[off + 1_u64] = b1;
    let bs2 = ishr(bs1, 8_u32);
    let b2 = cvt::<u64, u8>(iand(bs2, 255_u64));
    set buf[off + 2_u64] = b2;
    let bs3 = ishr(bs2, 8_u32);
    let b3 = cvt::<u64, u8>(iand(bs3, 255_u64));
    set buf[off + 3_u64] = b3;
    let bs4 = ishr(bs3, 8_u32);
    let b4 = cvt::<u64, u8>(iand(bs4, 255_u64));
    set buf[off + 4_u64] = b4;
    let bs5 = ishr(bs4, 8_u32);
    let b5 = cvt::<u64, u8>(iand(bs5, 255_u64));
    set buf[off + 5_u64] = b5;
    let bs6 = ishr(bs5, 8_u32);
    let b6 = cvt::<u64, u8>(iand(bs6, 255_u64));
    set buf[off + 6_u64] = b6;
    let bs7 = ishr(bs6, 8_u32);
    let b7 = cvt::<u64, u8>(iand(bs7, 255_u64));
    set buf[off + 7_u64] = b7;
    set sum_total = fadd.strict(sum_total, out_sum_8);
    set h0 = nh0;
    set h1 = nh1;
    set h2 = nh2;
    set h3 = nh3;
    set h4 = nh4;
    set h5 = nh5;
    set h6 = nh6;
    set h7 = nh7;
  }
  if feq(sum_total, 8.0_f64) {
  } else {
    return std::process::exit_status(code: 1_u8);
  }
  let sbits = reinterpret::<f64, u64>(sum_total);
  let soff = 512_u64;
  let sb0 = cvt::<u64, u8>(iand(sbits, 255_u64));
  set buf[soff] = sb0;
  let sbs1 = ishr(sbits, 8_u32);
  let sb1 = cvt::<u64, u8>(iand(sbs1, 255_u64));
  set buf[soff + 1_u64] = sb1;
  let sbs2 = ishr(sbs1, 8_u32);
  let sb2 = cvt::<u64, u8>(iand(sbs2, 255_u64));
  set buf[soff + 2_u64] = sb2;
  let sbs3 = ishr(sbs2, 8_u32);
  let sb3 = cvt::<u64, u8>(iand(sbs3, 255_u64));
  set buf[soff + 3_u64] = sb3;
  let sbs4 = ishr(sbs3, 8_u32);
  let sb4 = cvt::<u64, u8>(iand(sbs4, 255_u64));
  set buf[soff + 4_u64] = sb4;
  let sbs5 = ishr(sbs4, 8_u32);
  let sb5 = cvt::<u64, u8>(iand(sbs5, 255_u64));
  set buf[soff + 5_u64] = sb5;
  let sbs6 = ishr(sbs5, 8_u32);
  let sb6 = cvt::<u64, u8>(iand(sbs6, 255_u64));
  set buf[soff + 6_u64] = sb6;
  let sbs7 = ishr(sbs6, 8_u32);
  let sb7 = cvt::<u64, u8>(iand(sbs7, 255_u64));
  set buf[soff + 7_u64] = sb7;
  let nd = None<std::time::Instant>();
  let can = std::time::cancel_never();
  let wr = std::io::write_once(factory: &h, output: &out, source: &buf[0_u64..520_u64], start: 0_u64, end: 520_u64, deadline: nd, cancel: &can);
  std::time::close_cancel_watch(watch: move can);
  match wr {
    Ok(value: written) => {
      if written == 520_u64 {
        return std::process::exit_status(code: 0_u8);
      } else {
        return std::process::exit_status(code: 250_u8);
      }
    }
    Err(error: ioe) => {
      return std::process::exit_status(code: 250_u8);
    }
  }
}

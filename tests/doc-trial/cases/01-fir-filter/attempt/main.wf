alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias Directory = std::fs::Directory;
alias exit_status = std::process::exit_status;

fn extract_byte(value: u64, byte_index: u64) -> result: u8 pure contract {
  requires byte_index < 8_u64;
} {
  let shift = byte_index *wrap 8_u32;
  let shifted = ishr(value, shift);
  let masked = iand(shifted, 255_u64);
  return cvt::<u64, u8>(masked);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: output, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  let write_close = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let read_close = std::fs::close_directory(factory: &factory, directory: move cwd_read);
  match write_close {
    Ok(value: unused_write_ok) => {
    }
    Err(error: unused_write_error) => {
      return exit_status(code: 1_u8);
    }
  }
  match read_close {
    Ok(value: unused_read_ok) => {
    }
    Err(error: unused_read_error) => {
      return exit_status(code: 1_u8);
    }
  }

  let outputs = array_filled::<f64, 64>(value: 0.0_f64);
  let sum_var = 0.0_f64;

  for (i in 0_u64..64_u64) {
    let history_start = if i < 7_u64 {
      give 0_u64;
    } else {
      give i - 7_u64;
    }

    let fir_sum = 0.0_f64;
    let history_end = i + 1_u64;
    for (j in history_start..history_end) {
      let sample_value = if j == 0_u64 {
        give 8.0_f64;
      } else {
        give 0.0_f64;
      }
      set fir_sum = fadd.strict(fir_sum, sample_value);
    }

    let output = fdiv.strict(fir_sum, 8.0_f64);
    set outputs[i] = output;
    set sum_var = fadd.strict(sum_var, output);
  }

  let buffer = slots_new::<u8, 520>();

  for (i in 0_u64..64_u64) {
    let value = outputs[i];
    let bits = reinterpret::<f64, u64>(value);
    for (byte_idx in 0_u64..8_u64) {
      let byte = extract_byte(value: bits, byte_index: byte_idx);
      place_back(window: &buffer, value: byte);
    }
  }

  let sum_is_eight = feq(sum_var, 8.0_f64);
  if bnot(sum_is_eight) {
    return exit_status(code: 1_u8);
  }

  let sum_bits = reinterpret::<f64, u64>(sum_var);
  for (byte_idx in 0_u64..8_u64) {
    let byte = extract_byte(value: sum_bits, byte_index: byte_idx);
    place_back(window: &buffer, value: byte);
  }

  let buffer_slice = &buffer[0_u64..520_u64];
  let no_deadline = None<std::time::Instant>();
  let cancel = std::time::cancel_never();
  let outcome = std::io::write_once(
    factory: &factory,
    output: &output,
    source: buffer_slice,
    start: 0_u64,
    end: 520_u64,
    deadline: no_deadline,
    cancel: &cancel
  );
  std::time::close_cancel_watch(watch: move cancel);

  match outcome {
    Ok(value: written) => {
      if written == 520_u64 {
        return exit_status(code: 0_u8);
      } else {
        return exit_status(code: 250_u8);
      }
    }
    Err(error: unused_write_error) => {
      return exit_status(code: 250_u8);
    }
  }
}

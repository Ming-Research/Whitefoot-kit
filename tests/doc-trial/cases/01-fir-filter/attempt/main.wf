alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias Instant = std::time::Instant;

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: cwd_dir, handles: factory, stdout: output, ..) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_dir;
  std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  std::fs::close_directory(factory: &factory, directory: move cwd_read);
  let outputs = array_filled::<f64, 64>(value: 0.0_f64);
  let history = slots_new::<f64, 8>();
  for (i in 0_u64..64_u64) {
    let sample = if i == 0_u64 {
      give 8.0_f64;
    } else {
      give 0.0_f64;
    }
    if history.len == 8_u64 {
      let removed = take_front(window: &history);
    }
    place_back(window: &history, value: sample);
    let sum = 0.0_f64;
    for (j in 0_u64..history.len) {
      set sum = sum +strict history[j];
    }
    let coeff = 0.125_f64;
    let output_val = fmul.strict(sum, coeff);
    set outputs[i] = output_val;
  }
  let total = 0.0_f64;
  for (i in 0_u64..64_u64) {
    set total = total +strict outputs[i];
  }
  if feq(total, 8.0_f64) {
  } else {
    return exit_status(code: 1_u8);
  }
  let buffer = array_filled::<u8, 520>(value: 0_u8);
  for (i in 0_u64..64_u64) {
    let offset = i * 8_u64;
    let value = outputs[i];
    let bits = reinterpret::<f64, u64>(value);
    let b0 = iand(bits, 255_u64);
    let b1 = iand(ishr(bits, 8_u32), 255_u64);
    let b2 = iand(ishr(bits, 16_u32), 255_u64);
    let b3 = iand(ishr(bits, 24_u32), 255_u64);
    let b4 = iand(ishr(bits, 32_u32), 255_u64);
    let b5 = iand(ishr(bits, 40_u32), 255_u64);
    let b6 = iand(ishr(bits, 48_u32), 255_u64);
    let b7 = iand(ishr(bits, 56_u32), 255_u64);
    set buffer[offset] = cvt::<u64, u8>(b0);
    set buffer[offset + 1_u64] = cvt::<u64, u8>(b1);
    set buffer[offset + 2_u64] = cvt::<u64, u8>(b2);
    set buffer[offset + 3_u64] = cvt::<u64, u8>(b3);
    set buffer[offset + 4_u64] = cvt::<u64, u8>(b4);
    set buffer[offset + 5_u64] = cvt::<u64, u8>(b5);
    set buffer[offset + 6_u64] = cvt::<u64, u8>(b6);
    set buffer[offset + 7_u64] = cvt::<u64, u8>(b7);
  }
  let bits = reinterpret::<f64, u64>(total);
  let b0 = iand(bits, 255_u64);
  let b1 = iand(ishr(bits, 8_u32), 255_u64);
  let b2 = iand(ishr(bits, 16_u32), 255_u64);
  let b3 = iand(ishr(bits, 24_u32), 255_u64);
  let b4 = iand(ishr(bits, 32_u32), 255_u64);
  let b5 = iand(ishr(bits, 40_u32), 255_u64);
  let b6 = iand(ishr(bits, 48_u32), 255_u64);
  let b7 = iand(ishr(bits, 56_u32), 255_u64);
  set buffer[512_u64] = cvt::<u64, u8>(b0);
  set buffer[513_u64] = cvt::<u64, u8>(b1);
  set buffer[514_u64] = cvt::<u64, u8>(b2);
  set buffer[515_u64] = cvt::<u64, u8>(b3);
  set buffer[516_u64] = cvt::<u64, u8>(b4);
  set buffer[517_u64] = cvt::<u64, u8>(b5);
  set buffer[518_u64] = cvt::<u64, u8>(b6);
  set buffer[519_u64] = cvt::<u64, u8>(b7);
  let full_buffer = &buffer[0_u64..520_u64];
  let sent = 0_u64;
  loop @publish {
    if sent < 520_u64 {
    } else {
      break @publish;
    }
    let no_deadline = None<Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: &factory, output: &output, source: full_buffer, start: sent, end: 520_u64, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return exit_status(code: 250_u8);
      }
    }
  }
  return exit_status(code: 0_u8);
}

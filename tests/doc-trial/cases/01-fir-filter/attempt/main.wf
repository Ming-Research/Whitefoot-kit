alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(
    args: unused_args,
    drivers: unused_drivers,
    cwd: cwd_directory,
    stdout: output_stream,
    stderr: unused_stderr,
    handles: factory,
    stdin: unused_stdin,
    clock: unused_clock,
    wall_clock: unused_wall_clock,
    stops: unused_stops,
    memory_meter: unused_memory_meter
  ) = move inputs;

  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  let write_close_result = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let read_close_result = std::fs::close_directory(factory: &factory, directory: move cwd_read);

  match write_close_result {
    Ok(value: unused_w) => {
    }
    Err(error: unused_we) => {
    }
  }

  match read_close_result {
    Ok(value: unused_r) => {
    }
    Err(error: unused_re) => {
    }
  }

  let output_bytes = array_filled::<u8, 520>(value: 0_u8);

  let coeff = 0.125_f64;
  let history = array_filled::<f64, 8>(value: 0.0_f64);
  let total_sum = 0.0_f64;

  for (i in 0_u64..64_u64) {
    let current_sample = if i == 0_u64 {
      give 8.0_f64;
    } else {
      give 0.0_f64;
    };

    let temp_history = array_filled::<f64, 8>(value: 0.0_f64);
    set temp_history[0_u64] = current_sample;
    for (j in 0_u64..7_u64) {
      set temp_history[j + 1_u64] = history[j];
    }

    for (j in 0_u64..8_u64) {
      set history[j] = temp_history[j];
    }

    let sum = 0.0_f64;
    for (j in 0_u64..8_u64) {
      let product = fmul.strict(history[j], coeff);
      set sum = fadd.strict(sum, product);
    }

    let bits = reinterpret::<f64, u64>(sum);
    let byte_offset = i * 8_u64;
    let temp_bits = bits;
    for (k in 0_u64..8_u64) {
      let byte_val = cvt::<u64, u8>(iand(temp_bits, 0xFF_u64));
      set output_bytes[byte_offset + k] = byte_val;
      set temp_bits = ishr(temp_bits, 8_u32);
    }

    set total_sum = fadd.strict(total_sum, sum);
  }

  if feq(total_sum, 8.0_f64) {
  } else {
    return exit_status(code: 1_u8);
  }

  let sum_bits = reinterpret::<f64, u64>(total_sum);
  let sum_byte_offset = 512_u64;
  let temp_sum_bits = sum_bits;
  for (k in 0_u64..8_u64) {
    let byte_val = cvt::<u64, u8>(iand(temp_sum_bits, 0xFF_u64));
    set output_bytes[sum_byte_offset + k] = byte_val;
    set temp_sum_bits = ishr(temp_sum_bits, 8_u32);
  }

  let no_deadline = None<std::time::Instant>();
  let cancel = std::time::cancel_never();
  let write_result = std::io::write_once(
    factory: &factory,
    output: &output_stream,
    source: &output_bytes[0_u64..520_u64],
    start: 0_u64,
    end: 520_u64,
    deadline: no_deadline,
    cancel: &cancel
  );
  std::time::close_cancel_watch(watch: move cancel);

  match write_result {
    Ok(value: written) => {
      if written == 520_u64 {
        return exit_status(code: 0_u8);
      } else {
        return exit_status(code: 250_u8);
      }
    }
    Err(error: io_error) => {
      return exit_status(code: 250_u8);
    }
  }
}

alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;

const taps: Array<f64, 8> =[0.125_f64, 0.125_f64, 0.125_f64, 0.125_f64, 0.125_f64, 0.125_f64, 0.125_f64, 0.125_f64];

fn encode_f64(value: f64) -> result: Array<u8, 8> pure {
  let bits = reinterpret::<f64, u64>(value);
  let chunk = array_filled::<u8, 8>(value: 0_u8);
  let remaining = bits;
  for (j in 0_u64..8_u64) {
    set chunk[j] = cvt.wrap::<u64, u8>(remaining);
    set remaining = ishr(remaining, 8_u32);
  }
  return chunk;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  requires length <= source^.len;
} {
  let sent = 0_u64;
  loop @publish {
    if sent < length {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn publish_values(factory: &HandleFactory, output: &OutputStream, values: &[f64]) -> result: Result<unit, IoError> reads(values), writes(factory), writes(output) waits {
  let count = values^.len;
  for (i in 0_u64..count) {
    let chunk = encode_f64(value: values^[i]);
    let published = publish_all(factory: factory, output: output, source: &chunk[0_u64..8_u64], length: 8_u64);
    match published {
      Ok(value: unused_published) => {
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: directory, stdout: output, handles: factory, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let samples = array_filled::<f64, 64>(value: 0.0_f64);
  set samples[0_u64] = 8.0_f64;
  let results = array_filled::<f64, 65>(value: 0.0_f64);
  for (n in 0_u64..64_u64) {
    let accumulated = 0.0_f64;
    for (k in 0_u64..8_u64) {
      let reachable = n -defined k;
      if reachable {
        let index = n - k;
        let term = fmul.strict(taps[k], samples[index]);
        set accumulated = fadd.strict(accumulated, term);
      }
    }
    set results[n] = accumulated;
  }
  let total = 0.0_f64;
  let bounded = True();
  for (i in 0_u64..64_u64) {
    let value = results[i];
    set total = fadd.strict(total, value);
    let above = fge(value, 0.0_f64);
    let below = fle(value, 8.0_f64);
    let inside = band(above, below);
    set bounded = band(bounded, inside);
  }
  let sum_ok = feq(total, 8.0_f64);
  let accepted = band(bounded, sum_ok);
  if accepted {
    set results[64_u64] = total;
    let published = publish_values(factory: &factory, output: &output, values: &results[0_u64..65_u64]);
    match published {
      Ok(value: unused_published) => {
        return std::process::exit_status(code: 0_u8);
      }
      Err(error: problem) => {
        return std::process::exit_status(code: 250_u8);
      }
    }
  }
  return std::process::exit_status(code: 1_u8);
}

alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias Inputs = std::process::Inputs;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias Instant = std::time::Instant;
alias CancelWatch = std::time::CancelWatch;

fn write_all(factory: &HandleFactory, output: &OutputStream, source: &[u8]) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits {
  let length = source^.len;
  let sent = 0_u64;
  loop @publish {
    if sent < length {
    } else {
      break @publish;
    }
    let no_deadline = None<Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn f64_to_bytes(value: f64) -> result: Array<u8, 8> pure {
  let bits = reinterpret::<f64, u64>(value);
  let b0 = cvt.wrap::<u64, u8>(bits);
  let shifted1 = ishr(bits, 8_u32);
  let b1 = cvt.wrap::<u64, u8>(shifted1);
  let shifted2 = ishr(bits, 16_u32);
  let b2 = cvt.wrap::<u64, u8>(shifted2);
  let shifted3 = ishr(bits, 24_u32);
  let b3 = cvt.wrap::<u64, u8>(shifted3);
  let shifted4 = ishr(bits, 32_u32);
  let b4 = cvt.wrap::<u64, u8>(shifted4);
  let shifted5 = ishr(bits, 40_u32);
  let b5 = cvt.wrap::<u64, u8>(shifted5);
  let shifted6 = ishr(bits, 48_u32);
  let b6 = cvt.wrap::<u64, u8>(shifted6);
  let shifted7 = ishr(bits, 56_u32);
  let b7 = cvt.wrap::<u64, u8>(shifted7);
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  set bytes[0_u64] = b0;
  set bytes[1_u64] = b1;
  set bytes[2_u64] = b2;
  set bytes[3_u64] = b3;
  set bytes[4_u64] = b4;
  set bytes[5_u64] = b5;
  set bytes[6_u64] = b6;
  set bytes[7_u64] = b7;
  return bytes;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: output, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: directory, write: directory_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory);
  let output_buffer = array_filled::<u8, 520>(value: 0_u8);
  let history = array_filled::<f64, 8>(value: 0.0_f64);
  let coefficient = 0.125_f64;
  let total_sum = 0.0_f64;
  for (sample_index in 0_u64..64_u64) {
    let current_sample = if sample_index == 0_u64 {
      give 8.0_f64;
    } else {
      give 0.0_f64;
    };
    set history[7_u64] = history[6_u64];
    set history[6_u64] = history[5_u64];
    set history[5_u64] = history[4_u64];
    set history[4_u64] = history[3_u64];
    set history[3_u64] = history[2_u64];
    set history[2_u64] = history[1_u64];
    set history[1_u64] = history[0_u64];
    set history[0_u64] = current_sample;
    let sum = history[0_u64];
    let sum = sum +fadd.strict history[1_u64];
    let sum = sum +fadd.strict history[2_u64];
    let sum = sum +fadd.strict history[3_u64];
    let sum = sum +fadd.strict history[4_u64];
    let sum = sum +fadd.strict history[5_u64];
    let sum = sum +fadd.strict history[6_u64];
    let sum = sum +fadd.strict history[7_u64];
    let output_value = fmul.strict(sum, coefficient);
    set total_sum = total_sum +fadd.strict output_value;
    let output_bytes = f64_to_bytes(value: output_value);
    let byte_offset = sample_index * 8_u64;
    set output_buffer[byte_offset] = output_bytes[0_u64];
    set output_buffer[byte_offset + 1_u64] = output_bytes[1_u64];
    set output_buffer[byte_offset + 2_u64] = output_bytes[2_u64];
    set output_buffer[byte_offset + 3_u64] = output_bytes[3_u64];
    set output_buffer[byte_offset + 4_u64] = output_bytes[4_u64];
    set output_buffer[byte_offset + 5_u64] = output_bytes[5_u64];
    set output_buffer[byte_offset + 6_u64] = output_bytes[6_u64];
    set output_buffer[byte_offset + 7_u64] = output_bytes[7_u64];
  }
  let expected_sum = 8.0_f64;
  let sum_matches = feq(total_sum, expected_sum);
  if sum_matches {
  } else {
    return exit_status(code: 1_u8);
  }
  let sum_bytes = f64_to_bytes(value: total_sum);
  set output_buffer[512_u64] = sum_bytes[0_u64];
  set output_buffer[513_u64] = sum_bytes[1_u64];
  set output_buffer[514_u64] = sum_bytes[2_u64];
  set output_buffer[515_u64] = sum_bytes[3_u64];
  set output_buffer[516_u64] = sum_bytes[4_u64];
  set output_buffer[517_u64] = sum_bytes[5_u64];
  set output_buffer[518_u64] = sum_bytes[6_u64];
  set output_buffer[519_u64] = sum_bytes[7_u64];
  let output_view = &output_buffer[0_u64..520_u64];
  let write_result = write_all(factory: &factory, output: &output, source: output_view);
  match write_result {
    Ok(value: unused_unit) => {
      return exit_status(code: 0_u8);
    }
    Err(error: unused_error) => {
      return exit_status(code: 250_u8);
    }
  }
}

alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias write_once = std::io::write_once;

const percent_input: Array<u8, 11> =[65_u8, 37_u8, 52_u8, 50_u8, 37_u8, 52_u8, 97_u8, 37_u8, 122_u8, 122_u8, 37_u8];

fn decode(out: &[u8], src: &[u8]) -> result: u64 reads(src), writes(out) contract {
  define output_length = out^.len;
  define source_length = src^.len;
  define sufficient = output_length >= source_length;
  requires sufficient;
} {
  let source_length = src^.len;
  let consumed_until = 0_u64;
  let output_index = 0_u64;
  for (
    input_index in 0_u64..source_length,
    invariant writes_behind_scan: output_index <= input_index
  ) {
    let already_consumed = input_index < consumed_until;
    if already_consumed {
    } else {
      let byte = src^[input_index];
      let is_percent = byte == 37_u8;
      let next_index = input_index +wrap 1_u64;
      let last_index = input_index +wrap 2_u64;
      let high_in_source = next_index < source_length;
      let low_in_source = last_index < source_length;
      let has_pair = band(high_in_source, low_in_source);
      let candidate = band(is_percent, has_pair);
      if candidate {
        let high_byte = src^[next_index];
        let low_byte = src^[last_index];
        let high_decimal_low = high_byte >= 48_u8;
        let high_decimal_high = high_byte <= 57_u8;
        let high_decimal = band(high_decimal_low, high_decimal_high);
        let high_upper_low = high_byte >= 65_u8;
        let high_upper_high = high_byte <= 70_u8;
        let high_upper = band(high_upper_low, high_upper_high);
        let high_lower_low = high_byte >= 97_u8;
        let high_lower_high = high_byte <= 102_u8;
        let high_lower = band(high_lower_low, high_lower_high);
        let high_alphabetic = bor(high_upper, high_lower);
        let high_valid = bor(high_decimal, high_alphabetic);
        let low_decimal_low = low_byte >= 48_u8;
        let low_decimal_high = low_byte <= 57_u8;
        let low_decimal = band(low_decimal_low, low_decimal_high);
        let low_upper_low = low_byte >= 65_u8;
        let low_upper_high = low_byte <= 70_u8;
        let low_upper = band(low_upper_low, low_upper_high);
        let low_lower_low = low_byte >= 97_u8;
        let low_lower_high = low_byte <= 102_u8;
        let low_lower = band(low_lower_low, low_lower_high);
        let low_alphabetic = bor(low_upper, low_lower);
        let low_valid = bor(low_decimal, low_alphabetic);
        let valid = band(high_valid, low_valid);
        if valid {
          let high_is_decimal = high_byte <= 57_u8;
          let high = if high_is_decimal {
            let value = high_byte -wrap 48_u8;
            give value;
          } else {
            let high_is_upper = high_byte <= 70_u8;
            let value = if high_is_upper {
              let offset = high_byte -wrap 65_u8;
              give offset +wrap 10_u8;
            } else {
              let offset = high_byte -wrap 97_u8;
              give offset +wrap 10_u8;
            }
            give value;
          }
          let low_is_decimal = low_byte <= 57_u8;
          let low = if low_is_decimal {
            let value = low_byte -wrap 48_u8;
            give value;
          } else {
            let low_is_upper = low_byte <= 70_u8;
            let value = if low_is_upper {
              let offset = low_byte -wrap 65_u8;
              give offset +wrap 10_u8;
            } else {
              let offset = low_byte -wrap 97_u8;
              give offset +wrap 10_u8;
            }
            give value;
          }
          let shifted = high *wrap 16_u8;
          let decoded = shifted +wrap low;
          set out^[output_index] = decoded;
          set consumed_until = last_index + 1_u64;
          set output_index = output_index + 1_u64;
        } else {
          set out^[output_index] = byte;
          set consumed_until = input_index + 1_u64;
          set output_index = output_index + 1_u64;
        }
      } else {
        set out^[output_index] = byte;
        set consumed_until = input_index + 1_u64;
        set output_index = output_index + 1_u64;
      }
    }
  }
  return output_index;
}

fn low_byte(v: u64) -> result: u8 pure {
  let low = iand(v, 255_u64);
  let byte = cvt::<u64, u8>(low);
  return byte;
}

fn spell(destination: &[u8], at: u64, value: u64) -> result: u64 writes(destination) {
  doc "Writes the eight little-endian bytes of value at the given offset, skipping any slot the range does not have.";
  let cursor = at;
  let rest = value;
  loop @octets {
    let limit = at +wrap 8_u64;
    let done = cursor >= limit;
    if done {
      break @octets;
    }
    let spare = destination^.len;
    let writable = cursor < spare;
    if writable {
      let byte = low_byte(v: rest);
      set destination^[cursor] = byte;
    }
    set rest = irotr(rest, 8_u32);
    set cursor = cursor +wrap 1_u64;
  }
  return at +wrap 8_u64;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  doc "Publishes one prefix of the source range, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let wait_cancel_1 = std::time::cancel_never();
    let wait_outcome_1 = write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &wait_cancel_1);
    std::time::close_cancel_watch(watch: move wait_cancel_1);
    match wait_outcome_1 {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn publish_report(factory: &HandleFactory, output: &OutputStream, source: &[u8]) -> status: ExitStatus reads(source), writes(factory), writes(output) waits {
  doc "Trial adaptation: publish the actual observations with the maintained stdin_echo partial-write retry; status 250 reports publication failure.";
  let length = source^.len;
  match publish_all(factory: factory, output: output, source: source, length: length) {
    Ok(value: published) => {
      return exit_status(code: 0_u8);
    }
    Err(error: problem) => {
      return exit_status(code: 250_u8);
    }
  }
}

fn main(inputs: std::process::Inputs) -> status: ExitStatus pure waits {
  doc "Trial adaptation: keep the decoder and sentinel checks; publish decoded bytes, produced length and the untouched sentinel.";
  let std::process::Inputs(cwd: directory, handles: factory, stdout: out, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let report = slots_new::<u8, 16>();
  for (
    at in 0_u64..16_u64,
    invariant grown: report.len == at
  ) {
    place_back(window: &report, value: 0_u8);
  }
  let report_window = &report[0_u64..16_u64];
  let output = slots_new::<u8, 11>();
  for @fill_output (
    at in 0_u64..11_u64,
    invariant grown: output.len == at
  ) {
    place_back(window: &output, value: 204_u8);
  }
  let input = &percent_input[0_u64..11_u64];
  let window = &output[0_u64..11_u64];
  let window_length = window^.len;
  let input_length = input^.len;
  if window_length >= input_length {
  } else {
    return exit_status(code: 2_u8);
  }
  let produced = decode(out: window, src: input);
  if produced == 7_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  let output_zero = output[0_u64];
  let output_one = output[1_u64];
  let output_two = output[2_u64];
  let output_three = output[3_u64];
  let output_four = output[4_u64];
  let output_five = output[5_u64];
  let output_six = output[6_u64];
  let output_tail = output[7_u64];
  if output_zero == 65_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output_one == 66_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output_two == 74_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output_three == 37_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output_four == 122_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output_five == 122_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output_six == 37_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output_tail == 204_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  for (at in 0_u64..7_u64) {
    set report[at] = output[at];
  }
  let recorded_length = spell(destination: report_window, at: 7_u64, value: produced);
  set report[15_u64] = output_tail;
  return publish_report(factory: &factory, output: &out, source: report_window);
}

alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias write_once = std::io::write_once;
alias cancel_never = std::time::cancel_never;
alias close_cancel_watch = std::time::close_cancel_watch;
alias close_directory_write = std::fs::close_directory_write;
alias close_directory = std::fs::close_directory;
alias Directory = std::fs::Directory;

fn hex_digit(byte: u8) -> result: Option<u8> pure {
  let zero = 48_u8;
  let nine = 57_u8;
  let upper_a = 65_u8;
  let upper_f = 70_u8;
  let lower_a = 97_u8;
  let lower_f = 102_u8;
  let is_digit_low = byte >= zero;
  let is_digit_high = byte <= nine;
  let is_digit = band(is_digit_low, is_digit_high);
  if is_digit {
    let digit = byte - zero;
    return Some<u8>(value: digit);
  }
  let is_upper_low = byte >= upper_a;
  let is_upper_high = byte <= upper_f;
  let is_upper = band(is_upper_low, is_upper_high);
  if is_upper {
    let upper_offset = byte - upper_a;
    let digit = upper_offset + 10_u8;
    return Some<u8>(value: digit);
  }
  let is_lower_low = byte >= lower_a;
  let is_lower_high = byte <= lower_f;
  let is_lower = band(is_lower_low, is_lower_high);
  if is_lower {
    let lower_offset = byte - lower_a;
    let digit = lower_offset + 10_u8;
    return Some<u8>(value: digit);
  }
  return None<u8>();
}

fn percent_decode(source: &[u8], destination: &[u8]) -> result: u64 reads(source), writes(destination) {
  let source_len = source^.len;
  let dest_len = destination^.len;
  let dest_pos = 0_u64;
  let src_pos = 0_u64;
  loop (
    invariant bounded: dest_pos <= dest_len
  ) {
    let src_at_end = src_pos >= source_len;
    if src_at_end {
      return dest_pos;
    }
    let current = source^[src_pos];
    let percent = 37_u8;
    if current == percent {
      let next_pos = src_pos +wrap 1_u64;
      let second_pos = next_pos +wrap 1_u64;
      let can_read_two = second_pos < source_len;
      if can_read_two {
        if next_pos < source_len {
          let first_hex = source^[next_pos];
          let second_hex = source^[second_pos];
          let first_opt = hex_digit(byte: first_hex);
          match first_opt {
            Some(value: first_val) => {
              let second_opt = hex_digit(byte: second_hex);
              match second_opt {
                Some(value: second_val) => {
                  let high = first_val *wrap 16_u8;
                  let decoded = high +wrap second_val;
                  if dest_pos < dest_len {
                    set destination^[dest_pos] = decoded;
                  }
                  set src_pos = second_pos +wrap 1_u64;
                  set dest_pos = dest_pos +wrap 1_u64;
                }
                None() => {
                  if dest_pos < dest_len {
                    set destination^[dest_pos] = current;
                  }
                  set src_pos = src_pos +wrap 1_u64;
                  set dest_pos = dest_pos +wrap 1_u64;
                }
              }
            }
            None() => {
              if dest_pos < dest_len {
                set destination^[dest_pos] = current;
              }
              set src_pos = src_pos +wrap 1_u64;
              set dest_pos = dest_pos +wrap 1_u64;
            }
          }
        } else {
          if dest_pos < dest_len {
            set destination^[dest_pos] = current;
          }
          set src_pos = src_pos +wrap 1_u64;
          set dest_pos = dest_pos +wrap 1_u64;
        }
      } else {
        if dest_pos < dest_len {
          set destination^[dest_pos] = current;
        }
        set src_pos = src_pos +wrap 1_u64;
        set dest_pos = dest_pos +wrap 1_u64;
      }
    } else {
      if dest_pos < dest_len {
        set destination^[dest_pos] = current;
      }
      set src_pos = src_pos +wrap 1_u64;
      set dest_pos = dest_pos +wrap 1_u64;
    }
  }
}

fn write_all(factory: &std::io::HandleFactory, output: &std::io::OutputStream, bytes: &[u8]) -> result: Result<unit, std::io::IoError> reads(bytes), writes(factory), writes(output) waits {
  let length = bytes^.len;
  let sent = 0_u64;
  loop {
    let is_done = sent >= length;
    if is_done {
      return Ok<unit, std::io::IoError>(value: unit);
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = cancel_never();
    let outcome = write_once(factory: factory, output: output, source: bytes, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, std::io::IoError>(error: problem);
      }
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: cwd_directory, stdout: stdout_stream, handles: factory, ..) = move inputs;
  let Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  match close_directory_write(factory: &factory, directory: move cwd_write) {
    Ok(value: unused_write_ok) => {
    }
    Err(error: unused_write_error) => {
    }
  }
  match close_directory(factory: &factory, directory: move cwd_read) {
    Ok(value: unused_read_ok) => {
    }
    Err(error: unused_read_error) => {
    }
  }
  let source = array_filled::<u8, 11>(value: 65_u8);
  set source[1_u64] = 37_u8;
  set source[2_u64] = 52_u8;
  set source[3_u64] = 50_u8;
  set source[4_u64] = 37_u8;
  set source[5_u64] = 52_u8;
  set source[6_u64] = 97_u8;
  set source[7_u64] = 37_u8;
  set source[8_u64] = 122_u8;
  set source[9_u64] = 122_u8;
  set source[10_u64] = 37_u8;
  let destination = array_filled::<u8, 11>(value: 204_u8);
  let source_slice = &source[0_u64..11_u64];
  let dest_slice = &destination[0_u64..11_u64];
  let produced = percent_decode(source: source_slice, destination: dest_slice);
  if produced != 7_u64 {
    return exit_status(code: 1_u8);
  }
  let next_byte = destination[7_u64];
  if next_byte != 204_u8 {
    return exit_status(code: 1_u8);
  }
  let output = slots_new::<u8, 16>();
  place_back(window: &output, value: destination[0_u64]);
  place_back(window: &output, value: destination[1_u64]);
  place_back(window: &output, value: destination[2_u64]);
  place_back(window: &output, value: destination[3_u64]);
  place_back(window: &output, value: destination[4_u64]);
  place_back(window: &output, value: destination[5_u64]);
  place_back(window: &output, value: destination[6_u64]);
  let byte_zero = 0_u8;
  place_back(window: &output, value: 7_u8);
  place_back(window: &output, value: byte_zero);
  place_back(window: &output, value: byte_zero);
  place_back(window: &output, value: byte_zero);
  place_back(window: &output, value: byte_zero);
  place_back(window: &output, value: byte_zero);
  place_back(window: &output, value: byte_zero);
  place_back(window: &output, value: byte_zero);
  place_back(window: &output, value: 204_u8);
  let output_slice = &output[0_u64..16_u64];
  let write_result = write_all(factory: &factory, output: &stdout_stream, bytes: output_slice);
  match write_result {
    Ok(value: unused_ok) => {
      return exit_status(code: 0_u8);
    }
    Err(error: unused_error) => {
      return exit_status(code: 250_u8);
    }
  }
}

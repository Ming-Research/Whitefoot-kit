alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias Instant = std::time::Instant;
alias CancelWatch = std::time::CancelWatch;

fn hex_digit(byte: u8) -> result: Option<u8> pure {
  let is_digit = band(byte >= 48_u8, byte <= 57_u8);
  if is_digit {
    let value = byte - 48_u8;
    return Some<u8>(value: value);
  }
  let is_lower = band(byte >= 97_u8, byte <= 102_u8);
  if is_lower {
    let value = byte - 97_u8 +wrap 10_u8;
    return Some<u8>(value: value);
  }
  let is_upper = band(byte >= 65_u8, byte <= 70_u8);
  if is_upper {
    let value = byte - 65_u8 +wrap 10_u8;
    return Some<u8>(value: value);
  }
  return None<u8>();
}

fn percent_decode(source: &[u8], destination: &[u8]) -> result: u64 reads(source), writes(destination) contract {
  requires destination^.len >= source^.len;
} {
  let source_len = source^.len;
  let dest_len = destination^.len;
  let produced = 0_u64;
  let i = 0_u64;
  loop @decode {
    if i < source_len {
    } else {
      break @decode;
    }
    let byte = source^[i];
    if byte == 37_u8 {
      let next_i = i + 1_u64;
      if next_i < source_len {
        let second_i = next_i + 1_u64;
        if second_i < source_len {
          let high = source^[next_i];
          let low = source^[second_i];
          let high_opt = hex_digit(byte: high);
          match high_opt {
            Some(value: h) => {
              let low_opt = hex_digit(byte: low);
              match low_opt {
                Some(value: l) => {
                  let h16 = cvt::<u8, u16>(h);
                  let shifted = ishl(h16, 4_u32);
                  let l16 = cvt::<u8, u16>(l);
                  let combined16 = ior(shifted, l16);
                  let decoded = cvt::<u16, u8>(combined16);
                  if produced < dest_len {
                    set destination^[produced] = decoded;
                    set produced = produced + 1_u64;
                  }
                  set i = second_i + 1_u64;
                  continue @decode;
                }
                None() => {
                  if produced < dest_len {
                    set destination^[produced] = 37_u8;
                    set produced = produced + 1_u64;
                  }
                  set i = i + 1_u64;
                  continue @decode;
                }
              }
            }
            None() => {
              if produced < dest_len {
                set destination^[produced] = 37_u8;
                set produced = produced + 1_u64;
              }
              set i = i + 1_u64;
              continue @decode;
            }
          }
        } else {
          if produced < dest_len {
            set destination^[produced] = 37_u8;
            set produced = produced + 1_u64;
          }
          set i = i + 1_u64;
          continue @decode;
        }
      } else {
        if produced < dest_len {
          set destination^[produced] = 37_u8;
          set produced = produced + 1_u64;
        }
        set i = i + 1_u64;
        continue @decode;
      }
    } else {
      if produced < dest_len {
        set destination^[produced] = byte;
        set produced = produced + 1_u64;
      }
      set i = i + 1_u64;
      continue @decode;
    }
  }
  return produced;
}

fn write_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  requires length <= source^.len;
} {
  let sent = 0_u64;
  loop @publish {
    if sent < length {
    } else {
      break @publish;
    }
    let no_deadline = None<Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: cwd_directory, handles: factory, stdout: output, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let input = array_filled::<u8, 11>(value: 0_u8);
  set input[0_u64] = 65_u8;
  set input[1_u64] = 37_u8;
  set input[2_u64] = 52_u8;
  set input[3_u64] = 50_u8;
  set input[4_u64] = 37_u8;
  set input[5_u64] = 52_u8;
  set input[6_u64] = 97_u8;
  set input[7_u64] = 37_u8;
  set input[8_u64] = 122_u8;
  set input[9_u64] = 122_u8;
  set input[10_u64] = 37_u8;
  let destination = array_filled::<u8, 11>(value: 204_u8);
  let produced = percent_decode(source: &input[0_u64..11_u64], destination: &destination[0_u64..11_u64]);
  if produced != 7_u64 {
    return exit_status(code: 1_u8);
  }
  let sentinel = destination[7_u64];
  if sentinel != 204_u8 {
    return exit_status(code: 1_u8);
  }
  let output_buffer = array_filled::<u8, 16>(value: 0_u8);
  for (i in 0_u64..7_u64) {
    set output_buffer[i] = destination[i];
  }
  let p = produced;
  let b0 = cvt::<u64, u8>(p);
  let p_shifted1 = ishr(p, 8_u32);
  let b1 = cvt::<u64, u8>(p_shifted1);
  let p_shifted2 = ishr(p, 16_u32);
  let b2 = cvt::<u64, u8>(p_shifted2);
  let p_shifted3 = ishr(p, 24_u32);
  let b3 = cvt::<u64, u8>(p_shifted3);
  let p_shifted4 = ishr(p, 32_u32);
  let b4 = cvt::<u64, u8>(p_shifted4);
  let p_shifted5 = ishr(p, 40_u32);
  let b5 = cvt::<u64, u8>(p_shifted5);
  let p_shifted6 = ishr(p, 48_u32);
  let b6 = cvt::<u64, u8>(p_shifted6);
  let p_shifted7 = ishr(p, 56_u32);
  let b7 = cvt::<u64, u8>(p_shifted7);
  set output_buffer[7_u64] = b0;
  set output_buffer[8_u64] = b1;
  set output_buffer[9_u64] = b2;
  set output_buffer[10_u64] = b3;
  set output_buffer[11_u64] = b4;
  set output_buffer[12_u64] = b5;
  set output_buffer[13_u64] = b6;
  set output_buffer[14_u64] = b7;
  set output_buffer[15_u64] = sentinel;
  let output_slice = &output_buffer[0_u64..16_u64];
  let write_result = write_all(factory: &factory, output: &output, source: output_slice, length: 16_u64);
  match write_result {
    Ok(value: unused) => {
      return exit_status(code: 0_u8);
    }
    Err(error: unused) => {
      return exit_status(code: 250_u8);
    }
  }
}

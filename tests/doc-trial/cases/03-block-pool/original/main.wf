alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Block {
  bytes: Slots<u8, 256>;
}

nodrop struct Lease {
  run: Block;
}

struct BlockPool {
  free: Slots<Block, 8>;
}

fn block_new() -> made: Block pure {
  doc "One run of 256 slots, frame-resident inside the block that owns it [STOR-1].";
  let bytes = slots_new::<u8, 256>();
  let made = Block(bytes: move bytes);
  return move made;
}

fn pool_new() -> made: BlockPool pure {
  doc "A pool is a Slots plus the blocks it holds [OP-13]: eight runs are carved into one run of runs and kept as a free list.";
  let free = slots_new::<Block, 8>();
  for @carve (
    at in 0_u64..8_u64,
    invariant grown: free.len >= at,
    invariant bounded: free.len <= at,
    invariant spare: free.cap - free.len + at >= 8_u64
  ) {
    let run = block_new();
    place_back(window: &free, value: move run);
  }
  let pool = BlockPool(free: move free);
  return move pool;
}

fn take_free(free: &Slots<Block, 8>) -> block: Block writes(free.last), writes(free.len) contract {
  requires free^.len > 0_u64;
  ensures free^.len + 1_u64 == entry(free)^.len;
} {
  doc "One block off the back boundary; the row names exactly the last filled slot and the length take_back moves [OP-10].";
  let block = take_back(window: free);
  return move block;
}

fn return_free(free: &Slots<Block, 8>, block: Block) -> result: unit writes(free.next), writes(free.len) contract {
  requires free^.len < free^.cap;
  ensures free^.len == entry(free)^.len + 1_u64;
} {
  doc "One block back onto the append slot, under the caller's proof that the free list has room.";
  place_back(window: free, value: move block);
  return unit;
}

fn pool_take(pool: BlockPool) -> (rest: BlockPool, leased: Option<Lease>) pure {
  doc "Leases one run, or reports that the free list is empty. The pool arrives by value, so the row is empty and the reference the body forms is rooted in local storage [EFF-1, EFF-2].";
  let spare = pool.free.len;
  let any = spare > 0_u64;
  if any {
    let one = take_free(free: &pool.free);
    invariant removed_one_upper: pool.free.len + 1_u64 <= spare;
    invariant removed_one_lower: pool.free.len + 1_u64 >= spare;
    let ticket = Lease(run: move one);
    return move pool, Some<Lease>(value: move ticket);
  }
  return move pool, None<Lease>();
}

fn pool_release(pool: BlockPool, lease: Lease) -> rest: BlockPool pure contract {
  requires pool.free.len < pool.free.cap;
} {
  doc "Returns one lease to the free list; the caller has proved there is room. The linear lease leaves this scope only by being taken apart, which is what makes the return unavoidable [PROV-6].";
  let Lease(run: back) = move lease;
  return_free(free: &pool.free, block: move back);
  return move pool;
}

alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias write_once = std::io::write_once;

fn low_byte(v: u64) -> result: u8 pure {
  let low = iand(v, 255_u64);
  let byte = cvt::<u64, u8>(low);
  return byte;
}

fn spell(destination: &[u8], at: u64, value: u64) -> result: u64 writes(destination) {
  doc "Writes the eight little-endian bytes of value at the given offset, skipping any slot the range does not have.";
  let cursor = at;
  let rest = value;
  loop @octets {
    let limit = at +wrap 8_u64;
    let done = cursor >= limit;
    if done {
      break @octets;
    }
    let spare = destination^.len;
    let writable = cursor < spare;
    if writable {
      let byte = low_byte(v: rest);
      set destination^[cursor] = byte;
    }
    set rest = irotr(rest, 8_u32);
    set cursor = cursor +wrap 1_u64;
  }
  return at +wrap 8_u64;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  doc "Publishes one prefix of the source range, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let wait_cancel_1 = std::time::cancel_never();
    let wait_outcome_1 = write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &wait_cancel_1);
    std::time::close_cancel_watch(watch: move wait_cancel_1);
    match wait_outcome_1 {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn publish_report(factory: &HandleFactory, output: &OutputStream, source: &[u8]) -> status: ExitStatus reads(source), writes(factory), writes(output) waits {
  doc "Trial adaptation: publish the actual observations with the maintained stdin_echo partial-write retry; status 250 reports publication failure.";
  let length = source^.len;
  match publish_all(factory: factory, output: output, source: source, length: length) {
    Ok(value: published) => {
      return exit_status(code: 0_u8);
    }
    Err(error: problem) => {
      return exit_status(code: 250_u8);
    }
  }
}

fn main(inputs: std::process::Inputs) -> status: ExitStatus pure waits {
  doc "Trial adaptation: extract only the selected eight-block lease round trip; publish actual free counts before, during and after the lease.";
  let std::process::Inputs(cwd: directory, handles: factory, stdout: out, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let report = slots_new::<u8, 24>();
  for (
    at in 0_u64..24_u64,
    invariant grown: report.len == at
  ) {
    place_back(window: &report, value: 0_u8);
  }
  let report_window = &report[0_u64..24_u64];
  let pool = pool_new();
  let held = pool.free.len;
  let recorded_0 = spell(destination: report_window, at: 0_u64, value: held);
  if held == 8_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  let (rest, leased) = pool_take(pool: move pool);
  match move leased {
    None() => {
      return exit_status(code: 3_u8);
    }
    Some(value: ticket) => {
      let spare = rest.free.len;
      let recorded_8 = spell(destination: report_window, at: 8_u64, value: spare);
      let fits = spare < 8_u64;
      if fits {
        let back = pool_release(pool: move rest, lease: move ticket);
        let full = back.free.len;
        let recorded_16 = spell(destination: report_window, at: 16_u64, value: full);
        if full == 8_u64 {
        } else {
          return exit_status(code: 4_u8);
        }
      } else {
        let Lease(run: orphan) = move ticket;
        return exit_status(code: 5_u8);
      }
    }
  }
  return publish_report(factory: &factory, output: &out, source: report_window);
}

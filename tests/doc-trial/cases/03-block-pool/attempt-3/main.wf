alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;

nocopy struct Block {
  bytes: Array<u8, 256>;
}

nodrop struct Lease {
  block: Block;
}

struct Pool {
  available: Slots<Block, 8>;
}

nodrop enum Taken {
  Leased(lease: Lease, pool: Pool);
  Exhausted(pool: Pool);
}

nodrop enum Returned {
  Restored(pool: Pool);
  Full(pool: Pool, lease: Lease);
}

enum Cycle {
  Failed(code: u8);
  Counted(initial_free: u64, leased_free: u64, final_free: u64);
}

fn new_pool() -> result: Pool pure {
  let available = slots_new::<Block, 8>();
  for (
    index in 0_u64..8_u64,
    invariant filled_prefix: available.len == index
  ) {
    let bytes = array_filled::<u8, 256>(value: 0_u8);
    let fresh = Block(bytes: bytes);
    place_back(window: &available, value: move fresh);
  }
  return Pool(available: move available);
}

fn free_count(pool: &Pool) -> count: u64 reads(pool) {
  return pool^.available.len;
}

fn take_block(pool: Pool) -> result: Taken pure {
  let Pool(available: available_slots) = move pool;
  if available_slots.len > 0_u64 {
    let spent_block = take_back(window: &available_slots);
    let leased = Lease(block: move spent_block);
    let remaining = Pool(available: move available_slots);
    return Taken::Leased(lease: move leased, pool: move remaining);
  }
  let empty = Pool(available: move available_slots);
  return Taken::Exhausted(pool: move empty);
}

fn give_back(pool: Pool, lease: Lease) -> result: Returned pure {
  let Pool(available: available_slots) = move pool;
  if available_slots.len < available_slots.cap {
    let Lease(block: spent_block) = move lease;
    place_back(window: &available_slots, value: move spent_block);
    let restored = Pool(available: move available_slots);
    return Returned::Restored(pool: move restored);
  }
  let rejected = Pool(available: move available_slots);
  return Returned::Full(pool: move rejected, lease: move lease);
}

fn consume_lease(lease: Lease) -> result: unit pure {
  let Lease(block: unused_block) = move lease;
  return unit;
}

fn cycle(pool: Pool) -> result: Cycle pure {
  let initial = free_count(pool: &pool);
  if initial != 8_u64 {
    return Cycle::Failed(code: 2_u8);
  }
  let taken = take_block(pool: move pool);
  match move taken {
    Leased(lease: leased, pool: remaining) => {
      let leased_count = free_count(pool: &remaining);
      let returned = give_back(pool: move remaining, lease: move leased);
      match move returned {
        Restored(pool: restored) => {
          let last = free_count(pool: &restored);
          if last != 8_u64 {
            return Cycle::Failed(code: 4_u8);
          }
          return Cycle::Counted(initial_free: initial, leased_free: leased_count, final_free: last);
        }
        Full(pool: unused_rejected, lease: stuck) => {
          consume_lease(lease: move stuck);
          return Cycle::Failed(code: 5_u8);
        }
      }
    }
    Exhausted(pool: unused_remaining) => {
      return Cycle::Failed(code: 3_u8);
    }
  }
}

fn le_bytes(value: u64) -> result: Array<u8, 8> pure {
  let out = array_filled::<u8, 8>(value: 0_u8);
  let rest = value;
  for (position in 0_u64..8_u64) {
    set out[position] = cvt.wrap::<u64, u8>(rest);
    set rest = ishr(rest, 8_u32);
  }
  return out;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn publish_counts(factory: &HandleFactory, output: &OutputStream, initial_free: u64, leased_free: u64, final_free: u64) -> result: Result<unit, IoError> writes(factory), writes(output) waits {
  let initial_bytes = le_bytes(value: initial_free);
  let initial_view = &initial_bytes[0_u64..8_u64];
  let initial_length = initial_view^.len;
  let initial_sent = publish_all(factory: factory, output: output, source: initial_view, length: initial_length);
  match initial_sent {
    Ok(value: unused_initial) => {
    }
    Err(error: initial_problem) => {
      return Err<unit, IoError>(error: initial_problem);
    }
  }
  let leased_bytes = le_bytes(value: leased_free);
  let leased_view = &leased_bytes[0_u64..8_u64];
  let leased_length = leased_view^.len;
  let leased_sent = publish_all(factory: factory, output: output, source: leased_view, length: leased_length);
  match leased_sent {
    Ok(value: unused_leased) => {
    }
    Err(error: leased_problem) => {
      return Err<unit, IoError>(error: leased_problem);
    }
  }
  let final_bytes = le_bytes(value: final_free);
  let final_view = &final_bytes[0_u64..8_u64];
  let final_length = final_view^.len;
  let final_sent = publish_all(factory: factory, output: output, source: final_view, length: final_length);
  match final_sent {
    Ok(value: unused_final) => {
    }
    Err(error: final_problem) => {
      return Err<unit, IoError>(error: final_problem);
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: cwd_directory, stdout: stdout_stream, handles: factory, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let pool = new_pool();
  let outcome = cycle(pool: move pool);
  match outcome {
    Failed(code: failure) => {
      return exit_status(code: failure);
    }
    Counted(initial_free: initial_count, leased_free: leased_count, final_free: final_count) => {
      let published = publish_counts(factory: &factory, output: &stdout_stream, initial_free: initial_count, leased_free: leased_count, final_free: final_count);
      match published {
        Ok(value: unused_published) => {
          return exit_status(code: 0_u8);
        }
        Err(error: unused_publish_error) => {
          return exit_status(code: 250_u8);
        }
      }
    }
  }
}

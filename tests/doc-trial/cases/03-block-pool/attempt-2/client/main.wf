alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;

nodrop struct BlockLease {
  block_id: u64;
}

struct BlockPool {
  free_slots: Slots<u64, 8>;
}

fn make_pool() -> pool: BlockPool pure {
  let free_slots = slots_new::<u64, 8>();
  for (i in 0_u64..8_u64) {
    place_back(window: &free_slots, value: i);
  }
  return BlockPool(free_slots: move free_slots);
}

fn get_free_count(pool: &BlockPool) -> count: u64 reads(pool) {
  return pool^.free_slots.len;
}

fn take_block(pool: &BlockPool) -> result: Result<BlockLease, unit> writes(pool) {
  if pool^.free_slots.len > 0_u64 {
    let block_id = take_back(window: &pool^.free_slots);
    return Ok<BlockLease, unit>(value: BlockLease(block_id: block_id));
  } else {
    return Err<BlockLease, unit>(error: unit);
  }
}

fn return_block(pool: &BlockPool, lease: BlockLease) -> result: Result<unit, unit> writes(pool) {
  let BlockLease(block_id: id) = move lease;
  if pool^.free_slots.len < 8_u64 {
    place_back(window: &pool^.free_slots, value: id);
    return Ok<unit, unit>(value: unit);
  } else {
    return Err<unit, unit>(error: unit);
  }
}

fn u64_to_le_bytes(value: u64, destination: &[u8], offset: u64) -> result: unit writes(destination) contract {
  requires offset + 8_u64 <= destination^.len;
} {
  let b0 = cvt::<u64, u8>(iand(value, 255_u64));
  set destination^[offset] = b0;
  let b1 = cvt::<u64, u8>(iand(ishr(value, 8_u32), 255_u64));
  set destination^[offset + 1_u64] = b1;
  let b2 = cvt::<u64, u8>(iand(ishr(value, 16_u32), 255_u64));
  set destination^[offset + 2_u64] = b2;
  let b3 = cvt::<u64, u8>(iand(ishr(value, 24_u32), 255_u64));
  set destination^[offset + 3_u64] = b3;
  let b4 = cvt::<u64, u8>(iand(ishr(value, 32_u32), 255_u64));
  set destination^[offset + 4_u64] = b4;
  let b5 = cvt::<u64, u8>(iand(ishr(value, 40_u32), 255_u64));
  set destination^[offset + 5_u64] = b5;
  let b6 = cvt::<u64, u8>(iand(ishr(value, 48_u32), 255_u64));
  set destination^[offset + 6_u64] = b6;
  let b7 = cvt::<u64, u8>(iand(ishr(value, 56_u32), 255_u64));
  set destination^[offset + 7_u64] = b7;
  return unit;
}

fn main() -> status: ExitStatus pure waits {
  let input = std::process::input();
  let Inputs(cwd: directory, handles: factory, stdout: output, ..) = move input;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move directory;
  let close_write_result = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let close_read_result = std::fs::close_directory(factory: &factory, directory: move cwd_read);
  match close_write_result {
    Ok(value: _) => {
    }
    Err(error: _) => {
      return exit_status(code: 250_u8);
    }
  }
  match close_read_result {
    Ok(value: _) => {
    }
    Err(error: _) => {
      return exit_status(code: 250_u8);
    }
  }
  let pool = make_pool();
  let count1 = get_free_count(pool: &pool);
  if count1 != 8_u64 {
    return exit_status(code: 2_u8);
  }
  let taken = take_block(pool: &pool);
  let lease = match taken {
    Ok(value: l) => {
      l
    }
    Err(error: _) => {
      return exit_status(code: 3_u8);
    }
  }
  let count2 = get_free_count(pool: &pool);
  let returned = return_block(pool: &pool, lease: move lease);
  match returned {
    Ok(value: _) => {
    }
    Err(error: _) => {
      return exit_status(code: 5_u8);
    }
  }
  let count3 = get_free_count(pool: &pool);
  if count3 != 8_u64 {
    return exit_status(code: 4_u8);
  }
  let buffer = array_filled::<u8, 24>(value: 0_u8);
  u64_to_le_bytes(value: count1, destination: &buffer[0_u64..24_u64], offset: 0_u64);
  u64_to_le_bytes(value: count2, destination: &buffer[0_u64..24_u64], offset: 8_u64);
  u64_to_le_bytes(value: count3, destination: &buffer[0_u64..24_u64], offset: 16_u64);
  let cancel_watch = std::time::cancel_never();
  let write_result = std::io::write_once(factory: &factory, output: &output, source: &buffer[0_u64..24_u64], start: 0_u64, end: 24_u64, deadline: None<std::time::Instant>(), cancel: &cancel_watch);
  let close_cancel = std::time::close_cancel_watch(watch: move cancel_watch);
  match write_result {
    Ok(value: written) => {
      if written == 24_u64 {
        return exit_status(code: 0_u8);
      } else {
        return exit_status(code: 250_u8);
      }
    }
    Err(error: _) => {
      return exit_status(code: 250_u8);
    }
  }
}

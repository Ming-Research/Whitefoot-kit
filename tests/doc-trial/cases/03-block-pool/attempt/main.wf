alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;

fn encode_u64(buffer: &[u8], pos: u64, val: u64) -> result: unit writes(buffer) {
  let b0 = cvt.wrap::<u64, u8>(iand(val, 0xFF_u64));
  set buffer^[pos] = b0;
  let shift1 = ishr(val, 8_u32);
  let b1 = cvt.wrap::<u64, u8>(iand(shift1, 0xFF_u64));
  let pos1 = pos +wrap 1_u64;
  set buffer^[pos1] = b1;
  let shift2 = ishr(val, 16_u32);
  let b2 = cvt.wrap::<u64, u8>(iand(shift2, 0xFF_u64));
  let pos2 = pos +wrap 2_u64;
  set buffer^[pos2] = b2;
  let shift3 = ishr(val, 24_u32);
  let b3 = cvt.wrap::<u64, u8>(iand(shift3, 0xFF_u64));
  let pos3 = pos +wrap 3_u64;
  set buffer^[pos3] = b3;
  let shift4 = ishr(val, 32_u32);
  let b4 = cvt.wrap::<u64, u8>(iand(shift4, 0xFF_u64));
  let pos4 = pos +wrap 4_u64;
  set buffer^[pos4] = b4;
  let shift5 = ishr(val, 40_u32);
  let b5 = cvt.wrap::<u64, u8>(iand(shift5, 0xFF_u64));
  let pos5 = pos +wrap 5_u64;
  set buffer^[pos5] = b5;
  let shift6 = ishr(val, 48_u32);
  let b6 = cvt.wrap::<u64, u8>(iand(shift6, 0xFF_u64));
  let pos6 = pos +wrap 6_u64;
  set buffer^[pos6] = b6;
  let shift7 = ishr(val, 56_u32);
  let b7 = cvt.wrap::<u64, u8>(iand(shift7, 0xFF_u64));
  let pos7 = pos +wrap 7_u64;
  set buffer^[pos7] = b7;
  return unit;
}

fn main(inputs: Inputs) -> code: ExitStatus pure waits {
  let Inputs(cwd: directory, handles: factory, stdout: output, ..) = move inputs;
  let std::fs::Directory(read: read_dir, write: write_dir) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move write_dir);
  std::fs::close_directory(factory: &factory, directory: move read_dir);

  let pool = box_slots_new::<u64>(capacity: 8_u64);
  for (i in 0_u64..8_u64) {
    place_back(window: &pool.inner, value: 256_u64);
  }

  let count1 = pool.inner.len;
  let item = take_back(window: &pool.inner);
  let count2 = pool.inner.len;
  place_back(window: &pool.inner, value: move item);
  let count3 = pool.inner.len;

  let data = array_filled::<u8, 24>(value: 0_u8);
  encode_u64(buffer: &data, pos: 0_u64, val: count1);
  encode_u64(buffer: &data, pos: 8_u64, val: count2);
  encode_u64(buffer: &data, pos: 16_u64, val: count3);

  let never = std::time::cancel_never();
  let deadline = None<std::time::Instant>();
  let outcome = std::io::write_once(factory: &factory, output: &output, source: &data[0_u64..24_u64], start: 0_u64, end: 24_u64, deadline: deadline, cancel: &never);
  std::time::close_cancel_watch(watch: move never);

  let status_code = if count1 == 8_u64 {
    if count2 == 7_u64 {
      if count3 == 8_u64 {
        match outcome {
          Ok(value: wrote) => {
            if wrote == 24_u64 {
              0_u8
            } else {
              250_u8
            }
          }
          Err(error: err) => {
            250_u8
          }
        }
      } else {
        4_u8
      }
    } else {
      3_u8
    }
  } else {
    2_u8
  };

  return exit_status(code: status_code);
}

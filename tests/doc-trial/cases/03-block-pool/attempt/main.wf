alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias Inputs = std::process::Inputs;
alias Instant = std::time::Instant;
alias CancelWatch = std::time::CancelWatch;
alias IoError = std::io::IoError;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias Directory = std::fs::Directory;

struct BlockPool {
  free_blocks: Slots<u64, 8>;
}

fn create_pool() -> result: BlockPool pure {
  let free_blocks = slots_new::<u64, 8>();
  for (i in 0_u64..8_u64) {
    place_back(window: &free_blocks, value: i);
  }
  return BlockPool(free_blocks: move free_blocks);
}

fn get_free_count(pool: &BlockPool) -> result: u64 reads(pool) {
  return pool.free_blocks.len;
}

fn take_lease(pool: &BlockPool) -> result: Result<u64, unit> writes(pool) {
  if pool.free_blocks.len > 0_u64 {
    let block_id = take_back(window: &pool.free_blocks);
    return Ok<u64, unit>(value: block_id);
  }
  return Err<u64, unit>(error: unit);
}

fn return_lease(pool: &BlockPool, block_id: u64) -> result: Result<unit, unit> writes(pool) {
  if pool.free_blocks.len < pool.free_blocks.cap {
    place_back(window: &pool.free_blocks, value: block_id);
    return Ok<unit, unit>(value: unit);
  }
  return Err<unit, unit>(error: unit);
}

fn write_u64_le(factory: &HandleFactory, output: &OutputStream, value: u64) -> result: Result<unit, IoError> writes(factory), writes(output) waits {
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  let byte0 = cvt.wrap::<u64, u8>(value);
  set bytes[0_u64] = byte0;
  let byte1 = cvt.wrap::<u64, u8>(ishr(value, 8_u32));
  set bytes[1_u64] = byte1;
  let byte2 = cvt.wrap::<u64, u8>(ishr(value, 16_u32));
  set bytes[2_u64] = byte2;
  let byte3 = cvt.wrap::<u64, u8>(ishr(value, 24_u32));
  set bytes[3_u64] = byte3;
  let byte4 = cvt.wrap::<u64, u8>(ishr(value, 32_u32));
  set bytes[4_u64] = byte4;
  let byte5 = cvt.wrap::<u64, u8>(ishr(value, 40_u32));
  set bytes[5_u64] = byte5;
  let byte6 = cvt.wrap::<u64, u8>(ishr(value, 48_u32));
  set bytes[6_u64] = byte6;
  let byte7 = cvt.wrap::<u64, u8>(ishr(value, 56_u32));
  set bytes[7_u64] = byte7;
  let view = &bytes[0_u64..8_u64];
  let no_deadline = None<Instant>();
  let cancel = std::time::cancel_never();
  let result = std::io::write_once(factory: factory, output: output, source: view, start: 0_u64, end: 8_u64, deadline: no_deadline, cancel: &cancel);
  std::time::close_cancel_watch(watch: move cancel);
  match result {
    Ok(value: next) => {
      if next == 8_u64 {
        return Ok<unit, IoError>(value: unit);
      }
      let error = IoError::WriteZero(code: 0_u32, origin: 0_u8);
      return Err<unit, IoError>(error: error);
    }
    Err(error: problem) => {
      return Err<unit, IoError>(error: problem);
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_dir, stdout: stdout, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_dir;
  let write_closed = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let read_closed = std::fs::close_directory(factory: &factory, directory: move cwd_read);
  match write_closed {
    Ok(value: unused_write_closed) => {
    }
    Err(error: unused_write_error) => {
    }
  }
  match read_closed {
    Ok(value: unused_read_closed) => {
    }
    Err(error: unused_read_error) => {
    }
  }
  let pool = create_pool();
  let initial_free = get_free_count(pool: &pool);
  if initial_free != 8_u64 {
    return exit_status(code: 2_u8);
  }
  let take_result = take_lease(pool: &pool);
  let block_id = match take_result {
    Ok(value: bid) => {
      give bid;
    }
    Err(error: unused_error) => {
      return exit_status(code: 3_u8);
    }
  };
  let held_free = get_free_count(pool: &pool);
  let return_result = return_lease(pool: &pool, block_id: block_id);
  match return_result {
    Ok(value: unused_ok) => {
    }
    Err(error: unused_err) => {
      return exit_status(code: 5_u8);
    }
  }
  let final_free = get_free_count(pool: &pool);
  if final_free != 8_u64 {
    return exit_status(code: 4_u8);
  }
  let write1 = write_u64_le(factory: &factory, output: &stdout, value: initial_free);
  match write1 {
    Ok(value: unused_ok) => {
    }
    Err(error: unused_err) => {
      return exit_status(code: 250_u8);
    }
  }
  let write2 = write_u64_le(factory: &factory, output: &stdout, value: held_free);
  match write2 {
    Ok(value: unused_ok) => {
    }
    Err(error: unused_err) => {
      return exit_status(code: 250_u8);
    }
  }
  let write3 = write_u64_le(factory: &factory, output: &stdout, value: final_free);
  match write3 {
    Ok(value: unused_ok) => {
    }
    Err(error: unused_err) => {
      return exit_status(code: 250_u8);
    }
  }
  return exit_status(code: 0_u8);
}

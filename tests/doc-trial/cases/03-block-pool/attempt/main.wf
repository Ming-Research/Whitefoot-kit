alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias HandleFactory = std::io::HandleFactory;
alias IoError = std::io::IoError;
alias OutputStream = std::io::OutputStream;
alias Instant = std::time::Instant;

struct Block {
  bytes: Array<u8, 256>;
}

nodrop struct Lease {
  block: Block;
}

enum Taken {
  Leased(pool: Slots<Block, 8>, lease: Lease);
  Exhausted(pool: Slots<Block, 8>);
}

enum Cycle {
  Done(first: u64, second: u64, third: u64);
  Failed(code: u8);
}

fn full_pool() -> result: Slots<Block, 8> pure {
  let pool = slots_new::<Block, 8>();
  for (
    k in 0_u64..8_u64,
    invariant pool_filled: pool.len == k
  ) {
    let bytes = array_filled::<u8, 256>(value: 0_u8);
    let block = Block(bytes: bytes);
    place_back(window: &pool, value: block);
  }
  return move pool;
}

fn le_byte(value: u64, shift: u32) -> result: u8 pure {
  let moved = ishr.wrap(value, shift);
  return cvt.wrap::<u64, u8>(moved);
}

fn take_block(pool: Slots<Block, 8>) -> result: Taken pure {
  let window = move pool;
  if window.len > 0_u64 {
    let block = take_back(window: &window);
    let lease = Lease(block: block);
    return Taken::Leased(pool: move window, lease: move lease);
  }
  return Taken::Exhausted(pool: move window);
}

fn consume_lease(lease: Lease) -> result: unit pure {
  let Lease(block: unused_block) = move lease;
  return unit;
}

fn cycle(pool: Slots<Block, 8>) -> result: Cycle pure {
  let initial = pool.len;
  if initial != 8_u64 {
    return Cycle::Failed(code: 2_u8);
  }
  let taken = take_block(pool: move pool);
  match move taken {
    Exhausted(pool: empty) => {
      return Cycle::Failed(code: 3_u8);
    }
    Leased(pool: remaining, lease: leased) => {
      let held_count = remaining.len;
      if held_count != 7_u64 {
        consume_lease(lease: move leased);
        return Cycle::Failed(code: 4_u8);
      }
      if remaining.len < remaining.cap {
        let Lease(block: returned) = move leased;
        place_back(window: &remaining, value: returned);
        let final_count = remaining.len;
        if final_count != 8_u64 {
          return Cycle::Failed(code: 4_u8);
        }
        return Cycle::Done(first: initial, second: held_count, third: final_count);
      }
      consume_lease(lease: move leased);
      return Cycle::Failed(code: 5_u8);
    }
  }
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: output_stream, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  std::fs::close_directory(factory: &factory, directory: move cwd_read);
  let pool = full_pool();
  let outcome = cycle(pool: move pool);
  match outcome {
    Failed(code: failure) => {
      return std::process::exit_status(code: failure);
    }
    Done(first: first_count, second: held_count, third: final_count) => {
      let out = array_filled::<u8, 24>(value: 0_u8);
      set out[0_u64] = le_byte(value: first_count, shift: 0_u32);
      set out[1_u64] = le_byte(value: first_count, shift: 8_u32);
      set out[2_u64] = le_byte(value: first_count, shift: 16_u32);
      set out[3_u64] = le_byte(value: first_count, shift: 24_u32);
      set out[4_u64] = le_byte(value: first_count, shift: 32_u32);
      set out[5_u64] = le_byte(value: first_count, shift: 40_u32);
      set out[6_u64] = le_byte(value: first_count, shift: 48_u32);
      set out[7_u64] = le_byte(value: first_count, shift: 56_u32);
      set out[8_u64] = le_byte(value: held_count, shift: 0_u32);
      set out[9_u64] = le_byte(value: held_count, shift: 8_u32);
      set out[10_u64] = le_byte(value: held_count, shift: 16_u32);
      set out[11_u64] = le_byte(value: held_count, shift: 24_u32);
      set out[12_u64] = le_byte(value: held_count, shift: 32_u32);
      set out[13_u64] = le_byte(value: held_count, shift: 40_u32);
      set out[14_u64] = le_byte(value: held_count, shift: 48_u32);
      set out[15_u64] = le_byte(value: held_count, shift: 56_u32);
      set out[16_u64] = le_byte(value: final_count, shift: 0_u32);
      set out[17_u64] = le_byte(value: final_count, shift: 8_u32);
      set out[18_u64] = le_byte(value: final_count, shift: 16_u32);
      set out[19_u64] = le_byte(value: final_count, shift: 24_u32);
      set out[20_u64] = le_byte(value: final_count, shift: 32_u32);
      set out[21_u64] = le_byte(value: final_count, shift: 40_u32);
      set out[22_u64] = le_byte(value: final_count, shift: 48_u32);
      set out[23_u64] = le_byte(value: final_count, shift: 56_u32);
      let view = &out[0_u64..24_u64];
      let published = publish_all(factory: &factory, output: &output_stream, source: view, length: 24_u64);
      match published {
        Ok(value: written) => {
          return std::process::exit_status(code: 0_u8);
        }
        Err(error: problem) => {
          return std::process::exit_status(code: 250_u8);
        }
      }
    }
  }
}

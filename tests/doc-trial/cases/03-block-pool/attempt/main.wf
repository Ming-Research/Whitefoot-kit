alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias Instant = std::time::Instant;
alias CancelWatch = std::time::CancelWatch;

struct Block {
  data: Array<u8, 256>;
}

struct BlockPool {
  blocks: Array<Option<Block>, 8>;
  free_count: u64;
}

enum TakeError {
  NoFreeBlocks();
}

struct Lease {
  block: Block;
  pool: BlockPool;
}

fn block_pool_new() -> result: BlockPool pure {
  let blocks = array_filled::<Option<Block>, 8>(value: None<Block>());
  let idx0 = 0_u64;
  let block0_data = array_filled::<u8, 256>(value: 0_u8);
  let block0 = Block(data: move block0_data);
  set blocks[idx0] = Some<Block>(value: move block0);
  let idx1 = 1_u64;
  let block1_data = array_filled::<u8, 256>(value: 0_u8);
  let block1 = Block(data: move block1_data);
  set blocks[idx1] = Some<Block>(value: move block1);
  let idx2 = 2_u64;
  let block2_data = array_filled::<u8, 256>(value: 0_u8);
  let block2 = Block(data: move block2_data);
  set blocks[idx2] = Some<Block>(value: move block2);
  let idx3 = 3_u64;
  let block3_data = array_filled::<u8, 256>(value: 0_u8);
  let block3 = Block(data: move block3_data);
  set blocks[idx3] = Some<Block>(value: move block3);
  let idx4 = 4_u64;
  let block4_data = array_filled::<u8, 256>(value: 0_u8);
  let block4 = Block(data: move block4_data);
  set blocks[idx4] = Some<Block>(value: move block4);
  let idx5 = 5_u64;
  let block5_data = array_filled::<u8, 256>(value: 0_u8);
  let block5 = Block(data: move block5_data);
  set blocks[idx5] = Some<Block>(value: move block5);
  let idx6 = 6_u64;
  let block6_data = array_filled::<u8, 256>(value: 0_u8);
  let block6 = Block(data: move block6_data);
  set blocks[idx6] = Some<Block>(value: move block6);
  let idx7 = 7_u64;
  let block7_data = array_filled::<u8, 256>(value: 0_u8);
  let block7 = Block(data: move block7_data);
  set blocks[idx7] = Some<Block>(value: move block7);
  return BlockPool(blocks: move blocks, free_count: 8_u64);
}

fn pool_take(pool: BlockPool) -> result: Result<Lease, TakeError> pure {
  let found = False();
  let taken_index = 0_u64;
  let idx = 0_u64;
  loop {
    if idx == 8_u64 {
      break;
    }
    match &pool.blocks[idx] {
      Some(value: unused_block) => {
        if bnot(found) {
          set found = True();
          set taken_index = idx;
        }
      }
      None() => {
      }
    }
    set idx = idx + 1_u64;
  }
  if found {
    let none_option = None<Block>();
    swap(first: &pool.blocks[taken_index], second: &none_option);
    match move none_option {
      Some(value: block) => {
        let next_free = pool.free_count - 1_u64;
        set pool.free_count = next_free;
        let lease = Lease(block: move block, pool: move pool);
        return Ok<Lease, TakeError>(value: move lease);
      }
      None() => {
        return Err<Lease, TakeError>(error: TakeError::NoFreeBlocks());
      }
    }
  }
  let error = TakeError::NoFreeBlocks();
  return Err<Lease, TakeError>(error: move error);
}

enum ReturnError {
  NoRoom();
}

fn lease_return(lease: Lease) -> result: Result<BlockPool, ReturnError> pure {
  let block = move lease.block;
  let pool = move lease.pool;
  let found = False();
  let return_index = 0_u64;
  let idx = 0_u64;
  loop {
    if idx == 8_u64 {
      break;
    }
    match &pool.blocks[idx] {
      Some(value: unused_block) => {
      }
      None() => {
        if bnot(found) {
          set found = True();
          set return_index = idx;
        }
      }
    }
    set idx = idx + 1_u64;
  }
  if found {
    let some_block = Some<Block>(value: move block);
    swap(first: &pool.blocks[return_index], second: &some_block);
    let next_free = pool.free_count + 1_u64;
    set pool.free_count = next_free;
    return Ok<BlockPool, ReturnError>(value: move pool);
  }
  let unused_block = move block;
  return Err<BlockPool, ReturnError>(error: ReturnError::NoRoom());
}

fn u64_to_le_bytes(value: u64, bytes: &[u8], start: u64) -> result: unit writes(bytes) contract {
  requires start + 8_u64 <= bytes^.len;
} {
  let byte0 = cvt.wrap::<u64, u8>(value);
  set bytes^[start] = byte0;
  let byte1 = cvt.wrap::<u64, u8>(ishr(value, 8_u32));
  set bytes^[start + 1_u64] = byte1;
  let byte2 = cvt.wrap::<u64, u8>(ishr(value, 16_u32));
  set bytes^[start + 2_u64] = byte2;
  let byte3 = cvt.wrap::<u64, u8>(ishr(value, 24_u32));
  set bytes^[start + 3_u64] = byte3;
  let byte4 = cvt.wrap::<u64, u8>(ishr(value, 32_u32));
  set bytes^[start + 4_u64] = byte4;
  let byte5 = cvt.wrap::<u64, u8>(ishr(value, 40_u32));
  set bytes^[start + 5_u64] = byte5;
  let byte6 = cvt.wrap::<u64, u8>(ishr(value, 48_u32));
  set bytes^[start + 6_u64] = byte6;
  let byte7 = cvt.wrap::<u64, u8>(ishr(value, 56_u32));
  set bytes^[start + 7_u64] = byte7;
  return unit;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: cwd_directory, handles: factory, stdout: output, ..) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  let write_close_result = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let read_close_result = std::fs::close_directory(factory: &factory, directory: move cwd_read);
  match move write_close_result {
    Ok(value: unused_write_ok) => {
    }
    Err(error: unused_write_error) => {
    }
  }
  match move read_close_result {
    Ok(value: unused_read_ok) => {
    }
    Err(error: unused_read_error) => {
    }
  }
  let pool = block_pool_new();
  let initial_count = pool.free_count;
  if initial_count != 8_u64 {
    return exit_status(code: 2_u8);
  }
  let take_result = pool_take(pool: move pool);
  match move take_result {
    Ok(value: lease) => {
      let held_count = lease.pool.free_count;
      let return_result = lease_return(lease: move lease);
      match move return_result {
        Ok(value: returned_pool) => {
          let final_count = returned_pool.free_count;
          if final_count != 8_u64 {
            let unused_pool = move returned_pool;
            return exit_status(code: 4_u8);
          }
          let output_buffer = array_filled::<u8, 24>(value: 0_u8);
          u64_to_le_bytes(value: initial_count, bytes: &output_buffer[0_u64..24_u64], start: 0_u64);
          u64_to_le_bytes(value: held_count, bytes: &output_buffer[0_u64..24_u64], start: 8_u64);
          u64_to_le_bytes(value: final_count, bytes: &output_buffer[0_u64..24_u64], start: 16_u64);
          let no_deadline = None<std::time::Instant>();
          let cancel = std::time::cancel_never();
          let write_result = std::io::write_once(factory: &factory, output: &output, source: &output_buffer[0_u64..24_u64], start: 0_u64, end: 24_u64, deadline: no_deadline, cancel: &cancel);
          std::time::close_cancel_watch(watch: move cancel);
          match move write_result {
            Ok(value: written) => {
              if written == 24_u64 {
                return exit_status(code: 0_u8);
              }
              return exit_status(code: 250_u8);
            }
            Err(error: unused_write_error) => {
              return exit_status(code: 250_u8);
            }
          }
        }
        Err(error: unused_return_error) => {
          return exit_status(code: 5_u8);
        }
      }
    }
    Err(error: unused_take_error) => {
      return exit_status(code: 3_u8);
    }
  }
}

alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;

nocopy struct BlockLease {
  index: u64;
}

nocopy struct BlockPool {
  free_count: u64;
}

fn create_pool() -> result: BlockPool pure {
  return BlockPool(free_count: 8_u64);
}

fn take_lease(pool: BlockPool) -> (pool: BlockPool, lease: Option<BlockLease>) pure {
  if pool.free_count > 0_u64 {
    let index = pool.free_count - 1_u64;
    let new_pool = BlockPool(free_count: index);
    let block_lease = BlockLease(index: index);
    let lease = Some<BlockLease>(value: move block_lease);
    return move new_pool, move lease;
  }
  let no_lease = None<BlockLease>();
  return move pool, move no_lease;
}

fn return_lease(pool: BlockPool, lease: BlockLease) -> (pool: BlockPool, success: Bool) pure {
  if pool.free_count < 8_u64 {
    let new_count = pool.free_count + 1_u64;
    let new_pool = BlockPool(free_count: new_count);
    return move new_pool, True();
  }
  return move pool, False();
}

fn u64_to_bytes(value: u64) -> result: Array<u8, 8> pure {
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  set bytes[0_u64] = cvt.wrap::<u64, u8>(value);
  set bytes[1_u64] = cvt.wrap::<u64, u8>(ishr(value, 8_u32));
  set bytes[2_u64] = cvt.wrap::<u64, u8>(ishr(value, 16_u32));
  set bytes[3_u64] = cvt.wrap::<u64, u8>(ishr(value, 24_u32));
  set bytes[4_u64] = cvt.wrap::<u64, u8>(ishr(value, 32_u32));
  set bytes[5_u64] = cvt.wrap::<u64, u8>(ishr(value, 40_u32));
  set bytes[6_u64] = cvt.wrap::<u64, u8>(ishr(value, 48_u32));
  set bytes[7_u64] = cvt.wrap::<u64, u8>(ishr(value, 56_u32));
  return move bytes;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: cwd_directory, handles: factory, stdout: output, ..) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  std::fs::close_directory(factory: &factory, directory: move cwd_read);

  let pool = create_pool();

  let initial_count = pool.free_count;
  if initial_count != 8_u64 {
    return exit_status(code: 2_u8);
  }

  let taken = take_lease(pool: move pool);
  let pool = taken.0;
  let lease = taken.1;

  let mid_count = pool.free_count;
  if mid_count != 7_u64 {
    return exit_status(code: 3_u8);
  }

  let final_result = match move lease {
    Some(value: l) => {
      return_lease(pool: move pool, lease: move l)
    }
    None() => {
      return exit_status(code: 3_u8);
    }
  };

  let pool = final_result.0;
  let success = final_result.1;

  let final_count = pool.free_count;
  if final_count != 8_u64 {
    return exit_status(code: 4_u8);
  }

  if bnot(success) {
    return exit_status(code: 5_u8);
  }

  let bytes1 = u64_to_bytes(value: initial_count);
  let bytes2 = u64_to_bytes(value: mid_count);
  let bytes3 = u64_to_bytes(value: final_count);

  let output_buffer = array_filled::<u8, 24>(value: 0_u8);
  for (i in 0_u64..8_u64) {
    set output_buffer[i] = bytes1[i];
    set output_buffer[i + 8_u64] = bytes2[i];
    set output_buffer[i + 16_u64] = bytes3[i];
  }

  let output_view = &output_buffer[0_u64..24_u64];
  let no_deadline = None<std::time::Instant>();
  let cancel = std::time::cancel_never();
  let write_outcome = std::io::write_once(factory: &factory, output: &output, source: output_view, start: 0_u64, end: 24_u64, deadline: no_deadline, cancel: &cancel);
  std::time::close_cancel_watch(watch: move cancel);

  match write_outcome {
    Ok(value: written) => {
      if written == 24_u64 {
        return exit_status(code: 0_u8);
      }
      return exit_status(code: 250_u8);
    }
    Err(error: problem) => {
      return exit_status(code: 250_u8);
    }
  }
}

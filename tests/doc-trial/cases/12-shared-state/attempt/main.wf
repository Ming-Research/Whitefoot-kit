alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;

fn increment_counter(counter: Shared<u64>) -> result: unit pure waits {
  let i = 0_u64;
  loop {
    if i < 20000_u64 {
    } else {
      break;
    }
    atomic count = &counter {
      set count^ = count^ +wrap 1_u64;
    }
    set i = i + 1_u64;
  }
  return unit;
}

fn produce_values(queue: Shared<Ring<u64, 8>>) -> result: unit pure waits {
  let value = 0_u64;
  loop {
    if value < 5000_u64 {
    } else {
      break;
    }
    atomic items = &queue when items^.len < items^.cap {
      place_back(window: items, value: value);
    }
    set value = value + 1_u64;
  }
  return unit;
}

fn consume_values(queue: Shared<Ring<u64, 8>>, total: Shared<u64>) -> result: unit pure waits {
  let i = 0_u64;
  loop {
    if i < 5000_u64 {
    } else {
      break;
    }
    atomic items = &queue, sum = &total when items^.len > 0_u64 {
      let popped = take_front(window: items);
      set sum^ = sum^ +wrap popped;
    }
    set i = i + 1_u64;
  }
  return unit;
}

fn u64_to_little_endian(value: u64) -> result: Array<u8, 8> pure {
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  let byte0 = cvt.wrap::<u64, u8>(value);
  set bytes[0_u64] = byte0;
  let shift1 = ishr(value, 8_u32);
  let byte1 = cvt.wrap::<u64, u8>(shift1);
  set bytes[1_u64] = byte1;
  let shift2 = ishr(value, 16_u32);
  let byte2 = cvt.wrap::<u64, u8>(shift2);
  set bytes[2_u64] = byte2;
  let shift3 = ishr(value, 24_u32);
  let byte3 = cvt.wrap::<u64, u8>(shift3);
  set bytes[3_u64] = byte3;
  let shift4 = ishr(value, 32_u32);
  let byte4 = cvt.wrap::<u64, u8>(shift4);
  set bytes[4_u64] = byte4;
  let shift5 = ishr(value, 40_u32);
  let byte5 = cvt.wrap::<u64, u8>(shift5);
  set bytes[5_u64] = byte5;
  let shift6 = ishr(value, 48_u32);
  let byte6 = cvt.wrap::<u64, u8>(shift6);
  set bytes[6_u64] = byte6;
  let shift7 = ishr(value, 56_u32);
  let byte7 = cvt.wrap::<u64, u8>(shift7);
  set bytes[7_u64] = byte7;
  return bytes;
}

fn write_all(factory: &HandleFactory, output: &OutputStream, source: &[u8]) -> result: Result<unit, std::io::IoError> reads(source), writes(factory), writes(output) waits {
  let sent = 0_u64;
  let length = source^.len;
  loop @sending {
    if sent < length {
    } else {
      break @sending;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, std::io::IoError>(error: problem);
      }
    }
  }
  return Ok<unit, std::io::IoError>(value: unit);
}

fn launch_incrementers(counter: &Shared<u64>) -> result: unit reads(counter) waits {
  for (i in 0_u64..16_u64) {
    let h = shared_share::<u64>(shared: counter);
    spawn increment_counter(counter: move h);
  }
  return unit;
}

fn launch_producers(queue: &Shared<Ring<u64, 8>>) -> result: unit reads(queue) waits {
  for (i in 0_u64..4_u64) {
    let h = shared_share::<Ring<u64, 8>>(shared: queue);
    spawn produce_values(queue: move h);
  }
  return unit;
}

fn launch_consumers(queue: &Shared<Ring<u64, 8>>, total: &Shared<u64>) -> result: unit reads(queue), reads(total) waits {
  for (i in 0_u64..4_u64) {
    let q = shared_share::<Ring<u64, 8>>(shared: queue);
    let t = shared_share::<u64>(shared: total);
    spawn consume_values(queue: move q, total: move t);
  }
  return unit;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd, stdout: stdout, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: directory, write: writable) = move cwd;
  std::fs::close_directory_write(factory: &factory, directory: move writable);
  std::fs::close_directory(factory: &factory, directory: move directory);
  let counter = shared_new::<u64>(value: 0_u64);
  let initial_ring = ring_new::<u64, 8>();
  let queue = shared_new::<Ring<u64, 8>>(value: move initial_ring);
  let total = shared_new::<u64>(value: 0_u64);
  launch_incrementers(counter: &counter);
  launch_producers(queue: &queue);
  launch_consumers(queue: &queue, total: &total);
  let final_counter = 0_u64;
  atomic count = &counter {
    set final_counter = count^;
  }
  let final_total = 0_u64;
  atomic sum = &total {
    set final_total = sum^;
  }
  let final_queue_len = 0_u64;
  atomic items = &queue {
    set final_queue_len = items^.len;
  }
  if final_counter != 320000_u64 {
    return exit_status(code: 1_u8);
  }
  if final_total != 49990000_u64 {
    return exit_status(code: 2_u8);
  }
  if final_queue_len != 0_u64 {
    return exit_status(code: 3_u8);
  }
  let counter_bytes = u64_to_little_endian(value: final_counter);
  let total_bytes = u64_to_little_endian(value: final_total);
  let queue_len_bytes = u64_to_little_endian(value: final_queue_len);
  let output = array_filled::<u8, 24>(value: 0_u8);
  set output[0_u64] = counter_bytes[0_u64];
  set output[1_u64] = counter_bytes[1_u64];
  set output[2_u64] = counter_bytes[2_u64];
  set output[3_u64] = counter_bytes[3_u64];
  set output[4_u64] = counter_bytes[4_u64];
  set output[5_u64] = counter_bytes[5_u64];
  set output[6_u64] = counter_bytes[6_u64];
  set output[7_u64] = counter_bytes[7_u64];
  set output[8_u64] = total_bytes[0_u64];
  set output[9_u64] = total_bytes[1_u64];
  set output[10_u64] = total_bytes[2_u64];
  set output[11_u64] = total_bytes[3_u64];
  set output[12_u64] = total_bytes[4_u64];
  set output[13_u64] = total_bytes[5_u64];
  set output[14_u64] = total_bytes[6_u64];
  set output[15_u64] = total_bytes[7_u64];
  set output[16_u64] = queue_len_bytes[0_u64];
  set output[17_u64] = queue_len_bytes[1_u64];
  set output[18_u64] = queue_len_bytes[2_u64];
  set output[19_u64] = queue_len_bytes[3_u64];
  set output[20_u64] = queue_len_bytes[4_u64];
  set output[21_u64] = queue_len_bytes[5_u64];
  set output[22_u64] = queue_len_bytes[6_u64];
  set output[23_u64] = queue_len_bytes[7_u64];
  let output_slice = &output[0_u64..24_u64];
  let write_result = write_all(factory: &factory, output: &stdout, source: output_slice);
  match write_result {
    Ok(value: unused_ok) => {
      return exit_status(code: 0_u8);
    }
    Err(error: unused_error) => {
      return exit_status(code: 4_u8);
    }
  }
}

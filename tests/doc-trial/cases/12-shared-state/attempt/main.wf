alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias Instant = std::time::Instant;
alias CancelWatch = std::time::CancelWatch;

fn increment_counter(counter: Shared<u64>) -> result: unit pure waits {
  for (i in 0_u64..20000_u64) {
    atomic count = &counter {
      set count^ = count^ +wrap 1_u64;
    }
  }
  return unit;
}

fn produce(queue: Shared<Ring<u64, 8>>) -> result: unit pure waits {
  for (i in 0_u64..5000_u64) {
    atomic items = &queue when items^.len < 8_u64 {
      place_back(window: items, value: i);
    }
  }
  return unit;
}

fn consume(queue: Shared<Ring<u64, 8>>, total: Shared<u64>) -> result: unit pure waits {
  for (i in 0_u64..5000_u64) {
    let item = 0_u64;
    atomic items = &queue, sum = &total when items^.len > 0_u64 {
      set item = take_front(window: items);
      set sum^ = sum^ +wrap item;
    }
  }
  return unit;
}

fn encode_u64_le(value: u64) -> result: Array<u8, 8> pure {
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  let masked0 = iand(value, 255_u64);
  let b0 = cvt.wrap::<u64, u8>(masked0);
  let shifted1 = ishr(value, 8_u32);
  let masked1 = iand(shifted1, 255_u64);
  let b1 = cvt.wrap::<u64, u8>(masked1);
  let shifted2 = ishr(value, 16_u32);
  let masked2 = iand(shifted2, 255_u64);
  let b2 = cvt.wrap::<u64, u8>(masked2);
  let shifted3 = ishr(value, 24_u32);
  let masked3 = iand(shifted3, 255_u64);
  let b3 = cvt.wrap::<u64, u8>(masked3);
  let shifted4 = ishr(value, 32_u32);
  let masked4 = iand(shifted4, 255_u64);
  let b4 = cvt.wrap::<u64, u8>(masked4);
  let shifted5 = ishr(value, 40_u32);
  let masked5 = iand(shifted5, 255_u64);
  let b5 = cvt.wrap::<u64, u8>(masked5);
  let shifted6 = ishr(value, 48_u32);
  let masked6 = iand(shifted6, 255_u64);
  let b6 = cvt.wrap::<u64, u8>(masked6);
  let shifted7 = ishr(value, 56_u32);
  let masked7 = iand(shifted7, 255_u64);
  let b7 = cvt.wrap::<u64, u8>(masked7);
  set bytes[0_u64] = b0;
  set bytes[1_u64] = b1;
  set bytes[2_u64] = b2;
  set bytes[3_u64] = b3;
  set bytes[4_u64] = b4;
  set bytes[5_u64] = b5;
  set bytes[6_u64] = b6;
  set bytes[7_u64] = b7;
  return bytes;
}

fn write_all(factory: &HandleFactory, output: &OutputStream, bytes: &[u8]) -> result: Result<unit, IoError> reads(bytes), writes(factory), writes(output) waits {
  let sent = 0_u64;
  let length = bytes^.len;
  loop @writing {
    if sent < length {
    } else {
      break @writing;
    }
    let no_deadline = None<Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: bytes, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn launch_counter_incrementers(counter: &Shared<u64>) -> result: unit reads(counter) waits {
  for (i in 0_u64..16_u64) {
    let counter_handle = shared_share::<u64>(shared: counter);
    spawn increment_counter(counter: move counter_handle);
  }
  return unit;
}

fn launch_producers_and_consumers(queue: &Shared<Ring<u64, 8>>, total: &Shared<u64>) -> result: unit reads(queue), reads(total) waits {
  for (i in 0_u64..4_u64) {
    let queue_handle = shared_share::<Ring<u64, 8>>(shared: queue);
    spawn produce(queue: move queue_handle);
  }
  for (i in 0_u64..4_u64) {
    let queue_handle = shared_share::<Ring<u64, 8>>(shared: queue);
    let total_handle = shared_share::<u64>(shared: total);
    spawn consume(queue: move queue_handle, total: move total_handle);
  }
  return unit;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: stdout, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: directory, write: directory_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory);
  let counter = shared_new::<u64>(value: 0_u64);
  let initial_queue = ring_new::<u64, 8>();
  let queue = shared_new::<Ring<u64, 8>>(value: move initial_queue);
  let total = shared_new::<u64>(value: 0_u64);
  launch_counter_incrementers(counter: &counter);
  launch_producers_and_consumers(queue: &queue, total: &total);
  let final_counter = 0_u64;
  atomic count = &counter {
    set final_counter = count^;
  }
  let final_total = 0_u64;
  let final_queue_len = 0_u64;
  atomic items = &queue, sum = &total {
    set final_queue_len = items^.len;
    set final_total = sum^;
  }
  if final_counter != 320000_u64 {
    return exit_status(code: 1_u8);
  }
  if final_total != 49990000_u64 {
    return exit_status(code: 2_u8);
  }
  if final_queue_len != 0_u64 {
    return exit_status(code: 3_u8);
  }
  let bytes1 = encode_u64_le(value: final_counter);
  let bytes2 = encode_u64_le(value: final_total);
  let bytes3 = encode_u64_le(value: final_queue_len);
  let output_buffer = array_filled::<u8, 24>(value: 0_u8);
  for (j in 0_u64..8_u64) {
    set output_buffer[j] = bytes1[j];
  }
  for (j in 0_u64..8_u64) {
    let offset1 = 8_u64 + j;
    set output_buffer[offset1] = bytes2[j];
  }
  for (j in 0_u64..8_u64) {
    let offset2 = 16_u64 + j;
    set output_buffer[offset2] = bytes3[j];
  }
  let output_slice = &output_buffer[0_u64..24_u64];
  let write_result = write_all(factory: &factory, output: &stdout, bytes: output_slice);
  match write_result {
    Ok(value: unused_ok) => {
      return exit_status(code: 0_u8);
    }
    Err(error: unused_error) => {
      return exit_status(code: 4_u8);
    }
  }
}

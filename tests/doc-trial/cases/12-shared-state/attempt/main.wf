alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias Inputs = std::process::Inputs;
alias CancelWatch = std::time::CancelWatch;
alias Instant = std::time::Instant;

fn increment_counter(counter: Shared<u64>) -> result: unit pure {
  for (i in 0_u64..20000_u64) {
    atomic count = &counter {
      set count^ = count^ +wrap 1_u64;
    }
  }
  return unit;
}

fn producer(queue: Shared<Box<Ring<u32>>>) -> result: unit pure {
  for (i in 0_u64..5000_u64) {
    let i_u32 = cvt::<u64, u32>(i);
    loop {
      let placed = False();
      atomic q = &queue {
        if q^.inner.len < 8_u64 {
          deque_push_back(values: q, value: i_u32);
          set placed = True();
        }
      }
      if placed {
        break;
      }
    }
  }
  return unit;
}

fn consumer(queue: Shared<Box<Ring<u32>>>, total: Shared<u64>) -> result: unit pure {
  for (i in 0_u64..5000_u64) {
    loop {
      let item = None<u32>();
      atomic q = &queue {
        if q^.inner.len > 0_u64 {
          let value = deque_pop_front(values: q);
          set item = Some<u32>(value: value);
        }
      }
      match item {
        Some(value: v) => {
          let as_u64 = cvt::<u32, u64>(v);
          atomic sum = &total {
            set sum^ = sum^ +wrap as_u64;
          }
          break;
        }
        None() => {
        }
      }
    }
  }
  return unit;
}

fn main(inputs: Inputs) -> status: ExitStatus pure {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: output, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  let write_closed = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let read_closed = std::fs::close_directory(factory: &factory, directory: move cwd);
  match write_closed {
    Ok(value: unused_write_closed) => {
    }
    Err(error: unused_write_error) => {
      return exit_status(code: 4_u8);
    }
  }
  match read_closed {
    Ok(value: unused_read_closed) => {
    }
    Err(error: unused_read_error) => {
      return exit_status(code: 4_u8);
    }
  }
  let counter = shared_new::<u64>(value: 0_u64);
  let initial_queue = std::collections::deque::deque_new::<u32, 8_u64>(capacity: 8_u64);
  let queue = shared_new::<Box<Ring<u32>>>(value: move initial_queue);
  let total = shared_new::<u64>(value: 0_u64);
  for (i in 0_u64..16_u64) {
    let counter_handle = shared_share::<u64>(shared: &counter);
    spawn increment_counter(counter: move counter_handle);
  }
  for (p in 0_u64..4_u64) {
    let queue_handle = shared_share::<Box<Ring<u32>>>(shared: &queue);
    spawn producer(queue: move queue_handle);
  }
  for (c in 0_u64..4_u64) {
    let queue_handle = shared_share::<Box<Ring<u32>>>(shared: &queue);
    let total_handle = shared_share::<u64>(shared: &total);
    spawn consumer(queue: move queue_handle, total: move total_handle);
  }
  let final_counter = 0_u64;
  atomic count = &counter {
    set final_counter = count^;
  }
  let final_total = 0_u64;
  atomic sum = &total {
    set final_total = sum^;
  }
  let queue_length = 0_u64;
  atomic q = &queue {
    set queue_length = q^.inner.len;
  }
  if final_counter != 320000_u64 {
    return exit_status(code: 1_u8);
  }
  if final_total != 49990000_u64 {
    return exit_status(code: 2_u8);
  }
  if queue_length != 0_u64 {
    return exit_status(code: 3_u8);
  }
  let output_buffer = array_filled::<u8, 24>(value: 0_u8);
  set output_buffer[0_u64] = cvt::<u64, u8>(final_counter);
  let c1 = ishr(final_counter, 8_u32);
  set output_buffer[1_u64] = cvt::<u64, u8>(c1);
  let c2 = ishr(final_counter, 16_u32);
  set output_buffer[2_u64] = cvt::<u64, u8>(c2);
  let c3 = ishr(final_counter, 24_u32);
  set output_buffer[3_u64] = cvt::<u64, u8>(c3);
  let c4 = ishr(final_counter, 32_u32);
  set output_buffer[4_u64] = cvt::<u64, u8>(c4);
  let c5 = ishr(final_counter, 40_u32);
  set output_buffer[5_u64] = cvt::<u64, u8>(c5);
  let c6 = ishr(final_counter, 48_u32);
  set output_buffer[6_u64] = cvt::<u64, u8>(c6);
  let c7 = ishr(final_counter, 56_u32);
  set output_buffer[7_u64] = cvt::<u64, u8>(c7);
  set output_buffer[8_u64] = cvt::<u64, u8>(final_total);
  let t1 = ishr(final_total, 8_u32);
  set output_buffer[9_u64] = cvt::<u64, u8>(t1);
  let t2 = ishr(final_total, 16_u32);
  set output_buffer[10_u64] = cvt::<u64, u8>(t2);
  let t3 = ishr(final_total, 24_u32);
  set output_buffer[11_u64] = cvt::<u64, u8>(t3);
  let t4 = ishr(final_total, 32_u32);
  set output_buffer[12_u64] = cvt::<u64, u8>(t4);
  let t5 = ishr(final_total, 40_u32);
  set output_buffer[13_u64] = cvt::<u64, u8>(t5);
  let t6 = ishr(final_total, 48_u32);
  set output_buffer[14_u64] = cvt::<u64, u8>(t6);
  let t7 = ishr(final_total, 56_u32);
  set output_buffer[15_u64] = cvt::<u64, u8>(t7);
  set output_buffer[16_u64] = cvt::<u64, u8>(queue_length);
  let q1 = ishr(queue_length, 8_u32);
  set output_buffer[17_u64] = cvt::<u64, u8>(q1);
  let q2 = ishr(queue_length, 16_u32);
  set output_buffer[18_u64] = cvt::<u64, u8>(q2);
  let q3 = ishr(queue_length, 24_u32);
  set output_buffer[19_u64] = cvt::<u64, u8>(q3);
  let q4 = ishr(queue_length, 32_u32);
  set output_buffer[20_u64] = cvt::<u64, u8>(q4);
  let q5 = ishr(queue_length, 40_u32);
  set output_buffer[21_u64] = cvt::<u64, u8>(q5);
  let q6 = ishr(queue_length, 48_u32);
  set output_buffer[22_u64] = cvt::<u64, u8>(q6);
  let q7 = ishr(queue_length, 56_u32);
  set output_buffer[23_u64] = cvt::<u64, u8>(q7);
  let sent = 0_u64;
  loop {
    if sent < 24_u64 {
      let remaining = 24_u64 - sent;
      let no_deadline = None<Instant>();
      let cancel = std::time::cancel_never();
      let outcome = std::io::write_once(factory: &factory, output: &output, source: &output_buffer[sent..24_u64], start: 0_u64, end: remaining, deadline: no_deadline, cancel: &cancel);
      std::time::close_cancel_watch(watch: move cancel);
      match outcome {
        Ok(value: next) => {
          set sent = sent + next;
        }
        Err(error: problem) => {
          return exit_status(code: 4_u8);
        }
      }
    } else {
      break;
    }
  }
  return exit_status(code: 0_u8);
}

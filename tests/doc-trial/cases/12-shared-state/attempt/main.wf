alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;

fn add_to_counter(counter: Shared<u64>) -> result: unit pure waits {
  for (i in 0_u64..20000_u64) {
    atomic count = &counter {
      set count^ = count^ +wrap 1_u64;
    }
  }
  return unit;
}

fn produce(queue: Shared<Ring<u64, 8>>) -> result: unit pure waits {
  for (i in 0_u64..5000_u64) {
    atomic items = &queue when items^.len < items^.cap {
      place_back(window: items, value: i);
    }
  }
  return unit;
}

fn consume(queue: Shared<Ring<u64, 8>>, total: Shared<u64>) -> result: unit pure waits {
  for (i in 0_u64..5000_u64) {
    atomic items = &queue, sum = &total when items^.len > 0_u64 {
      let value = take_front(window: items);
      set sum^ = sum^ +wrap value;
    }
  }
  return unit;
}

fn write_u64(factory: &HandleFactory, output: &OutputStream, value: u64) -> result: Result<unit, std::io::IoError> reads(factory), writes(factory), writes(output) waits {
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  set bytes[0_u64] = cvt.wrap::<u64, u8>(value);
  let shifted_1 = ishr(value, 8_u32);
  set bytes[1_u64] = cvt.wrap::<u64, u8>(shifted_1);
  let shifted_2 = ishr(value, 16_u32);
  set bytes[2_u64] = cvt.wrap::<u64, u8>(shifted_2);
  let shifted_3 = ishr(value, 24_u32);
  set bytes[3_u64] = cvt.wrap::<u64, u8>(shifted_3);
  let shifted_4 = ishr(value, 32_u32);
  set bytes[4_u64] = cvt.wrap::<u64, u8>(shifted_4);
  let shifted_5 = ishr(value, 40_u32);
  set bytes[5_u64] = cvt.wrap::<u64, u8>(shifted_5);
  let shifted_6 = ishr(value, 48_u32);
  set bytes[6_u64] = cvt.wrap::<u64, u8>(shifted_6);
  let shifted_7 = ishr(value, 56_u32);
  set bytes[7_u64] = cvt.wrap::<u64, u8>(shifted_7);
  let buffer = &bytes[0_u64..8_u64];
  let sent = 0_u64;
  loop @sending {
    if sent < 8_u64 {
    } else {
      break @sending;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: buffer, start: sent, end: 8_u64, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, std::io::IoError>(error: problem);
      }
    }
  }
  return Ok<unit, std::io::IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: stdout_stream, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let counter = shared_new::<u64>(value: 0_u64);
  let initial_ring = ring_new::<u64, 8>();
  let queue = shared_new::<Ring<u64, 8>>(value: move initial_ring);
  let total = shared_new::<u64>(value: 0_u64);
  for (i in 0_u64..16_u64) {
    let counter_handle = shared_share::<u64>(shared: &counter);
    spawn add_to_counter(counter: move counter_handle);
  }
  for (i in 0_u64..4_u64) {
    let queue_handle = shared_share::<Ring<u64, 8>>(shared: &queue);
    spawn produce(queue: move queue_handle);
  }
  for (i in 0_u64..4_u64) {
    let queue_handle = shared_share::<Ring<u64, 8>>(shared: &queue);
    let total_handle = shared_share::<u64>(shared: &total);
    spawn consume(queue: move queue_handle, total: move total_handle);
  }
  let observed_counter = 0_u64;
  atomic count = &counter {
    set observed_counter = count^;
  }
  if observed_counter != 320000_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  let observed_total = 0_u64;
  let observed_queue_len = 0_u64;
  atomic items = &queue, sum = &total {
    set observed_total = sum^;
    set observed_queue_len = items^.len;
  }
  if observed_total != 49990000_u64 {
    return std::process::exit_status(code: 2_u8);
  }
  if observed_queue_len != 0_u64 {
    return std::process::exit_status(code: 3_u8);
  }
  let write_result_counter = write_u64(factory: &factory, output: &stdout_stream, value: observed_counter);
  match write_result_counter {
    Ok(value: unused_ok) => {
    }
    Err(error: unused_error) => {
      return std::process::exit_status(code: 4_u8);
    }
  }
  let write_result_total = write_u64(factory: &factory, output: &stdout_stream, value: observed_total);
  match write_result_total {
    Ok(value: unused_ok) => {
    }
    Err(error: unused_error) => {
      return std::process::exit_status(code: 4_u8);
    }
  }
  let write_result_queue = write_u64(factory: &factory, output: &stdout_stream, value: observed_queue_len);
  match write_result_queue {
    Ok(value: unused_ok) => {
    }
    Err(error: unused_error) => {
      return std::process::exit_status(code: 4_u8);
    }
  }
  return std::process::exit_status(code: 0_u8);
}

alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;

fn bump(counter: Shared<u64>) -> result: unit pure waits {
  for (index in 0_u64..20000_u64) {
    atomic count = &counter {
      set count^ = count^ +wrap 1_u64;
    }
  }
  return unit;
}

fn launch_adders(counter: &Shared<u64>) -> result: unit reads(counter) waits {
  for (index in 0_u64..16_u64) {
    let handle = shared_share::<u64>(shared: counter);
    spawn bump(counter: move handle);
  }
  return unit;
}

fn produce(queue: Shared<Ring<u64, 8>>) -> result: unit pure waits {
  for (item in 0_u64..5000_u64) {
    atomic items = &queue when items^.len < items^.cap {
      place_back(window: items, value: item);
    }
  }
  return unit;
}

fn consume(queue: Shared<Ring<u64, 8>>, total: Shared<u64>) -> result: unit pure waits {
  for (index in 0_u64..5000_u64) {
    atomic items = &queue, sum = &total when items^.len > 0_u64 {
      let got = take_front(window: items);
      set sum^ = sum^ +wrap got;
    }
  }
  return unit;
}

fn launch_queue(queue: &Shared<Ring<u64, 8>>, total: &Shared<u64>) -> result: unit reads(queue), reads(total) waits {
  for (producer in 0_u64..4_u64) {
    let producer_handle = shared_share::<Ring<u64, 8>>(shared: queue);
    spawn produce(queue: move producer_handle);
  }
  for (consumer in 0_u64..4_u64) {
    let queue_handle = shared_share::<Ring<u64, 8>>(shared: queue);
    let total_handle = shared_share::<u64>(shared: total);
    spawn consume(queue: move queue_handle, total: move total_handle);
  }
  return unit;
}

fn byte_at(value: u64, shift: u32) -> result: u8 pure contract {
  requires shift < 64_u32;
} {
  let moved = ishr(value, shift);
  return cvt.wrap::<u64, u8>(moved);
}

fn encode_observation(counter: u64, total: u64, remaining: u64) -> result: Array<u8, 24> pure {
  let bytes = array_filled::<u8, 24>(value: 0_u8);
  set bytes[0_u64] = byte_at(value: counter, shift: 0_u32);
  set bytes[1_u64] = byte_at(value: counter, shift: 8_u32);
  set bytes[2_u64] = byte_at(value: counter, shift: 16_u32);
  set bytes[3_u64] = byte_at(value: counter, shift: 24_u32);
  set bytes[4_u64] = byte_at(value: counter, shift: 32_u32);
  set bytes[5_u64] = byte_at(value: counter, shift: 40_u32);
  set bytes[6_u64] = byte_at(value: counter, shift: 48_u32);
  set bytes[7_u64] = byte_at(value: counter, shift: 56_u32);
  set bytes[8_u64] = byte_at(value: total, shift: 0_u32);
  set bytes[9_u64] = byte_at(value: total, shift: 8_u32);
  set bytes[10_u64] = byte_at(value: total, shift: 16_u32);
  set bytes[11_u64] = byte_at(value: total, shift: 24_u32);
  set bytes[12_u64] = byte_at(value: total, shift: 32_u32);
  set bytes[13_u64] = byte_at(value: total, shift: 40_u32);
  set bytes[14_u64] = byte_at(value: total, shift: 48_u32);
  set bytes[15_u64] = byte_at(value: total, shift: 56_u32);
  set bytes[16_u64] = byte_at(value: remaining, shift: 0_u32);
  set bytes[17_u64] = byte_at(value: remaining, shift: 8_u32);
  set bytes[18_u64] = byte_at(value: remaining, shift: 16_u32);
  set bytes[19_u64] = byte_at(value: remaining, shift: 24_u32);
  set bytes[20_u64] = byte_at(value: remaining, shift: 32_u32);
  set bytes[21_u64] = byte_at(value: remaining, shift: 40_u32);
  set bytes[22_u64] = byte_at(value: remaining, shift: 48_u32);
  set bytes[23_u64] = byte_at(value: remaining, shift: 56_u32);
  return bytes;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: output, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  let write_closed = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let read_closed = std::fs::close_directory(factory: &factory, directory: move cwd_read);
  match write_closed {
    Ok(value: unused_write_closed) => {
    }
    Err(error: unused_write_error) => {
    }
  }
  match read_closed {
    Ok(value: unused_read_closed) => {
    }
    Err(error: unused_read_error) => {
    }
  }
  let counter = shared_new::<u64>(value: 0_u64);
  launch_adders(counter: &counter);
  let counter_value = 0_u64;
  atomic count = &counter {
    set counter_value = count^;
  }
  let initial = ring_new::<u64, 8>();
  let queue = shared_new::<Ring<u64, 8>>(value: move initial);
  let total = shared_new::<u64>(value: 0_u64);
  launch_queue(queue: &queue, total: &total);
  let total_value = 0_u64;
  let remaining = 0_u64;
  atomic items = &queue, sum = &total {
    set remaining = items^.len;
    set total_value = sum^;
  }
  if counter_value != 320000_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  if total_value != 49990000_u64 {
    return std::process::exit_status(code: 2_u8);
  }
  if remaining != 0_u64 {
    return std::process::exit_status(code: 3_u8);
  }
  let encoded = encode_observation(counter: counter_value, total: total_value, remaining: remaining);
  let source = &encoded[0_u64..24_u64];
  let length = source^.len;
  let published = publish_all(factory: &factory, output: &output, source: source, length: length);
  match published {
    Ok(value: unused_published) => {
    }
    Err(error: unused_publish_error) => {
      return std::process::exit_status(code: 4_u8);
    }
  }
  return std::process::exit_status(code: 0_u8);
}

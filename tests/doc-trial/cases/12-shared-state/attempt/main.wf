alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias OutputStream = std::io::OutputStream;
alias HandleFactory = std::io::HandleFactory;
alias Instant = std::time::Instant;
alias CancelWatch = std::time::CancelWatch;
alias IoError = std::io::IoError;
alias Directory = std::fs::Directory;

fn increment_counter(counter: Shared<u64>) -> result: unit pure waits {
  let i = 0_u64;
  loop {
    if i < 20000_u64 {
    } else {
      break;
    }
    atomic c = &counter {
      set c^ = c^ +wrap 1_u64;
    }
    set i = i + 1_u64;
  }
  return unit;
}

fn produce(queue: Shared<Ring<u64, 8>>) -> result: unit pure waits {
  let value = 0_u64;
  loop {
    if value < 5000_u64 {
    } else {
      break;
    }
    atomic q = &queue when q^.len < 8_u64 {
      place_back(window: q, value: value);
    }
    set value = value + 1_u64;
  }
  return unit;
}

fn consume(queue: Shared<Ring<u64, 8>>, total: Shared<u64>) -> result: unit pure waits {
  let count = 0_u64;
  let val = 0_u64;
  loop {
    if count < 5000_u64 {
    } else {
      break;
    }
    atomic q = &queue, t = &total when q^.len > 0_u64 {
      set val = take_front(window: q);
      set t^ = t^ +wrap val;
    }
    set count = count + 1_u64;
  }
  return unit;
}

fn encode_u64_le(value: u64, buffer: &[u8], offset: u64) -> result: unit writes(buffer) contract {
  requires offset + 8_u64 <= buffer^.len;
} {
  let v = value;
  let byte0 = cvt.wrap::<u64, u8>(v);
  set buffer^[offset] = byte0;
  let shifted1 = ishr(v, 8_u32);
  let byte1 = cvt.wrap::<u64, u8>(shifted1);
  set buffer^[offset + 1_u64] = byte1;
  let shifted2 = ishr(v, 16_u32);
  let byte2 = cvt.wrap::<u64, u8>(shifted2);
  set buffer^[offset + 2_u64] = byte2;
  let shifted3 = ishr(v, 24_u32);
  let byte3 = cvt.wrap::<u64, u8>(shifted3);
  set buffer^[offset + 3_u64] = byte3;
  let shifted4 = ishr(v, 32_u32);
  let byte4 = cvt.wrap::<u64, u8>(shifted4);
  set buffer^[offset + 4_u64] = byte4;
  let shifted5 = ishr(v, 40_u32);
  let byte5 = cvt.wrap::<u64, u8>(shifted5);
  set buffer^[offset + 5_u64] = byte5;
  let shifted6 = ishr(v, 48_u32);
  let byte6 = cvt.wrap::<u64, u8>(shifted6);
  set buffer^[offset + 6_u64] = byte6;
  let shifted7 = ishr(v, 56_u32);
  let byte7 = cvt.wrap::<u64, u8>(shifted7);
  set buffer^[offset + 7_u64] = byte7;
  return unit;
}

fn write_all(factory: &HandleFactory, output: &OutputStream, buffer: &[u8]) -> result: Result<unit, IoError> reads(buffer), writes(factory), writes(output) waits {
  let sent = 0_u64;
  let length = buffer^.len;
  loop {
    if sent < length {
    } else {
      break;
    }
    let no_deadline = None<Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: buffer, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_dir, stdout: output, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let Directory(read: cwd_read, write: cwd_write) = move cwd_dir;
  let write_closed = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let read_closed = std::fs::close_directory(factory: &factory, directory: move cwd_read);
  match write_closed {
    Ok(value: unused_wc) => {
    }
    Err(error: unused_we) => {
    }
  }
  match read_closed {
    Ok(value: unused_rc) => {
    }
    Err(error: unused_re) => {
    }
  }

  let counter = shared_new::<u64>(value: 0_u64);
  let empty_ring = ring_new::<u64, 8>();
  let queue = shared_new::<Ring<u64, 8>>(value: move empty_ring);
  let total = shared_new::<u64>(value: 0_u64);

  for (i in 0_u64..16_u64) {
    let counter_share = shared_share::<u64>(shared: &counter);
    spawn increment_counter(counter: move counter_share);
  }

  for (i in 0_u64..4_u64) {
    let queue_share = shared_share::<Ring<u64, 8>>(shared: &queue);
    spawn produce(queue: move queue_share);
  }

  for (i in 0_u64..4_u64) {
    let queue_share = shared_share::<Ring<u64, 8>>(shared: &queue);
    let total_share = shared_share::<u64>(shared: &total);
    spawn consume(queue: move queue_share, total: move total_share);
  }

  let final_counter = 0_u64;
  atomic c = &counter {
    set final_counter = c^;
  }

  let final_total = 0_u64;
  let final_queue_len = 0_u64;
  atomic t = &total, q = &queue {
    set final_total = t^;
    set final_queue_len = q^.len;
  }

  let status_code = 0_u8;
  if final_counter != 320000_u64 {
    set status_code = 1_u8;
  } else if final_total != 49990000_u64 {
    set status_code = 2_u8;
  } else if final_queue_len != 0_u64 {
    set status_code = 3_u8;
  }

  if status_code == 0_u8 {
    let buffer = array_filled::<u8, 24>(value: 0_u8);
    let buffer_slice = &buffer[0_u64..24_u64];
    encode_u64_le(value: final_counter, buffer: buffer_slice, offset: 0_u64);
    encode_u64_le(value: final_total, buffer: buffer_slice, offset: 8_u64);
    encode_u64_le(value: final_queue_len, buffer: buffer_slice, offset: 16_u64);

    let output_result = write_all(factory: &factory, output: &output, buffer: buffer_slice);
    match output_result {
      Ok(value: unused_ok) => {
      }
      Err(error: unused_error) => {
        set status_code = 4_u8;
      }
    }
  }

  return exit_status(code: status_code);
}

alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias IoError = std::io::IoError;
alias OutputStream = std::io::OutputStream;
alias exit_status = std::process::exit_status;

fn bump(counter: Shared<u64>) -> result: unit pure waits {
  for (step in 0_u64..20000_u64) {
    atomic count = &counter {
      set count^ = count^ +wrap 1_u64;
    }
  }
  return unit;
}

fn produce(queue: Shared<Ring<u64, 8>>) -> result: unit pure waits {
  for (item in 0_u64..5000_u64) {
    atomic items = &queue when items^.len < items^.cap {
      place_back(window: items, value: item);
    }
  }
  return unit;
}

fn consume(queue: Shared<Ring<u64, 8>>, total: Shared<u64>) -> result: unit pure waits {
  for (taken in 0_u64..5000_u64) {
    let got = 0_u64;
    atomic items = &queue, sum = &total when items^.len > 0_u64 {
      set got = take_front(window: items);
      set sum^ = sum^ +wrap got;
    }
  }
  return unit;
}

fn launch_all(queue: &Shared<Ring<u64, 8>>, counter: &Shared<u64>, total: &Shared<u64>) -> result: unit reads(queue), reads(counter), reads(total) waits {
  for (bumper in 0_u64..16_u64) {
    let handle = shared_share::<u64>(shared: counter);
    spawn bump(counter: move handle);
  }
  for (producer in 0_u64..4_u64) {
    let handle = shared_share::<Ring<u64, 8>>(shared: queue);
    spawn produce(queue: move handle);
  }
  for (consumer in 0_u64..4_u64) {
    let queue_handle = shared_share::<Ring<u64, 8>>(shared: queue);
    let total_handle = shared_share::<u64>(shared: total);
    spawn consume(queue: move queue_handle, total: move total_handle);
  }
  return unit;
}

fn le_byte(value: u64, shift: u32) -> result: u8 pure contract {
  requires shift < 64_u32;
} {
  let shifted = ishr(value, shift);
  return cvt.wrap::<u64, u8>(shifted);
}

fn encode_u64(value: u64) -> result: Array<u8, 8> pure {
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  set bytes[0_u64] = le_byte(value: value, shift: 0_u32);
  set bytes[1_u64] = le_byte(value: value, shift: 8_u32);
  set bytes[2_u64] = le_byte(value: value, shift: 16_u32);
  set bytes[3_u64] = le_byte(value: value, shift: 24_u32);
  set bytes[4_u64] = le_byte(value: value, shift: 32_u32);
  set bytes[5_u64] = le_byte(value: value, shift: 40_u32);
  set bytes[6_u64] = le_byte(value: value, shift: 48_u32);
  set bytes[7_u64] = le_byte(value: value, shift: 56_u32);
  return bytes;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn publish_counts(factory: &HandleFactory, output: &OutputStream, counter: &[u8], total: &[u8], left: &[u8]) -> result: Result<unit, IoError> reads(counter), reads(total), reads(left), writes(factory), writes(output) waits contract {
  requires counter^.len == 8_u64;
  requires total^.len == 8_u64;
  requires left^.len == 8_u64;
} {
  let counter_written = propagate publish_all(factory: factory, output: output, source: counter, length: 8_u64);
  let total_written = propagate publish_all(factory: factory, output: output, source: total, length: 8_u64);
  let left_written = propagate publish_all(factory: factory, output: output, source: left, length: 8_u64);
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: cwd_directory, stdout: output, handles: factory, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move cwd_directory;
  let write_closed = std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  let read_closed = std::fs::close_directory(factory: &factory, directory: move directory_read);
  match write_closed {
    Ok(value: unused_write_closed) => {
    }
    Err(error: unused_write_error) => {
    }
  }
  match read_closed {
    Ok(value: unused_read_closed) => {
    }
    Err(error: unused_read_error) => {
    }
  }
  let counter = shared_new::<u64>(value: 0_u64);
  let initial = ring_new::<u64, 8>();
  let queue = shared_new::<Ring<u64, 8>>(value: move initial);
  let total = shared_new::<u64>(value: 0_u64);
  launch_all(queue: &queue, counter: &counter, total: &total);
  let counted = 0_u64;
  let summed = 0_u64;
  let left = 1_u64;
  atomic count = &counter, sum = &total, items = &queue {
    set counted = count^;
    set summed = sum^;
    set left = items^.len;
  }
  if counted != 320000_u64 {
    return exit_status(code: 1_u8);
  }
  if summed != 49990000_u64 {
    return exit_status(code: 2_u8);
  }
  if left != 0_u64 {
    return exit_status(code: 3_u8);
  }
  let counter_bytes = encode_u64(value: counted);
  let total_bytes = encode_u64(value: summed);
  let left_bytes = encode_u64(value: left);
  let written = publish_counts(factory: &factory, output: &output, counter: &counter_bytes[0_u64..8_u64], total: &total_bytes[0_u64..8_u64], left: &left_bytes[0_u64..8_u64]);
  match written {
    Ok(value: unused_written) => {
    }
    Err(error: unused_written_error) => {
      return exit_status(code: 4_u8);
    }
  }
  return exit_status(code: 0_u8);
}

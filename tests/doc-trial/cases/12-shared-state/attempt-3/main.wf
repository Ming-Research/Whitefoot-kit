alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias CancelWatch = std::time::CancelWatch;

fn increment(counter: Shared<u64>) -> result: unit pure waits {
  for (i in 0_u64..20000_u64) {
    atomic count = &counter {
      set count^ = count^ +wrap 1_u64;
    }
  }
  return unit;
}

fn produce(queue: Shared<Ring<u64, 8>>) -> result: unit pure waits {
  for (i in 0_u64..5000_u64) {
    atomic items = &queue when items^.len < items^.cap {
      place_back(window: items, value: i);
    }
  }
  return unit;
}

fn consume(queue: Shared<Ring<u64, 8>>, total: Shared<u64>) -> result: unit pure waits {
  for (i in 0_u64..5000_u64) {
    let got = 0_u64;
    atomic items = &queue, sum = &total when items^.len > 0_u64 {
      set got = take_front(window: items);
      set sum^ = sum^ +wrap got;
    }
  }
  return unit;
}

fn encode_le(value: u64, buffer: &[u8], offset: u64) -> result: unit writes(buffer) contract {
  requires offset + 8_u64 <= buffer^.len;
} {
  let byte0 = cvt::<u64, u8>(value);
  set buffer^[offset] = byte0;
  let shifted1 = ishr(value, 8_u32);
  let byte1 = cvt::<u64, u8>(shifted1);
  set buffer^[offset + 1_u64] = byte1;
  let shifted2 = ishr(value, 16_u32);
  let byte2 = cvt::<u64, u8>(shifted2);
  set buffer^[offset + 2_u64] = byte2;
  let shifted3 = ishr(value, 24_u32);
  let byte3 = cvt::<u64, u8>(shifted3);
  set buffer^[offset + 3_u64] = byte3;
  let shifted4 = ishr(value, 32_u32);
  let byte4 = cvt::<u64, u8>(shifted4);
  set buffer^[offset + 4_u64] = byte4;
  let shifted5 = ishr(value, 40_u32);
  let byte5 = cvt::<u64, u8>(shifted5);
  set buffer^[offset + 5_u64] = byte5;
  let shifted6 = ishr(value, 48_u32);
  let byte6 = cvt::<u64, u8>(shifted6);
  set buffer^[offset + 6_u64] = byte6;
  let shifted7 = ishr(value, 56_u32);
  let byte7 = cvt::<u64, u8>(shifted7);
  set buffer^[offset + 7_u64] = byte7;
  return unit;
}

fn write_all(factory: &HandleFactory, output: &OutputStream, source: &[u8]) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits {
  let sent = 0_u64;
  let length = source^.len;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn launch_all(
  counter: &Shared<u64>,
  queue: &Shared<Ring<u64, 8>>,
  total: &Shared<u64>
) -> result: unit reads(counter), reads(queue), reads(total) waits {
  for (i in 0_u64..16_u64) {
    let counter_share = shared_share::<u64>(shared: counter);
    spawn increment(counter: move counter_share);
  }

  for (i in 0_u64..4_u64) {
    let queue_share = shared_share::<Ring<u64, 8>>(shared: queue);
    spawn produce(queue: move queue_share);
  }

  for (i in 0_u64..4_u64) {
    let queue_share = shared_share::<Ring<u64, 8>>(shared: queue);
    let total_share = shared_share::<u64>(shared: total);
    spawn consume(queue: move queue_share, total: move total_share);
  }
  return unit;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: stdout, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  std::fs::close_directory(factory: &factory, directory: move cwd);

  let counter = shared_new::<u64>(value: 0_u64);
  let initial_ring = ring_new::<u64, 8>();
  let queue = shared_new::<Ring<u64, 8>>(value: move initial_ring);
  let total = shared_new::<u64>(value: 0_u64);

  launch_all(counter: &counter, queue: &queue, total: &total);

  let final_counter = 0_u64;
  atomic count = &counter {
    set final_counter = count^;
  }

  let final_total = 0_u64;
  let final_queue_len = 0_u64;
  atomic items = &queue, sum = &total {
    set final_queue_len = items^.len;
    set final_total = sum^;
  }

  let status = 0_u8;
  if final_counter != 320000_u64 {
    set status = 1_u8;
  } else if final_total != 49990000_u64 {
    set status = 2_u8;
  } else if final_queue_len != 0_u64 {
    set status = 3_u8;
  }

  if status == 0_u8 {
    let buffer = array_filled::<u8, 24>(value: 0_u8);
    let buffer_slice = &buffer[0_u64..24_u64];
    encode_le(value: final_counter, buffer: buffer_slice, offset: 0_u64);
    encode_le(value: final_total, buffer: buffer_slice, offset: 8_u64);
    encode_le(value: final_queue_len, buffer: buffer_slice, offset: 16_u64);
    let outcome = write_all(factory: &factory, output: &stdout, source: buffer_slice);
    match outcome {
      Ok(value: unit) => {
        return exit_status(code: 0_u8);
      }
      Err(error: unused) => {
        return exit_status(code: 4_u8);
      }
    }
  }

  return exit_status(code: status);
}

alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;

fn increment_counter(counter: Shared<u64>) -> result: unit pure waits {
  let i = 0_u64;
  loop {
    if i < 20000_u64 {
    } else {
      break;
    }
    atomic value = &counter {
      set value^ = value^ +wrap 1_u64;
    }
    set i = i + 1_u64;
  }
  return unit;
}

fn produce(queue: Shared<Ring<u64, 8>>) -> result: unit pure waits {
  let base = 0_u64;
  loop {
    if base < 5000_u64 {
    } else {
      break;
    }
    atomic items = &queue when items^.len < items^.cap {
      place_back(window: items, value: base);
    }
    set base = base + 1_u64;
  }
  return unit;
}

fn consume(queue: Shared<Ring<u64, 8>>, total: Shared<u64>) -> result: unit pure waits {
  let count = 0_u64;
  loop {
    if count < 5000_u64 {
    } else {
      break;
    }
    atomic items = &queue, sum = &total when items^.len > 0_u64 {
      let value = take_front(window: items);
      set sum^ = sum^ +wrap value;
    }
    set count = count + 1_u64;
  }
  return unit;
}

fn write_le64(bytes: &[u8], index: u64, value: u64) -> result: unit writes(bytes) {
  set bytes^[index] = cvt::<u64, u8>(value);
  set bytes^[index + 1_u64] = cvt::<u64, u8>(ishr(value, 8_u32));
  set bytes^[index + 2_u64] = cvt::<u64, u8>(ishr(value, 16_u32));
  set bytes^[index + 3_u64] = cvt::<u64, u8>(ishr(value, 24_u32));
  set bytes^[index + 4_u64] = cvt::<u64, u8>(ishr(value, 32_u32));
  set bytes^[index + 5_u64] = cvt::<u64, u8>(ishr(value, 40_u32));
  set bytes^[index + 6_u64] = cvt::<u64, u8>(ishr(value, 48_u32));
  set bytes^[index + 7_u64] = cvt::<u64, u8>(ishr(value, 56_u32));
  return unit;
}

fn publish_all(factory: &std::io::HandleFactory, output: &std::io::OutputStream, source: &[u8]) -> result: Result<unit, std::io::IoError> reads(source), writes(factory), writes(output) waits {
  let sent = 0_u64;
  let length = source^.len;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, std::io::IoError>(error: problem);
      }
    }
  }
  return Ok<unit, std::io::IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: output, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  std::fs::close_directory(factory: &factory, directory: move cwd_read);

  let counter = shared_new::<u64>(value: 0_u64);
  let i = 0_u64;
  loop {
    if i < 16_u64 {
    } else {
      break;
    }
    let handle = shared_share::<u64>(shared: &counter);
    spawn increment_counter(counter: move handle);
    set i = i + 1_u64;
  }

  let initial_queue = ring_new::<u64, 8>();
  let queue = shared_new::<Ring<u64, 8>>(value: move initial_queue);
  let total = shared_new::<u64>(value: 0_u64);

  let p = 0_u64;
  loop {
    if p < 4_u64 {
    } else {
      break;
    }
    let queue_handle = shared_share::<Ring<u64, 8>>(shared: &queue);
    spawn produce(queue: move queue_handle);
    set p = p + 1_u64;
  }

  let c = 0_u64;
  loop {
    if c < 4_u64 {
    } else {
      break;
    }
    let queue_handle = shared_share::<Ring<u64, 8>>(shared: &queue);
    let total_handle = shared_share::<u64>(shared: &total);
    spawn consume(queue: move queue_handle, total: move total_handle);
    set c = c + 1_u64;
  }

  let final_counter = 0_u64;
  atomic value = &counter {
    set final_counter = value^;
  }

  let final_total = 0_u64;
  let final_queue_length = 0_u64;
  atomic items = &queue, sum = &total {
    set final_queue_length = items^.len;
    set final_total = sum^;
  }

  if final_counter != 320000_u64 {
    return exit_status(code: 1_u8);
  }
  if final_total != 49990000_u64 {
    return exit_status(code: 2_u8);
  }
  if final_queue_length != 0_u64 {
    return exit_status(code: 3_u8);
  }

  let output_buffer = array_filled::<u8, 24>(value: 0_u8);
  let view = &output_buffer[0_u64..24_u64];
  write_le64(bytes: view, index: 0_u64, value: final_counter);
  write_le64(bytes: view, index: 8_u64, value: final_total);
  write_le64(bytes: view, index: 16_u64, value: final_queue_length);

  let outcome = publish_all(factory: &factory, output: &output, source: view);
  match outcome {
    Ok(value: unused_success) => {
      return exit_status(code: 0_u8);
    }
    Err(error: unused_problem) => {
      return exit_status(code: 4_u8);
    }
  }
}

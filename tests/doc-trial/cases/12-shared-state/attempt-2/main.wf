alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias IoError = std::io::IoError;
alias OutputStream = std::io::OutputStream;

fn byte_of(value: u64, shift: u32) -> result: u8 pure {
  let shifted = ishr.wrap(value, shift);
  return cvt.wrap::<u64, u8>(shifted);
}

fn encode_word(value: u64) -> result: Array<u8, 8> pure {
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  set bytes[0_u64] = byte_of(value: value, shift: 0_u32);
  set bytes[1_u64] = byte_of(value: value, shift: 8_u32);
  set bytes[2_u64] = byte_of(value: value, shift: 16_u32);
  set bytes[3_u64] = byte_of(value: value, shift: 24_u32);
  set bytes[4_u64] = byte_of(value: value, shift: 32_u32);
  set bytes[5_u64] = byte_of(value: value, shift: 40_u32);
  set bytes[6_u64] = byte_of(value: value, shift: 48_u32);
  set bytes[7_u64] = byte_of(value: value, shift: 56_u32);
  return bytes;
}

fn publish_word(factory: &HandleFactory, output: &OutputStream, value: u64) -> result: Result<unit, IoError> writes(factory), writes(output) waits {
  let bytes = encode_word(value: value);
  let view = &bytes[0_u64..8_u64];
  let sent = 0_u64;
  loop @publish {
    let pending = sent < 8_u64;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: view, start: sent, end: 8_u64, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn publish_all_words(factory: &HandleFactory, output: &OutputStream, counter: u64, total: u64, length: u64) -> result: Result<unit, IoError> writes(factory), writes(output) waits {
  let counter_done = propagate publish_word(factory: factory, output: output, value: counter);
  let total_done = propagate publish_word(factory: factory, output: output, value: total);
  let length_done = propagate publish_word(factory: factory, output: output, value: length);
  return Ok<unit, IoError>(value: unit);
}

fn add_repeatedly(counter: Shared<u64>) -> result: unit pure waits {
  for (step in 0_u64..20000_u64) {
    atomic count = &counter {
      set count^ = count^ +wrap 1_u64;
    }
  }
  return unit;
}

fn produce(queue: Shared<Ring<u64, 8>>) -> result: unit pure waits {
  for (item in 0_u64..5000_u64) {
    atomic items = &queue when items^.len < items^.cap {
      place_back(window: items, value: item);
    }
  }
  return unit;
}

fn consume(queue: Shared<Ring<u64, 8>>, total: Shared<u64>) -> result: unit pure waits {
  for (step in 0_u64..5000_u64) {
    let got = 0_u64;
    atomic items = &queue, sum = &total when items^.len > 0_u64 {
      set got = take_front(window: items);
      set sum^ = sum^ +wrap got;
    }
  }
  return unit;
}

fn launch(counter: &Shared<u64>, queue: &Shared<Ring<u64, 8>>, total: &Shared<u64>) -> result: unit reads(counter), reads(queue), reads(total) waits {
  for (index in 0_u64..16_u64) {
    let counter_handle = shared_share::<u64>(shared: counter);
    spawn add_repeatedly(counter: move counter_handle);
  }
  for (index in 0_u64..4_u64) {
    let producer_handle = shared_share::<Ring<u64, 8>>(shared: queue);
    spawn produce(queue: move producer_handle);
  }
  for (index in 0_u64..4_u64) {
    let queue_handle = shared_share::<Ring<u64, 8>>(shared: queue);
    let total_handle = shared_share::<u64>(shared: total);
    spawn consume(queue: move queue_handle, total: move total_handle);
  }
  return unit;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: output_stream, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let counter = shared_new::<u64>(value: 0_u64);
  let initial = ring_new::<u64, 8>();
  let queue = shared_new::<Ring<u64, 8>>(value: move initial);
  let total = shared_new::<u64>(value: 0_u64);
  launch(counter: &counter, queue: &queue, total: &total);
  let observed_counter = 0_u64;
  let observed_total = 0_u64;
  let observed_length = 0_u64;
  atomic count = &counter {
    set observed_counter = count^;
  }
  atomic sum = &total {
    set observed_total = sum^;
  }
  atomic items = &queue {
    set observed_length = items^.len;
  }
  if observed_counter != 320000_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  if observed_total != 49990000_u64 {
    return std::process::exit_status(code: 2_u8);
  }
  if observed_length != 0_u64 {
    return std::process::exit_status(code: 3_u8);
  }
  let published = publish_all_words(factory: &factory, output: &output_stream, counter: observed_counter, total: observed_total, length: observed_length);
  match published {
    Ok(value: unused_published) => {
    }
    Err(error: unused_publish_error) => {
      return std::process::exit_status(code: 4_u8);
    }
  }
  return std::process::exit_status(code: 0_u8);
}

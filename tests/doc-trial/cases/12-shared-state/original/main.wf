alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias IoError = std::io::IoError;
alias OutputStream = std::io::OutputStream;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;
alias write_once = std::io::write_once;

fn bump_many(counter: Shared<u64>) -> result: unit pure waits {
  for @bump (index in 0_u64..20000_u64) {
    atomic count = &counter {
      set count^ = count^ +wrap 1_u64;
    }
  }
  return unit;
}

fn count_together(counter: &Shared<u64>) -> result: unit reads(counter) waits {
  for @start (index in 0_u64..16_u64) {
    let handle = shared_share::<u64>(shared: counter);
    spawn bump_many(counter: move handle);
  }
  return unit;
}

fn produce(queue: Shared<Ring<u64, 8>>) -> result: unit pure waits {
  for @put (index in 0_u64..5000_u64) {
    atomic items = &queue when items^.len < items^.cap {
      place_back(window: items, value: index);
    }
  }
  return unit;
}

fn consume(queue: Shared<Ring<u64, 8>>, total: Shared<u64>) -> result: unit pure waits {
  for @get (index in 0_u64..5000_u64) {
    let got = 0_u64;
    atomic items = &queue when items^.len > 0_u64 {
      set got = take_front(window: items);
    }
    atomic sum = &total {
      set sum^ = sum^ +wrap got;
    }
  }
  return unit;
}

fn pass_along(queue: &Shared<Ring<u64, 8>>, total: &Shared<u64>) -> result: unit reads(queue), reads(total) waits {
  for @start (index in 0_u64..4_u64) {
    let produced = shared_share::<Ring<u64, 8>>(shared: queue);
    spawn produce(queue: move produced);
    let consumed = shared_share::<Ring<u64, 8>>(shared: queue);
    let summed = shared_share::<u64>(shared: total);
    spawn consume(queue: move consumed, total: move summed);
  }
  return unit;
}

fn low_byte(v: u64) -> result: u8 pure {
  let low = iand(v, 255_u64);
  let byte = cvt::<u64, u8>(low);
  return byte;
}

fn spell(destination: &[u8], at: u64, value: u64) -> result: u64 writes(destination) {
  doc "Writes the eight little-endian bytes of value at the given offset, skipping any slot the range does not have.";
  let cursor = at;
  let rest = value;
  loop @octets {
    let limit = at +wrap 8_u64;
    let done = cursor >= limit;
    if done {
      break @octets;
    }
    let spare = destination^.len;
    let writable = cursor < spare;
    if writable {
      let byte = low_byte(v: rest);
      set destination^[cursor] = byte;
    }
    set rest = irotr(rest, 8_u32);
    set cursor = cursor +wrap 1_u64;
  }
  return at +wrap 8_u64;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  doc "Publishes one prefix of the source range, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let wait_cancel_1 = std::time::cancel_never();
    let wait_outcome_1 = write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &wait_cancel_1);
    std::time::close_cancel_watch(watch: move wait_cancel_1);
    match wait_outcome_1 {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Shared objects reached from many contexts at once: sixteen contexts add to one counter, and four producers and four consumers pass values through one guarded queue. The trial adaptation publishes the computed counter, consumed sum and remaining queue length as three little-endian u64 values before successful exit; error statuses still name the first wrong sum.";
  let Inputs(args: unused_args, drivers: unused_driver_count, cwd: unused_cwd_directory, stdout: out, stderr: unused_stderr, handles: entry_factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: unused_cwd, write: unused_cwd_write) = move unused_cwd_directory;
  std::fs::close_directory_write(factory: &entry_factory, directory: move unused_cwd_write);
  close_directory(factory: &entry_factory, directory: move unused_cwd);
  let counter = shared_new::<u64>(value: 0_u64);
  count_together(counter: &counter);
  let counted = 0_u64;
  atomic count = &counter {
    set counted = count^;
  }
  if counted != 320000_u64 {
    return exit_status(code: 1_u8);
  }
  let empty = ring_new::<u64, 8>();
  let queue = shared_new::<Ring<u64, 8>>(value: move empty);
  let total = shared_new::<u64>(value: 0_u64);
  pass_along(queue: &queue, total: &total);
  let sum = 0_u64;
  atomic seen = &total {
    set sum = seen^;
  }
  if sum != 49990000_u64 {
    return exit_status(code: 2_u8);
  }
  let left = 1_u64;
  atomic items = &queue {
    set left = items^.len;
  }
  if left != 0_u64 {
    return exit_status(code: 3_u8);
  }
  let report = box_array_filled::<u8>(count: 24_u64, value: 0_u8);
  let window = &report.inner[0_u64..24_u64];
  let encoded_0 = spell(destination: window, at: 0_u64, value: counted);
  let encoded_1 = spell(destination: window, at: 8_u64, value: sum);
  let encoded_2 = spell(destination: window, at: 16_u64, value: left);
  match publish_all(factory: &entry_factory, output: &out, source: window, length: 24_u64) {
    Ok(value: published) => {
    }
    Err(error: problem) => {
      return exit_status(code: 4_u8);
    }
  }
  return exit_status(code: 0_u8);
}

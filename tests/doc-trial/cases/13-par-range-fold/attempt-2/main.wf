alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias OutputStream = std::io::OutputStream;
alias HandleFactory = std::io::HandleFactory;
alias CancelWatch = std::time::CancelWatch;

fn process_seed(seed: u64) -> result: u64 pure {
  let state = seed;
  let rotated = irotl(state, 27_u32);
  let mult = state *wrap 6364136223846793005_u64;
  let xored = ixor(rotated, mult);
  let state = xored +wrap 1442695040888963407_u64;
  let rotated = irotl(state, 27_u32);
  let mult = state *wrap 6364136223846793005_u64;
  let xored = ixor(rotated, mult);
  let state = xored +wrap 1442695040888963407_u64;
  let rotated = irotl(state, 27_u32);
  let mult = state *wrap 6364136223846793005_u64;
  let xored = ixor(rotated, mult);
  let state = xored +wrap 1442695040888963407_u64;
  let rotated = irotl(state, 27_u32);
  let mult = state *wrap 6364136223846793005_u64;
  let xored = ixor(rotated, mult);
  let state = xored +wrap 1442695040888963407_u64;
  let rotated = irotl(state, 27_u32);
  let mult = state *wrap 6364136223846793005_u64;
  let xored = ixor(rotated, mult);
  let state = xored +wrap 1442695040888963407_u64;
  let rotated = irotl(state, 27_u32);
  let mult = state *wrap 6364136223846793005_u64;
  let xored = ixor(rotated, mult);
  let state = xored +wrap 1442695040888963407_u64;
  let rotated = irotl(state, 27_u32);
  let mult = state *wrap 6364136223846793005_u64;
  let xored = ixor(rotated, mult);
  let state = xored +wrap 1442695040888963407_u64;
  let rotated = irotl(state, 27_u32);
  let mult = state *wrap 6364136223846793005_u64;
  let xored = ixor(rotated, mult);
  let state = xored +wrap 1442695040888963407_u64;
  let rotated = irotl(state, 27_u32);
  let mult = state *wrap 6364136223846793005_u64;
  let xored = ixor(rotated, mult);
  let state = xored +wrap 1442695040888963407_u64;
  let rotated = irotl(state, 27_u32);
  let mult = state *wrap 6364136223846793005_u64;
  let xored = ixor(rotated, mult);
  let state = xored +wrap 1442695040888963407_u64;
  let rotated = irotl(state, 27_u32);
  let mult = state *wrap 6364136223846793005_u64;
  let xored = ixor(rotated, mult);
  let state = xored +wrap 1442695040888963407_u64;
  let rotated = irotl(state, 27_u32);
  let mult = state *wrap 6364136223846793005_u64;
  let xored = ixor(rotated, mult);
  let state = xored +wrap 1442695040888963407_u64;
  let rotated = irotl(state, 27_u32);
  let mult = state *wrap 6364136223846793005_u64;
  let xored = ixor(rotated, mult);
  let state = xored +wrap 1442695040888963407_u64;
  let rotated = irotl(state, 27_u32);
  let mult = state *wrap 6364136223846793005_u64;
  let xored = ixor(rotated, mult);
  let state = xored +wrap 1442695040888963407_u64;
  let rotated = irotl(state, 27_u32);
  let mult = state *wrap 6364136223846793005_u64;
  let xored = ixor(rotated, mult);
  let state = xored +wrap 1442695040888963407_u64;
  let rotated = irotl(state, 27_u32);
  let mult = state *wrap 6364136223846793005_u64;
  let xored = ixor(rotated, mult);
  let state = xored +wrap 1442695040888963407_u64;
  let rotated = irotl(state, 27_u32);
  let mult = state *wrap 6364136223846793005_u64;
  let xored = ixor(rotated, mult);
  let state = xored +wrap 1442695040888963407_u64;
  let rotated = irotl(state, 27_u32);
  let mult = state *wrap 6364136223846793005_u64;
  let xored = ixor(rotated, mult);
  let state = xored +wrap 1442695040888963407_u64;
  let rotated = irotl(state, 27_u32);
  let mult = state *wrap 6364136223846793005_u64;
  let xored = ixor(rotated, mult);
  let state = xored +wrap 1442695040888963407_u64;
  let rotated = irotl(state, 27_u32);
  let mult = state *wrap 6364136223846793005_u64;
  let xored = ixor(rotated, mult);
  let state = xored +wrap 1442695040888963407_u64;
  let rotated = irotl(state, 27_u32);
  let mult = state *wrap 6364136223846793005_u64;
  let xored = ixor(rotated, mult);
  let state = xored +wrap 1442695040888963407_u64;
  let rotated = irotl(state, 27_u32);
  let mult = state *wrap 6364136223846793005_u64;
  let xored = ixor(rotated, mult);
  let state = xored +wrap 1442695040888963407_u64;
  return state;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: directory, stdout: output, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_meter) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move directory;
  let close_write_result = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let close_read_result = std::fs::close_directory(factory: &factory, directory: move cwd_read);

  let total = 0_u64;
  for (seed in 0_u64..400000_u64) {
    let state = process_seed(seed: seed);
    set total = total +wrap state;
  }

  let bytes = array_filled::<u8, 8>(value: 0_u8);
  let byte0 = cvt.wrap::<u64, u8>(total);
  set bytes[0_u64] = byte0;
  let byte1 = cvt.wrap::<u64, u8>(ishr(total, 8_u32));
  set bytes[1_u64] = byte1;
  let byte2 = cvt.wrap::<u64, u8>(ishr(total, 16_u32));
  set bytes[2_u64] = byte2;
  let byte3 = cvt.wrap::<u64, u8>(ishr(total, 24_u32));
  set bytes[3_u64] = byte3;
  let byte4 = cvt.wrap::<u64, u8>(ishr(total, 32_u32));
  set bytes[4_u64] = byte4;
  let byte5 = cvt.wrap::<u64, u8>(ishr(total, 40_u32));
  set bytes[5_u64] = byte5;
  let byte6 = cvt.wrap::<u64, u8>(ishr(total, 48_u32));
  set bytes[6_u64] = byte6;
  let byte7 = cvt.wrap::<u64, u8>(ishr(total, 56_u32));
  set bytes[7_u64] = byte7;

  let output_bytes = &bytes[0_u64..8_u64];
  let no_deadline = None<std::time::Instant>();
  let cancel = std::time::cancel_never();
  let write_result = std::io::write_once(factory: &factory, output: &output, source: output_bytes, start: 0_u64, end: 8_u64, deadline: no_deadline, cancel: &cancel);
  std::time::close_cancel_watch(watch: move cancel);

  let code = 0_u8;
  match write_result {
    Ok(value: written) => {
      if written != 8_u64 {
        set code = 1_u8;
      }
    }
    Err(error: err) => {
      set code = 1_u8;
    }
  }

  match close_write_result {
    Ok(value: unused_ok) => {
    }
    Err(error: unused_err) => {
    }
  }
  match close_read_result {
    Ok(value: unused_ok) => {
    }
    Err(error: unused_err) => {
    }
  }

  return exit_status(code: code);
}

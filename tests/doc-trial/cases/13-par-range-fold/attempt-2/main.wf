alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias HandleFactory = std::io::HandleFactory;
alias IoError = std::io::IoError;
alias Instant = std::time::Instant;
alias OutputStream = std::io::OutputStream;

fn seed_block_sum(lo: u64, hi: u64) -> result: u64 pure {
  let total = 0_u64;
  for (seed in lo..hi) {
    let state = seed;
    for (step in 0_u64..24_u64) {
      let rotated = irotl(state, 27_u32);
      let scaled = state *wrap 6364136223846793005_u64;
      let mixed = ixor(rotated, scaled);
      set state = mixed +wrap 1442695040888963407_u64;
    }
    set total = total +wrap state;
  }
  return total;
}

fn grand_total() -> result: u64 pure {
  let total = 0_u64;
  for (chunk in 0_u64..400_u64) {
    let lo = chunk *wrap 1000_u64;
    let hi = lo +wrap 1000_u64;
    let part = seed_block_sum(lo: lo, hi: hi);
    set total = total +wrap part;
  }
  return total;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: output, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: directory, write: writable) = move cwd_directory;
  let write_closed = std::fs::close_directory_write(factory: &factory, directory: move writable);
  let read_closed = std::fs::close_directory(factory: &factory, directory: move directory);
  let code = 0_u8;
  match write_closed {
    Ok(value: unused_write_closed) => {
    }
    Err(error: unused_write_error) => {
      set code = 1_u8;
    }
  }
  match read_closed {
    Ok(value: unused_read_closed) => {
    }
    Err(error: unused_read_error) => {
      set code = 1_u8;
    }
  }
  let total = grand_total();
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  let remaining = total;
  for (index in 0_u64..8_u64) {
    set bytes[index] = cvt.wrap::<u64, u8>(remaining);
    set remaining = ishr(remaining, 8_u32);
  }
  let window = &bytes[0_u64..8_u64];
  let published = publish_all(factory: &factory, output: &output, source: window, length: 8_u64);
  match published {
    Ok(value: unused_published) => {
    }
    Err(error: unused_publish_error) => {
      set code = 1_u8;
    }
  }
  return std::process::exit_status(code: code);
}

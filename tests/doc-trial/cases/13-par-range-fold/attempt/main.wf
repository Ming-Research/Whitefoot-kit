alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias Inputs = std::process::Inputs;

fn mixer(state: u64) -> result: u64 pure {
  let current = state;
  let round = 0_u64;
  loop @mixing {
    if round < 24_u64 {
    } else {
      return current;
    }
    let rotated = irotl(current, 27_u32);
    let multiplied = current *wrap 6364136223846793005_u64;
    let xored = ixor(rotated, multiplied);
    set current = xored +wrap 1442695040888963407_u64;
    set round = round +wrap 1_u64;
    continue @mixing;
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: directory, handles: factory, stdout: output, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let total = 0_u64;
  for (seed in 0_u64..400000_u64) {
    let final_state = mixer(state: seed);
    set total = total +wrap final_state;
  }

  let output_bytes = array_filled::<u8, 8>(value: 0_u8);
  set output_bytes[0_u64] = cvt.wrap::<u64, u8>(total);
  let byte1_shifted = ishr(total, 8_u32);
  set output_bytes[1_u64] = cvt.wrap::<u64, u8>(byte1_shifted);
  let byte2_shifted = ishr(total, 16_u32);
  set output_bytes[2_u64] = cvt.wrap::<u64, u8>(byte2_shifted);
  let byte3_shifted = ishr(total, 24_u32);
  set output_bytes[3_u64] = cvt.wrap::<u64, u8>(byte3_shifted);
  let byte4_shifted = ishr(total, 32_u32);
  set output_bytes[4_u64] = cvt.wrap::<u64, u8>(byte4_shifted);
  let byte5_shifted = ishr(total, 40_u32);
  set output_bytes[5_u64] = cvt.wrap::<u64, u8>(byte5_shifted);
  let byte6_shifted = ishr(total, 48_u32);
  set output_bytes[6_u64] = cvt.wrap::<u64, u8>(byte6_shifted);
  let byte7_shifted = ishr(total, 56_u32);
  set output_bytes[7_u64] = cvt.wrap::<u64, u8>(byte7_shifted);

  let buffer = &output_bytes[0_u64..8_u64];
  let sent = 0_u64;
  loop @send_all {
    let pending = sent < 8_u64;
    if pending {
    } else {
      break @send_all;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: &factory, output: &output, source: buffer, start: sent, end: 8_u64, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return exit_status(code: 1_u8);
      }
    }
  }
  return exit_status(code: 0_u8);
}

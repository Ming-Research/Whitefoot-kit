fn main(inputs: std::process::Inputs) -> result: std::process::ExitStatus pure {
  let std::process::Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: out, stderr: unused_err, handles: factory, stdin: unused_input, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;

  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_directory;

  let close_write_result = std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  match move close_write_result {
    Ok(value: ok) => {
    }
    Err(error: err) => {
      return std::process::exit_status(code: 1_u8);
    }
  }

  let close_read_result = std::fs::close_directory(factory: &factory, directory: move cwd_read);
  match move close_read_result {
    Ok(value: ok) => {
    }
    Err(error: err) => {
      return std::process::exit_status(code: 1_u8);
    }
  }

  let total_sum = 0_u64;
  for (seed in 0_u64..400000_u64) {
    let final_state = apply_mixer(state: seed);
    set total_sum = total_sum +wrap final_state;
  }

  let byte0 = cvt.wrap::<u64, u8>(total_sum);
  let shifted1 = ishr(total_sum, 8_u32);
  let byte1 = cvt.wrap::<u64, u8>(shifted1);
  let shifted2 = ishr(total_sum, 16_u32);
  let byte2 = cvt.wrap::<u64, u8>(shifted2);
  let shifted3 = ishr(total_sum, 24_u32);
  let byte3 = cvt.wrap::<u64, u8>(shifted3);
  let shifted4 = ishr(total_sum, 32_u32);
  let byte4 = cvt.wrap::<u64, u8>(shifted4);
  let shifted5 = ishr(total_sum, 40_u32);
  let byte5 = cvt.wrap::<u64, u8>(shifted5);
  let shifted6 = ishr(total_sum, 48_u32);
  let byte6 = cvt.wrap::<u64, u8>(shifted6);
  let shifted7 = ishr(total_sum, 56_u32);
  let byte7 = cvt.wrap::<u64, u8>(shifted7);

  let bytes: Array<u8, 8> = [byte0, byte1, byte2, byte3, byte4, byte5, byte6, byte7];

  let cancel = std::time::cancel_never();

  let write_result = std::io::write_once(factory: &factory, output: &out, source: &bytes[0_u64..8_u64], start: 0_u64, end: 8_u64, deadline: None::<std::time::Instant>(), cancel: &cancel);

  let close_result = std::time::close_cancel_watch(watch: move cancel);

  match move write_result {
    Ok(value: bytes_written) => {
      return std::process::exit_status(code: 0_u8);
    }
    Err(error: err) => {
      return std::process::exit_status(code: 1_u8);
    }
  }
}

fn apply_mixer(state: u64) -> result: u64 pure {
  let current = state;
  let current = mixer_round(state: move current);
  let current = mixer_round(state: move current);
  let current = mixer_round(state: move current);
  let current = mixer_round(state: move current);
  let current = mixer_round(state: move current);
  let current = mixer_round(state: move current);
  let current = mixer_round(state: move current);
  let current = mixer_round(state: move current);
  let current = mixer_round(state: move current);
  let current = mixer_round(state: move current);
  let current = mixer_round(state: move current);
  let current = mixer_round(state: move current);
  let current = mixer_round(state: move current);
  let current = mixer_round(state: move current);
  let current = mixer_round(state: move current);
  let current = mixer_round(state: move current);
  let current = mixer_round(state: move current);
  let current = mixer_round(state: move current);
  let current = mixer_round(state: move current);
  let current = mixer_round(state: move current);
  let current = mixer_round(state: move current);
  let current = mixer_round(state: move current);
  let current = mixer_round(state: move current);
  let current = mixer_round(state: move current);
  return move current;
}

fn mixer_round(state: u64) -> result: u64 pure {
  let rotated = bor(ishl(state, 27_u32), ishr(state, 37_u32));
  let multiplied = state *wrap 6364136223846793005_u64;
  let xored = bxor(rotated, multiplied);
  let result = xored +wrap 1442695040888963407_u64;
  return result;
}

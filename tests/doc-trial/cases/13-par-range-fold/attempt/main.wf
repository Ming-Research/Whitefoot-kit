alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias IoError = std::io::IoError;
alias OutputStream = std::io::OutputStream;

fn mix_seed(seed: u64) -> result: u64 pure {
  let state = seed;
  for (round in 0_u64..24_u64) {
    let rotated = irotl(state, 27_u32);
    let product = state *wrap 6364136223846793005_u64;
    let mixed = ixor(rotated, product);
    set state = mixed +wrap 1442695040888963407_u64;
  }
  return state;
}

fn seed_sum(lo: u64, hi: u64) -> result: u64 pure {
  let total = 0_u64;
  for (seed in lo..hi) {
    let mixed = mix_seed(seed: seed);
    set total = total +wrap mixed;
  }
  return total;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8]) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits {
  let sent = 0_u64;
  loop @publish {
    let pending = sent < source^.len;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: source^.len, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: stdout_stream, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let first = seed_sum(lo: 0_u64, hi: 50000_u64);
  let second = seed_sum(lo: 50000_u64, hi: 100000_u64);
  let third = seed_sum(lo: 100000_u64, hi: 150000_u64);
  let fourth = seed_sum(lo: 150000_u64, hi: 200000_u64);
  let fifth = seed_sum(lo: 200000_u64, hi: 250000_u64);
  let sixth = seed_sum(lo: 250000_u64, hi: 300000_u64);
  let seventh = seed_sum(lo: 300000_u64, hi: 350000_u64);
  let eighth = seed_sum(lo: 350000_u64, hi: 400000_u64);
  let pair_one = first +wrap second;
  let pair_two = third +wrap fourth;
  let pair_three = fifth +wrap sixth;
  let pair_four = seventh +wrap eighth;
  let quad_one = pair_one +wrap pair_two;
  let quad_two = pair_three +wrap pair_four;
  let total = quad_one +wrap quad_two;
  let remaining = total;
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  for (index in 0_u64..8_u64) {
    let low = cvt.wrap::<u64, u8>(remaining);
    set bytes[index] = low;
    set remaining = ishr.wrap(remaining, 8_u32);
  }
  let published = publish_all(factory: &factory, output: &stdout_stream, source: &bytes[0_u64..8_u64]);
  match published {
    Ok(value: written) => {
    }
    Err(error: problem) => {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}

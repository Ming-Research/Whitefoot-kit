alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias Instant = std::time::Instant;
alias IoError = std::io::IoError;

const MULTIPLIER: u64 = 6364136223846793005_u64;
const INCREMENT: u64 = 1442695040888963407_u64;
const ROTATE_AMOUNT: u32 = 27_u32;
const ROUNDS: u64 = 24_u64;
const MAX_SEED: u64 = 400000_u64;

fn mixer(seed: u64) -> result: u64 pure {
  let state = seed;
  for (round in 0_u64..ROUNDS) {
    let rotated = irotl(state, ROTATE_AMOUNT);
    let multiplied = state *wrap MULTIPLIER;
    let xored = ixor(rotated, multiplied);
    set state = xored +wrap INCREMENT;
  }
  return state;
}

fn write_all(factory: &std::io::HandleFactory, output: &std::io::OutputStream, source: &[u8]) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits {
  let sent = 0_u64;
  let length = source^.len;
  loop @publish {
    if sent < length {
    } else {
      break @publish;
    }
    let no_deadline = None<Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: cwd_directory, stdout: stdout, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: directory, write: directory_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory);
  let total = 0_u64;
  for (seed in 0_u64..MAX_SEED) {
    let final_state = mixer(seed: seed);
    set total = total +wrap final_state;
  }
  let output_bytes = array_filled::<u8, 8>(value: 0_u8);
  set output_bytes[0_u64] = cvt.wrap::<u64, u8>(total);
  let shift1 = ishr(total, 8_u32);
  set output_bytes[1_u64] = cvt.wrap::<u64, u8>(shift1);
  let shift2 = ishr(total, 16_u32);
  set output_bytes[2_u64] = cvt.wrap::<u64, u8>(shift2);
  let shift3 = ishr(total, 24_u32);
  set output_bytes[3_u64] = cvt.wrap::<u64, u8>(shift3);
  let shift4 = ishr(total, 32_u32);
  set output_bytes[4_u64] = cvt.wrap::<u64, u8>(shift4);
  let shift5 = ishr(total, 40_u32);
  set output_bytes[5_u64] = cvt.wrap::<u64, u8>(shift5);
  let shift6 = ishr(total, 48_u32);
  set output_bytes[6_u64] = cvt.wrap::<u64, u8>(shift6);
  let shift7 = ishr(total, 56_u32);
  set output_bytes[7_u64] = cvt.wrap::<u64, u8>(shift7);
  let view = &output_bytes[0_u64..8_u64];
  let write_result = write_all(factory: &factory, output: &stdout, source: view);
  match write_result {
    Ok(value: unused_ok) => {
      return exit_status(code: 0_u8);
    }
    Err(error: unused_error) => {
      return exit_status(code: 1_u8);
    }
  }
}

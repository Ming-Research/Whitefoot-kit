alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;

fn mixer_round(state: u64) -> result: u64 pure {
  let rotated = irotl(state, 27_u32);
  let product = state *wrap 6364136223846793005_u64;
  let xored = ixor(rotated, product);
  let result = xored +wrap 1442695040888963407_u64;
  return result;
}

fn apply_rounds(state: u64, rounds: u64) -> result: u64 pure {
  let current = state;
  let count = 0_u64;
  loop {
    if count < rounds {
    } else {
      return current;
    }
    set current = mixer_round(state: current);
    set count = count + 1_u64;
  }
}

fn mix_seed(seed: u64) -> result: u64 pure {
  return apply_rounds(state: seed, rounds: 24_u64);
}

fn sum_range(lower: u64, upper: u64) -> result: u64 pure {
  let sum = 0_u64;
  for (seed in lower..upper) {
    let mixed = mix_seed(seed: seed);
    set sum = sum +wrap mixed;
  }
  return sum;
}

fn worker_task(lower: u64, upper: u64, accumulator: Shared<u64>) -> result: unit pure waits {
  let partial = sum_range(lower: lower, upper: upper);
  atomic total = &accumulator {
    set total^ = total^ +wrap partial;
  }
  return unit;
}

fn write_all(factory: &std::io::HandleFactory, output: &std::io::OutputStream, data: &[u8]) -> result: Result<unit, std::io::IoError> reads(factory), writes(output) waits {
  let sent = 0_u64;
  let datalen = data^.len;
  loop @write_loop {
    if sent < datalen {
    } else {
      break @write_loop;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: data, start: sent, end: datalen, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, std::io::IoError>(error: problem);
      }
    }
  }
  return Ok<unit, std::io::IoError>(value: unit);
}

fn main(inputs: Inputs) -> result: ExitStatus pure waits {
  let Inputs(cwd: cwd_directory, handles: factory, stdout: output, ..) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  std::fs::close_directory(factory: &factory, directory: move cwd_read);

  let accumulator = shared_new::<u64>(value: 0_u64);
  let chunk_size = 100000_u64;
  let offset_1 = 0_u64;
  let offset_2 = chunk_size;
  let offset_3 = chunk_size + chunk_size;
  let offset_4 = chunk_size + chunk_size + chunk_size;

  let handle_1 = shared_share::<u64>(shared: &accumulator);
  spawn worker_task(lower: offset_1, upper: offset_2, accumulator: move handle_1);
  let handle_2 = shared_share::<u64>(shared: &accumulator);
  spawn worker_task(lower: offset_2, upper: offset_3, accumulator: move handle_2);
  let handle_3 = shared_share::<u64>(shared: &accumulator);
  spawn worker_task(lower: offset_3, upper: offset_4, accumulator: move handle_3);
  let handle_4 = shared_share::<u64>(shared: &accumulator);
  spawn worker_task(lower: offset_4, upper: 400000_u64, accumulator: move handle_4);

  let total = 0_u64;
  atomic sum = &accumulator {
    set total = sum^;
  }

  let b0 = cvt::<u64, u8>(total);
  let s1 = ishr(total, 8_u32);
  let b1 = cvt::<u64, u8>(s1);
  let s2 = ishr(total, 16_u32);
  let b2 = cvt::<u64, u8>(s2);
  let s3 = ishr(total, 24_u32);
  let b3 = cvt::<u64, u8>(s3);
  let s4 = ishr(total, 32_u32);
  let b4 = cvt::<u64, u8>(s4);
  let s5 = ishr(total, 40_u32);
  let b5 = cvt::<u64, u8>(s5);
  let s6 = ishr(total, 48_u32);
  let b6 = cvt::<u64, u8>(s6);
  let s7 = ishr(total, 56_u32);
  let b7 = cvt::<u64, u8>(s7);

  let buffer = slots_new::<u8, 8>();
  place_back(window: &buffer, value: b0);
  place_back(window: &buffer, value: b1);
  place_back(window: &buffer, value: b2);
  place_back(window: &buffer, value: b3);
  place_back(window: &buffer, value: b4);
  place_back(window: &buffer, value: b5);
  place_back(window: &buffer, value: b6);
  place_back(window: &buffer, value: b7);

  let buf_slice = &buffer[0_u64..8_u64];
  let write_result = write_all(factory: &factory, output: &output, data: buf_slice);
  match write_result {
    Ok(value: unused_ok) => {
      return exit_status(code: 0_u8);
    }
    Err(error: unused_error) => {
      return exit_status(code: 1_u8);
    }
  }
}

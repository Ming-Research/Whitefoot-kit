alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;

fn mixer_round(state: u64) -> result: u64 pure {
  let rotated = irotl(state, 27_u32);
  let product = state *wrap 6364136223846793005_u64;
  let xored = ixor(rotated, product);
  let result = xored +wrap 1442695040888963407_u64;
  return result;
}

fn mix_seed(seed: u64) -> result: u64 pure {
  let state = seed;
  let state = mixer_round(state: state);
  let state = mixer_round(state: state);
  let state = mixer_round(state: state);
  let state = mixer_round(state: state);
  let state = mixer_round(state: state);
  let state = mixer_round(state: state);
  let state = mixer_round(state: state);
  let state = mixer_round(state: state);
  let state = mixer_round(state: state);
  let state = mixer_round(state: state);
  let state = mixer_round(state: state);
  let state = mixer_round(state: state);
  let state = mixer_round(state: state);
  let state = mixer_round(state: state);
  let state = mixer_round(state: state);
  let state = mixer_round(state: state);
  let state = mixer_round(state: state);
  let state = mixer_round(state: state);
  let state = mixer_round(state: state);
  let state = mixer_round(state: state);
  let state = mixer_round(state: state);
  let state = mixer_round(state: state);
  let state = mixer_round(state: state);
  let state = mixer_round(state: state);
  return state;
}

fn sum_range(lower: u64, upper: u64) -> result: u64 pure {
  let sum = 0_u64;
  for (seed in lower..upper) {
    let mixed = mix_seed(seed: seed);
    set sum = sum +wrap mixed;
  }
  return sum;
}

fn worker_task(lower: u64, upper: u64, accumulator: Shared<u64>) -> result: unit pure waits {
  let partial = sum_range(lower: lower, upper: upper);
  atomic total = &accumulator {
    set total^ = total^ +wrap partial;
  }
  return unit;
}

fn write_u64_le(factory: &std::io::HandleFactory, output: &std::io::OutputStream, value: u64) -> result: Result<unit, std::io::IoError> reads(factory), writes(output) waits {
  let byte0 = cvt::<u64, u8>(value);
  let s1 = ishr(value, 8_u32);
  let byte1 = cvt::<u64, u8>(s1);
  let s2 = ishr(value, 16_u32);
  let byte2 = cvt::<u64, u8>(s2);
  let s3 = ishr(value, 24_u32);
  let byte3 = cvt::<u64, u8>(s3);
  let s4 = ishr(value, 32_u32);
  let byte4 = cvt::<u64, u8>(s4);
  let s5 = ishr(value, 40_u32);
  let byte5 = cvt::<u64, u8>(s5);
  let s6 = ishr(value, 48_u32);
  let byte6 = cvt::<u64, u8>(s6);
  let s7 = ishr(value, 56_u32);
  let byte7 = cvt::<u64, u8>(s7);
  let bytes = array_filled::<u8, 8>(value: byte0);
  set bytes[1_u64] = byte1;
  set bytes[2_u64] = byte2;
  set bytes[3_u64] = byte3;
  set bytes[4_u64] = byte4;
  set bytes[5_u64] = byte5;
  set bytes[6_u64] = byte6;
  set bytes[7_u64] = byte7;
  let window = &bytes[0_u64..8_u64];
  let sent = 0_u64;
  loop @write_loop {
    let pending = sent < 8_u64;
    if pending {
    } else {
      break @write_loop;
    }
    let no_deadline = None<std::time::Instant>();
    let cancel = std::time::cancel_never();
    let outcome = std::io::write_once(factory: factory, output: output, source: window, start: sent, end: 8_u64, deadline: no_deadline, cancel: &cancel);
    std::time::close_cancel_watch(watch: move cancel);
    match outcome {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, std::io::IoError>(error: problem);
      }
    }
  }
  return Ok<unit, std::io::IoError>(value: unit);
}

fn main(inputs: Inputs) -> result: ExitStatus pure waits {
  let Inputs(cwd: cwd_directory, handles: factory, stdout: output, ..) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  std::fs::close_directory(factory: &factory, directory: move cwd_read);

  let accumulator = shared_new::<u64>(value: 0_u64);
  let chunk_size = 100000_u64;
  let offset_1 = 0_u64;
  let offset_2 = chunk_size;
  let offset_3 = chunk_size + chunk_size;
  let offset_4 = chunk_size + chunk_size + chunk_size;

  let handle_1 = shared_share::<u64>(shared: &accumulator);
  spawn worker_task(lower: offset_1, upper: offset_2, accumulator: move handle_1);
  let handle_2 = shared_share::<u64>(shared: &accumulator);
  spawn worker_task(lower: offset_2, upper: offset_3, accumulator: move handle_2);
  let handle_3 = shared_share::<u64>(shared: &accumulator);
  spawn worker_task(lower: offset_3, upper: offset_4, accumulator: move handle_3);
  let handle_4 = shared_share::<u64>(shared: &accumulator);
  spawn worker_task(lower: offset_4, upper: 400000_u64, accumulator: move handle_4);

  let total = 0_u64;
  atomic sum = &accumulator {
    set total = sum^;
  }

  let write_result = write_u64_le(factory: &factory, output: &output, value: total);
  match write_result {
    Ok(value: unused_ok) => {
      return exit_status(code: 0_u8);
    }
    Err(error: unused_error) => {
      return exit_status(code: 1_u8);
    }
  }
}

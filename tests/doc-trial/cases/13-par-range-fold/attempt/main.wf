alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;

const mix_multiplier: u64 = 6364136223846793005_u64;
const mix_addend: u64 = 1442695040888963407_u64;
const mix_rounds: u64 = 24_u64;

fn mix_one(state: u64) -> result: u64 pure {
  let rotated = irotl(state, 27_u32);
  let multiplied = state *wrap mix_multiplier;
  let xored = ixor(rotated, multiplied);
  let result = xored +wrap mix_addend;
  return result;
}

fn fold_range(lo: u64, hi: u64) -> result: u64 pure {
  let total = 0_u64;
  for (seed in lo..hi) {
    let state = seed;
    for (round in 0_u64..mix_rounds) {
      set state = mix_one(state: state);
    }
    set total = total +wrap state;
  }
  return total;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: unused_args, drivers: unused_drivers, cwd: directory, stdout: output, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  let close_write = std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  let close_read = std::fs::close_directory(factory: &factory, directory: move directory_read);
  match close_write {
    Ok(value: unused_ok) => {
    }
    Err(error: unused_err) => {
    }
  }
  match close_read {
    Ok(value: unused_ok2) => {
    }
    Err(error: unused_err2) => {
    }
  }

  let a = fold_range(lo: 0_u64, hi: 100000_u64);
  let b = fold_range(lo: 100000_u64, hi: 200000_u64);
  let c = fold_range(lo: 200000_u64, hi: 300000_u64);
  let d = fold_range(lo: 300000_u64, hi: 400000_u64);
  let sum = a +wrap b;
  let sum = sum +wrap c;
  let sum = sum +wrap d;

  let buffer = array_filled::<u8, 8>(value: 0_u8);
  set buffer[0_u64] = cvt.wrap::<u64, u8>(sum);
  let shift1 = ishr(sum, 8_u32);
  set buffer[1_u64] = cvt.wrap::<u64, u8>(shift1);
  let shift2 = ishr(sum, 16_u32);
  set buffer[2_u64] = cvt.wrap::<u64, u8>(shift2);
  let shift3 = ishr(sum, 24_u32);
  set buffer[3_u64] = cvt.wrap::<u64, u8>(shift3);
  let shift4 = ishr(sum, 32_u32);
  set buffer[4_u64] = cvt.wrap::<u64, u8>(shift4);
  let shift5 = ishr(sum, 40_u32);
  set buffer[5_u64] = cvt.wrap::<u64, u8>(shift5);
  let shift6 = ishr(sum, 48_u32);
  set buffer[6_u64] = cvt.wrap::<u64, u8>(shift6);
  let shift7 = ishr(sum, 56_u32);
  set buffer[7_u64] = cvt.wrap::<u64, u8>(shift7);

  let window = &buffer[0_u64..8_u64];
  let no_deadline = None<std::time::Instant>();
  let cancel = std::time::cancel_never();
  let outcome = std::io::write_once(factory: &factory, output: &output, source: window, start: 0_u64, end: 8_u64, deadline: no_deadline, cancel: &cancel);
  std::time::close_cancel_watch(watch: move cancel);

  match outcome {
    Ok(value: written) => {
      if written == 8_u64 {
        return exit_status(code: 0_u8);
      } else {
        return exit_status(code: 1_u8);
      }
    }
    Err(error: problem) => {
      return exit_status(code: 1_u8);
    }
  }
}

alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias write_once = std::io::write_once;

fn low_byte(v: u64) -> result: u8 pure {
  let low = iand(v, 255_u64);
  let byte = cvt::<u64, u8>(low);
  return byte;
}

fn spell(destination: &[u8], at: u64, value: u64) -> result: u64 writes(destination) {
  doc "Writes the eight little-endian bytes of value at the given offset, skipping any slot the range does not have.";
  let cursor = at;
  let rest = value;
  loop @octets {
    let limit = at +wrap 8_u64;
    let done = cursor >= limit;
    if done {
      break @octets;
    }
    let spare = destination^.len;
    let writable = cursor < spare;
    if writable {
      let byte = low_byte(v: rest);
      set destination^[cursor] = byte;
    }
    set rest = irotr(rest, 8_u32);
    set cursor = cursor +wrap 1_u64;
  }
  return at +wrap 8_u64;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  doc "Publishes one prefix of the source range, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let wait_cancel_1 = std::time::cancel_never();
    let wait_outcome_1 = write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &wait_cancel_1);
    std::time::close_cancel_watch(watch: move wait_cancel_1);
    match wait_outcome_1 {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn publish_report(factory: &HandleFactory, output: &OutputStream, source: &[u8]) -> status: ExitStatus reads(source), writes(factory), writes(output) waits {
  doc "Trial adaptation: publish the actual observations with the maintained stdin_echo partial-write retry; status 250 reports publication failure.";
  let length = source^.len;
  match publish_all(factory: factory, output: output, source: source, length: length) {
    Ok(value: published) => {
      return exit_status(code: 0_u8);
    }
    Err(error: problem) => {
      return exit_status(code: 250_u8);
    }
  }
}

const names: Array<u8, 8> =[97_u8, 98_u8, 99_u8, 100_u8, 101_u8, 102_u8, 103_u8, 104_u8];

struct Totals {
  total: u64;
}

fn prefixes() -> keys: KeySet pure {
  doc "The eight prefixes of the name in first-insertion order, shortest first.";
  let keys = key_set_new(capacity: 8_u64);
  for @key (at in 1_u64..9_u64) {
    key_set_insert(keys: &keys, key: &names[0_u64..at]);
  }
  return move keys;
}

fn bump_keys(store: Shared<Totals>, store_map: Shared<ConcurrentHashMap<u64>>) -> result: unit pure waits {
  for @round (index in 0_u64..2000_u64) {
    for @key (at in 1_u64..9_u64) {
      let key = &names[0_u64..at];
      atomic slot = &store_map[key], s = &store {
        match slot^ {
          Some(value: seen) => {
            let next = seen^ +wrap 1_u64;
            set slot^ = Some<u64>(value: next);
          }
          None() => {
            set slot^ = Some<u64>(value: 1_u64);
          }
        }
        set s^.total = s^.total +wrap 1_u64;
      }
    }
  }
  return unit;
}

fn watch_sums(store: Shared<Totals>, store_map: Shared<ConcurrentHashMap<u64>>, mismatches: Shared<u64>) -> result: unit pure waits {
  let keys = prefixes();
  for @look (index in 0_u64..300_u64) {
    let sum = 0_u64;
    let counted = 0_u64;
    atomic all = &store_map[keys], s = &store {
      for @key (at in 0_u64..all^.len) {
        match all^[at] {
          Some(value: seen) => {
            set sum = sum +wrap seen^;
          }
          None() => {
          }
        }
      }
      set counted = s^.total;
    }
    if sum != counted {
      atomic wrong = &mismatches {
        set wrong^ = wrong^ +wrap 1_u64;
      }
    }
  }
  return unit;
}

fn bump_together(store: &Shared<Totals>, store_map: &Shared<ConcurrentHashMap<u64>>, mismatches: &Shared<u64>) -> result: unit reads(store), reads(mismatches), reads(store_map) waits {
  for @start (index in 0_u64..8_u64) {
    let handle = shared_share::<Totals>(shared: store);
    let handle_map = shared_share::<ConcurrentHashMap<u64>>(shared: store_map);
    spawn bump_keys(store: move handle, store_map: move handle_map);
  }
  for @watch (index in 0_u64..2_u64) {
    let handle = shared_share::<Totals>(shared: store);
    let handle_map = shared_share::<ConcurrentHashMap<u64>>(shared: store_map);
    let seen = shared_share::<u64>(shared: mismatches);
    spawn watch_sums(store: move handle, store_map: move handle_map, mismatches: move seen);
  }
  return unit;
}

fn main(inputs: std::process::Inputs) -> status: ExitStatus pure waits {
  doc "One shared map and a separate totals object reached from ten contexts at once: eight each add one to the entries under eight keys, the prefixes of one name, two thousand times, and to the state's total in the same statement; two others hold the entries of all eight keys three hundred times each and compare their sum with the total, which agree whenever no other statement is under way. A statement then counts the entries and reads each, another removes one, and a last counts again. Every order of the statements gives the same counts, so the status is 0 on every driver count and names the first wrong one otherwise.";
  let std::process::Inputs(args: unused_args, drivers: unused_driver_count, cwd: directory, stdout: out, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let values = slots_new::<u64, 8>();
  for (
    at in 0_u64..8_u64,
    invariant grown: values.len == at
  ) {
    place_back(window: &values, value: 0_u64);
  }
  let store_map = shared_map_new::<u64>(capacity: 0_u64);
  let state = Totals(total: 0_u64);
  let store = shared_new::<Totals>(value: state);
  let mismatches = shared_new::<u64>(value: 0_u64);
  bump_together(store: &store, store_map: &store_map, mismatches: &mismatches);
  let counted = 0_u64;
  let wrong = 0_u64;
  let keys = prefixes();
  atomic t = &store_map {
    let all = &t^[keys];
    set counted = map_count::<u64>(map: t);
    for @check (at in 0_u64..all^.len) {
      match all^[at] {
        Some(value: seen) => {
          if at < 8_u64 {
            set values[at] = seen^;
          }
          if seen^ != 16000_u64 {
            set wrong = wrong +wrap 1_u64;
          }
        }
        None() => {
          set wrong = wrong +wrap 1_u64;
        }
      }
    }
  }
  if counted != 8_u64 {
    return exit_status(code: 1_u8);
  }
  if wrong != 0_u64 {
    return exit_status(code: 2_u8);
  }
  let first = &names[0_u64..1_u64];
  atomic slot = &store_map[first] {
    set slot^ = None<u64>();
  }
  let left = 0_u64;
  atomic t = &store_map {
    set left = map_count::<u64>(map: t);
  }
  if left != 7_u64 {
    return exit_status(code: 3_u8);
  }
  let sum = 0_u64;
  atomic s = &store {
    set sum = s^.total;
  }
  if sum != 128000_u64 {
    return exit_status(code: 4_u8);
  }
  let missed = 0_u64;
  atomic noted = &mismatches {
    set missed = noted^;
  }
  if missed != 0_u64 {
    return exit_status(code: 5_u8);
  }
  let report = slots_new::<u8, 96>();
  for (
    at in 0_u64..96_u64,
    invariant grown: report.len == at
  ) {
    place_back(window: &report, value: 0_u8);
  }
  let window = &report[0_u64..96_u64];
  for (at in 0_u64..8_u64) {
    let offset = at *wrap 8_u64;
    let recorded = spell(destination: window, at: offset, value: values[at]);
  }
  let recorded_count = spell(destination: window, at: 64_u64, value: counted);
  let recorded_total = spell(destination: window, at: 72_u64, value: sum);
  let recorded_missed = spell(destination: window, at: 80_u64, value: missed);
  let recorded_left = spell(destination: window, at: 88_u64, value: left);
  return publish_report(factory: &factory, output: &out, source: window);
}

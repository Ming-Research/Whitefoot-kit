alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias write_once = std::io::write_once;
alias Clock = std::time::Clock;
alias Instant = std::time::Instant;
alias now = std::time::now;
alias instant_after = std::time::instant_after;
alias instant_reached = std::time::instant_reached;
alias sleep_until = std::time::sleep_until;

fn deadline_timer(deadline: Instant, source: std::time::CancelSource, disarm: std::time::CancelWatch) -> result: Bool pure waits {
  let outcome = sleep_until(deadline: deadline, cancel: &disarm);
  std::time::close_cancel_watch(watch: move disarm);
  let elapsed = match outcome {
    Ok(value: slept) => {
      std::time::cancel_fire(source: &source);
      give True();
    }
    Err(error: cancelled) => {
      give False();
    }
  }
  std::time::close_cancel_source(source: move source);
  return elapsed;
}

fn deadline_competition(clock: &Clock, ready: Bool) -> result: Bool writes(clock) waits {
  let timer_source = std::time::cancel_source();
  let timer_watch = std::time::cancel_watch(source: &timer_source);
  let timeout = std::time::cancel_state(watch: &timer_watch);
  std::time::close_cancel_watch(watch: move timer_watch);
  let disarm_source = std::time::cancel_source();
  let disarm_watch = std::time::cancel_watch(source: &disarm_source);
  let work = shared_new::<Bool>(value: ready);
  let delay = if ready {
    give 60000000000_u64;
  } else {
    give 10000000_u64;
  }
  let begin = now(clock: clock);
  let deadline = instant_after(instant: begin, nanoseconds: delay);
  let timer_elapsed = spawn deadline_timer(deadline: deadline, source: move timer_source, disarm: move disarm_watch);
  let saw_timeout = False();
  atomic item = &work, timer = &timeout when bor(item^, timer^.fired) {
    set saw_timeout = timer^.fired;
  }
  std::time::cancel_fire(source: &disarm_source);
  std::time::close_cancel_source(source: move disarm_source);
  let joined = timer_elapsed;
  let ended = now(clock: clock);
  let reached = instant_reached(deadline: deadline, instant: ended);
  if ready {
    let quiet_timer = bnot(joined);
    let ready_won = bnot(saw_timeout);
    let correct = band(quiet_timer, ready_won);
    let prompt = bnot(reached);
    return band(correct, prompt);
  }
  return band(saw_timeout, joined);
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  doc "Publishes one prefix of the source range, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let wait_cancel_1 = std::time::cancel_never();
    let wait_outcome_1 = write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &wait_cancel_1);
    std::time::close_cancel_watch(watch: move wait_cancel_1);
    match wait_outcome_1 {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn publish_report(factory: &HandleFactory, output: &OutputStream, source: &[u8]) -> status: ExitStatus reads(source), writes(factory), writes(output) waits {
  doc "Trial adaptation: publish the actual observations with the maintained stdin_echo partial-write retry; status 250 reports publication failure.";
  let length = source^.len;
  match publish_all(factory: factory, output: output, source: source, length: length) {
    Ok(value: published) => {
      return exit_status(code: 0_u8);
    }
    Err(error: problem) => {
      return exit_status(code: 250_u8);
    }
  }
}

fn main(inputs: std::process::Inputs) -> status: ExitStatus pure waits {
  let std::process::Inputs(args: unused_args, drivers: unused_driver_count, cwd: directory, stdout: out, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let ready = True();
  let work_won = deadline_competition(clock: &clock, ready: ready);
  let unready = False();
  let timer_won = deadline_competition(clock: &clock, ready: unready);
  let work_byte = if work_won {
    give 1_u8;
  } else {
    give 0_u8;
  }
  let timer_byte = if timer_won {
    give 1_u8;
  } else {
    give 0_u8;
  }
  let report = slots_new::<u8, 2>();
  place_back(window: &report, value: work_byte);
  place_back(window: &report, value: timer_byte);
  return publish_report(factory: &factory, output: &out, source: &report[0_u64..2_u64]);
}

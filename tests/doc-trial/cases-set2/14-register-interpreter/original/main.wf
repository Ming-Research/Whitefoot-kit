alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias write_once = std::io::write_once;

struct Op {
  kind: u8;
  a: u8;
  b: u8;
  target: u64;
}

fn run(ops: &Box<Slots<Op>>, regs: &Box<Slots<u64>>, base0: u64, room: u64) -> r: u64 reads(ops), writes(regs) contract {
  requires base0 <= room;
  requires room + 256_u64 <= regs^.inner.len;
  requires 1_u64 <= ops^.inner.len;
  ensures regs^.inner.len == entry(regs)^.inner.len;
} {
  let n = ops^.inner.len;
  let pc = 0_u64;
  let base = base0;
  loop (
    invariant inside: pc < n,
    invariant frame: base <= room
  ) {
    let op = ops^.inner[pc];
    let ai = cvt::<u8, u64>(op.a);
    let ra = base + ai;
    if op.kind == 0_u8 {
      let out = regs^.inner[ra];
      return out;
    } else if op.kind == 1_u8 {
      let t = op.target;
      if t < n {
        set pc = t;
      } else {
        return 0_u64;
      }
      if t <= room {
        set base = t;
      } else {
        return 0_u64;
      }
    } else {
      let bi = cvt::<u8, u64>(op.b);
      let rb = base + bi;
      let v = regs^.inner[rb];
      set regs^.inner[ra] = v;
      let next = pc + 1_u64;
      if next < n {
        set pc = next;
      } else {
        return 0_u64;
      }
    }
  }
}

fn low_byte(v: u64) -> result: u8 pure {
  let low = iand(v, 255_u64);
  let byte = cvt::<u64, u8>(low);
  return byte;
}

fn spell(destination: &[u8], at: u64, value: u64) -> result: u64 writes(destination) {
  doc "Writes the eight little-endian bytes of value at the given offset, skipping any slot the range does not have.";
  let cursor = at;
  let rest = value;
  loop @octets {
    let limit = at +wrap 8_u64;
    let done = cursor >= limit;
    if done {
      break @octets;
    }
    let spare = destination^.len;
    let writable = cursor < spare;
    if writable {
      let byte = low_byte(v: rest);
      set destination^[cursor] = byte;
    }
    set rest = irotr(rest, 8_u32);
    set cursor = cursor +wrap 1_u64;
  }
  return at +wrap 8_u64;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  doc "Publishes one prefix of the source range, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let wait_cancel_1 = std::time::cancel_never();
    let wait_outcome_1 = write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &wait_cancel_1);
    std::time::close_cancel_watch(watch: move wait_cancel_1);
    match wait_outcome_1 {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn publish_report(factory: &HandleFactory, output: &OutputStream, source: &[u8]) -> status: ExitStatus reads(source), writes(factory), writes(output) waits {
  doc "Trial adaptation: publish the actual observations with the maintained stdin_echo partial-write retry; status 250 reports publication failure.";
  let length = source^.len;
  match publish_all(factory: factory, output: output, source: source, length: length) {
    Ok(value: published) => {
      return exit_status(code: 0_u8);
    }
    Err(error: problem) => {
      return exit_status(code: 250_u8);
    }
  }
}

fn main(inputs: std::process::Inputs) -> status: ExitStatus pure waits {
  let std::process::Inputs(args: unused_args, drivers: unused_driver_count, cwd: directory, stdout: out, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let ops = box_slots_new::<Op>(capacity: 4_u64);
  for (
    at in 0_u64..4_u64,
    invariant grown: ops.inner.len == at
  ) {
    let placeholder = Op(kind: 0_u8, a: 0_u8, b: 0_u8, target: 0_u64);
    place_back(window: &ops.inner, value: placeholder);
  }
  set ops.inner[0_u64] = Op(kind: 2_u8, a: 0_u8, b: 1_u8, target: 0_u64);
  set ops.inner[1_u64] = Op(kind: 1_u8, a: 0_u8, b: 0_u8, target: 2_u64);
  set ops.inner[2_u64] = Op(kind: 255_u8, a: 0_u8, b: 1_u8, target: 0_u64);
  set ops.inner[3_u64] = Op(kind: 0_u8, a: 0_u8, b: 0_u8, target: 0_u64);
  let regs = box_slots_new::<u64>(capacity: 260_u64);
  for (
    at in 0_u64..260_u64,
    invariant grown: regs.inner.len == at
  ) {
    place_back(window: &regs.inner, value: 0_u64);
  }
  set regs.inner[1_u64] = 77_u64;
  set regs.inner[3_u64] = 99_u64;
  let returned = run(ops: &ops, regs: &regs, base0: 0_u64, room: 4_u64);
  let copied_first = regs.inner[0_u64];
  let copied_second = regs.inner[2_u64];
  set ops.inner[0_u64] = Op(kind: 1_u8, a: 0_u8, b: 0_u8, target: 4_u64);
  let outside_code = run(ops: &ops, regs: &regs, base0: 0_u64, room: 4_u64);
  set ops.inner[0_u64] = Op(kind: 1_u8, a: 0_u8, b: 0_u8, target: 2_u64);
  let outside_frame = run(ops: &ops, regs: &regs, base0: 0_u64, room: 1_u64);
  set ops.inner[0_u64] = Op(kind: 2_u8, a: 0_u8, b: 1_u8, target: 0_u64);
  set ops.inner[3_u64] = Op(kind: 2_u8, a: 0_u8, b: 1_u8, target: 0_u64);
  let past_end = run(ops: &ops, regs: &regs, base0: 0_u64, room: 4_u64);
  set ops.inner[0_u64] = Op(kind: 0_u8, a: 1_u8, b: 0_u8, target: 0_u64);
  let based_return = run(ops: &ops, regs: &regs, base0: 2_u64, room: 4_u64);
  let report = slots_new::<u8, 56>();
  for (
    at in 0_u64..56_u64,
    invariant grown: report.len == at
  ) {
    place_back(window: &report, value: 0_u8);
  }
  let window = &report[0_u64..56_u64];
  let recorded_return = spell(destination: window, at: 0_u64, value: returned);
  let recorded_first = spell(destination: window, at: 8_u64, value: copied_first);
  let recorded_second = spell(destination: window, at: 16_u64, value: copied_second);
  let recorded_code = spell(destination: window, at: 24_u64, value: outside_code);
  let recorded_frame = spell(destination: window, at: 32_u64, value: outside_frame);
  let recorded_end = spell(destination: window, at: 40_u64, value: past_end);
  let recorded_based = spell(destination: window, at: 48_u64, value: based_return);
  return publish_report(factory: &factory, output: &out, source: window);
}

alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias MemoryMeter = std::process::MemoryMeter;
alias exit_status = std::process::exit_status;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias write_once = std::io::write_once;

struct ReleasePair {
  left: Box<u64>;
  right: Box<Slots<u8>>;
}

fn measure_release(meter: &MemoryMeter, report: &[u8]) -> result: u8 writes(meter), writes(report) {
  doc "Trial adaptation: serialize the measured relative heap readings and owned values before consuming each owner.";
  let before = std::process::heap_in_use(meter: meter);
  let released = box_slots_new::<Box<u64>>(capacity: 4_u64);
  let element = box_new::<u64>(value: 73_u64);
  place_back(window: &released.inner, value: move element);
  let held = std::process::heap_in_use(meter: meter);
  if held <= before {
    return 20_u8;
  }
  let report_value_nested_heap = held -wrap before;
  let recorded_nested_heap = spell(destination: report, at: 0_u64, value: report_value_nested_heap);
  let recorded_nested_value = spell(destination: report, at: 48_u64, value: released.inner[0_u64].inner);
  release::<Box<Slots<Box<u64>>>>(value: move released);
  let after = std::process::heap_in_use(meter: meter);
  if after != before {
    return 21_u8;
  }
  let report_value_nested_release = after -wrap before;
  let recorded_nested_release = spell(destination: report, at: 8_u64, value: report_value_nested_release);
  let empty = box_slots_new::<u8>(capacity: 0_u64);
  let empty_held = std::process::heap_in_use(meter: meter);
  if empty_held < before {
    return 22_u8;
  }
  let report_value_empty_heap = empty_held -wrap before;
  let recorded_empty_heap = spell(destination: report, at: 16_u64, value: report_value_empty_heap);
  release::<Box<Slots<u8>>>(value: move empty);
  let empty_after = std::process::heap_in_use(meter: meter);
  if empty_after != before {
    return 23_u8;
  }
  let report_value_empty_release = empty_after -wrap before;
  let recorded_empty_release = spell(destination: report, at: 24_u64, value: report_value_empty_release);
  let left = box_new::<u64>(value: 73_u64);
  let right = box_slots_new::<u8>(capacity: 4_u64);
  place_back(window: &right.inner, value: 7_u8);
  let pair = ReleasePair(left: move left, right: move right);
  let pair_held = std::process::heap_in_use(meter: meter);
  if pair_held <= before {
    return 24_u8;
  }
  let report_value_pair_heap = pair_held -wrap before;
  let recorded_pair_heap = spell(destination: report, at: 32_u64, value: report_value_pair_heap);
  let recorded_pair_left = spell(destination: report, at: 56_u64, value: pair.left.inner);
  let report_value_pair_right = cvt::<u8, u64>(pair.right.inner[0_u64]);
  let recorded_pair_right = spell(destination: report, at: 64_u64, value: report_value_pair_right);
  release::<ReleasePair>(value: move pair);
  let pair_after = std::process::heap_in_use(meter: meter);
  if pair_after != before {
    return 25_u8;
  }
  let report_value_pair_release = pair_after -wrap before;
  let recorded_pair_release = spell(destination: report, at: 40_u64, value: report_value_pair_release);
  return 0_u8;
}

fn low_byte(v: u64) -> result: u8 pure {
  let low = iand(v, 255_u64);
  let byte = cvt::<u64, u8>(low);
  return byte;
}

fn spell(destination: &[u8], at: u64, value: u64) -> result: u64 writes(destination) {
  doc "Writes the eight little-endian bytes of value at the given offset, skipping any slot the range does not have.";
  let cursor = at;
  let rest = value;
  loop @octets {
    let limit = at +wrap 8_u64;
    let done = cursor >= limit;
    if done {
      break @octets;
    }
    let spare = destination^.len;
    let writable = cursor < spare;
    if writable {
      let byte = low_byte(v: rest);
      set destination^[cursor] = byte;
    }
    set rest = irotr(rest, 8_u32);
    set cursor = cursor +wrap 1_u64;
  }
  return at +wrap 8_u64;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  doc "Publishes one prefix of the source range, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let wait_cancel_1 = std::time::cancel_never();
    let wait_outcome_1 = write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &wait_cancel_1);
    std::time::close_cancel_watch(watch: move wait_cancel_1);
    match wait_outcome_1 {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn publish_report(factory: &HandleFactory, output: &OutputStream, source: &[u8]) -> status: ExitStatus reads(source), writes(factory), writes(output) waits {
  doc "Trial adaptation: publish the actual observations with the maintained stdin_echo partial-write retry; status 250 reports publication failure.";
  let length = source^.len;
  match publish_all(factory: factory, output: output, source: source, length: length) {
    Ok(value: published) => {
      return exit_status(code: 0_u8);
    }
    Err(error: problem) => {
      return exit_status(code: 250_u8);
    }
  }
}

fn main(inputs: std::process::Inputs) -> status: ExitStatus pure waits {
  doc "Trial adaptation: call only the selected release routine, retaining a frame-resident report and publishing after reclamation.";
  let std::process::Inputs(args: unused_args, drivers: unused_driver_count, cwd: directory, stdout: out, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: meter) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let report = array_filled::<u8, 72>(value: 0_u8);
  let report_window = &report[0_u64..72_u64];
  let code = measure_release(meter: &meter, report: report_window);
  if code != 0_u8 {
    return exit_status(code: code);
  }
  return publish_report(factory: &factory, output: &out, source: report_window);
}

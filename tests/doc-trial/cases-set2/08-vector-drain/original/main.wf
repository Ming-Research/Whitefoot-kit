alias ExitStatus = std::process::ExitStatus;
alias VectorDrain = std::collections::vector::VectorDrain;
alias exit_status = std::process::exit_status;
alias grow_vector_append = std::collections::vector::grow_vector_append;
alias grow_vector_drain = std::collections::vector::grow_vector_drain;
alias grow_vector_free_empty = std::collections::vector::grow_vector_free_empty;
alias grow_vector_insert = std::collections::vector::grow_vector_insert;
alias grow_vector_new = std::collections::vector::grow_vector_new;
alias grow_vector_remove = std::collections::vector::grow_vector_remove;
alias grow_vector_reserve = std::collections::vector::grow_vector_reserve;
alias grow_vector_swap_remove = std::collections::vector::grow_vector_swap_remove;
alias grow_vector_truncate = std::collections::vector::grow_vector_truncate;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias IoError = std::io::IoError;
alias write_once = std::io::write_once;

struct Sum {
  total: u64;
  sequence: u64;
  count: u64;
}

fn sum_accept(env: &Sum, value: u64) -> result: unit writes(env) {
  doc "One drain member: folds each drained value into the caller's accumulator through the reference the row declares.";
  let running = env^.total;
  set env^.total = running +wrap value;
  let prefix = env^.sequence *wrap 257_u64;
  set env^.sequence = prefix +wrap value;
  set env^.count = env^.count +wrap 1_u64;
  return unit;
}

binding SumDrain : VectorDrain<u64, Sum> {
  accept = sum_accept;
}

fn low_byte(v: u64) -> result: u8 pure {
  let low = iand(v, 255_u64);
  let byte = cvt::<u64, u8>(low);
  return byte;
}

fn spell(destination: &[u8], at: u64, value: u64) -> result: u64 writes(destination) {
  doc "Writes the eight little-endian bytes of value at the given offset, skipping any slot the range does not have.";
  let cursor = at;
  let rest = value;
  loop @octets {
    let limit = at +wrap 8_u64;
    let done = cursor >= limit;
    if done {
      break @octets;
    }
    let spare = destination^.len;
    let writable = cursor < spare;
    if writable {
      let byte = low_byte(v: rest);
      set destination^[cursor] = byte;
    }
    set rest = irotr(rest, 8_u32);
    set cursor = cursor +wrap 1_u64;
  }
  return at +wrap 8_u64;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  doc "Publishes one prefix of the source range, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let wait_cancel_1 = std::time::cancel_never();
    let wait_outcome_1 = write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &wait_cancel_1);
    std::time::close_cancel_watch(watch: move wait_cancel_1);
    match wait_outcome_1 {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn publish_report(factory: &HandleFactory, output: &OutputStream, source: &[u8]) -> status: ExitStatus reads(source), writes(factory), writes(output) waits {
  doc "Trial adaptation: publish the actual observations with the maintained stdin_echo partial-write retry; status 250 reports publication failure.";
  let length = source^.len;
  match publish_all(factory: factory, output: output, source: source, length: length) {
    Ok(value: published) => {
      return exit_status(code: 0_u8);
    }
    Err(error: problem) => {
      return exit_status(code: 250_u8);
    }
  }
}

fn scalar_consumption(report: &[u8]) -> code: u64 writes(report) {
  let values = grow_vector_new::<u64, 8>();
  let seen = Sum(total: 0_u64, sequence: 0_u64, count: 0_u64);
  grow_vector_drain::<SumDrain, 8>(values: &values, env: &seen);
  let reserved = grow_vector_reserve::<u64, 8>(values: &values, total: 8_u64);
  for @fill (
    index in 0_u64..5_u64,
    invariant length_lo: values.storage.inner.len >= index,
    invariant length_hi: values.storage.inner.len <= index
  ) {
    let value = index + 1_u64;
    let length = grow_vector_append::<u64, 8>(values: &values, value: value);
  }
  grow_vector_truncate::<SumDrain, 8>(values: &values, retained: 2_u64, env: &seen);
  let recorded_0 = spell(destination: report, at: 0_u64, value: seen.sequence);
  let recorded_8 = spell(destination: report, at: 8_u64, value: seen.count);
  let recorded_16 = spell(destination: report, at: 16_u64, value: values.storage.inner[0_u64]);
  let recorded_24 = spell(destination: report, at: 24_u64, value: values.storage.inner[1_u64]);
  let recorded_32 = spell(destination: report, at: 32_u64, value: reserved);
  if seen.sequence != 199180_u64 {
    return 1_u64;
  }
  if seen.count != 3_u64 {
    return 2_u64;
  }
  if values.storage.inner[0_u64] != 1_u64 {
    return 3_u64;
  }
  if values.storage.inner[1_u64] != 2_u64 {
    return 4_u64;
  }
  if values.storage.inner.cap != reserved {
    return 5_u64;
  }
  let appended = grow_vector_append::<u64, 8>(values: &values, value: 6_u64);
  let first = grow_vector_swap_remove::<u64, 8>(values: &values, index: 0_u64);
  let last = grow_vector_swap_remove::<u64, 8>(values: &values, index: 1_u64);
  let recorded_40 = spell(destination: report, at: 40_u64, value: first);
  let recorded_48 = spell(destination: report, at: 48_u64, value: last);
  if first != 1_u64 {
    return 6_u64;
  }
  if last != 2_u64 {
    return 7_u64;
  }
  set seen.sequence = 0_u64;
  set seen.count = 0_u64;
  grow_vector_drain::<SumDrain, 8>(values: &values, env: &seen);
  grow_vector_drain::<SumDrain, 8>(values: &values, env: &seen);
  let reused = grow_vector_append::<u64, 8>(values: &values, value: 7_u64);
  grow_vector_truncate::<SumDrain, 8>(values: &values, retained: 1_u64, env: &seen);
  grow_vector_truncate::<SumDrain, 8>(values: &values, retained: 0_u64, env: &seen);
  let recorded_56 = spell(destination: report, at: 56_u64, value: seen.sequence);
  let recorded_64 = spell(destination: report, at: 64_u64, value: seen.count);
  if seen.sequence != 1549_u64 {
    return 8_u64;
  }
  if seen.count != 2_u64 {
    return 9_u64;
  }
  set seen.sequence = 0_u64;
  set seen.count = 0_u64;
  for @refill (
    index in 0_u64..8_u64,
    invariant length_lo: values.storage.inner.len >= index,
    invariant length_hi: values.storage.inner.len <= index
  ) {
    let value = index + 1_u64;
    let length = grow_vector_append::<u64, 8>(values: &values, value: value);
  }
  grow_vector_truncate::<SumDrain, 8>(values: &values, retained: 7_u64, env: &seen);
  grow_vector_truncate::<SumDrain, 8>(values: &values, retained: 6_u64, env: &seen);
  let recorded_72 = spell(destination: report, at: 72_u64, value: seen.sequence);
  let recorded_80 = spell(destination: report, at: 80_u64, value: seen.count);
  if seen.sequence != 2063_u64 {
    return 10_u64;
  }
  if seen.count != 2_u64 {
    return 11_u64;
  }
  for (index in 0_u64..6_u64) {
    let expected = index + 1_u64;
    if values.storage.inner[index] != expected {
      return 12_u64;
    }
  }
  if values.storage.inner.cap != reserved {
    return 13_u64;
  }
  let recorded_88 = spell(destination: report, at: 88_u64, value: values.storage.inner.cap);
  grow_vector_drain::<SumDrain, 8>(values: &values, env: &seen);
  grow_vector_free_empty::<u64, 8>(values: move values);
  let recorded_96 = spell(destination: report, at: 96_u64, value: seen.count);
  if seen.count != 8_u64 {
    return 14_u64;
  }
  return 0_u64;
}

fn main(inputs: std::process::Inputs) -> status: ExitStatus pure waits {
  doc "Trial adaptation: call the scalar consuming-callback sequence and publish the actual folds, counts, retained values, removals and capacities.";
  let std::process::Inputs(args: unused_args, drivers: unused_driver_count, cwd: directory, stdout: out, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let report = array_filled::<u8, 104>(value: 0_u8);
  let report_window = &report[0_u64..104_u64];
  let code = scalar_consumption(report: report_window);
  if code != 0_u64 {
    return exit_status(code: 1_u8);
  }
  return publish_report(factory: &factory, output: &out, source: report_window);
}
